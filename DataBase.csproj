<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DataBase</RootNamespace>
    <AssemblyName>DataBase</AssemblyName>
    <Version>1.0.2</Version>
    <!-- Иконка, вшиваемая в Windows .exe (проводник, ярлык, закреп в таскбаре).
         Учитывается только при сборке под Windows; на других ОС игнорируется. -->
    <ApplicationIcon>Assets\Branding\icon.ico</ApplicationIcon>
    <!--
      При публикации в один файл (-p:PublishSingleFile=true) вшивать нативные
      библиотеки (SkiaSharp, HarfBuzz, SQLite) в .exe и распаковывать их при
      запуске. Без этого Skia не грузится из бандла → DllNotFoundException и
      приложение падает на старте. На обычные сборки свойство не влияет.
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia"                        Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop"               Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent"         Version="11.2.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid"     Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter"           Version="11.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm"          Version="8.3.2"  />
    <PackageReference Include="Microsoft.EntityFrameworkCore"  Version="9.0.0"  />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Markdown.Avalonia"                Version="11.0.3" />
    <PackageReference Include="Markdig"                          Version="0.37.0" />
    <PackageReference Include="ClosedXML"                        Version="0.104.2" />
    <PackageReference Include="PdfPig"                          Version="0.1.15" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- Исключить старый скаффолд, который не является частью проекта -->
  <ItemGroup>
    <Compile    Remove="calendar_avalonia\**" />
    <AvaloniaXaml Remove="calendar_avalonia\**" />
    <AvaloniaResource Remove="calendar_avalonia\**" />
    <None       Remove="calendar_avalonia\**" />
    <EmbeddedResource Remove="calendar_avalonia\**" />
  </ItemGroup>

</Project>
