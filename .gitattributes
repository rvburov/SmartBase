# Общие правила
* text=auto

# Для текстовых файлов: принудительно используем LF в репозитории
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.base text eol=lf

# Для Windows-скриптов: сохраняем CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Двоичные файлы
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary 