<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Замеры производительности (не автотесты). Объединяет прежние SidebarPerf, ImportPerf
    и ExportPerf в один инструмент с диспетчером команд (sidebar / import / export).
    Функциональные проверки этих харнессов перенесены в Tests/SmartBase.Tests (xUnit).
    Как запускать — см. Tests/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SmartBase.Tests.Benchmarks</RootNamespace>
    <AssemblyName>Benchmarks</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SmartBase.csproj" />
  </ItemGroup>

</Project>
