<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Функциональная матрица и замер производительности импорта таблиц (Excel/CSV/JSON).
    Вызывает те же методы, что и приложение: ImportPlanner.Plan → ITableSource.Analyze/ReadRows →
    ConstructorRepository.ImportStreamedCollectionIsolated. Тестовые файлы генерирует сам
    (xlsx — через ClosedXML из главного проекта). Запуск из корня репозитория:
      dotnet run -c Release ~project Tests/ImportPerf                     → селф-тест матрицы
      dotnet run -c Release ~project Tests/ImportPerf ~ ~perf ~rows N     → замер на большом CSV
    (~ здесь заменяет двойной дефис, запрещённый внутри XML-комментария).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DataBase.Tests.ImportPerf</RootNamespace>
    <AssemblyName>ImportPerf</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DataBase.csproj" />
  </ItemGroup>

</Project>
