<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Тесты расширения «Сравнение составов изделий» (Extensions/ProductCompare/).

    Стенд (источники .xlsx и шаблон .xlsm) собирается ClosedXML прямо в тесте — бинарных
    фикстур в репозитории нет. ClosedXML приходит транзитивно через ссылку на приложение.

    Отдельная сборка на расширение: удаление расширения = удаление этой папки, больше ничего
    править не нужно — ни SmartBase.sln, ни скрипт прогона (глоб), ни CI.

    Запуск: dotnet test Tests/Extensions/ProductCompare
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>SmartBase.Tests.Extensions.ProductCompare</RootNamespace>
    <AssemblyName>SmartBase.Tests.Extensions.ProductCompare</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\SmartBase.csproj" />
  </ItemGroup>

</Project>
