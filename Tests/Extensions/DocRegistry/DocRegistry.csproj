<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Тесты расширения «Регистрация КД» (Extensions/DocRegistry/).

    Отдельная сборка на расширение: удаление расширения = удаление этой папки, больше ничего
    править не нужно — ни SmartBase.sln (проектов тестов расширений в нем нет), ни скрипт
    прогона (он берет проекты глобом), ни CI.

    Запуск: dotnet test Tests/Extensions/DocRegistry
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>SmartBase.Tests.Extensions.DocRegistry</RootNamespace>
    <AssemblyName>SmartBase.Tests.Extensions.DocRegistry</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="SmartBase.Tests.Extensions.Shared" />
    <!-- Самостоятельный UI-стенд запускается отдельно, а не внутри xUnit. -->
    <Compile Remove="Ui/**/*.cs" />
  </ItemGroup>

  <!-- Приложение (оттуда же встроенный справочник ЕСКД — он лежит в ресурсах SmartBase.dll)
       и общая обвязка тестов расширений (TempDatabase). Стенд журнала регистрации
       (JournalStand.cs) остается здесь: он знает про это расширение. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\SmartBase.csproj" />
    <ProjectReference Include="..\..\ExtensionsShared\ExtensionsShared.csproj" />
  </ItemGroup>

</Project>
