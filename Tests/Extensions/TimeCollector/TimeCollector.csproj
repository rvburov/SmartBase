<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Тесты расширения «Сводная трудоемкость» (Extensions/TimeCollector/).

    Отдельная сборка на расширение: удаление расширения = удаление этой папки, больше ничего
    править не нужно — ни SmartBase.sln (проектов тестов расширений в нем нет), ни скрипт
    прогона (он берет проекты глобом), ни CI. Тесты ядра (Tests/Unit, Tests/Integration) с
    этим проектом не пересекаются: другая сборка, другой процесс тест-хоста, общая только
    ссылка на приложение.

    Запуск: dotnet test Tests/Extensions/TimeCollector
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>SmartBase.Tests.Extensions.TimeCollector</RootNamespace>
    <AssemblyName>SmartBase.Tests.Extensions.TimeCollector</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="SmartBase.Tests.Extensions.Shared" />
  </ItemGroup>

  <!-- Приложение (ClosedXML и ExcelDataReader приходят транзитивно — так же ими пользовался
       этот же тест, пока лежал в Tests/Integration) и общая обвязка тестов расширений
       (TempDatabase, TempDir, SyncProgress). Excel-стенд остается здесь: он знает про формат
       расчетов этого расширения. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\SmartBase.csproj" />
    <ProjectReference Include="..\..\ExtensionsShared\ExtensionsShared.csproj" />
  </ItemGroup>

</Project>
