<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Стенд многопользовательской работы с одним SQLite-файлом (см.
    docs/architecture/multi-database.md, раздел «Многопользовательский режим»).
    Режимы (запуск из корня: dotnet run -c Release ~project Tests/MultiUserHarness ~ <режим>):
      ~check-pragmas          профиль журнала/прагм: локально WAL, «сеть» DELETE+FULL+mmap=0
      ~contend <db>           два процесса бьют в одну ячейку: без падений, integrity ok
      ~writer <db>            «второй пользователь» правит ячейку раз в 2 с (для живой
                              проверки синхронизации в запущенном приложении)
      ~hold-write-lock <db> N держать write-транзакцию N секунд (проверка тоста «занята»)
    (~ здесь заменяет двойной дефис, запрещённый в XML-комментарии).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SmartBase.Tests.MultiUserHarness</RootNamespace>
    <AssemblyName>MultiUserHarness</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SmartBase.csproj" />
  </ItemGroup>

</Project>
