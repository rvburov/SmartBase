<Project Sdk="Microsoft.NET.Sdk">

  <!-- Стенд этапов 0–3 плана drawn-grid.md: рисованная сетка на настоящих данных.
       Меряет открытие, шаги прокрутки по обеим осям, прыжок в конец, сортировку и отбор в фоне,
       память; сохраняет кадры в PNG. Режим ~~snap: попиксельное сравнение с нынешней таблицей при
       масштабе 1 и 2, включая сцены выделения; ~~gestures: безголовая мышь — наведение, ширины и
       высоты, навигация; ~~keys: клавиши и мышь на настоящем TableView — выделение, буфер, отмена.
       Настоящий шрифт (Skia), не входит в автотесты. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SmartBase.Tests.GridProto</RootNamespace>
    <AssemblyName>SmartBase.Tests.GridProto</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="11.2.3" />
    <ProjectReference Include="..\..\SmartBase.csproj" />
  </ItemGroup>

</Project>
