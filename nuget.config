<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Все кэши NuGet перенаправлены ВНУТРЬ проекта (аналог venv в Python).
    Скачанные пакеты и кэш загрузок складываются в calendar_avalonia\packages\.
    Системный диск C не используется. Артефакты сборки лежат отдельно в artifacts\
    (см. Directory.Build.props). Папка packages\ исключена в .gitignore — это кэш.
  -->
  <config>
    <!-- Куда распаковываются установленные пакеты (главный кэш, ~3 ГБ) -->
    <add key="globalPackagesFolder" value="packages\packages" />
    <!-- HTTP-кэш загрузок с nuget.org -->
    <add key="http_cacheFolder" value="packages\http-cache" />
    <!-- Кэш плагинов NuGet -->
    <add key="pluginsCacheFolder" value="packages\plugins-cache" />
  </config>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
