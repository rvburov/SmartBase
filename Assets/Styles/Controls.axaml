<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- Радиусы скругления -->
        <CornerRadius x:Key="RadiusXS">4</CornerRadius>
        <CornerRadius x:Key="RadiusSmall">5</CornerRadius>
        <CornerRadius x:Key="RadiusBase">6</CornerRadius>
        <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
        <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
        <CornerRadius x:Key="RadiusPill">15</CornerRadius>

        <!-- Толщина всех разделительных линий (1 DIP). Цвет линий — BrushSeparator.
             Меняешь здесь — меняется толщина во всём приложении. -->
        <x:Double x:Key="SeparatorThickness">1</x:Double>

        <!-- Единый стандарт высоты строки (таблица + блоки сайдбара + блоки событий). -->
        <x:Double x:Key="RowHeightStandard">36</x:Double>
        <!-- Шаг строки = высота + линия-разделитель 1px (как сетка таблицы).
             Используется в сайдбаре, где линия рисуется внутри высоты Border. -->
        <x:Double x:Key="RowStepStandard">37</x:Double>

        <!-- Цвет скроллбара -->
        <SolidColorBrush x:Key="BrushScrollbar" Color="#C7C7CC" />

        <!-- Тема кнопки-стрелки скроллбара: своя отрисовка без Fluent-обводки,
             контент строго по центру. -->
        <ControlTheme x:Key="ScrollLineButton" TargetType="RepeatButton">
            <Setter Property="Background"       Value="#EDEDF0" />
            <Setter Property="BorderThickness"  Value="0" />
            <Setter Property="Padding"          Value="0" />
            <Setter Property="MinWidth"         Value="0" />
            <Setter Property="MinHeight"        Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#DADADE" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="#C2C2C8" />
            </Style>
        </ControlTheme>

        <!-- Тема постраничной области (прозрачная, без визуала). -->
        <ControlTheme x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinWidth"        Value="0" />
            <Setter Property="MinHeight"       Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <!-- Window -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
        <!-- Округление координат к физическим пикселям наследуется вниз по дереву:
             1px-линии остаются ровно 1px и не «толстеют» на дробном масштабе ОС. -->
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>
    <!-- Минимальный размер только у главного окна, не у диалогов -->
    <Style Selector="Window.main">
        <Setter Property="MinWidth"  Value="1100" />
        <Setter Property="MinHeight" Value="760" />
    </Style>

    <!-- ── Разделительная линия ───────────────────────────────────────────
         Единый цвет (BrushSeparator) + толщина (SeparatorThickness) в одном месте.
         Использование:
           <Border Classes="separator h" />   горизонтальная (тянется по ширине)
           <Border Classes="separator v" />   вертикальная   (тянется по высоте)
         Позиционирование (VerticalAlignment/Margin/ColumnSpan) задаётся по месту. -->
    <Style Selector="Border.separator">
        <Setter Property="Background" Value="{StaticResource BrushSeparator}" />
    </Style>
    <Style Selector="Border.separator.h">
        <Setter Property="Height" Value="{StaticResource SeparatorThickness}" />
    </Style>
    <Style Selector="Border.separator.v">
        <Setter Property="Width" Value="{StaticResource SeparatorThickness}" />
    </Style>

    <!-- Button -->
    <Style Selector="Button">
        <Setter Property="Background"   Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="Foreground"   Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusBase}" />
        <Setter Property="Padding"      Value="12,6" />
        <Setter Property="Cursor"       Value="Hand" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushHover}" />
    </Style>

    <Style Selector="Button.dialog">
        <Setter Property="Width"                      Value="110" />
        <Setter Property="Height"                     Value="30" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="CornerRadius"               Value="{StaticResource RadiusMedium}" />
        <Setter Property="Background"                 Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="Foreground"                 Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="FontSize"                   Value="{DynamicResource FontSizeBase}" />
        <Setter Property="FontWeight"                 Value="{StaticResource FontWeightNormal}" />
        <Setter Property="BorderBrush"                Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness"            Value="1.2" />
    </Style>

    <Style Selector="Button.dialog:pointerover /template/ ContentPresenter">
        <Setter Property="Background"  Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>

    <!-- Button/ToggleButton с иконкой: прозрачный фон, при наведении иконка синеет -->
    <Style Selector="Button.icon, ToggleButton.icon">
        <Setter Property="Background"                 Value="Transparent" />
        <Setter Property="BorderThickness"            Value="0" />
        <Setter Property="Padding"                    Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="Foreground"                 Value="{StaticResource BrushSecondaryText}" />
        <Setter Property="Cursor"                     Value="Hand" />
    </Style>

    <Style Selector="Button.icon /template/ ContentPresenter,
                     ToggleButton.icon /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.icon:pointerover /template/ ContentPresenter,
                     ToggleButton.icon:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.icon:pointerover,
                     ToggleButton.icon:pointerover">
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
    </Style>

    <Style Selector="Button.filterChevron:pointerover /template/ ContentPresenter">
        <Setter Property="Background"     Value="{StaticResource BrushHover}" />
        <Setter Property="CornerRadius"   Value="4" />
    </Style>

    <!-- Цвет текста таблицы — из общей палитры (единый источник, как у Button/ComboBox/TextBox). -->
    <Style Selector="DataGrid">
        <Setter Property="Foreground" Value="{StaticResource BrushPrimaryText}" />
    </Style>

    <!-- Заголовок колонки таблицы: серый фон при наведении -->
    <Style Selector="Border.colHeader:pointerover">
        <Setter Property="Background" Value="{StaticResource BrushHover}" />
    </Style>

    <!-- Активный модуль в ActivityBar -->
    <Style Selector="ToggleButton.icon.module:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ToggleButton.icon.module:checked">
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
    </Style>

    <!-- Кнопки навбаров в стиле «Сегодня»: серый фон, серая рамка,
         при наведении синяя рамка + синяя иконка.
         ToolTip.Placement=Top: в fullscreen-режиме футер прижат к нижней границе
         экрана; дефолтное Placement=Pointer уводит popup тултипа на саму кнопку,
         курсор уходит в окно тултипа, hover теряется, тултип закрывается — и
         цикл повторяется (мерцание hover-стиля и cursor Hand↔Arrow). Top гарантирует,
         что popup всегда выше кнопки и не перехватывает курсор. -->
    <Style Selector="Button.navbtn, ToggleButton.navbtn">
        <Setter Property="Background"                 Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="Foreground"                 Value="{StaticResource BrushSecondaryText}" />
        <Setter Property="BorderBrush"                Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness"            Value="1.2" />
        <Setter Property="Padding"                    Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="Cursor"                     Value="Hand" />
        <Setter Property="ToolTip.Placement"          Value="Top" />
        <Setter Property="ToolTip.VerticalOffset"     Value="-4" />
    </Style>
    <Style Selector="Button.navbtn:pointerover /template/ ContentPresenter,
                     ToggleButton.navbtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background"  Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>
    <Style Selector="Button.navbtn:pointerover,
                     ToggleButton.navbtn:pointerover">
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
    </Style>
    <!-- В нажатом/checked состоянии остаёмся серыми (перебиваем синий Fluent).
         Синий — только при наведении. -->
    <Style Selector="ToggleButton.navbtn:checked /template/ ContentPresenter">
        <Setter Property="Background"  Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushSeparator}" />
    </Style>
    <Style Selector="ToggleButton.navbtn:checked">
        <Setter Property="Foreground" Value="{StaticResource BrushSecondaryText}" />
    </Style>
    <!-- Но при наведении на checked — снова синий -->
    <Style Selector="ToggleButton.navbtn:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background"  Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>
    <Style Selector="ToggleButton.navbtn:checked:pointerover">
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
    </Style>

    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{StaticResource BrushRed}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Всплывающее окно фильтра/сортировки колонок таблицы (Excel-стиль).
         Стиль обязан жить здесь: FlyoutPresenter рендерится в popup-руте,
         до которого локальные стили UserControl не доходят. -->
    <Style Selector="FlyoutPresenter.filterFlyout">
        <Setter Property="Padding"         Value="0" />
        <!-- Серая подложка (как у панели свойств в сайдбаре): белые карточки поиска и списка
             на сером фоне. -->
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
    </Style>

    <!-- Всплывашка-уведомление (Toast): сама плашка БЕЗ своего оформления — внутри живёт обычный
         баннер (ErrorBanner) ровно как в диалогах, поэтому фон под ним = BrushBg (как фон окна
         диалога), скругление = радиус баннера, без рамки/паддинга. Так всплывашка 1-в-1 совпадает
         с баннером в окнах «Создать»/«Изменить». Живёт здесь, т.к. FlyoutPresenter рендерится в popup-руте. -->
    <Style Selector="FlyoutPresenter.toast">
        <Setter Property="Padding"                    Value="0" />
        <Setter Property="Background"                 Value="{StaticResource BrushBg}" />
        <Setter Property="BorderThickness"            Value="0" />
        <Setter Property="CornerRadius"               Value="{StaticResource RadiusBase}" />
        <Setter Property="MinWidth"                   Value="0" />
        <!-- Снимаем дефолтную min-высоту Fluent: высота = как у баннера (по контенту),
             а не выше с пустотой снизу. Контент — по центру по вертикали. -->
        <Setter Property="MinHeight"                  Value="0" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="MaxWidth"                   Value="460" />
    </Style>

    <!-- ComboBox — серый фон, скругление, рамка как у поля даты/времени -->
    <Style Selector="ComboBox">
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="Foreground"      Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
        <!-- Выбранное значение по центру по вертикали; единый внутренний отступ
             (последнее число — отступ справа до стрелки одинаков везде). -->
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding"                  Value="10,0,8,0" />
        <!-- Снимаем дефолтный Fluent MinHeight (~32px), чтобы Height=30
             совпадал по высоте с навигационными кнопками. -->
        <Setter Property="MinHeight"                Value="30" />
    </Style>

    <!-- Текст выбранного значения: по центру + обрезка многоточием при длинном тексте. -->
    <Style Selector="ComboBox /template/ ContentControl#ContentPresenter">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox /template/ ContentControl#ContentPresenter TextBlock">
        <Setter Property="TextTrimming"      Value="CharacterEllipsis" />
        <Setter Property="TextWrapping"      Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ComboBox /template/ Border#Background">
        <Setter Property="Background" Value="{StaticResource BrushSecondaryBg}" />
    </Style>

    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background"   Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"  Value="{StaticResource BrushAccent}" />
    </Style>

    <Style Selector="ComboBox:focus /template/ Border#Background">
        <Setter Property="Background"   Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"  Value="{StaticResource BrushAccent}" />
    </Style>

    <!-- Стрелка — шеврон вниз (как у поля времени/даты), цвет BrushSecondaryText.
         PathIcon рисует заливкой, поэтому геометрия — замкнутый контур "V". -->
    <Style Selector="ComboBox /template/ PathIcon#DropDownGlyph">
        <Setter Property="IsVisible"   Value="True" />
        <Setter Property="Width"       Value="12" />
        <Setter Property="Height"      Value="8" />
        <Setter Property="Foreground"  Value="{StaticResource BrushSecondaryText}" />
        <Setter Property="Data"        Value="{StaticResource IconChevronDownFilled}" />
        <Setter Property="RenderTransform" Value="none" />
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="Foreground"               Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="Background"               Value="Transparent" />
        <Setter Property="Padding"                  Value="10,7" />
        <Setter Property="Margin"                   Value="4,2" />
        <Setter Property="CornerRadius"             Value="{StaticResource RadiusBase}" />
        <Setter Property="HorizontalAlignment"      Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Длинный пункт списка обрезается многоточием. -->
    <Style Selector="ComboBoxItem TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- Эффекты ровно как в контекстном меню: используем те же ресурсы темы Fluent,
         что и MenuFlyoutItem (фон при наведении/выборе, цвет текста). -->
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background"             Value="{DynamicResource MenuFlyoutItemBackgroundPointerOver}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MenuFlyoutItemForegroundPointerOver}" />
        <Setter Property="CornerRadius"           Value="{StaticResource RadiusBase}" />
    </Style>

    <Style Selector="ComboBoxItem:selected">
        <Setter Property="Foreground" Value="{StaticResource BrushPrimaryText}" />
    </Style>

    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background"             Value="{DynamicResource MenuFlyoutItemBackgroundPointerOver}" />
        <Setter Property="CornerRadius"           Value="{StaticResource RadiusBase}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushPrimaryText}" />
    </Style>

    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushPrimaryText}" />
    </Style>

    <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background"             Value="{DynamicResource MenuFlyoutItemBackgroundPointerOver}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushPrimaryText}" />
    </Style>

    <Style Selector="ComboBox /template/ Popup > Border">
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding"         Value="0,2" />
        <!-- Зазор между полем и выпадашкой — как у списка времени (timePopup). -->
        <Setter Property="Margin"          Value="0,1,0,0" />
    </Style>

    <!-- TextBox -->
    <Style Selector="TextBox">
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="Foreground"      Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusBase}" />
        <Setter Property="Padding"         Value="10,6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <!-- Выделение текста серым вместо системного синего -->
        <Setter Property="SelectionBrush"           Value="#C7C7CC" />
        <Setter Property="SelectionForegroundBrush" Value="{StaticResource BrushPrimaryText}" />
        <!-- По умолчанию однострочный: без вертикальной прокрутки — иначе при крупном шрифте
             текст переполняет поле фикс. высоты и вылезает кнопка-стрелка скроллбара.
             Многострочным (notesEditor, DescBox, лог) скролл возвращается отдельно. -->
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>

    <!-- Заголовок «в строку» (имя коллекции в навбаре, имя записи в RecordPageView).
         Не показывает рамку/фон ни в одном состоянии. Watermark наследует
         текущие FontSize/FontWeight, чтобы плейсхолдер выглядел как сам заголовок,
         только полупрозрачным. -->
    <Style Selector="TextBox.titleEditor">
        <Setter Property="Background"               Value="Transparent" />
        <Setter Property="BorderThickness"          Value="0" />
        <Setter Property="Padding"                  Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox.titleEditor /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.titleEditor:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.titleEditor:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Watermark копирует размер и жирность с самого TextBox -->
    <Style Selector="TextBox.titleEditor /template/ TextBlock#PART_Watermark">
        <Setter Property="FontSize"          Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight"        Value="{StaticResource FontWeightBold}" />
        <Setter Property="Foreground"        Value="{StaticResource BrushSecondaryText}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Безбордерный редактор (письмо как в заметках): убираем рамку во всех состояниях,
         включая синюю рамку фокуса. -->
    <Style Selector="TextBox.notesEditor">
        <Setter Property="Background"               Value="Transparent" />
        <Setter Property="BorderThickness"          Value="0" />
        <Setter Property="Padding"                  Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <!-- Многострочный редактор — вертикальная прокрутка нужна (перебиваем дефолт TextBox). -->
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style Selector="TextBox.notesEditor /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.notesEditor:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.notesEditor:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ===== Значение свойства в карточке RecordPageView ===== -->
    <!-- Безбордерное во ВСЕХ состояниях (включая фокус/наведение): рамку и подсветку даёт
         сама карточка, как у поля даты (timeInput). Без этого тема Fluent в фокусе рисует
         собственную синюю рамку ВНУТРИ карточки — «бокс в боксе», что и просили убрать. -->
    <Style Selector="TextBox.propValue">
        <Setter Property="Background"               Value="Transparent" />
        <Setter Property="Foreground"               Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="BorderThickness"          Value="0" />
        <Setter Property="Padding"                  Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="TextBox.propValue /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.propValue:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.propValue:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ComboBox-значение свойства (тип «список»): так же без собственной рамки/фона во
         всех состояниях — рамку даёт карточка. -->
    <Style Selector="ComboBox.propValue">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding"         Value="0,0,8,0" />
        <Setter Property="MinHeight"       Value="0" />
    </Style>
    <Style Selector="ComboBox.propValue /template/ Border#Background">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ComboBox.propValue:pointerover /template/ Border#Background">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ComboBox.propValue:focus /template/ Border#Background">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Классический скроллбар (как в Excel): дорожка всегда видна, сверху/снизу
         кнопки-стрелки, посередине перетаскиваемый ползунок. Собственный шаблон,
         т.к. тема Fluent прячет ползунок. -->
    <Style Selector="ScrollBar">
        <Setter Property="AllowAutoHide" Value="False" />
        <Setter Property="Opacity"       Value="1" />
        <Setter Property="Background"     Value="Transparent" />
    </Style>

    <!-- Стрелка в Viewbox — всегда влезает и одинакового размера. -->
    <Style Selector="ScrollBar Path.arrow">
        <Setter Property="Stroke"          Value="#7A7A80" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap"   Value="Round" />
        <Setter Property="StrokeJoin"      Value="Round" />
    </Style>

    <!-- Ползунок: собственный шаблон (залитый прямоугольник) — не зависит от темы Fluent. -->
    <Style Selector="ScrollBar Thumb">
        <Setter Property="Background" Value="#A0A0A6" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="3" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ScrollBar Thumb:pointerover">
        <Setter Property="Background" Value="#7A7A80" />
    </Style>
    <Style Selector="ScrollBar Thumb:pressed">
        <Setter Property="Background" Value="#5A5A5E" />
    </Style>

    <!-- Вертикальный -->
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="20" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- 3 отдельных блока: кнопка-вверх, дорожка с ползунком, кнопка-вниз; разделены зазорами -->
                <Grid RowDefinitions="20,4,*,4,20" Background="Transparent">
                    <RepeatButton Grid.Row="0" Name="PART_LineUpButton" Theme="{StaticResource ScrollLineButton}" Margin="2,0">
                        <Viewbox Width="10" Height="7" Stretch="Uniform">
                            <Path Classes="arrow" Data="{StaticResource IconScrollUp}" />
                        </Viewbox>
                    </RepeatButton>
                    <Border Grid.Row="2" Background="#EDEDF0" CornerRadius="4" Margin="2,0" Padding="0,2">
                        <Track Name="PART_Track" Orientation="Vertical"
                               IsDirectionReversed="True"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               ViewportSize="{TemplateBinding ViewportSize}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource ScrollPageButton}" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource ScrollPageButton}" />
                            </Track.IncreaseButton>
                            <Track.Thumb>
                                <Thumb MinHeight="28" />
                            </Track.Thumb>
                        </Track>
                    </Border>
                    <RepeatButton Grid.Row="4" Name="PART_LineDownButton" Theme="{StaticResource ScrollLineButton}" Margin="2,0">
                        <Viewbox Width="10" Height="7" Stretch="Uniform">
                            <Path Classes="arrow" Data="{StaticResource IconScrollDown}" />
                        </Viewbox>
                    </RepeatButton>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Горизонтальный -->
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- 3 отдельных блока: кнопка-влево, дорожка с ползунком, кнопка-вправо; разделены зазорами -->
                <Grid ColumnDefinitions="20,4,*,4,20" Background="Transparent">
                    <RepeatButton Grid.Column="0" Name="PART_LineUpButton" Theme="{StaticResource ScrollLineButton}" Margin="0,2">
                        <Viewbox Width="7" Height="10" Stretch="Uniform">
                            <Path Classes="arrow" Data="{StaticResource IconScrollLeft}" />
                        </Viewbox>
                    </RepeatButton>
                    <Border Grid.Column="2" Background="#EDEDF0" CornerRadius="4" Margin="0,2" Padding="2,0">
                        <Track Name="PART_Track" Orientation="Horizontal"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               ViewportSize="{TemplateBinding ViewportSize}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource ScrollPageButton}" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource ScrollPageButton}" />
                            </Track.IncreaseButton>
                            <Track.Thumb>
                                <Thumb MinWidth="28" />
                            </Track.Thumb>
                        </Track>
                    </Border>
                    <RepeatButton Grid.Column="4" Name="PART_LineDownButton" Theme="{StaticResource ScrollLineButton}" Margin="0,2">
                        <Viewbox Width="7" Height="10" Stretch="Uniform">
                            <Path Classes="arrow" Data="{StaticResource IconScrollRight}" />
                        </Viewbox>
                    </RepeatButton>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- CalendarDatePicker -->
    <Style Selector="CalendarDatePicker">
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
        <Setter Property="Foreground"      Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="Padding"         Value="10,0" />
    </Style>

    <!-- Текст даты: прозрачный фон, вертикальный центр, отступ как у времени -->
    <Style Selector="CalendarDatePicker /template/ TextBox#PART_TextBox">
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="CalendarDatePicker /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="CalendarDatePicker:pointerover /template/ Border#Background">
        <Setter Property="Background"  Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>

    <Style Selector="CalendarDatePicker:focus /template/ Border#Background">
        <Setter Property="Background"  Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>

    <!-- Кнопка справа — стандартная иконка «дата» (календарь с цифрой 1), как в таблице
         (DateField/DateEditor): Viewbox → Canvas 24×24 → Path IconCalendarDate -->
    <Style Selector="CalendarDatePicker /template/ Button#PART_Button">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width"           Value="NaN" />
        <Setter Property="MinWidth"        Value="0" />
        <Setter Property="Padding"         Value="4,0,8,0" />
        <Setter Property="Cursor"          Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                    <Viewbox Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}"
                             VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconCalendarDate}"
                                  Stroke="{StaticResource BrushSecondaryText}"
                                  StrokeThickness="1.8"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Popup календаря -->
    <Style Selector="CalendarDatePicker /template/ Popup > Border">
        <Setter Property="Background"      Value="{StaticResource BrushBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
        <Setter Property="BoxShadow"       Value="0 4 16 0 #1A000000" />
    </Style>

    <!-- Фон всего календаря -->
    <Style Selector="Calendar">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
    </Style>

    <Style Selector="CalendarItem">
        <Setter Property="Background"      Value="{StaticResource BrushBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushBg}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="CalendarItem /template/ Border">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="CalendarItem /template/ Grid">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
    </Style>

    <Style Selector="CalendarItem /template/ Grid#PART_Root">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
    </Style>

    <Style Selector="CalendarItem /template/ Border#BackgroundLayer">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
    </Style>

    <Style Selector="CalendarItem /template/ Rectangle">
        <Setter Property="Fill" Value="Transparent" />
    </Style>

    <!-- Заголовок месяца -->
    <Style Selector="CalendarItem /template/ Button#PART_HeaderButton">
        <Setter Property="Foreground"  Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="FontWeight"  Value="{StaticResource FontWeightBold}" />
        <Setter Property="FontSize"    Value="{DynamicResource FontSizeBase}" />
        <Setter Property="Background"  Value="{StaticResource BrushBg}" />
        <Setter Property="Padding"     Value="0" />
    </Style>

    <Style Selector="CalendarItem /template/ Button#PART_HeaderButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Кнопки prev/next месяца -->
    <Style Selector="Calendar /template/ Button#PART_PreviousButton">
        <Setter Property="Foreground"  Value="{StaticResource BrushSecondaryText}" />
        <Setter Property="Background"  Value="Transparent" />
        <Setter Property="Width"       Value="28" />
        <Setter Property="Height"      Value="28" />
    </Style>

    <Style Selector="Calendar /template/ Button#PART_NextButton">
        <Setter Property="Foreground"  Value="{StaticResource BrushSecondaryText}" />
        <Setter Property="Background"  Value="Transparent" />
        <Setter Property="Width"       Value="28" />
        <Setter Property="Height"      Value="28" />
    </Style>

    <!-- Дни недели -->
    <Style Selector="Calendar /template/ TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushSecondaryText}" />
        <Setter Property="FontSize"   Value="{DynamicResource FontSizeBase}" />
    </Style>

    <!-- Обычный день -->
    <Style Selector="CalendarDayButton">
        <Setter Property="Width"        Value="32" />
        <Setter Property="Height"       Value="32" />
        <Setter Property="Foreground"   Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="Background"   Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize"     Value="{DynamicResource FontSizeBase}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
    </Style>

    <Style Selector="CalendarDayButton /template/ Border#DayButtonFocusVisual">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="CalendarDayButton:pointerover /template/ Border#Background">
        <Setter Property="Background"      Value="{StaticResource BrushHover}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusBase}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Сегодня -->
    <Style Selector="CalendarDayButton:today /template/ Border#Background">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusBase}" />
    </Style>

    <Style Selector="CalendarDayButton:today">
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
    </Style>

    <!-- Выбранный день -->
    <Style Selector="CalendarDayButton:selected /template/ Border#Background">
        <Setter Property="Background"      Value="{StaticResource BrushAccent}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusBase}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="CalendarDayButton:selected">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
    </Style>

    <!-- Выбранный и сегодня одновременно -->
    <Style Selector="CalendarDayButton:selected:today /template/ Border#Background">
        <Setter Property="Background"      Value="{StaticResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="CalendarDayButton:selected:today">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Не текущего месяца -->
    <Style Selector="CalendarDayButton:inactive">
        <Setter Property="Foreground" Value="{StaticResource BrushSecondaryText}" />
        <Setter Property="Opacity"    Value="0.4" />
    </Style>

    <Style Selector="CalendarItem /template/ Grid#PART_YearView">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
    </Style>

    <Style Selector="CalendarItem /template/ Grid#PART_MonthView">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
    </Style>

    <!-- CalendarButton (месяцы и годы) -->
    <Style Selector="CalendarButton">
        <Setter Property="Foreground"      Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeBase}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
    </Style>

    <Style Selector="CalendarButton:pointerover /template/ Border#Background">
        <Setter Property="Background"      Value="{StaticResource BrushHover}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusBase}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="CalendarButton:selected">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
    </Style>

    <Style Selector="CalendarButton:selected /template/ Border#Background">
        <Setter Property="Background"      Value="{StaticResource BrushAccent}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusBase}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="CalendarButton:selected:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
    </Style>

    <Style Selector="CalendarButton:calendarbutton-hasbtn /template/ Border#Background">
        <Setter Property="Background"   Value="Transparent" />
        <Setter Property="BorderBrush"  Value="{StaticResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusBase}" />
    </Style>

    <Style Selector="CalendarButton:calendarbutton-hasbtn">
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
    </Style>

    <!-- ===== Кастомное поле времени (editable combobox, как CalendarDatePicker) ===== -->

    <!-- Внешний бокс: фон, рамка, скругление как у даты -->
    <Style Selector="Border.timeField">
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
    </Style>

    <!-- Наведение — синяя рамка (как у даты) -->
    <Style Selector="Border.timeField:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>

    <!-- Фокус в поле — белый фон + яркая толстая синяя рамка (как у даты) -->
    <Style Selector="Border.timeField:focus-within">
        <Setter Property="Background"      Value="{StaticResource BrushBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- Поле ввода внутри бокса: прозрачное, без рамки -->
    <Style Selector="TextBox.timeInput">
        <Setter Property="Background"               Value="Transparent" />
        <Setter Property="Foreground"               Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="BorderThickness"          Value="0" />
        <Setter Property="Padding"                  Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment"        Value="Stretch" />
        <!-- Однострочный ввод даты/времени: без вертикальной прокрутки, иначе при крупном
             шрифте текст переполняет поле и вылезает кнопка-стрелка скроллбара. -->
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style Selector="TextBox.timeInput /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.timeInput:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.timeInput:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Кнопка-стрелка справа -->
    <Style Selector="Button.timeArrow">
        <Setter Property="Background"                 Value="Transparent" />
        <Setter Property="BorderThickness"            Value="0" />
        <Setter Property="Padding"                    Value="4,0,8,0" />
        <Setter Property="CornerRadius"               Value="0" />
        <Setter Property="VerticalAlignment"          Value="Stretch" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="Cursor"                     Value="Hand" />
    </Style>

    <!-- Фон стрелки прозрачный во ВСЕХ состояниях: иначе тема Fluent рисует серый
         квадрат (фон кнопки по умолчанию виден через TemplateBinding). -->
    <Style Selector="Button.timeArrow /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.timeArrow:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.timeArrow:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Popup со списком времени -->
    <Style Selector="Border.timePopup">
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
        <Setter Property="BoxShadow"       Value="0 4 16 0 #1A000000" />
        <Setter Property="Padding"         Value="0,2" />
        <Setter Property="Margin"          Value="0,1,0,0" />
    </Style>

    <Style Selector="ListBox.timeList">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding"         Value="0" />
    </Style>

    <!-- Элементы списка времени -->
    <Style Selector="ListBox.timeList ListBoxItem">
        <Setter Property="Foreground"   Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="FontSize"     Value="{DynamicResource FontSizeBase}" />
        <Setter Property="Background"   Value="Transparent" />
        <Setter Property="Padding"      Value="10,7" />
        <Setter Property="Margin"       Value="4,2" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusBase}" />
    </Style>

    <Style Selector="ListBox.timeList ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background"   Value="{DynamicResource MenuFlyoutItemBackgroundPointerOver}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusBase}" />
    </Style>

    <Style Selector="ListBox.timeList ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background"   Value="{DynamicResource MenuFlyoutItemBackgroundPointerOver}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusBase}" />
    </Style>

    <Style Selector="ListBox.timeList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextBlock.Foreground" Value="{StaticResource BrushPrimaryText}" />
    </Style>

    <Style Selector="ListBox.timeList ListBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background"   Value="{DynamicResource MenuFlyoutItemBackgroundPointerOver}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusBase}" />
    </Style>

    <!-- CheckBox: единый стиль вынесен в Controls/Widgets/AppCheckBox.axaml -->

    <!-- ContextMenu / MenuItem: визуально как ComboBox-выпадашка.
         Фон/рамка/скругление контейнера повторяют ComboBox Popup, элементы — ComboBoxItem
         (наведение/выделение тем же ресурсом MenuFlyoutItemBackgroundPointerOver). -->
    <Style Selector="ContextMenu">
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeBase}" />
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding"         Value="0,2" />
        <Setter Property="MinWidth"        Value="180" />
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="FontSize"                 Value="{DynamicResource FontSizeBase}" />
        <Setter Property="Foreground"               Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="Background"               Value="Transparent" />
        <Setter Property="Padding"                  Value="10,7" />
        <Setter Property="Margin"                   Value="4,2" />
        <Setter Property="CornerRadius"             Value="{StaticResource RadiusSmall}" />
        <!-- Минимальная ширина самого пункта — растянет контейнер до одинаковой ширины
             у основного меню и у сабменю. -->
        <Setter Property="MinWidth"                 Value="172" />
    </Style>

    <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusSmall}" />
        <Setter Property="Padding"         Value="0" />
    </Style>

    <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background"   Value="{DynamicResource MenuFlyoutItemBackgroundPointerOver}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    </Style>

    <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background"   Value="{DynamicResource MenuFlyoutItemBackgroundPointerOver}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    </Style>

    <!-- Подменю (MenuFlyoutPresenter) — тот же стиль контейнера, что и ContextMenu,
         иначе сабменю «Изменить цвет» рендерится с белым Fluent-фоном. -->
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding"         Value="0,2" />
        <Setter Property="MinWidth"        Value="180" />
    </Style>

    <!-- Подменю у вложенного MenuItem (Popup со списком цветов): фон/рамка/радиус
         как у основного контекстного меню. Шаблон MenuItem кладёт сабменю в
         Border#PART_Popup + ScrollViewer#PART_ScrollViewer.
         Зазор от меню (чтобы не наезжало) задаётся в коде: HorizontalOffset попапа правится
         на инстансе (Sidebar.FixSubmenuGap), т.к. шаблон темы ставит его локальным значением,
         которое стиль перебить не может. -->
    <Style Selector="MenuItem /template/ Border#PART_Popup">
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding"         Value="0,2" />
    </Style>

    <!-- Хост панели «Отображение свойств даты» в сабменю: без chrome пункта меню
         (паддинг/маржа/подсветка наведения), чтобы внутри была чистая панель фильтра. -->
    <!-- Свой минимальный шаблон: только контент, без иконочной колонки/шеврона/подсветки
         пункта меню. Иначе общая (SharedSizeGroup) иконочная колонка добавляла бы лишний
         отступ слева — панель должна иметь одинаковые поля по кругу. -->
    <Style Selector="MenuItem.dateFieldsHost">
        <Setter Property="Margin"   Value="0" />
        <Setter Property="Padding"  Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Template">
            <ControlTemplate TargetType="MenuItem">
                <ContentPresenter Content="{TemplateBinding Header}" />
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>
