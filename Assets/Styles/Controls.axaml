<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="using:SmartBase.Controls.Behaviors">

    <Styles.Resources>
        <!-- Радиусы скругления -->
        <CornerRadius x:Key="RadiusXS">4</CornerRadius>
        <CornerRadius x:Key="RadiusSmall">5</CornerRadius>
        <CornerRadius x:Key="RadiusBase">6</CornerRadius>
        <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
        <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
        <CornerRadius x:Key="RadiusPill">15</CornerRadius>

        <!-- ── Единая высота элементов формы ───────────────────────────────────
             Один стандарт высоты для полей ввода (TextBox), выпадающих списков
             (ComboBox) и кнопок-действий (Button.dialog): в строках настроек/диалогов
             они стоят рядом и обязаны совпадать. Меняется в ОДНОМ месте.
             Тема Fluent навязывает TextBox/ComboBox свою min-высоту (~32px) — стили
             ниже перебивают ее этим значением, поэтому Height у контролов honored. -->
        <x:Double x:Key="ControlHeightStandard">30</x:Double>

        <!-- ── Толщина линий ────────────────────────────────────────────────
             ДЕФОЛТЫ токенов толщины. Живые значения пишет LineMetrics (Utils) в
             Resources каждого окна — визуально ~1 логический пиксель при любом зуме
             приложения и DPI монитора, снап к целым физическим пикселям. Потребители
             обязаны ссылаться через DynamicResource. Цвет линий — BrushSeparator. -->
        <x:Double x:Key="SeparatorThickness">1</x:Double>
        <!-- Legacy: толщина без компенсации зума — для контента ВНЕ зум-трансформа.
             Сейчас зумируется все (окна — WindowZoom, попапы — обертки AppZoomTransform),
             поэтому потребители в попапах тоже используют SeparatorThickness/BorderLine. -->
        <x:Double x:Key="SeparatorThicknessPopup">1</x:Double>
        <Thickness x:Key="BorderLine">1</Thickness>
        <Thickness x:Key="BorderLineFocus">2</Thickness>
        <Thickness x:Key="BorderLineTop">0,1,0,0</Thickness>
        <Thickness x:Key="BorderLineBottom">0,0,0,1</Thickness>
        <Thickness x:Key="BorderLineLeft">1,0,0,0</Thickness>
        <Thickness x:Key="BorderLineRight">0,0,1,0</Thickness>
        <!-- Для сеток из ячеек-Border: ячейка рисует правую и нижнюю, контейнер —
             верхнюю и левую. Так на стыке соседних ячеек линию рисует ровно ОДИН
             элемент (иначе две линии складываются в двойную толщину). -->
        <Thickness x:Key="BorderLineBottomRight">0,0,1,1</Thickness>
        <Thickness x:Key="BorderLineTopLeft">1,1,0,0</Thickness>
        <Thickness x:Key="BorderLinePopup">1</Thickness>
        <!-- При зуме ≠ 1 layout rounding пере-округлил бы компенсированную толщину
             (округление идет в пре-трансформ координатах) — линии-потребители
             отключают его динамически этим флагом. -->
        <x:Boolean x:Key="LineUseLayoutRounding">True</x:Boolean>

        <!-- Дефолт трансформа зума приложения для оберток попапов (живое значение
             публикует Scaling в Application.Resources при загрузке и смене зума). -->
        <ScaleTransform x:Key="AppZoomTransform" ScaleX="1" ScaleY="1" />

        <!-- Базовая высота строки: DataGrid.RowHeight (ячейки), высота шапки колонок
             (DataGridColumnHeader.Height) и блоки событий. ВНИМАНИЕ: у строки ДАННЫХ таблицы
             DataGrid ПРИБАВЛЯЕТ 1px линию сетки к RowHeight → ее реальный шаг = 36 + 1 = 37, а у
             шапки колонок разделитель сидит внутри → ее высота = 36. Поэтому сайдбар выравнивается
             так: первая строка (на месте шапки) = 36, остальные (на месте строк данных) = 37 —
             см. SidebarRow.RowHeight. Белые линии сайдбара тогда садятся на линии сетки таблицы. -->
        <x:Double x:Key="RowHeightStandard">36</x:Double>

        <!-- Высота строки ТАБЛИЦЫ конструктора и выровненного с ней дерева коллекций: то же
             36, но отдельным токеном, потому что его меняет настройка «Плотность строк
             таблицы» (ConstructorSettings публикует значение в Application.Resources, как
             Scaling — AppZoomTransform). Списки настроек, профиля и заметок остаются на
             RowHeightStandard: их плотность к конструктору отношения не имеет.
             ТОЛЬКО DynamicResource — со StaticResource смена настройки не доедет до экрана. -->
        <x:Double x:Key="RowHeightTable">36</x:Double>

        <!-- ── Всплывающий блок-список ──────────────────────────────────────────
             Дропдаун со списком на серой подложке (FlyoutPresenter.filterFlyout):
             фильтр колонки таблицы, журнала и историй, пикер коллекций, чеклисты
             мультисписка и связи, попап дня в режиме «Год». Везде одна раскладка:
             серая плашка → белая карточка поиска → белая карточка списка.

             Ширина плашки ФИКСИРОВАННАЯ (PopupContentWidth — ширина контента внутри
             ее полей): блок не меняет размер от длины значений, длинные значения
             читаются горизонтальной полосой, а не растягиванием окна.

             Высота белой карточки списка: PopupListHeight — там, где список
             наполняется асинхронно (фикс, иначе блок «прыгает» при замене
             «Загрузка…» на значения); PopupListMinHeight..PopupListHeight — там,
             где список растет по содержимому (попап дня календаря). -->
        <x:Double x:Key="PopupContentWidth">240</x:Double>
        <x:Double x:Key="PopupListHeight">232</x:Double>
        <x:Double x:Key="PopupListMinHeight">120</x:Double>

        <!-- Палитра и толщина скроллбара — одним набором токенов: шаблон полосы (ниже)
             и локальные копии тем DataGrid ссылаются только на них, литералов в разметке
             быть не должно (общее правило — docs/developer/ui/theming.md). -->
        <x:Double x:Key="ScrollBarThickness">14</x:Double>
        <Color x:Key="ColorScrollbarTrack">#EDEDF0</Color>
        <SolidColorBrush x:Key="BrushScrollbarTrack"         Color="{StaticResource ColorScrollbarTrack}" />
        <SolidColorBrush x:Key="BrushScrollbarThumb"         Color="#A0A0A6" />
        <SolidColorBrush x:Key="BrushScrollbarThumbHover"    Color="#7A7A80" />
        <SolidColorBrush x:Key="BrushScrollbarThumbPressed"  Color="#5A5A5E" />
        <SolidColorBrush x:Key="BrushScrollbarArrow"         Color="#7A7A80" />

        <!-- Квадрат на пересечении двух полос у обычного ScrollViewer (в теме Fluent —
             Panel#PART_ScrollBarsSeparator). Белый по умолчанию, перекрашиваем в цвет
             дорожки, чтобы угол не выбивался пятном. То же, что сделано для таблицы
             ключом DataGridScrollBarsSeparatorBackground. -->
        <SolidColorBrush x:Key="ScrollViewerScrollBarsSeparatorBackground"
                         Color="{StaticResource ColorScrollbarTrack}" />

        <!-- Тема кнопки-стрелки скроллбара: своя отрисовка без Fluent-обводки,
             контент строго по центру. -->
        <ControlTheme x:Key="ScrollLineButton" TargetType="RepeatButton">
            <Setter Property="Background"       Value="{StaticResource BrushScrollbarTrack}" />
            <Setter Property="BorderThickness"  Value="0" />
            <Setter Property="Padding"          Value="0" />
            <Setter Property="MinWidth"         Value="0" />
            <Setter Property="MinHeight"        Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- Фон совпадает с дорожкой, скругления нет — кнопка неотличима от полосы
                         и стыкуется с ней без шва. Реакции на наведение и нажатие у кнопки
                         нет намеренно: видимым остается только шеврон. -->
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!-- Тема постраничной области (прозрачная, без визуала). -->
        <ControlTheme x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinWidth"        Value="0" />
            <Setter Property="MinHeight"       Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <!-- Window -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
        <!-- Округление координат к физическим пикселям наследуется вниз по дереву:
             1px-линии остаются ровно 1px и не «толстеют» на дробном масштабе ОС. -->
        <Setter Property="UseLayoutRounding" Value="True" />
        <!-- Каждое окно (включая диалоги) получает динамические токены толщины линий
             от LineMetrics: пересчет при смене зума и переезде между мониторами. -->
        <Setter Property="(b:LineMetrics.IsManaged)" Value="True" />
        <!-- Каждое отдельное окно (диалоги, расширения, сплэш) масштабируется под общий
             зум приложения: контент — LayoutTransform, габариты — ×зум. MainWindow
             исключен внутри WindowZoom (у него собственный ScaleHost). -->
        <Setter Property="(b:WindowZoom.Enabled)" Value="True" />
    </Style>
    <!-- Минимальный размер только у главного окна, не у диалогов -->
    <Style Selector="Window.main">
        <Setter Property="MinWidth"  Value="1100" />
        <Setter Property="MinHeight" Value="760" />
    </Style>

    <!-- ── Разделительная линия ───────────────────────────────────────────
         Единый цвет (BrushSeparator) + толщина (SeparatorThickness) в одном месте.
         Использование:
           <Border Classes="separator h" />   горизонтальная (тянется по ширине)
           <Border Classes="separator v" />   вертикальная   (тянется по высоте)
         Позиционирование (VerticalAlignment/Margin/ColumnSpan) задается по месту. -->
    <Style Selector="Border.separator">
        <Setter Property="Background" Value="{StaticResource BrushSeparator}" />
        <!-- Компенсированная толщина при зуме ≠ 1 дробная — штатное округление
             уничтожило бы ее, поэтому флаг выключает его динамически (LineMetrics). -->
        <Setter Property="UseLayoutRounding" Value="{DynamicResource LineUseLayoutRounding}" />
        <!-- Без сглаживания: при зуме ≠ 1 линия попадает на дробные физические пиксели
             и антиалиасинг размазал бы края — Aliased защелкивает ее в целый пиксель.
             Только для линий: на скругленных рамках дал бы зазубрины. Через мост
             LineMetrics.Aliased: у RenderOptions нет полей для сеттера стиля. -->
        <Setter Property="(b:LineMetrics.Aliased)" Value="True" />
    </Style>
    <Style Selector="Border.separator.h">
        <Setter Property="Height" Value="{DynamicResource SeparatorThickness}" />
    </Style>
    <Style Selector="Border.separator.v">
        <Setter Property="Width" Value="{DynamicResource SeparatorThickness}" />
    </Style>

    <!-- Button -->
    <Style Selector="Button">
        <Setter Property="Background"   Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="Foreground"   Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusBase}" />
        <Setter Property="Padding"      Value="12,6" />
        <Setter Property="Cursor"       Value="Hand" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushHover}" />
    </Style>

    <Style Selector="Button.dialog">
        <Setter Property="Width"                      Value="110" />
        <Setter Property="Height"                     Value="{StaticResource ControlHeightStandard}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="CornerRadius"               Value="{StaticResource RadiusMedium}" />
        <Setter Property="Background"                 Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="Foreground"                 Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="FontSize"                   Value="{DynamicResource FontSizeBase}" />
        <Setter Property="FontWeight"                 Value="{StaticResource FontWeightNormal}" />
        <Setter Property="BorderBrush"                Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness"            Value="{DynamicResource BorderLine}" />
    </Style>

    <Style Selector="Button.dialog:pointerover /template/ ContentPresenter">
        <Setter Property="Background"  Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>

    <!-- Тот же вид, но ширина по тексту. В модалке кнопки стоят рядом и выравниваются по 110 px,
         а одиночная кнопка с длинной подписью в эту ширину не влезает и обрезает текст. Ширину
         не задаем числом: FontSizeBase меняется настройкой размера шрифта, и любое число рано или
         поздно окажется мало. NaN = «мерить по содержимому» (значение Width по умолчанию). -->
    <Style Selector="Button.dialog.auto">
        <Setter Property="Width"    Value="NaN" />
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="Padding"  Value="16,0" />
    </Style>

    <!-- Button/ToggleButton с иконкой: прозрачный фон, при наведении иконка синеет -->
    <Style Selector="Button.icon, ToggleButton.icon">
        <Setter Property="Background"                 Value="Transparent" />
        <Setter Property="BorderThickness"            Value="0" />
        <Setter Property="Padding"                    Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="Foreground"                 Value="{StaticResource BrushSecondaryText}" />
        <Setter Property="Cursor"                     Value="Hand" />
    </Style>

    <Style Selector="Button.icon /template/ ContentPresenter,
                     ToggleButton.icon /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.icon:pointerover /template/ ContentPresenter,
                     ToggleButton.icon:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.icon:pointerover,
                     ToggleButton.icon:pointerover">
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
    </Style>

    <!-- Иконка-кнопка разрушительного действия (корзина и т.п.): при наведении
         краснеет, а не синеет — как красный пункт «Удалить» в контекстных меню.
         Класс намеренно НЕ «danger»: Button.danger (ниже) — залитая красная кнопка
         диалогов с белым текстом, для прозрачной иконки-кнопки он делал бы обводку
         белой (иконка «исчезала» на белом фоне). -->
    <Style Selector="Button.icon.red:pointerover,
                     ToggleButton.icon.red:pointerover">
        <Setter Property="Foreground" Value="{StaticResource BrushRed}" />
    </Style>

    <Style Selector="Button.filterChevron:pointerover /template/ ContentPresenter">
        <Setter Property="Background"     Value="{StaticResource BrushHover}" />
        <Setter Property="CornerRadius"   Value="4" />
    </Style>

    <!-- Цвет текста таблицы — из общей палитры (единый источник, как у Button/ComboBox/TextBox). -->
    <Style Selector="DataGrid">
        <Setter Property="Foreground" Value="{StaticResource BrushPrimaryText}" />
    </Style>

    <!-- Заголовок колонки таблицы: серый фон при наведении -->
    <Style Selector="Border.colHeader:pointerover">
        <Setter Property="Background" Value="{StaticResource BrushHover}" />
    </Style>

    <!-- ── Карточки полей в панели «Детали» ────────────────────────────────────
         Строка выбранной записи раскрывается панелью справа: карточка на поле,
         клик по карточке открывает полный текст снизу. Оформление — карточки
         свойств «Страницы записи» (Border.proprow в RecordPageView): БЕЛАЯ карточка
         на серой подложке блока, hover — чуть притемненный белый, выбор — голубой фон
         с синей рамкой, подпись и иконка синеют. Фон нужен явный: прозрачный дал бы
         серый с подложки, а серый hover совпал бы с ней (карточка «пропадала» бы).
         Стиль общий: панель деталей есть и в «Настройки → Диагностика», и в
         «Профиль → История изменений» — карточки обязаны выглядеть одинаково. -->
    <Style Selector="Border.detailRow">
        <Setter Property="Background"      Value="{StaticResource BrushBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderLine}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding"         Value="10,3" />
        <Setter Property="MinHeight"       Value="40" />
        <Setter Property="Cursor"          Value="Hand" />
    </Style>
    <Style Selector="Border.detailRow:pointerover">
        <Setter Property="Background" Value="{StaticResource BrushInactiveBg}" />
    </Style>
    <Style Selector="Border.detailRow.selected, Border.detailRow.selected:pointerover">
        <Setter Property="Background"  Value="{StaticResource BrushAccentLight}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>
    <Style Selector="Border.detailRow TextBlock.detailName">
        <Setter Property="Foreground" Value="{StaticResource BrushSecondaryText}" />
    </Style>
    <Style Selector="Border.detailRow Path.detailIcon">
        <Setter Property="Stroke" Value="{StaticResource BrushSecondaryText}" />
    </Style>
    <Style Selector="Border.detailRow.selected TextBlock.detailName">
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
    </Style>
    <Style Selector="Border.detailRow.selected Path.detailIcon">
        <Setter Property="Stroke" Value="{StaticResource BrushAccent}" />
    </Style>

    <!-- Ручка-разделитель (три вертикальные точки ⋮) между названием и значением
         карточки — тянем влево/вправо, меняем общую ширину колонки названий. -->
    <Style Selector="Border.detailGrip">
        <Setter Property="Background"        Value="Transparent" />
        <Setter Property="Width"             Value="18" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Cursor"            Value="SizeWestEast" />
    </Style>

    <!-- Активный модуль в ActivityBar -->
    <Style Selector="ToggleButton.icon.module:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ToggleButton.icon.module:checked">
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
    </Style>

    <!-- Кнопки навбаров в стиле «Сегодня»: серый фон, серая рамка,
         при наведении синяя рамка + синяя иконка.
         ToolTip.Placement=Top: в fullscreen-режиме футер прижат к нижней границе
         экрана; дефолтное Placement=Pointer уводит popup тултипа на саму кнопку,
         курсор уходит в окно тултипа, hover теряется, тултип закрывается — и
         цикл повторяется (мерцание hover-стиля и cursor Hand↔Arrow). Top гарантирует,
         что popup всегда выше кнопки и не перехватывает курсор. -->
    <Style Selector="Button.navbtn, ToggleButton.navbtn">
        <Setter Property="Background"                 Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="Foreground"                 Value="{StaticResource BrushSecondaryText}" />
        <Setter Property="BorderBrush"                Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness"            Value="{DynamicResource BorderLine}" />
        <Setter Property="Padding"                    Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="Cursor"                     Value="Hand" />
        <Setter Property="ToolTip.Placement"          Value="Top" />
        <Setter Property="ToolTip.VerticalOffset"     Value="-4" />
    </Style>
    <Style Selector="Button.navbtn:pointerover /template/ ContentPresenter,
                     ToggleButton.navbtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background"  Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>
    <Style Selector="Button.navbtn:pointerover,
                     ToggleButton.navbtn:pointerover">
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
    </Style>
    <!-- В нажатом/checked состоянии остаемся серыми (перебиваем синий Fluent).
         Синий — только при наведении. -->
    <Style Selector="ToggleButton.navbtn:checked /template/ ContentPresenter">
        <Setter Property="Background"  Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushSeparator}" />
    </Style>
    <Style Selector="ToggleButton.navbtn:checked">
        <Setter Property="Foreground" Value="{StaticResource BrushSecondaryText}" />
    </Style>
    <!-- Но при наведении на checked — снова синий -->
    <Style Selector="ToggleButton.navbtn:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background"  Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>
    <Style Selector="ToggleButton.navbtn:checked:pointerover">
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
    </Style>

    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{StaticResource BrushRed}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Всплывающее окно фильтра/сортировки колонок таблицы (Excel-стиль).
         Стиль обязан жить здесь: FlyoutPresenter рендерится в popup-руте,
         до которого локальные стили UserControl не доходят. -->
    <Style Selector="FlyoutPresenter.filterFlyout">
        <Setter Property="Padding"         Value="0" />
        <!-- Серая подложка (как у панели свойств в сайдбаре): белые карточки поиска и списка
             на сером фоне. -->
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderLinePopup}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
    </Style>

    <!-- Всплывашка-уведомление (Toast): сама плашка БЕЗ своего оформления — внутри живет обычный
         баннер (NoticeBanner) ровно как в диалогах, поэтому фон под ним = BrushBg (как фон окна
         диалога), скругление = радиус баннера, без рамки/паддинга. Так всплывашка 1-в-1 совпадает
         с баннером в окнах «Создать»/«Изменить». Живет здесь, т.к. FlyoutPresenter рендерится в popup-руте. -->
    <Style Selector="FlyoutPresenter.toast">
        <Setter Property="Padding"                    Value="0" />
        <Setter Property="Background"                 Value="{StaticResource BrushBg}" />
        <Setter Property="BorderThickness"            Value="0" />
        <Setter Property="CornerRadius"               Value="{StaticResource RadiusBase}" />
        <Setter Property="MinWidth"                   Value="0" />
        <!-- Снимаем дефолтную min-высоту Fluent: высота = как у баннера (по контенту),
             а не выше с пустотой снизу. Контент — по центру по вертикали. -->
        <Setter Property="MinHeight"                  Value="0" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="MaxWidth"                   Value="460" />
    </Style>

    <!-- Карточки сообщений в правом верхнем углу (AppNotifications, WindowNotificationManager):
         карточка Avalonia (NotificationCard) БЕЗ своего оформления — ни белой подложки, ни тени,
         ни цветной полоски заголовка (Panel#PART_HeaderBar): всей карточкой служит содержимое,
         обычный NoticeBanner, ровно как у всплывашки Toast. Ширина чуть больше баннеров в
         диалогах — длинные сообщения об ошибках записи переносятся в две-три строки. Отступ от
         краев окна — на менеджере (его собственные поля по умолчанию нулевые). -->
    <Style Selector="WindowNotificationManager">
        <Setter Property="Margin" Value="0,8,8,0" />
    </Style>
    <Style Selector="NotificationCard">
        <Setter Property="Width"      Value="380" />
        <Setter Property="Background" Value="Transparent" />
        <!-- Тень и скругление в шаблоне Fluent заданы прямо на его Border'ах (локальные
             значения, стилем не перебить), поэтому шаблон свой. Имена частей сохранены:
             по PART_LayoutTransformControl тема Fluent анимирует появление и закрытие. -->
        <Setter Property="Template">
            <ControlTemplate>
                <LayoutTransformControl Name="PART_LayoutTransformControl" UseRenderTransform="True">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Margin="0,0,0,8" />
                </LayoutTransformControl>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ComboBox — серый фон, скругление, рамка как у поля даты/времени -->
    <Style Selector="ComboBox">
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="Foreground"      Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderLine}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
        <!-- Выбранное значение по центру по вертикали; единый внутренний отступ
             (последнее число — отступ справа до стрелки одинаков везде). -->
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding"                  Value="10,0,8,0" />
        <!-- Снимаем дефолтный Fluent MinHeight (~32px), чтобы заданный Height
             (ControlHeightStandard) совпадал по высоте с кнопками и полями ввода. -->
        <Setter Property="MinHeight"                Value="{StaticResource ControlHeightStandard}" />
    </Style>

    <!-- Текст выбранного значения: по центру + обрезка многоточием при длинном тексте. -->
    <Style Selector="ComboBox /template/ ContentControl#ContentPresenter">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox /template/ ContentControl#ContentPresenter TextBlock">
        <Setter Property="TextTrimming"      Value="CharacterEllipsis" />
        <Setter Property="TextWrapping"      Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ComboBox /template/ Border#Background">
        <Setter Property="Background" Value="{StaticResource BrushSecondaryBg}" />
    </Style>

    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background"   Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"  Value="{StaticResource BrushAccent}" />
    </Style>

    <Style Selector="ComboBox:focus /template/ Border#Background">
        <Setter Property="Background"   Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"  Value="{StaticResource BrushAccent}" />
    </Style>

    <!-- Стрелка — шеврон вниз (как у поля времени/даты), цвет BrushSecondaryText.
         PathIcon рисует заливкой, поэтому геометрия — замкнутый контур "V". -->
    <Style Selector="ComboBox /template/ PathIcon#DropDownGlyph">
        <Setter Property="IsVisible"   Value="True" />
        <Setter Property="Width"       Value="12" />
        <Setter Property="Height"      Value="8" />
        <Setter Property="Foreground"  Value="{StaticResource BrushSecondaryText}" />
        <Setter Property="Data"        Value="{StaticResource IconChevronDownFilled}" />
        <Setter Property="RenderTransform" Value="none" />
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="Foreground"               Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="Background"               Value="Transparent" />
        <Setter Property="Padding"                  Value="10,7" />
        <Setter Property="Margin"                   Value="4,2" />
        <Setter Property="CornerRadius"             Value="{StaticResource RadiusBase}" />
        <Setter Property="HorizontalAlignment"      Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Длинный пункт списка обрезается многоточием. -->
    <Style Selector="ComboBoxItem TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- Эффекты ровно как в контекстном меню: используем те же ресурсы темы Fluent,
         что и MenuFlyoutItem (фон при наведении/выборе, цвет текста). -->
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background"             Value="{DynamicResource MenuFlyoutItemBackgroundPointerOver}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MenuFlyoutItemForegroundPointerOver}" />
        <Setter Property="CornerRadius"           Value="{StaticResource RadiusBase}" />
    </Style>

    <Style Selector="ComboBoxItem:selected">
        <Setter Property="Foreground" Value="{StaticResource BrushPrimaryText}" />
    </Style>

    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background"             Value="{DynamicResource MenuFlyoutItemBackgroundPointerOver}" />
        <Setter Property="CornerRadius"           Value="{StaticResource RadiusBase}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushPrimaryText}" />
    </Style>

    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushPrimaryText}" />
    </Style>

    <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background"             Value="{DynamicResource MenuFlyoutItemBackgroundPointerOver}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushPrimaryText}" />
    </Style>

    <!-- Выпадашка наследует зум приложения (Fluent-шаблон ComboBox сам ставит
         InheritsTransform на PART_Popup) → токены обычные, не Popup-вариант. -->
    <Style Selector="ComboBox /template/ Popup > Border">
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderLine}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
        <!-- Padding НУЛЕВОЙ (стандарт «полоса прилегает к краю», theming.md): вертикальный
             давал зазоры сверху и снизу полосы, а ее прямые углы вылезали за скругление
             плашки. Воздух вокруг пунктов переехал внутрь области прокрутки — Margin
             презентера в копии темы (ComboBoxTheme.axaml). ClipToBounds — срезает углы
             полосы скруглением плашки, как в карточках списков. -->
        <Setter Property="Padding"         Value="0" />
        <Setter Property="ClipToBounds"    Value="True" />
        <!-- Зазор между полем и выпадашкой — как у списка времени (timePopup). -->
        <Setter Property="Margin"          Value="0,1,0,0" />
    </Style>

    <!-- TextBox -->
    <Style Selector="TextBox">
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="Foreground"      Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusBase}" />
        <Setter Property="Padding"         Value="10,6" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderLine}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <!-- Единый стандарт высоты (как у ComboBox): снимаем дефолтный Fluent MinHeight
             (~32px), чтобы однострочные поля с Height=ControlHeightStandard были 30px
             вровень с кнопками и списками. Многострочные (notesEditor/DescBox) растут
             выше — это только нижняя граница; поле-значение карточки (propValue) сбрасывает
             ее обратно в 0, там высоту задает строка карточки. -->
        <Setter Property="MinHeight"       Value="{StaticResource ControlHeightStandard}" />
        <!-- Выделение текста серым вместо системного синего -->
        <Setter Property="SelectionBrush"           Value="{StaticResource BrushTextSelection}" />
        <Setter Property="SelectionForegroundBrush" Value="{StaticResource BrushPrimaryText}" />
        <!-- По умолчанию однострочный: без вертикальной прокрутки — иначе при крупном шрифте
             текст переполняет поле фикс. высоты и вылезает кнопка-стрелка скроллбара.
             Многострочным (notesEditor, DescBox, лог) скролл возвращается отдельно. -->
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <!-- Контекстное меню по-русски: дефолт темы Fluent — английские Cut/Copy/Paste
             (Avalonia не локализуется сама). Команды/жесты — те же, что у дефолтного
             флайаута темы ($parent[TextBox] в попапе резолвится, это паттерн самой темы). -->
        <Setter Property="ContextFlyout">
            <MenuFlyout>
                <MenuItem Header="Вырезать"
                          Command="{Binding $parent[TextBox].Cut}"
                          IsEnabled="{Binding $parent[TextBox].CanCut}"
                          InputGesture="{x:Static TextBox.CutGesture}" />
                <MenuItem Header="Копировать"
                          Command="{Binding $parent[TextBox].Copy}"
                          IsEnabled="{Binding $parent[TextBox].CanCopy}"
                          InputGesture="{x:Static TextBox.CopyGesture}" />
                <MenuItem Header="Вставить"
                          Command="{Binding $parent[TextBox].Paste}"
                          IsEnabled="{Binding $parent[TextBox].CanPaste}"
                          InputGesture="{x:Static TextBox.PasteGesture}" />
            </MenuFlyout>
        </Setter>
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>

    <!-- Поле ввода на серой карточке (BrushCardBg, например «Параметры ручного импорта»):
         белый фон во всех состояниях — стандартный серый сливался бы с фоном карточки. -->
    <Style Selector="TextBox.onCard">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
    </Style>
    <Style Selector="TextBox.onCard /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
    </Style>
    <Style Selector="TextBox.onCard:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
    </Style>
    <Style Selector="TextBox.onCard:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
    </Style>

    <!-- ===== Поле секрета: точки вместо букв и глаз ===== -->
    <!-- Пароль, секрет соединения, мастер-пароль набираются вслепую, и опечатка в них видна
         только по отказу: повтор ловит расхождение двух наборов, а не саму опечатку, и есть он
         не везде. Глаз показывает набранное, пока его держат открытым.

         Закрыт по умолчанию, и это не настройка, а устройство: RevealPassword у нового поля
         ложь, а поля создаются заново с каждым окном. Открытый глаз не переживает закрытие
         окна, и подсмотренное не остается на экране у того, кто отошел.

         PasswordChar задан здесь же: точки и глаз — одна вещь, и поле, где забыли одно из
         двух, показывало бы пароль всем. Ставится класс, а не PasswordChar в разметке.

         Глаз не берет фокус (Focusable=False): Tab ведет в следующее поле, а щелчок по глазу
         не выбивает курсор из набора. -->
    <Style Selector="TextBox.password">
        <Setter Property="PasswordChar" Value="●" />
        <!-- Через Template, а не значением: контрол у каждого поля должен быть свой, одно и то
             же дерево в двух полях Avalonia не разложит. -->
        <Setter Property="InnerRightContent">
            <Template>
                <ToggleButton Classes="icon reveal"
                              Width="24" Height="24"
                              Margin="0,0,6,0"
                              Focusable="False"
                              IsChecked="{Binding $parent[TextBox].RevealPassword, Mode=TwoWay}">
                    <Panel>
                        <Viewbox Classes="eyeClosed"
                                 Width="{StaticResource IconSizeSmall}"
                                 Height="{StaticResource IconSizeSmall}">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconEyeClosed}"
                                      Stroke="{Binding $parent[ToggleButton].Foreground}"
                                      StrokeThickness="{StaticResource IconStrokeSmall}"
                                      StrokeLineCap="Round" StrokeJoin="Round" />
                            </Canvas>
                        </Viewbox>
                        <Viewbox Classes="eyeOpen"
                                 Width="{StaticResource IconSizeSmall}"
                                 Height="{StaticResource IconSizeSmall}">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconEye}"
                                      Stroke="{Binding $parent[ToggleButton].Foreground}"
                                      StrokeThickness="{StaticResource IconStrokeSmall}"
                                      StrokeLineCap="Round" StrokeJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Panel>
                </ToggleButton>
            </Template>
        </Setter>
    </Style>

    <!-- Какой из двух глаз виден. Оба лежат стопкой и переключаются видимостью: менять Data
         одного пришлось бы привязкой с конвертером ради той же пары путей. -->
    <Style Selector="ToggleButton.reveal Viewbox.eyeOpen">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ToggleButton.reveal:checked Viewbox.eyeOpen">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="ToggleButton.reveal:checked Viewbox.eyeClosed">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Подпись меняется вместе с состоянием: тултип «Показать» у уже открытого глаза врал бы. -->
    <Style Selector="ToggleButton.reveal">
        <Setter Property="ToolTip.Tip" Value="Показать набранное" />
    </Style>
    <Style Selector="ToggleButton.reveal:checked">
        <Setter Property="ToolTip.Tip" Value="Скрыть набранное" />
        <Setter Property="Foreground"  Value="{StaticResource BrushAccent}" />
    </Style>

    <!-- Тема Fluent заливает нажатый ToggleButton акцентным фоном — глазу он не нужен: это
         переключатель показа, а не кнопка выбора. Открытое состояние видно самой иконкой
         и ее цветом. -->
    <Style Selector="ToggleButton.reveal:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.reveal:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Заголовок «в строку» (имя коллекции в навбаре, имя записи в RecordPageView).
         Не показывает рамку/фон ни в одном состоянии. Watermark наследует
         текущие FontSize/FontWeight, чтобы плейсхолдер выглядел как сам заголовок,
         только полупрозрачным. -->
    <Style Selector="TextBox.titleEditor">
        <Setter Property="Background"               Value="Transparent" />
        <Setter Property="BorderThickness"          Value="0" />
        <Setter Property="Padding"                  Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox.titleEditor /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.titleEditor:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.titleEditor:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Watermark копирует размер и жирность с самого TextBox -->
    <Style Selector="TextBox.titleEditor /template/ TextBlock#PART_Watermark">
        <Setter Property="FontSize"          Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight"        Value="{StaticResource FontWeightBold}" />
        <Setter Property="Foreground"        Value="{StaticResource BrushSecondaryText}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Многострочное поле с прокруткой (описание записи/задачи, журнал) ===== -->
    <!-- Полоса прокрутки — во ВСЮ высоту поля: Padding в шаблоне Fluent это Margin
         контейнера PART_InnerDockPanel, который держит и ScrollViewer, поэтому вертикальной
         составляющей у него нет вовсе (была 6 сверху и снизу — ровно на столько полоса и не
         доходила до краев), правой тоже: полоса прилегает к рамке, а рамка рисуется ПОВЕРХ
         нее (см. ниже) — линия и скругления накрывают полосу, она читается как часть блока.
         Воздух над первой и под последней строкой дает Margin содержимого ВНУТРИ
         ScrollViewer — оно прокручивается вместе с текстом: при прокрутке строки уходят
         под самый край поля, а отступ виден только в крайних положениях. -->
    <Style Selector="TextBox.multiline">
        <Setter Property="Padding" Value="10,0,0,0" />
        <!-- Многострочному прокрутка нужна (базовый стиль TextBox ее отключает). -->
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <!-- РАМКА ПОВЕРХ СОДЕРЖИМОГО. В шаблоне Fluent рамка (PART_BorderElement) лежит ПОД
         контентом, поэтому полоса прокрутки, прижатая к краю, закрывала линию, а ее прямые
         углы вылезали за скругление. Поднимаем рамку наверх (ZIndex) — линия и скругления
         рисуются ПО полосе, она выглядит частью блока; клики сквозь нее проходят
         (IsHitTestVisible=False), а фон переезжает на внутреннюю обертку содержимого —
         иначе рамка, оказавшись сверху, закрасила бы своим фоном весь текст. -->
    <Style Selector="TextBox.multiline /template/ Border#PART_BorderElement">
        <Setter Property="Background"       Value="Transparent" />
        <Setter Property="ZIndex"           Value="1" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <!-- Внутренняя обертка содержимого (единственный Border шаблона, кроме рамки; сдвинута
         на ее толщину): несет фон поля и срезает углы полосы по скруглению — ClipToBounds
         режет прямоугольником, поэтому клип скругленный (RoundedClip). -->
    <Style Selector="TextBox.multiline /template/ Border:not(#PART_BorderElement)">
        <Setter Property="Background"           Value="{Binding $parent[TextBox].Background}" />
        <Setter Property="CornerRadius"         Value="{StaticResource RadiusMedium}" />
        <Setter Property="b:RoundedClip.Radius" Value="{StaticResource RadiusMedium}" />
    </Style>
    <Style Selector="TextBox.multiline /template/ TextPresenter#PART_TextPresenter">
        <Setter Property="Margin" Value="0,6" />
    </Style>
    <Style Selector="TextBox.multiline /template/ TextBlock#PART_Watermark">
        <Setter Property="Margin" Value="0,6" />
    </Style>

    <!-- Безбордерный редактор (письмо как в заметках): убираем рамку во всех состояниях,
         включая синюю рамку фокуса. -->
    <Style Selector="TextBox.notesEditor">
        <Setter Property="Background"               Value="Transparent" />
        <Setter Property="BorderThickness"          Value="0" />
        <Setter Property="Padding"                  Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <!-- Многострочный редактор — вертикальная прокрутка нужна (перебиваем дефолт TextBox). -->
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style Selector="TextBox.notesEditor /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.notesEditor:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.notesEditor:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ===== Значение свойства в карточке RecordPageView ===== -->
    <!-- Безбордерное во ВСЕХ состояниях (включая фокус/наведение): рамку и подсветку дает
         сама карточка, как у поля даты (timeInput). Без этого тема Fluent в фокусе рисует
         собственную синюю рамку ВНУТРИ карточки — «бокс в боксе», что и просили убрать. -->
    <Style Selector="TextBox.propValue">
        <Setter Property="Background"               Value="Transparent" />
        <Setter Property="Foreground"               Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="BorderThickness"          Value="0" />
        <Setter Property="Padding"                  Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <!-- Высоту в карточке задает строка (RowHeightStandard/ручная), а не стандарт
             формы: сбрасываем нижнюю границу базового TextBox обратно в 0. -->
        <Setter Property="MinHeight"                Value="0" />
    </Style>
    <Style Selector="TextBox.propValue /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.propValue:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.propValue:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ComboBox-значение свойства (тип «список»): так же без собственной рамки/фона во
         всех состояниях — рамку дает карточка. -->
    <Style Selector="ComboBox.propValue">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding"         Value="0,0,8,0" />
        <Setter Property="MinHeight"       Value="0" />
    </Style>
    <Style Selector="ComboBox.propValue /template/ Border#Background">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ComboBox.propValue:pointerover /template/ Border#Background">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ComboBox.propValue:focus /template/ Border#Background">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ПОЛОСА — ОТДЕЛЬНЫЙ БЛОК, А НЕ НАКЛАДКА. Шаблон ScrollViewer темы Fluent кладет
         содержимое в ячейку 0,0 сетки "*,Auto"/"*,Auto" (полосы — в колонку 1 и строку 1),
         но при AllowAutoHide=True добавляет стилем Grid.ColumnSpan=2 и Grid.RowSpan=2:
         содержимое растягивается ПОД обе полосы, и правые 14px данных не видно.
         AllowAutoHide=False у САМОГО ScrollViewer этот стиль отключает — содержимое
         сужается на толщину полосы везде разом. Одноименный сеттер ниже (у ScrollBar)
         этого не делает: селектор темы читает свойство ScrollViewer, не полосы. -->
    <!-- :is() обязателен — селектор по имени типа в Avalonia ловит ТОЛЬКО точный тип,
         а прокрутку наследуют и производные (виджеты сторонних пакетов). -->
    <Style Selector=":is(ScrollViewer)">
        <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
    </Style>

    <!-- Классический скроллбар (как в Excel): дорожка всегда видна, сверху/снизу
         кнопки-стрелки, посередине перетаскиваемый ползунок. Собственный шаблон,
         т.к. тема Fluent прячет ползунок. -->
    <Style Selector="ScrollBar">
        <Setter Property="AllowAutoHide" Value="False" />
        <Setter Property="Opacity"       Value="1" />
        <Setter Property="Background"     Value="Transparent" />
    </Style>

    <!-- Стрелка: Path ВСЕГДА кладется в Canvas фиксированного размера, а Canvas — в Viewbox.
         Без Canvas Path меряется по габаритам геометрии (у IconScrollUp это 12×5), а обводка
         толщиной 2 с круглыми торцами выходит за них на 1 единицу с каждой стороны — Viewbox
         масштабирует только измеренный прямоугольник и срезает торцы. Canvas 14×7 (для
         горизонтальных стрелок 7×14) = габариты геометрии + припуск на обводку, поэтому
         шеврон виден целиком. Размер Canvas от толщины полосы НЕ зависит — итоговый
         масштаб стрелки задает Viewbox. Тот же прием, что у иконок в RecordPageView. -->
    <Style Selector="ScrollBar Path.arrow">
        <Setter Property="Stroke"          Value="{StaticResource BrushScrollbarArrow}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap"   Value="Round" />
        <Setter Property="StrokeJoin"      Value="Round" />
    </Style>

    <!-- Ползунок — пилюля в стиле Google/Chrome: уже дорожки, с полями по бокам и круглыми
         торцами. Собственный шаблон, не зависит от темы Fluent. -->
    <Style Selector="ScrollBar Thumb">
        <Setter Property="Background" Value="{StaticResource BrushScrollbarThumb}" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- Радиус = половине толщины пилюли (14 − 2×2)/2 = 5 → торцы полукруглые. -->
                <Border Background="{TemplateBinding Background}" CornerRadius="5" />
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- Поля пилюли внутри дорожки — по 2px с боков (поперек прокрутки). Вдоль прокрутки
         полей нет: длина ползунка и стыки кнопок с дорожкой остаются как были. -->
    <Style Selector="ScrollBar:vertical Thumb">
        <Setter Property="Margin" Value="2,0" />
    </Style>
    <Style Selector="ScrollBar:horizontal Thumb">
        <Setter Property="Margin" Value="0,2" />
    </Style>
    <!-- Покой задается отдельным правилом с псевдоклассами, а не только базовым сеттером
         выше: базовый проигрывает правилу темы Fluent и ползунок в покое рисовался ее
         светло-серым (#BEBEC0) вместо нашего #A0A0A6. Правила с псевдоклассом (как
         :pointerover ниже) тему перебивают — отсюда такая форма селектора. -->
    <Style Selector="ScrollBar Thumb:not(:pointerover):not(:pressed)">
        <Setter Property="Background" Value="{StaticResource BrushScrollbarThumb}" />
    </Style>
    <Style Selector="ScrollBar Thumb:pointerover">
        <Setter Property="Background" Value="{StaticResource BrushScrollbarThumbHover}" />
    </Style>
    <Style Selector="ScrollBar Thumb:pressed">
        <Setter Property="Background" Value="{StaticResource BrushScrollbarThumbPressed}" />
    </Style>

    <!-- Вертикальный -->
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="{StaticResource ScrollBarThickness}" />
        <!-- Тема Fluent держит свой MinWidth (шире нашей полосы) — иначе Width не сработает:
             в Avalonia MinWidth сильнее Width. -->
        <Setter Property="MinWidth" Value="{StaticResource ScrollBarThickness}" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- Три блока ВПЛОТНУЮ: кнопка-вверх, дорожка с ползунком, кнопка-вниз.
                     Пустых ячеек-зазоров нет, у блоков нет Margin/Padding — фон дорожки
                     лежит на корневом Grid, поэтому полоса читается сплошной лентой во
                     всю толщину, а стык кнопки и дорожки не виден. -->
                <Grid RowDefinitions="Auto,*,Auto" Background="{StaticResource BrushScrollbarTrack}">
                    <RepeatButton Grid.Row="0" Name="PART_LineUpButton" Theme="{StaticResource ScrollLineButton}"
                                  Width="{StaticResource ScrollBarThickness}"
                                  Height="{StaticResource ScrollBarThickness}">
                        <Viewbox Width="12" Height="6" Stretch="Uniform">
                            <Canvas Width="16" Height="8">
                                <Path Classes="arrow" Data="{StaticResource IconScrollUp}" />
                            </Canvas>
                        </Viewbox>
                    </RepeatButton>
                    <Track Grid.Row="1" Name="PART_Track" Orientation="Vertical"
                           IsDirectionReversed="True"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           ViewportSize="{TemplateBinding ViewportSize}">
                        <Track.DecreaseButton>
                            <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource ScrollPageButton}" />
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource ScrollPageButton}" />
                        </Track.IncreaseButton>
                        <Track.Thumb>
                            <!-- MinHeight — минимальная ДЛИНА пилюли (чтобы было за что схватить).
                                 MinWidth=0 обязателен: у темы Fluent он свой и распирал полосу
                                 шире заданной толщины. Локальные значения перебивают тему. -->
                            <Thumb MinHeight="28" MinWidth="0" />
                        </Track.Thumb>
                    </Track>
                    <RepeatButton Grid.Row="2" Name="PART_LineDownButton" Theme="{StaticResource ScrollLineButton}"
                                  Width="{StaticResource ScrollBarThickness}"
                                  Height="{StaticResource ScrollBarThickness}">
                        <Viewbox Width="12" Height="6" Stretch="Uniform">
                            <Canvas Width="16" Height="8">
                                <Path Classes="arrow" Data="{StaticResource IconScrollDown}" />
                            </Canvas>
                        </Viewbox>
                    </RepeatButton>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Горизонтальный -->
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="{StaticResource ScrollBarThickness}" />
        <Setter Property="MinHeight" Value="{StaticResource ScrollBarThickness}" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- Зеркально вертикальному: три блока вплотную, фон на корневом Grid. -->
                <Grid ColumnDefinitions="Auto,*,Auto" Background="{StaticResource BrushScrollbarTrack}">
                    <RepeatButton Grid.Column="0" Name="PART_LineUpButton" Theme="{StaticResource ScrollLineButton}"
                                  Width="{StaticResource ScrollBarThickness}"
                                  Height="{StaticResource ScrollBarThickness}">
                        <Viewbox Width="6" Height="12" Stretch="Uniform">
                            <Canvas Width="8" Height="16">
                                <Path Classes="arrow" Data="{StaticResource IconScrollLeft}" />
                            </Canvas>
                        </Viewbox>
                    </RepeatButton>
                    <Track Grid.Column="1" Name="PART_Track" Orientation="Horizontal"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           ViewportSize="{TemplateBinding ViewportSize}">
                        <Track.DecreaseButton>
                            <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource ScrollPageButton}" />
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource ScrollPageButton}" />
                        </Track.IncreaseButton>
                        <Track.Thumb>
                            <!-- MinWidth — минимальная ДЛИНА пилюли; MinHeight=0 — см. вертикальную. -->
                            <Thumb MinWidth="28" MinHeight="0" />
                        </Track.Thumb>
                    </Track>
                    <RepeatButton Grid.Column="2" Name="PART_LineDownButton" Theme="{StaticResource ScrollLineButton}"
                                  Width="{StaticResource ScrollBarThickness}"
                                  Height="{StaticResource ScrollBarThickness}">
                        <Viewbox Width="6" Height="12" Stretch="Uniform">
                            <Canvas Width="8" Height="16">
                                <Path Classes="arrow" Data="{StaticResource IconScrollRight}" />
                            </Canvas>
                        </Viewbox>
                    </RepeatButton>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Календарь-выпадашка поля даты (DateField создает Calendar сам; попап и рамку
         дает Border.timePopup, поэтому стилей CalendarDatePicker здесь больше нет). -->

    <!-- Фон всего календаря -->
    <Style Selector="Calendar">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
    </Style>

    <Style Selector="CalendarItem">
        <Setter Property="Background"      Value="{StaticResource BrushBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushBg}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="CalendarItem /template/ Border">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="CalendarItem /template/ Grid">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
    </Style>

    <Style Selector="CalendarItem /template/ Grid#PART_Root">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
    </Style>

    <Style Selector="CalendarItem /template/ Border#BackgroundLayer">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
    </Style>

    <Style Selector="CalendarItem /template/ Rectangle">
        <Setter Property="Fill" Value="Transparent" />
    </Style>

    <!-- Заголовок месяца -->
    <Style Selector="CalendarItem /template/ Button#PART_HeaderButton">
        <Setter Property="Foreground"  Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="FontWeight"  Value="{StaticResource FontWeightBold}" />
        <Setter Property="FontSize"    Value="{DynamicResource FontSizeBase}" />
        <Setter Property="Background"  Value="{StaticResource BrushBg}" />
        <Setter Property="Padding"     Value="0" />
    </Style>

    <Style Selector="CalendarItem /template/ Button#PART_HeaderButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Кнопки prev/next месяца -->
    <Style Selector="Calendar /template/ Button#PART_PreviousButton">
        <Setter Property="Foreground"  Value="{StaticResource BrushSecondaryText}" />
        <Setter Property="Background"  Value="Transparent" />
        <Setter Property="Width"       Value="28" />
        <Setter Property="Height"      Value="28" />
    </Style>

    <Style Selector="Calendar /template/ Button#PART_NextButton">
        <Setter Property="Foreground"  Value="{StaticResource BrushSecondaryText}" />
        <Setter Property="Background"  Value="Transparent" />
        <Setter Property="Width"       Value="28" />
        <Setter Property="Height"      Value="28" />
    </Style>

    <!-- Дни недели -->
    <Style Selector="Calendar /template/ TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushSecondaryText}" />
        <Setter Property="FontSize"   Value="{DynamicResource FontSizeBase}" />
    </Style>

    <!-- Обычный день -->
    <Style Selector="CalendarDayButton">
        <Setter Property="Width"        Value="32" />
        <Setter Property="Height"       Value="32" />
        <Setter Property="Foreground"   Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="Background"   Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize"     Value="{DynamicResource FontSizeBase}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
    </Style>

    <Style Selector="CalendarDayButton /template/ Border#DayButtonFocusVisual">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="CalendarDayButton:pointerover /template/ Border#Background">
        <Setter Property="Background"      Value="{StaticResource BrushHover}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusBase}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Сегодня. Календарь живет в попапе поля даты (DateField) — попап наследует зум,
         токен обычный (рамка была 1.5 — приведена к стандартной 1, как все линии). -->
    <Style Selector="CalendarDayButton:today /template/ Border#Background">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderLine}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusBase}" />
    </Style>

    <Style Selector="CalendarDayButton:today">
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
    </Style>

    <!-- Выбранный день -->
    <Style Selector="CalendarDayButton:selected /template/ Border#Background">
        <Setter Property="Background"      Value="{StaticResource BrushAccent}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusBase}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="CalendarDayButton:selected">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
    </Style>

    <!-- Выбранный и сегодня одновременно -->
    <Style Selector="CalendarDayButton:selected:today /template/ Border#Background">
        <Setter Property="Background"      Value="{StaticResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="CalendarDayButton:selected:today">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Не текущего месяца -->
    <Style Selector="CalendarDayButton:inactive">
        <Setter Property="Foreground" Value="{StaticResource BrushSecondaryText}" />
        <Setter Property="Opacity"    Value="0.4" />
    </Style>

    <Style Selector="CalendarItem /template/ Grid#PART_YearView">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
    </Style>

    <Style Selector="CalendarItem /template/ Grid#PART_MonthView">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
    </Style>

    <!-- CalendarButton (месяцы и годы) -->
    <Style Selector="CalendarButton">
        <Setter Property="Foreground"      Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeBase}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
    </Style>

    <Style Selector="CalendarButton:pointerover /template/ Border#Background">
        <Setter Property="Background"      Value="{StaticResource BrushHover}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusBase}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="CalendarButton:selected">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
    </Style>

    <Style Selector="CalendarButton:selected /template/ Border#Background">
        <Setter Property="Background"      Value="{StaticResource BrushAccent}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusBase}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="CalendarButton:selected:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
    </Style>

    <Style Selector="CalendarButton:calendarbutton-hasbtn /template/ Border#Background">
        <Setter Property="Background"   Value="Transparent" />
        <Setter Property="BorderBrush"  Value="{StaticResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderLine}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusBase}" />
    </Style>

    <Style Selector="CalendarButton:calendarbutton-hasbtn">
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
    </Style>

    <!-- ===== Единый бокс полей даты и времени (DateField / TimeField / DateEditor) ===== -->

    <!-- Внешний бокс: фон, рамка, скругление как у даты -->
    <Style Selector="Border.timeField">
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderLine}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
    </Style>

    <!-- Наведение — синяя рамка (как у даты) -->
    <Style Selector="Border.timeField:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>

    <!-- Фокус в поле — белый фон + яркая толстая синяя рамка (как у даты):
         акцент = ровно 2× стандартной линии. -->
    <Style Selector="Border.timeField:focus-within">
        <Setter Property="Background"      Value="{StaticResource BrushBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderLineFocus}" />
    </Style>

    <!-- Поле ввода внутри бокса: прозрачное, без рамки -->
    <Style Selector="TextBox.timeInput">
        <Setter Property="Background"               Value="Transparent" />
        <Setter Property="Foreground"               Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="BorderThickness"          Value="0" />
        <Setter Property="Padding"                  Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment"        Value="Stretch" />
        <!-- Однострочный ввод даты/времени: без вертикальной прокрутки, иначе при крупном
             шрифте текст переполняет поле и вылезает кнопка-стрелка скроллбара. -->
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style Selector="TextBox.timeInput /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.timeInput:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.timeInput:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Кнопка-стрелка справа -->
    <Style Selector="Button.timeArrow">
        <Setter Property="Background"                 Value="Transparent" />
        <Setter Property="BorderThickness"            Value="0" />
        <Setter Property="Padding"                    Value="4,0,8,0" />
        <Setter Property="CornerRadius"               Value="0" />
        <Setter Property="VerticalAlignment"          Value="Stretch" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="Cursor"                     Value="Hand" />
    </Style>

    <!-- Фон стрелки прозрачный во ВСЕХ состояниях: иначе тема Fluent рисует серый
         квадрат (фон кнопки по умолчанию виден через TemplateBinding). -->
    <Style Selector="Button.timeArrow /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.timeArrow:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.timeArrow:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Popup со списком времени (его Popup наследует зум — InheritsTransform в XAML) -->
    <Style Selector="Border.timePopup">
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderLine}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
        <Setter Property="BoxShadow"       Value="0 4 16 0 #1A000000" />
        <Setter Property="Padding"         Value="0,2" />
        <Setter Property="Margin"          Value="0,1,0,0" />
    </Style>

    <!-- Padding списка = воздух сверху/снизу вместо Padding попапа: ListBox отдает его
         в Margin презентера ВНУТРИ своего ScrollViewer, поэтому пункты отступают от края,
         а полоса прокрутки остается прижатой к рамке (см. TimeField.axaml). -->
    <Style Selector="ListBox.timeList">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding"         Value="0,2" />
    </Style>

    <!-- Элементы списка времени -->
    <Style Selector="ListBox.timeList ListBoxItem">
        <Setter Property="Foreground"   Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="FontSize"     Value="{DynamicResource FontSizeBase}" />
        <Setter Property="Background"   Value="Transparent" />
        <Setter Property="Padding"      Value="10,7" />
        <Setter Property="Margin"       Value="4,2" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusBase}" />
    </Style>

    <Style Selector="ListBox.timeList ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background"   Value="{DynamicResource MenuFlyoutItemBackgroundPointerOver}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusBase}" />
    </Style>

    <Style Selector="ListBox.timeList ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background"   Value="{DynamicResource MenuFlyoutItemBackgroundPointerOver}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusBase}" />
    </Style>

    <Style Selector="ListBox.timeList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextBlock.Foreground" Value="{StaticResource BrushPrimaryText}" />
    </Style>

    <Style Selector="ListBox.timeList ListBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background"   Value="{DynamicResource MenuFlyoutItemBackgroundPointerOver}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusBase}" />
    </Style>

    <!-- CheckBox: единый стиль вынесен в Controls/Widgets/AppCheckBox.axaml -->

    <!-- ContextMenu / MenuItem: визуально как ComboBox-выпадашка.
         Фон/рамка/скругление контейнера повторяют ComboBox Popup, элементы — ComboBoxItem
         (наведение/выделение тем же ресурсом MenuFlyoutItemBackgroundPointerOver). -->
    <!-- Меню отмасштабировано зум-оберткой в своей теме (ZoomPopupThemes) —
         рамка ВНУТРИ трансформа, токен обычный. -->
    <Style Selector="ContextMenu">
        <Setter Property="FontSize"        Value="{DynamicResource FontSizeBase}" />
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderLine}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding"         Value="0,2" />
        <Setter Property="MinWidth"        Value="180" />
    </Style>

    <!-- Сабменю наследует зум приложения: контекстное меню отмасштабировано оберткой
         в своей теме (ZoomPopupThemes), а попап сабменю берет накопленный трансформ
         плейсмент-таргета (пункта меню) — как выпадашка ComboBox в Fluent. -->
    <Style Selector="MenuItem /template/ Popup#PART_Popup">
        <Setter Property="InheritsTransform" Value="True" />
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="FontSize"                 Value="{DynamicResource FontSizeBase}" />
        <Setter Property="Foreground"               Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="Background"               Value="Transparent" />
        <Setter Property="Padding"                  Value="10,7" />
        <Setter Property="Margin"                   Value="4,2" />
        <Setter Property="CornerRadius"             Value="{StaticResource RadiusSmall}" />
        <!-- Минимальная ширина самого пункта — растянет контейнер до одинаковой ширины
             у основного меню и у сабменю. -->
        <Setter Property="MinWidth"                 Value="172" />
    </Style>

    <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusSmall}" />
        <Setter Property="Padding"         Value="0" />
    </Style>

    <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background"   Value="{DynamicResource MenuFlyoutItemBackgroundPointerOver}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    </Style>

    <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background"   Value="{DynamicResource MenuFlyoutItemBackgroundPointerOver}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    </Style>

    <!-- Подменю (MenuFlyoutPresenter) — тот же стиль контейнера, что и ContextMenu,
         иначе сабменю «Изменить цвет» рендерится с белым Fluent-фоном. -->
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderLinePopup}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding"         Value="0,2" />
        <Setter Property="MinWidth"        Value="180" />
    </Style>

    <!-- Подменю у вложенного MenuItem (Popup со списком цветов): фон/рамка/радиус
         как у основного контекстного меню. В шаблоне Fluent сабменю лежит в
         БЕЗЫМЯННОМ Border — прямом ребенке Popup#PART_Popup (селектор Border#PART_Popup
         не матчился бы: PART_Popup — имя самого Popup). Попап наследует зум
         (InheritsTransform выше) → рамка внутри трансформа, токен обычный.
         Зазор от меню (чтобы не наезжало) задается в коде: HorizontalOffset попапа правится
         на инстансе (Sidebar.FixSubmenuGap), т.к. шаблон темы ставит его локальным значением,
         которое стиль перебить не может. -->
    <Style Selector="MenuItem /template/ Popup#PART_Popup > Border">
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderLine}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding"         Value="0,2" />
    </Style>

    <!-- Хост панели «Отображение свойств даты» в сабменю: без chrome пункта меню
         (паддинг/маржа/подсветка наведения), чтобы внутри была чистая панель фильтра. -->
    <!-- Свой минимальный шаблон: только контент, без иконочной колонки/шеврона/подсветки
         пункта меню. Иначе общая (SharedSizeGroup) иконочная колонка добавляла бы лишний
         отступ слева — панель должна иметь одинаковые поля по кругу. -->
    <Style Selector="MenuItem.dateFieldsHost">
        <Setter Property="Margin"   Value="0" />
        <Setter Property="Padding"  Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Template">
            <ControlTemplate TargetType="MenuItem">
                <ContentPresenter Content="{TemplateBinding Header}" />
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>
