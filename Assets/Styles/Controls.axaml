<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- Радиусы скругления -->
        <CornerRadius x:Key="RadiusXS">4</CornerRadius>
        <CornerRadius x:Key="RadiusSmall">5</CornerRadius>
        <CornerRadius x:Key="RadiusBase">6</CornerRadius>
        <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
        <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
        <CornerRadius x:Key="RadiusPill">15</CornerRadius>

        <!-- Цвет скроллбара -->
        <SolidColorBrush x:Key="BrushScrollbar" Color="#C7C7CC" />
    </Styles.Resources>

    <!-- Window -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
        <Setter Property="MinWidth"   Value="1100" />
        <Setter Property="MinHeight"  Value="760" />
    </Style>

    <!-- Button -->
    <Style Selector="Button">
        <Setter Property="Background"   Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="Foreground"   Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusBase}" />
        <Setter Property="Padding"      Value="12,6" />
        <Setter Property="Cursor"       Value="Hand" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushHover}" />
    </Style>

    <Style Selector="Button.dialog">
        <Setter Property="Width"                      Value="110" />
        <Setter Property="Height"                     Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="CornerRadius"               Value="{StaticResource RadiusMedium}" />
        <Setter Property="Background"                 Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="Foreground"                 Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="FontWeight"                 Value="{StaticResource FontWeightBold}" />
        <Setter Property="BorderBrush"                Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness"            Value="1" />
    </Style>

    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{StaticResource BrushRed}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- ComboBox — серый фон, скругление, рамка как у поля даты/времени -->
    <Style Selector="ComboBox">
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="Foreground"      Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
    </Style>

    <Style Selector="ComboBox /template/ Border#Background">
        <Setter Property="Background" Value="{StaticResource BrushSecondaryBg}" />
    </Style>

    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background"   Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"  Value="{StaticResource BrushAccent}" />
    </Style>

    <Style Selector="ComboBox:focus /template/ Border#Background">
        <Setter Property="Background"   Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"  Value="{StaticResource BrushAccent}" />
    </Style>

    <!-- Стрелка — шеврон вниз (как у поля времени/даты), цвет BrushSecondaryText.
         PathIcon рисует заливкой, поэтому геометрия — замкнутый контур "V". -->
    <Style Selector="ComboBox /template/ PathIcon#DropDownGlyph">
        <Setter Property="IsVisible"   Value="True" />
        <Setter Property="Width"       Value="12" />
        <Setter Property="Height"      Value="8" />
        <Setter Property="Foreground"  Value="{StaticResource BrushSecondaryText}" />
        <Setter Property="Data"        Value="M1 1 L6 6 L11 1 L12.4 2.4 L6 8.8 L-0.4 2.4 Z" />
        <Setter Property="RenderTransform" Value="none" />
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="Foreground"            Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="Background"            Value="Transparent" />
        <Setter Property="Padding"               Value="10,7" />
        <Setter Property="Margin"                Value="4,2" />
        <Setter Property="CornerRadius"          Value="{StaticResource RadiusBase}" />
        <Setter Property="HorizontalAlignment"   Value="Stretch" />
    </Style>

    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background"   Value="{StaticResource BrushHover}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusBase}" />
    </Style>

    <Style Selector="ComboBoxItem:selected">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextBlock.Foreground" Value="White" />
    </Style>

    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background"   Value="{StaticResource BrushAccent}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusBase}" />
    </Style>

    <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
    </Style>

    <Style Selector="ComboBox /template/ Popup > Border">
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding"         Value="4,6" />
    </Style>

    <!-- TextBox -->
    <Style Selector="TextBox">
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="Foreground"      Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusBase}" />
        <Setter Property="Padding"         Value="10,6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>

    <!-- ScrollBar тонкий -->
    <Style Selector="ScrollBar">
        <Setter Property="Width"   Value="6" />
        <Setter Property="Height"  Value="6" />
        <Setter Property="Opacity" Value="1.0" />
    </Style>

    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background"   Value="{StaticResource BrushScrollbar}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXS}" />
    </Style>

    <!-- CalendarDatePicker -->
    <Style Selector="CalendarDatePicker">
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
        <Setter Property="Foreground"      Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="Padding"         Value="10,0" />
    </Style>

    <!-- Текст даты: прозрачный фон, вертикальный центр, отступ как у времени -->
    <Style Selector="CalendarDatePicker /template/ TextBox#PART_TextBox">
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="CalendarDatePicker /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="CalendarDatePicker:pointerover /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>

    <Style Selector="CalendarDatePicker:focus /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>

    <!-- Кнопка справа — полностью свой шаблон с шевроном вниз (как у поля времени),
         вместо стилизованной иконки календаря с числом дня -->
    <Style Selector="CalendarDatePicker /template/ Button#PART_Button">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width"           Value="NaN" />
        <Setter Property="MinWidth"        Value="0" />
        <Setter Property="Padding"         Value="4,0,8,0" />
        <Setter Property="Cursor"          Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                    <Viewbox Width="16" Height="16"
                             VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="M6 9 L12 15 L18 9"
                                  Stroke="{StaticResource BrushSecondaryText}"
                                  StrokeThickness="2"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Popup календаря -->
    <Style Selector="CalendarDatePicker /template/ Popup > Border">
        <Setter Property="Background"      Value="{StaticResource BrushBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
        <Setter Property="BoxShadow"       Value="0 4 16 0 #1A000000" />
    </Style>

    <!-- Фон всего календаря -->
    <Style Selector="Calendar">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
    </Style>

    <Style Selector="CalendarItem">
        <Setter Property="Background"      Value="{StaticResource BrushBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushBg}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="CalendarItem /template/ Border">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="CalendarItem /template/ Grid">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
    </Style>

    <Style Selector="CalendarItem /template/ Grid#PART_Root">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
    </Style>

    <Style Selector="CalendarItem /template/ Border#BackgroundLayer">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
    </Style>

    <Style Selector="CalendarItem /template/ Rectangle">
        <Setter Property="Fill" Value="Transparent" />
    </Style>

    <!-- Заголовок месяца -->
    <Style Selector="CalendarItem /template/ Button#PART_HeaderButton">
        <Setter Property="Foreground"  Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="FontWeight"  Value="{StaticResource FontWeightBold}" />
        <Setter Property="FontSize"    Value="{StaticResource FontSizeBase}" />
        <Setter Property="Background"  Value="{StaticResource BrushBg}" />
        <Setter Property="Padding"     Value="0" />
    </Style>

    <Style Selector="CalendarItem /template/ Button#PART_HeaderButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Кнопки prev/next месяца -->
    <Style Selector="Calendar /template/ Button#PART_PreviousButton">
        <Setter Property="Foreground"  Value="{StaticResource BrushSecondaryText}" />
        <Setter Property="Background"  Value="Transparent" />
        <Setter Property="Width"       Value="28" />
        <Setter Property="Height"      Value="28" />
    </Style>

    <Style Selector="Calendar /template/ Button#PART_NextButton">
        <Setter Property="Foreground"  Value="{StaticResource BrushSecondaryText}" />
        <Setter Property="Background"  Value="Transparent" />
        <Setter Property="Width"       Value="28" />
        <Setter Property="Height"      Value="28" />
    </Style>

    <!-- Дни недели -->
    <Style Selector="Calendar /template/ TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushSecondaryText}" />
        <Setter Property="FontSize"   Value="{StaticResource FontSizeBase}" />
    </Style>

    <!-- Обычный день -->
    <Style Selector="CalendarDayButton">
        <Setter Property="Width"        Value="32" />
        <Setter Property="Height"       Value="32" />
        <Setter Property="Foreground"   Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="Background"   Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize"     Value="{StaticResource FontSizeBase}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
    </Style>

    <Style Selector="CalendarDayButton /template/ Border#DayButtonFocusVisual">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="CalendarDayButton:pointerover /template/ Border#Background">
        <Setter Property="Background"      Value="{StaticResource BrushHover}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusBase}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Сегодня -->
    <Style Selector="CalendarDayButton:today /template/ Border#Background">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusBase}" />
    </Style>

    <Style Selector="CalendarDayButton:today">
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
    </Style>

    <!-- Выбранный день -->
    <Style Selector="CalendarDayButton:selected /template/ Border#Background">
        <Setter Property="Background"      Value="{StaticResource BrushAccent}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusBase}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="CalendarDayButton:selected">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
    </Style>

    <!-- Выбранный и сегодня одновременно -->
    <Style Selector="CalendarDayButton:selected:today /template/ Border#Background">
        <Setter Property="Background"      Value="{StaticResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="CalendarDayButton:selected:today">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Не текущего месяца -->
    <Style Selector="CalendarDayButton:inactive">
        <Setter Property="Foreground" Value="{StaticResource BrushSecondaryText}" />
        <Setter Property="Opacity"    Value="0.4" />
    </Style>

    <Style Selector="CalendarItem /template/ Grid#PART_YearView">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
    </Style>

    <Style Selector="CalendarItem /template/ Grid#PART_MonthView">
        <Setter Property="Background" Value="{StaticResource BrushBg}" />
    </Style>

    <!-- CalendarButton (месяцы и годы) -->
    <Style Selector="CalendarButton">
        <Setter Property="Foreground"      Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize"        Value="{StaticResource FontSizeBase}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
    </Style>

    <Style Selector="CalendarButton:pointerover /template/ Border#Background">
        <Setter Property="Background"      Value="{StaticResource BrushHover}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusBase}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="CalendarButton:selected">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
    </Style>

    <Style Selector="CalendarButton:selected /template/ Border#Background">
        <Setter Property="Background"      Value="{StaticResource BrushAccent}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusBase}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="CalendarButton:selected:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
    </Style>

    <Style Selector="CalendarButton:calendarbutton-hasbtn /template/ Border#Background">
        <Setter Property="Background"   Value="Transparent" />
        <Setter Property="BorderBrush"  Value="{StaticResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusBase}" />
    </Style>

    <Style Selector="CalendarButton:calendarbutton-hasbtn">
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
    </Style>

    <!-- ===== Кастомное поле времени (editable combobox, как CalendarDatePicker) ===== -->

    <!-- Внешний бокс: фон, рамка, скругление как у даты -->
    <Style Selector="Border.timeField">
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
    </Style>

    <!-- Наведение — синяя рамка (как у даты) -->
    <Style Selector="Border.timeField:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    </Style>

    <!-- Фокус в поле — белый фон + яркая толстая синяя рамка (как у даты) -->
    <Style Selector="Border.timeField:focus-within">
        <Setter Property="Background"      Value="{StaticResource BrushBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- Поле ввода внутри бокса: прозрачное, без рамки -->
    <Style Selector="TextBox.timeInput">
        <Setter Property="Background"               Value="Transparent" />
        <Setter Property="Foreground"               Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="BorderThickness"          Value="0" />
        <Setter Property="Padding"                  Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment"        Value="Stretch" />
    </Style>

    <Style Selector="TextBox.timeInput /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.timeInput:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.timeInput:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Кнопка-стрелка справа -->
    <Style Selector="Button.timeArrow">
        <Setter Property="Background"                 Value="Transparent" />
        <Setter Property="BorderThickness"            Value="0" />
        <Setter Property="Padding"                    Value="4,0,8,0" />
        <Setter Property="CornerRadius"               Value="0" />
        <Setter Property="VerticalAlignment"          Value="Stretch" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="Cursor"                     Value="Hand" />
    </Style>

    <Style Selector="Button.timeArrow:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Popup со списком времени -->
    <Style Selector="Border.timePopup">
        <Setter Property="Background"      Value="{StaticResource BrushBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
        <Setter Property="BoxShadow"       Value="0 4 16 0 #1A000000" />
        <Setter Property="Padding"         Value="4,6" />
        <Setter Property="Margin"          Value="0,4,0,0" />
    </Style>

    <Style Selector="ListBox.timeList">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding"         Value="0" />
    </Style>

    <!-- Элементы списка времени -->
    <Style Selector="ListBox.timeList ListBoxItem">
        <Setter Property="Foreground"   Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="FontSize"     Value="{StaticResource FontSizeBase}" />
        <Setter Property="Background"   Value="Transparent" />
        <Setter Property="Padding"      Value="10,7" />
        <Setter Property="Margin"       Value="4,2" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusBase}" />
    </Style>

    <Style Selector="ListBox.timeList ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background"   Value="{StaticResource BrushHover}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusBase}" />
    </Style>

    <Style Selector="ListBox.timeList ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background"   Value="{StaticResource BrushAccent}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusBase}" />
    </Style>

    <Style Selector="ListBox.timeList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextBlock.Foreground" Value="White" />
    </Style>

    <!-- CheckBox -->
    <Style Selector="CheckBox /template/ Border#NormalRectangle">
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusXS}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushAccent}" />
    </Style>

    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
    </Style>

</Styles>
