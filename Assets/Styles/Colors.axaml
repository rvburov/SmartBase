<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Палитра приложения -->

    <!-- Фоны -->
    <Color x:Key="ColorBg">#FFFFFF</Color>
    <Color x:Key="ColorSecondaryBg">#F2F2F7</Color>
    <Color x:Key="ColorInactiveBg">#FAFAFA</Color>
    <Color x:Key="ColorActivityBar">#EBEBEB</Color>
    <!-- Фон карточки-блока внутри диалога (например, «Параметры ручного импорта»):
         серый как у полей ввода; сами поля НА карточке — белые (TextBox.onCard),
         иначе инпуты сливаются с фоном карточки. -->
    <Color x:Key="ColorCardBg">#F2F2F7</Color>

    <!-- Разделители. Единый цвет всех линий в приложении. -->
    <Color x:Key="ColorSeparator">#E5E5EA</Color>
    <!-- Линия темнее разделителя: полоса цитаты и рамка пустого флажка в markdown.
         Разделителя им не хватает — он читается как случайная царапина, а эти две линии
         несут смысл (граница цитаты, «сюда можно нажать»). -->
    <Color x:Key="ColorLineStrong">#C7C7CC</Color>

    <!-- Текст -->
    <Color x:Key="ColorPrimaryText">#1C1C1E</Color>
    <Color x:Key="ColorSecondaryText">#8E8E93</Color>
    <Color x:Key="ColorWeekend">#8E8E93</Color>
    <Color x:Key="ColorTodayText">#FFFFFF</Color>

    <!-- Акценты -->
    <Color x:Key="ColorAccent">#007AFF</Color>
    <Color x:Key="ColorAccentLight">#E5F0FF</Color>
    <Color x:Key="ColorRed">#FF3B30</Color>
    <Color x:Key="ColorGreen">#34C759</Color>
    <!-- Светлые подложки чипов (статусы задач): по образцу ColorAccentLight. -->
    <Color x:Key="ColorRedLight">#FFE9E7</Color>
    <Color x:Key="ColorGreenLight">#E3F7E9</Color>
    <!-- Оранжевый заведен под выносной блок «предупреждение» в markdown: у выносных
         блоков четыре вида, и три из них уже покрыты синим, зеленым и красным. -->
    <Color x:Key="ColorOrange">#FF9500</Color>
    <!-- Подложка найденного слова в тексте (сниппет карточки библиотеки документов). Желтый,
         а не акцентный синий: синим набраны ссылки и действия, и подсвеченное слово читалось
         бы как то, на что можно нажать. Светлее подложек чипов — поверх нее идет обычный
         текст, а не короткая надпись на своем фоне. -->
    <Color x:Key="ColorHighlight">#FFF0B3</Color>

    <!-- Код внутри строки. Отдельный цвет, а не вторичный серый: серым набраны
         служебные знаки разметки, и код с ними слился бы. Приглушенный зеленый
         отделяет код от текста, не споря с синим у ссылок. -->
    <Color x:Key="ColorCode">#4E9A8C</Color>

    <!-- Форматы документов (лента на плитке карточки в библиотеке документов).
         Эти цвета НЕ смысловые: они не значат «хорошо» или «плохо», они опознают вид файла,
         как обложка. Поэтому вынесены отдельной группой, а не взяты из красного/зеленого выше.

         Красный формата ТЕМНЕЕ тревожного #FF3B30, синий ТЕМНЕЕ акцентного #007AFF: иначе
         лента на каждом втором документе читалась бы как ошибка или как то, на что можно
         нажать. Пара «насыщенный + светлый» — тот же прием, что у ColorRed/ColorRedLight:
         цветом набраны обводка и надпись, заливка светлая. Сплошной насыщенной заливки в
         приложении нет нигде, и лента формата ее не заводит. -->
    <Color x:Key="ColorFormatPdf">#D0342C</Color>
    <Color x:Key="ColorFormatPdfLight">#F9E8E6</Color>
    <Color x:Key="ColorFormatWord">#2B579A</Color>
    <Color x:Key="ColorFormatWordLight">#E8EDF5</Color>
    <Color x:Key="ColorFormatExcel">#1E6F42</Color>
    <Color x:Key="ColorFormatExcelLight">#E8F0EB</Color>
    <Color x:Key="ColorFormatText">#6E7278</Color>
    <Color x:Key="ColorFormatTextLight">#F0F0F1</Color>
    <Color x:Key="ColorFormatOther">#8E8E93</Color>
    <Color x:Key="ColorFormatOtherLight">#F3F3F4</Color>

    <!-- Прочее -->
    <Color x:Key="ColorHover">#E5E5EA</Color>
    <Color x:Key="ColorDragHandle">#AEAEB2</Color>
    <Color x:Key="ColorScrollbar">#C7C7CC</Color>
    <!-- Подсветка выделенного мышью текста: серая вместо системной синей. Одна на все
         приложение — поля ввода (TextBox) и markdown-текст инструкции. -->
    <Color x:Key="ColorTextSelection">#C7C7CC</Color>

    <!-- SolidColorBrush для привязок -->
    <SolidColorBrush x:Key="BrushBg"           Color="{StaticResource ColorBg}" />
    <SolidColorBrush x:Key="BrushInactiveBg"   Color="{StaticResource ColorInactiveBg}" />
    <SolidColorBrush x:Key="BrushSecondaryBg"  Color="{StaticResource ColorSecondaryBg}" />
    <SolidColorBrush x:Key="BrushCardBg"       Color="{StaticResource ColorCardBg}" />
    <SolidColorBrush x:Key="BrushSeparator"    Color="{StaticResource ColorSeparator}" />
    <SolidColorBrush x:Key="BrushLineStrong"   Color="{StaticResource ColorLineStrong}" />
    <SolidColorBrush x:Key="BrushPrimaryText"  Color="{StaticResource ColorPrimaryText}" />
    <SolidColorBrush x:Key="BrushSecondaryText" Color="{StaticResource ColorSecondaryText}" />
    <SolidColorBrush x:Key="BrushAccent"       Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentLight"  Color="{StaticResource ColorAccentLight}" />
    <SolidColorBrush x:Key="BrushRed"          Color="{StaticResource ColorRed}" />
    <SolidColorBrush x:Key="BrushRedLight"     Color="{StaticResource ColorRedLight}" />
    <SolidColorBrush x:Key="BrushGreen"        Color="{StaticResource ColorGreen}" />
    <SolidColorBrush x:Key="BrushGreenLight"   Color="{StaticResource ColorGreenLight}" />
    <SolidColorBrush x:Key="BrushOrange"       Color="{StaticResource ColorOrange}" />
    <SolidColorBrush x:Key="BrushHighlight"    Color="{StaticResource ColorHighlight}" />
    <SolidColorBrush x:Key="BrushCode"         Color="{StaticResource ColorCode}" />

    <SolidColorBrush x:Key="BrushFormatPdf"        Color="{StaticResource ColorFormatPdf}" />
    <SolidColorBrush x:Key="BrushFormatPdfLight"   Color="{StaticResource ColorFormatPdfLight}" />
    <SolidColorBrush x:Key="BrushFormatWord"       Color="{StaticResource ColorFormatWord}" />
    <SolidColorBrush x:Key="BrushFormatWordLight"  Color="{StaticResource ColorFormatWordLight}" />
    <SolidColorBrush x:Key="BrushFormatExcel"      Color="{StaticResource ColorFormatExcel}" />
    <SolidColorBrush x:Key="BrushFormatExcelLight" Color="{StaticResource ColorFormatExcelLight}" />
    <SolidColorBrush x:Key="BrushFormatText"       Color="{StaticResource ColorFormatText}" />
    <SolidColorBrush x:Key="BrushFormatTextLight"  Color="{StaticResource ColorFormatTextLight}" />
    <SolidColorBrush x:Key="BrushFormatOther"      Color="{StaticResource ColorFormatOther}" />
    <SolidColorBrush x:Key="BrushFormatOtherLight" Color="{StaticResource ColorFormatOtherLight}" />
    <SolidColorBrush x:Key="BrushHover"        Color="{StaticResource ColorHover}" />
    <SolidColorBrush x:Key="BrushTextSelection" Color="{StaticResource ColorTextSelection}" />

    <!-- Фон вложенного меню (Popup у MenuItem с сабпунктами): Fluent по умолчанию
         использует белый из FlyoutBackground/MenuFlyoutPresenterBackground.
         Переопределяем на тот же серый, что и у основного ContextMenu. -->
    <SolidColorBrush x:Key="FlyoutBackground"               Color="{StaticResource ColorSecondaryBg}" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground"  Color="{StaticResource ColorSecondaryBg}" />
    <SolidColorBrush x:Key="MenuFlyoutSubItemBackground"    Color="{StaticResource ColorSecondaryBg}" />

    <!-- Фон выпадающего списка ComboBox — тот же серый, что и у контекстного меню. -->
    <SolidColorBrush x:Key="ComboBoxDropDownBackground"     Color="{StaticResource ColorSecondaryBg}" />

    <!-- Переопределение системного акцентного цвета Fluent -->
    <Color x:Key="SystemAccentColor">#007AFF</Color>
    <Color x:Key="SystemAccentColorLight1">#3395FF</Color>
    <Color x:Key="SystemAccentColorLight2">#66B0FF</Color>
    <Color x:Key="SystemAccentColorLight3">#99CAFF</Color>
    <Color x:Key="SystemAccentColorDark1">#0062CC</Color>
    <Color x:Key="SystemAccentColorDark2">#004999</Color>
    <Color x:Key="SystemAccentColorDark3">#003166</Color>

</ResourceDictionary>
