<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Палитра приложения -->

    <!-- Фоны -->
    <Color x:Key="ColorBg">#FFFFFF</Color>
    <Color x:Key="ColorSecondaryBg">#F2F2F7</Color>
    <Color x:Key="ColorInactiveBg">#FAFAFA</Color>
    <Color x:Key="ColorActivityBar">#EBEBEB</Color>
    <!-- Фон карточки-блока внутри диалога (например, «Параметры ручного импорта»):
         серый как у полей ввода; сами поля НА карточке — белые (TextBox.onCard),
         иначе инпуты сливаются с фоном карточки. -->
    <Color x:Key="ColorCardBg">#F2F2F7</Color>

    <!-- Разделители. Единый цвет всех линий в приложении. -->
    <Color x:Key="ColorSeparator">#E5E5EA</Color>

    <!-- Текст -->
    <Color x:Key="ColorPrimaryText">#1C1C1E</Color>
    <Color x:Key="ColorSecondaryText">#8E8E93</Color>
    <Color x:Key="ColorWeekend">#8E8E93</Color>
    <Color x:Key="ColorTodayText">#FFFFFF</Color>

    <!-- Акценты -->
    <Color x:Key="ColorAccent">#007AFF</Color>
    <Color x:Key="ColorAccentLight">#E5F0FF</Color>
    <Color x:Key="ColorRed">#FF3B30</Color>
    <Color x:Key="ColorGreen">#34C759</Color>
    <!-- Светлые подложки чипов (статусы задач): по образцу ColorAccentLight. -->
    <Color x:Key="ColorRedLight">#FFE9E7</Color>
    <Color x:Key="ColorGreenLight">#E3F7E9</Color>

    <!-- Прочее -->
    <Color x:Key="ColorHover">#E5E5EA</Color>
    <Color x:Key="ColorDragHandle">#AEAEB2</Color>
    <Color x:Key="ColorScrollbar">#C7C7CC</Color>
    <!-- Подсветка выделенного мышью текста: серая вместо системной синей. Одна на всё
         приложение — поля ввода (TextBox) и markdown-текст инструкции. -->
    <Color x:Key="ColorTextSelection">#C7C7CC</Color>

    <!-- SolidColorBrush для привязок -->
    <SolidColorBrush x:Key="BrushBg"           Color="{StaticResource ColorBg}" />
    <SolidColorBrush x:Key="BrushInactiveBg"   Color="{StaticResource ColorInactiveBg}" />
    <SolidColorBrush x:Key="BrushSecondaryBg"  Color="{StaticResource ColorSecondaryBg}" />
    <SolidColorBrush x:Key="BrushCardBg"       Color="{StaticResource ColorCardBg}" />
    <SolidColorBrush x:Key="BrushSeparator"    Color="{StaticResource ColorSeparator}" />
    <SolidColorBrush x:Key="BrushPrimaryText"  Color="{StaticResource ColorPrimaryText}" />
    <SolidColorBrush x:Key="BrushSecondaryText" Color="{StaticResource ColorSecondaryText}" />
    <SolidColorBrush x:Key="BrushAccent"       Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentLight"  Color="{StaticResource ColorAccentLight}" />
    <SolidColorBrush x:Key="BrushRed"          Color="{StaticResource ColorRed}" />
    <SolidColorBrush x:Key="BrushRedLight"     Color="{StaticResource ColorRedLight}" />
    <SolidColorBrush x:Key="BrushGreen"        Color="{StaticResource ColorGreen}" />
    <SolidColorBrush x:Key="BrushGreenLight"   Color="{StaticResource ColorGreenLight}" />
    <SolidColorBrush x:Key="BrushHover"        Color="{StaticResource ColorHover}" />
    <SolidColorBrush x:Key="BrushTextSelection" Color="{StaticResource ColorTextSelection}" />

    <!-- Фон вложенного меню (Popup у MenuItem с сабпунктами): Fluent по умолчанию
         использует белый из FlyoutBackground/MenuFlyoutPresenterBackground.
         Переопределяем на тот же серый, что и у основного ContextMenu. -->
    <SolidColorBrush x:Key="FlyoutBackground"               Color="{StaticResource ColorSecondaryBg}" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground"  Color="{StaticResource ColorSecondaryBg}" />
    <SolidColorBrush x:Key="MenuFlyoutSubItemBackground"    Color="{StaticResource ColorSecondaryBg}" />

    <!-- Фон выпадающего списка ComboBox — тот же серый, что и у контекстного меню. -->
    <SolidColorBrush x:Key="ComboBoxDropDownBackground"     Color="{StaticResource ColorSecondaryBg}" />

    <!-- Переопределение системного акцентного цвета Fluent -->
    <Color x:Key="SystemAccentColor">#007AFF</Color>
    <Color x:Key="SystemAccentColorLight1">#3395FF</Color>
    <Color x:Key="SystemAccentColorLight2">#66B0FF</Color>
    <Color x:Key="SystemAccentColorLight3">#99CAFF</Color>
    <Color x:Key="SystemAccentColorDark1">#0062CC</Color>
    <Color x:Key="SystemAccentColorDark2">#004999</Color>
    <Color x:Key="SystemAccentColorDark3">#003166</Color>

</ResourceDictionary>
