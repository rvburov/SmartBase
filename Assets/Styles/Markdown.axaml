<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctxt="using:ColorTextBlock.Avalonia">

    <!-- ═══════════════════════════════════════════════════════════════════════════
         Вид markdown-текста (Markdown.Avalonia) под типографику приложения — ЕДИНЫЙ на
         все приложение и правится ТОЛЬКО здесь (см. docs/developer/ui/markdown.md).

         Где применяется: везде, где стоит виджет AppMarkdown, — «Настройки → Инструкция
         пользователя», описания расширений, просмотр описания записи. Набор ставится не
         глобально, а на сам контрол (или на его хост): встроенная тема пакета
         (MarkdownStyleGithubLike и прочие) живет ВНУТРИ контрола и потому сильнее
         глобального стиля — пока ее не заменить, заголовки идут ее размером, а таблицы
         рисуются черными рамками с «зеброй». Гасит ее AppMarkdown.

         Раз тема заменена целиком, здесь описан ВЕСЬ вид: заголовки, абзацы, цитаты,
         код, таблицы, списки. Не описанное здесь остается на общих стилях приложения.

         Правила проекта: размеры шрифта — только {DynamicResource FontSizeXxx} (живой
         «Размер шрифта», Utils/FontScale), цвета и линии — токены Colors.axaml и
         Controls.axaml. Рендер вешает на элементы классы («Heading1»…«Heading6»,
         «Paragraph», «Blockquote», «CodeBlock», «Table», «TableHeader», «TableRowOdd»,
         «TableRowEven», «List», «ListMarker», «Note»); текст — CTextBlock из
         ColorTextBlock.Avalonia, поэтому селекторы пишутся по ctxt|CTextBlock.
         ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- ── Текст ────────────────────────────────────────────────────────────────
         Межстрочный интервал выше стандартного: сплошной справочный текст читается
         строками, а не словами. -->
    <Style Selector="ctxt|CTextBlock">
        <Setter Property="FontFamily"  Value="{StaticResource FontFamilyBase}" />
        <Setter Property="FontSize"    Value="{DynamicResource FontSizeBase}" />
        <Setter Property="Foreground"  Value="{StaticResource BrushPrimaryText}" />
        <Setter Property="LineSpacing" Value="5" />
        <!-- Выделение мышью — общий серый приложения (тот же, что у полей ввода):
             свой дефолт у ColorTextBlock ярко-голубой и выбивается из оформления. -->
        <Setter Property="SelectionBrush" Value="{StaticResource BrushTextSelection}" />
    </Style>

    <!-- Единый вертикальный ритм: КАЖДЫЙ блок текста (абзац, список, таблица, цитата,
         код) отбивается снизу на одну и ту же величину и НЕ имеет отступа сверху. Иначе
         отступы складываются попарно и «прыгают»: между абзацами один зазор, между
         абзацем и таблицей другой, после цитаты третий. -->
    <Style Selector="ctxt|CTextBlock.Paragraph">
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- ── Заголовки ────────────────────────────────────────────────────────────
         H1 — заголовок документа, H2 — раздел (он же пункт оглавления), H3 и ниже —
         подраздел базового размера, отличается только весом. -->
    <Style Selector="ctxt|CTextBlock.Heading1">
        <Setter Property="FontSize"   Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
        <Setter Property="Margin"     Value="0,0,0,10" />
    </Style>

    <!-- Заголовок раздела: небольшой отступ сверху сверх общего ритма — раздел отбивается
         воздухом, а не линией (линия отделяет только документ целиком, см. SettingsGuide). -->
    <Style Selector="ctxt|CTextBlock.Heading2">
        <Setter Property="FontSize"   Value="{DynamicResource FontSizeMedium}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
        <Setter Property="Margin"     Value="0,8,0,10" />
    </Style>

    <!-- Селекторы пишем в ОДНУ строку: перенос внутри Selector ломает разбор, и стиль
         молча не применяется (так пропали линии таблицы в первом заходе). -->
    <Style Selector="ctxt|CTextBlock.Heading3, ctxt|CTextBlock.Heading4, ctxt|CTextBlock.Heading5, ctxt|CTextBlock.Heading6">
        <Setter Property="FontSize"   Value="{DynamicResource FontSizeBase}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
        <Setter Property="Margin"     Value="0,6,0,10" />
    </Style>

    <!-- Разделительную линию под заголовком рендер рисует сам — гасим: линии в
         приложении рисует отдельный Border.separator, вторая тут лишняя. -->
    <Style Selector="Border.Heading1, Border.Heading2">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ── Цитата: она же callout «> **Зачин.** пояснение» ──────────────────────
         Слева акцентная полоса, фон — подложка карточки. -->
    <Style Selector="Border.Blockquote">
        <Setter Property="Background"      Value="{StaticResource BrushCardBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusXS}" />
        <Setter Property="Padding"         Value="12,10,12,2" />
        <Setter Property="Margin"          Value="0,0,0,10" />
    </Style>

    <!-- ── Код ──────────────────────────────────────────────────────────────────
         Блок кода — карточка с рамкой; в инструкции это команды и пути. -->
    <Style Selector="Border.CodeBlock">
        <Setter Property="Background"      Value="{StaticResource BrushCardBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderLine}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusBase}" />
        <Setter Property="Padding"         Value="12,10" />
        <Setter Property="Margin"          Value="0,0,0,10" />
    </Style>

    <!-- ── Таблицы ──────────────────────────────────────────────────────────────
         Как таблицы приложения: тонкие серые линии, шапка серой заливкой и жирным,
         строки без «зебры» — заливка через одну спорит с выделением и утомляет
         на длинных справочных таблицах. -->
    <Style Selector="Border.Table">
        <Setter Property="BorderBrush"       Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness"   Value="{DynamicResource BorderLineTopLeft}" />
        <Setter Property="UseLayoutRounding" Value="{DynamicResource LineUseLayoutRounding}" />
        <Setter Property="Margin"            Value="0,0,0,10" />
    </Style>

    <!-- Сетка ячеек: каждая рисует правую и нижнюю линию, внешние верхнюю и левую дает
         контейнер таблицы — так на стыке линию рисует ровно ОДИН элемент и она не выходит
         двойной толщины (правило проекта, см. ui/theming.md).

         И толщина, и кисть приходили из встроенной темы пакета; ее отключили, и рамки
         пропали вовсе. Селектор по вложенности, а не по классам ячеек: классы
         («TableHeader», «TableRowOdd» и прочие) навешиваются не на все ячейки.

         UseLayoutRounding — динамический токен: при зуме ≠ 1 штатное округление съедает
         компенсированную толщину, и линии выходят разной ширины (см. LineMetrics).
         RenderOptions.EdgeMode здесь НЕ ставим: он наследуется на поддерево и отключает
         сглаживание текста, а текст в ячейках как раз и живет. -->
    <Style Selector="Border.Table Border">
        <Setter Property="BorderBrush"       Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness"   Value="{DynamicResource BorderLineBottomRight}" />
        <Setter Property="UseLayoutRounding" Value="{DynamicResource LineUseLayoutRounding}" />
        <Setter Property="Padding"           Value="8,5" />
    </Style>

    <Style Selector="Border.TableHeader">
        <Setter Property="Background" Value="{StaticResource BrushSecondaryBg}" />
    </Style>
    <!-- «Зебры» нет: заливка через строку спорит с выделением и утомляет на длинных
         справочных таблицах — как и в таблицах приложения. -->
    <Style Selector="Border.TableRowOdd, Border.TableRowEven, Border.TableFooter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ctxt|CTextBlock.TableHeader">
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
    </Style>

    <!-- ── Списки ───────────────────────────────────────────────────────────────
         Маркер серый, как вторичный текст: перечисление читается по содержанию. -->
    <!-- Маркер («1.» или точка) отбит от текста: рендер ставит его вплотную, и строка
         читается как «1.Создайте» — цифра слипается с первым словом. -->
    <Style Selector="ctxt|CTextBlock.ListMarker">
        <Setter Property="Foreground" Value="{StaticResource BrushSecondaryText}" />
        <Setter Property="Margin"     Value="0,0,8,0" />
    </Style>

    <Style Selector="Grid.List">
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- ── Горизонтальная черта ─────────────────────────────────────────────────-->
    <Style Selector="Border.Note">
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderLine}" />
    </Style>

</Styles>
