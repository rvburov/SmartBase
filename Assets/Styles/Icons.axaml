    <StreamGeometry x:Key="IconCheck">M20 6 L9 17 l-5 -5</StreamGeometry>
    <!-- ✕ Крестик / закрыть (x) -->
    <StreamGeometry x:Key="IconClose">M18 6 L6 18 M6 6 L18 18</StreamGeometry>

    <!-- ─── Стрелки скроллбара (сетка ~14px, Classes="arrow") ─── -->

    <!-- ⌃ вверх -->
    <StreamGeometry x:Key="IconScrollUp">M1 6 L7 1 L13 6</StreamGeometry>
    <!-- ⌄ вниз -->
    <StreamGeometry x:Key="IconScrollDown">M1 1 L7 6 L13 1</StreamGeometry>
    <!-- ‹ влево -->
    <StreamGeometry x:Key="IconScrollLeft">M6 1 L1 7 L6 13</StreamGeometry>
    <!-- › вправо -->
    <StreamGeometry x:Key="IconScrollRight">M1 1 L6 7 L1 13</StreamGeometry>

</ResourceDictionary>
