    <!-- ─── Стрелки скроллбара (Classes="arrow") ───
         Рисуются в рамке 16×8 (вертикальные) и 8×16 (горизонтальные) — это размер Canvas
         в шаблоне полосы. Чертеж отступает от края рамки на 2 единицы, обводка (толщина 2,
         круглые торцы) съедает 1 → между краской и краем рамки остается запас в 1 единицу.
         Запас обязателен: раньше чертеж стоял впритык, и Viewbox при дробном масштабе
         срезал торцы шевронов. Меняете геометрию — сохраняйте отступ 2 от всех краев. -->

    <!-- ⌃ вверх -->
    <StreamGeometry x:Key="IconScrollUp">M2 6 L8 2 L14 6</StreamGeometry>
    <!-- ⌄ вниз -->
    <StreamGeometry x:Key="IconScrollDown">M2 2 L8 6 L14 2</StreamGeometry>
    <!-- ‹ влево -->
    <StreamGeometry x:Key="IconScrollLeft">M6 2 L2 8 L6 14</StreamGeometry>
    <!-- › вправо -->
    <StreamGeometry x:Key="IconScrollRight">M2 2 L6 8 L2 14</StreamGeometry>

