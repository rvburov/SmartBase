    <!-- Календарь в полях даты (lucide calendar) -->
    <StreamGeometry x:Key="IconCalendar">M7 4 L7 7 M17 4 L17 7 M4 9 L20 9 M5 6 L19 6 A1 1 0 0 1 20 7 L20 19 A1 1 0 0 1 19 20 L5 20 A1 1 0 0 1 4 19 L4 7 A1 1 0 0 1 5 6 Z</StreamGeometry>
