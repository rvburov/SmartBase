<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════════════════════════
         Единое место для всех иконок приложения.

         Иконки — это geometry-строки (стиль lucide, сетка 24×24, обводка
         без заливки; кроме стрелок скроллбара — те в своей сетке ~14px).
         Здесь хранится ТОЛЬКО форма (Data). Оформление — Stroke / толщина /
         скругления — остается на самом <Path> в месте использования, т.к.
         у разных иконок оно разное (цвет из биндинга, толщина 1.2/2/2.5…).

         Использование:
             <Path Data="{StaticResource IconPlus}" Stroke="…" StrokeThickness="…" … />

         Поменять иконку = поменять Data здесь → меняется во всех местах сразу.

         Глиф галочки чекбокса тоже здесь — ключ CheckBoxGlyphGeometry; его
         толщина/размер/радиус остаются в Controls/Widgets/AppCheckBox.axaml.
         ════════════════════════════════════════════════════════════════ -->

    <!-- ═══ РАЗМЕРЫ ИКОНОК (сторона Viewbox, px). Меняешь здесь — меняется
         везде, где иконка этого размера. Сетка самой иконки всегда 24×24. ═══ -->
    <x:Double x:Key="IconSizeSmall">16</x:Double>   <!-- Маленький -->
    <x:Double x:Key="IconSizeMedium">18</x:Double>  <!-- Средний -->
    <x:Double x:Key="IconSizeLarge">24</x:Double>   <!-- Большой -->
    <x:Double x:Key="IconSizeXLarge">32</x:Double>  <!-- Крупный -->

    <!-- ═══ ТОЛЩИНА ЛИНИЙ ИКОНОК (StrokeThickness обводочного Path). СТАНДАРТ.
         Толщина задается В СЕТКЕ 24, а Viewbox потом ужимает иконку до размера, поэтому на
         экране реальная толщина = значение × размер / 24. Чтобы ЛИНИЯ ВЫГЛЯДЕЛА ОДИНАКОВОЙ при
         разных размерах, для каждого размера — свое значение (посчитано под видимую толщину):
           • Regular ≈ 1.2 px — по умолчанию (почти все иконки);
           • Bold    ≈ 1.5 px — акцентные (активная вкладка навбара, кнопка сайдбара и т.п.).
         ПРАВИЛО: взял размер IconSizeX → бери толщину IconStrokeX (или …Bold для акцентных).
         Не писать «сырые» числа в разметке — только эти токены.
         ИСКЛЮЧЕНИЯ (сырые числа допустимы): шевроны/стрелки-индикаторы (часто нестандартного
         размера 12/14), линии сетки DataGrid и белая галочка тоста — это не контент-иконки. ═══ -->
    <x:Double x:Key="IconStrokeSmall">1.8</x:Double>       <!-- 16px → ~1.2px -->
    <x:Double x:Key="IconStrokeMedium">1.6</x:Double>      <!-- 18px → ~1.2px -->
    <x:Double x:Key="IconStrokeLarge">1.2</x:Double>       <!-- 24px → ~1.2px -->
    <x:Double x:Key="IconStrokeXLarge">0.9</x:Double>      <!-- 32px → ~1.2px -->
    <x:Double x:Key="IconStrokeSmallBold">2.2</x:Double>   <!-- 16px → ~1.5px -->
    <x:Double x:Key="IconStrokeMediumBold">2</x:Double>    <!-- 18px → ~1.5px -->
    <x:Double x:Key="IconStrokeLargeBold">1.5</x:Double>   <!-- 24px → ~1.5px -->
    <x:Double x:Key="IconStrokeXLargeBold">1.1</x:Double>  <!-- 32px → ~1.5px -->

    <!-- ═══ КАРТА ПРИМЕНЕНИЯ РАЗМЕРОВ (где какой IconSize/IconStroke). Ставишь иконку в новом
         месте — держись размера соседей из этого списка, новый размер не заводи. ═══
         Small  16px — редактор ячейки таблицы, поля даты/времени, контекстные меню, диалоги
                       записи/задачи/свойства, настройки, панель записи, список задач;
                       Bold: диалоги-карточки отображения (RecordDisplayDialog, DisplayDialog).
         Medium 18px — навбар, футеры, сайдбар (дерево/список), пикер типа в диалоге свойства,
                       иконка типа поля в таблице, список конструкторов, таблицы профиля;
                       Bold: активная вкладка навбара, диаграмма, сетка месяца.
         Large  24px — заголовок открытой вкладки конструктора (ConstructorControllerView).
         XLarge 32px — ActivityBar (иконки модулей и кнопка сайдбара), всегда Bold. -->

    <!-- ─── Activity bar: модули и кнопка сайдбара ─── -->

    <!-- → panel-left-open: сайдбар закрыт, клик откроет -->
    <StreamGeometry x:Key="IconPanelOpen">M5 3 H19 A2 2 0 0 1 21 5 V19 A2 2 0 0 1 19 21 H5 A2 2 0 0 1 3 19 V5 A2 2 0 0 1 5 3 Z M9 3 V21 M14 9 L17 12 L14 15</StreamGeometry>
    <!-- ← panel-right-open: сайдбар открыт, клик закроет -->
