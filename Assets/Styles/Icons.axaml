    <StreamGeometry x:Key="IconPanelOpen">M5 3 H19 A2 2 0 0 1 21 5 V19 A2 2 0 0 1 19 21 H5 A2 2 0 0 1 3 19 V5 A2 2 0 0 1 5 3 Z M9 3 V21 M14 9 L17 12 L14 15</StreamGeometry>
    <!-- ← panel-right-open: сайдбар открыт, клик закроет -->
