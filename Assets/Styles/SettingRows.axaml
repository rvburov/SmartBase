<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ПАСПОРТ ФАЙЛА. Вид строки настройки: заголовок с пояснением, ячейка с показанными
        данными, строка таблицы. Один набор на все приложение.

        Почему файл общий, а не лежит в разметке одного раздела. Строки настроек собираются
        в code-behind там, где список строк заранее неизвестен, — «Интеграции» строят вкладки
        по данным, «Расширения» по IExtension.Settings, панель администратора показывает
        контур безопасности. Пока стиль лежал в SettingsView.axaml, второй такой экран мог
        взять его только копией: копия уже завелась в ProfileView.axaml и разошлась бы с
        оригиналом при первой же правке отступа.

        Живые пары «стиль — сборщик»: сами контролы собирает Controls/Widgets/SettingRows.cs,
        и числа там не пишутся — они здесь.
    -->

    <!-- ── Строка одной настройки ──────────────────────────────────────────────
         Линия под строкой — отдельный separator h ПОСЛЕ каждой строки, а не рамка
         контейнера с текстом: отдельную линию можно алиасить, и она четкая при любом зуме. -->
    <Style Selector="Border.settingRow">
        <Setter Property="Padding" Value="0,16" />
    </Style>
    <Style Selector="Border.settingRow TextBlock.title">
        <Setter Property="Foreground" Value="{StaticResource BrushPrimaryText}" />
    </Style>
    <Style Selector="Border.settingRow TextBlock.desc">
        <Setter Property="FontSize"     Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="Foreground"   Value="{StaticResource BrushSecondaryText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Поле настройки расширения. Строки раздела «Расширения» собираются в code-behind
         по IExtension.Settings, поэтому вид задаем стилем, а не атрибутами разметки —
         как у поля пути обновления в «О программе». -->
    <Style Selector="Border.settingRow TextBox.extSetting">
        <Setter Property="Height"                   Value="{StaticResource ControlHeightStandard}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background"               Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="CornerRadius"             Value="{StaticResource RadiusBase}" />
    </Style>

    <!-- ── Ячейка с данными ────────────────────────────────────────────────────
         Показанное программой (списки политики, состояние приема, тела запросов) живет
         в такой же рамке, что и поле ввода, — но серым текстом и без нажатия: человек по
         виду отличает «сюда вводят» от «здесь показано», а не по тому, отзовется ли рамка
         на щелчок. -->
    <Style Selector="Border.dataBox">
        <Setter Property="Background"      Value="{StaticResource BrushSecondaryBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
        <Setter Property="BorderThickness" Value="{DynamicResource BorderLine}" />
        <Setter Property="CornerRadius"    Value="{StaticResource RadiusBase}" />
        <Setter Property="Padding"         Value="10,8" />
    </Style>
    <!-- :is(TextBlock) — чтобы правило доставало и до SelectableTextBlock: выделяемый
         текст в ячейке тот же самый, отличается он только возможностью его скопировать. -->
    <Style Selector="Border.dataBox :is(TextBlock)">
        <Setter Property="FontSize"     Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="Foreground"   Value="{StaticResource BrushSecondaryText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Моноширинная ячейка: пример файла, тело запроса и ответа. Перенос по словам
         в них врет о содержимом, поэтому текст не переносится, а прокручивается. -->
    <Style Selector="Border.dataBox :is(TextBlock).mono">
        <Setter Property="FontFamily"   Value="{StaticResource FontFamilyMono}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- ── Строка таблицы ──────────────────────────────────────────────────────
         Журналы обмена и безопасности — таблицы, и меряются они теми же числами, что
         таблица конструктора и «Диагностика»: высота строки RowHeightStandard, подсветка
         под курсором BrushSecondaryBg, линия под строкой — отдельный separator h.
         Раскрытые подробности лежат ПОД строкой, вне ее рамки: иначе подсветка уезжала бы
         на полэкрана вместе с ними. -->
    <Style Selector="Border.tableRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor"     Value="Hand" />
        <Setter Property="MinHeight"  Value="{StaticResource RowHeightStandard}" />
        <Setter Property="Padding"    Value="0,6" />
    </Style>
    <Style Selector="Border.tableRow:pointerover">
        <Setter Property="Background" Value="{StaticResource BrushSecondaryBg}" />
    </Style>
    <Style Selector="Border.tableRow.open">
        <Setter Property="Background" Value="{StaticResource BrushAccentLight}" />
    </Style>
    <!-- Шапка таблицы: та же высота, что у строки, и тот же вид, что у шапки DataGrid. -->
    <Style Selector="Border.tableHead">
        <Setter Property="MinHeight" Value="{StaticResource RowHeightStandard}" />
        <Setter Property="Padding"   Value="0,6" />
    </Style>

</Styles>
