<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══ Стандарт размеров диалоговых окон ═══════════════════════════════
         Габариты диалогов берутся ТОЛЬКО отсюда — как размеры шрифта из
         Typography.axaml. Голых чисел в шапках окон быть не должно: правка
         стандарта — одно место, а не двадцать файлов.

         Три размера, больше не заводим:

           1) Compact 420 × авто — окна без формы: сообщение, подтверждение,
              один-два коротких поля, индикатор процесса.
           2) Base    520 × авто — все формы: создание и правка сущностей,
              настройки, подключения. Размер по умолчанию, если сомневаетесь.
           3) Wide    800 × 800  — окна-таблицы со списком и колонками, где
              высота нужна под содержимое, а не под форму.

         Высота у Compact и Base — SizeToContent="Height": окно ровно по
         содержимому. Ширина при этом жестко фиксирована тройкой
         Width/MinWidth/MaxWidth, чтобы длинная строка не распирала окно.

         СТАНДАРТ НЕ РАСПРОСТРАНЯЕТСЯ НА:
           · окна расширений (Extensions/**) — у каждого своя задача и своя
             компоновка, размер подбирается индивидуально;
           · главное окно — единственное в своем роде (1331 × 813, мин.
             1100 × 760, стиль Window.main в Controls.axaml);
           · заставку — 460 × 230 числами в разметке: окно без системной рамки,
             показывается до старта интерфейса, диалогом не является.

         Габариты умножаются на зум приложения (Controls/Behaviors/WindowZoom).
         Числа ниже — размер при 100%. -->

    <Styles.Resources>

        <!-- ── Ширина ──────────────────────────────────────────────────── -->

        <!-- Compact: подтверждение, напоминание, прогресс, ввод пароля -->
        <x:Double x:Key="DialogWidthCompact">420</x:Double>
        <!-- Base: формы создания и редактирования, настройки, подключения -->
        <x:Double x:Key="DialogWidthBase">520</x:Double>
        <!-- Wide: окна отображения свойств и записей -->
        <x:Double x:Key="DialogWidthWide">800</x:Double>

        <!-- ── Высота ──────────────────────────────────────────────────── -->

        <!-- Только у Wide: у Compact и Base высота идет за содержимым.
             Потолок по рабочей области экрана ставит DialogFit.LimitToScreen —
             при зуме 150% окно 800 не влезает в ноутбучный экран. -->
        <x:Double x:Key="DialogHeightWide">800</x:Double>

        <!-- ── Отступ содержимого от края окна ─────────────────────────── -->

        <!-- Единая рамка вокруг содержимого любого диалога. По горизонтали
             больше, чем по вертикали: сверху и снизу поля добирают заголовок
             окна и кнопки, по бокам добирать нечем. -->
        <Thickness x:Key="DialogPadding">20,16</Thickness>

        <!-- Ширина ОДНОЙ колонки в многоколоночном диалоге = ширина Base минус
             отступы (520 − 20 − 20). Нужна там, где ширина окна считается от
             содержимого (SizeToContent="WidthAndHeight"): окно с одной колонкой
             выходит ровно в Base, со второй — расширяется вправо на столько же.
             В обычных диалогах содержимое ширину не задает — тянется по окну. -->
        <x:Double x:Key="DialogColumnWidth">480</x:Double>

    </Styles.Resources>

</Styles>
