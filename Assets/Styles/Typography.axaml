<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- Размеры шрифтов -->
        <x:Double x:Key="FontSizeSmall">11</x:Double>
        <x:Double x:Key="FontSizeBase">13</x:Double>
        <x:Double x:Key="FontSizeLarge">20</x:Double>

        <!-- Веса шрифтов -->
        <FontWeight x:Key="FontWeightNormal">Normal</FontWeight>
        <FontWeight x:Key="FontWeightBold">SemiBold</FontWeight>

        <!-- Единый стандарт высоты строки (таблица + блоки сайдбара + блоки событий). -->
        <x:Double x:Key="RowHeightStandard">36</x:Double>
        <!-- Шаг строки = высота + линия-разделитель 1px (как сетка таблицы).
             Используется в сайдбаре, где линия рисуется внутри высоты Border. -->
        <x:Double x:Key="RowStepStandard">37</x:Double>
    </Styles.Resources>

    <Style Selector="TextBlock">
        <Setter Property="FontFamily"  Value="Helvetica Neue, Arial, sans-serif" />
        <Setter Property="FontSize"    Value="{StaticResource FontSizeBase}" />
        <Setter Property="Foreground"  Value="{StaticResource BrushPrimaryText}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="FontFamily"  Value="Helvetica Neue, Arial, sans-serif" />
        <Setter Property="FontSize"    Value="{StaticResource FontSizeBase}" />
    </Style>

    <Style Selector="Button">
        <Setter Property="FontFamily"  Value="Helvetica Neue, Arial, sans-serif" />
        <Setter Property="FontSize"    Value="{StaticResource FontSizeBase}" />
    </Style>

</Styles>
