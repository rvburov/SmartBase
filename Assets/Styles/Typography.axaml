<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- Семейство шрифтов: единый токен на все приложение -->
        <FontFamily x:Key="FontFamilyBase">Helvetica Neue, Arial, sans-serif</FontFamily>
        <!-- Код: моноширинный. Цепочка запасных — свой шрифт на каждой системе, чтобы не
             тащить файл в Assets ради одной роли. Пользуются им блоки кода и код внутри
             строки: и в разметке markdown, и в живом редакторе заметок. -->
        <FontFamily x:Key="FontFamilyMono">Menlo, Consolas, DejaVu Sans Mono, Courier New, monospace</FontFamily>

        <!-- Размеры шрифтов -->
        
        <!-- вторичный/мелкий текст: описания настроек, футеры, подписи под
             основным, тип поля в меню, логи расширений -->
        <x:Double x:Key="FontSizeSmall">10</x:Double>
        <!-- ОСНОВНОЙ размер: дефолт всего текста (TextBlock/TextBox/Button),
             тело таблицы, блоки событий, диалоги -->
        <x:Double x:Key="FontSizeBase">12</x:Double>
        <!-- промежуточный: заголовки внутри длинного текста (разделы инструкции
             пользователя) — между телом и крупным заголовком страницы -->
        <x:Double x:Key="FontSizeMedium">16</x:Double>
        <!-- крупные заголовки: названия в навбарах, заголовок раздела
             сайдбара, заголовок страницы настроек -->
        <x:Double x:Key="FontSizeLarge">20</x:Double>

        <!-- ── Два размера под markdown ─────────────────────────────────────
             Заводились под раздел «Заметки», но живут здесь: набор размеров в
             приложении один. Оба, как и остальные, двигает настройка «Размер шрифта».

             H3 в длинном тексте. Без него H3..H6 идут одним базовым размером, и
             четыре уровня подряд различить нечем: вес у всех одинаковый. -->
        <x:Double x:Key="FontSizeH3">14</x:Double>
        <!-- Код. На одном кегле с текстом моноширинный выглядит крупнее — у него выше
             строчные. На размер меньше он садится на общую строку и перестает выпирать. -->
        <x:Double x:Key="FontSizeMono">11</x:Double>

        <!-- Веса шрифтов -->
        <FontWeight x:Key="FontWeightNormal">Normal</FontWeight>
        <FontWeight x:Key="FontWeightBold">SemiBold</FontWeight>
    </Styles.Resources>

    <!-- TextBlock = просто надпись/текст, который НЕ редактируется (заголовки,
         подписи, названия событий, текст в таблице) -->
    <Style Selector="TextBlock">
        <Setter Property="FontFamily"  Value="{StaticResource FontFamilyBase}" />
        <Setter Property="FontSize"    Value="{DynamicResource FontSizeBase}" />
        <Setter Property="Foreground"  Value="{StaticResource BrushPrimaryText}" />
    </Style>

    <!-- TextBox = поле ВВОДА (туда печатают: имя коллекции, поиск, заметки) -->
    <Style Selector="TextBox">
        <Setter Property="FontFamily"  Value="{StaticResource FontFamilyBase}" />
        <Setter Property="FontSize"    Value="{DynamicResource FontSizeBase}" />
    </Style>

    <!-- Button = кнопка («Сегодня», «Сохранить», «Отмена») -->
    <Style Selector="Button">
        <Setter Property="FontFamily"  Value="{StaticResource FontFamilyBase}" />
        <Setter Property="FontSize"    Value="{DynamicResource FontSizeBase}" />
    </Style>

</Styles>
