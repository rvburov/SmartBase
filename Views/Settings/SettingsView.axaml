<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataBase.Views.Settings"
             xmlns:comp="using:DataBase.Controls.Components"
             x:Class="DataBase.Views.Settings.SettingsView"
             Background="{StaticResource BrushBg}">

    <UserControl.Resources>
        <!-- Ползунок-«таблетка»: белый прямоугольник со скруглением и мягкой тенью. -->
        <ControlTheme x:Key="SettingSliderThumb" TargetType="Thumb">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border CornerRadius="9"
                            Background="White"
                            BorderBrush="{StaticResource BrushSeparator}"
                            BorderThickness="1"
                            BoxShadow="0 1 3 0 #22000000" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!-- Половинки дорожки — прозрачные, чтобы под ними была видна единая линия. -->
        <ControlTheme x:Key="SettingSliderTrackButton" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Слайдер настроек: тонкая дорожка + ползунок-«таблетка» (как в Obsidian). -->
        <Style Selector="Slider.setting">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Height"   Value="24" />
            <Setter Property="Minimum"  Value="0" />
            <Setter Property="Maximum"  Value="100" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" VerticalAlignment="Center">
                        <Grid VerticalAlignment="Center">
                            <!-- единая дорожка -->
                            <Border Height="4" CornerRadius="2"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource BrushSeparator}" />
                            <Track Name="PART_Track" Orientation="Horizontal"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value, Mode=TwoWay}">
                                <Track.DecreaseButton>
                                    <RepeatButton Name="PART_DecreaseButton"
                                                  Theme="{StaticResource SettingSliderTrackButton}" />
                                </Track.DecreaseButton>
                                <Track.IncreaseButton>
                                    <RepeatButton Name="PART_IncreaseButton"
                                                  Theme="{StaticResource SettingSliderTrackButton}" />
                                </Track.IncreaseButton>
                                <Track.Thumb>
                                    <Thumb Width="26" Height="18"
                                           Theme="{StaticResource SettingSliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Строка одной настройки -->
        <Style Selector="Border.settingRow">
            <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding"         Value="0,16" />
        </Style>
        <Style Selector="Border.settingRow TextBlock.title">
            <Setter Property="Foreground" Value="{StaticResource BrushPrimaryText}" />
        </Style>
        <Style Selector="Border.settingRow TextBlock.desc">
            <Setter Property="FontSize"     Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground"   Value="{StaticResource BrushSecondaryText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <!-- Шапка раздела (вынесена в компонент-навбар). -->
        <comp:NavbarSettings DockPanel.Dock="Top" x:Name="HeaderBar" />

        <!-- Содержимое выбранного раздела -->
        <Grid>

            <!-- ── Общие ─────────────────────────────────────────── -->
            <ScrollViewer x:Name="GeneralPanel" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1400" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="16,16,16,32" Spacing="12">
                    <TextBlock Text="Основные параметры приложения."
                               Foreground="{StaticResource BrushSecondaryText}" />

                    <!-- Подгрузка строк с заглушкой «Загрузка…» -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Фоновая подгрузка строк («Загрузка…»)" />
                                <TextBlock Classes="desc"
                                           Text="Данные строк подгружаются в фоновом потоке: при прокрутке строки сначала показывают «Загрузка…», затем заполняются — интерфейс не подвисает даже при очень быстрой прокрутке больших таблиц. Выключите для синхронной загрузки (тоже быстрой, ~мс). Изменение вступает в силу при следующем открытии коллекции." />
                            </StackPanel>
                            <CheckBox x:Name="AsyncRowLoadCheck"
                                      Grid.Column="1"
                                      VerticalAlignment="Center"
                                      IsCheckedChanged="OnAsyncRowLoadChanged" />
                        </Grid>
                    </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ── Оформление ────────────────────────────────────── -->
            <ScrollViewer x:Name="AppearancePanel" IsVisible="False"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1400" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="16,0,16,32">

                    <!-- Уровень масштабирования -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Уровень масштабирования" />
                                <TextBlock Classes="desc"
                                           Text="Общий масштаб интерфейса. Диапазон 70…130 %, шаг 10 %; кнопка-стрелка возвращает 100 %." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        Spacing="14" VerticalAlignment="Center">
                                <Button Classes="icon" Width="24" Height="24"
                                        x:Name="ScaleResetBtn" Click="OnScaleReset"
                                        ToolTip.Tip="Сбросить">
                                    <Viewbox Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}">
                                        <Canvas Width="24" Height="24">
                                            <!-- rotate-ccw -->
                                            <Path Data="{StaticResource IconRotateCcw}"
                                                  Stroke="{Binding $parent[Button].Foreground}"
                                                  StrokeThickness="1.8"
                                                  StrokeLineCap="Round" StrokeJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Slider Classes="setting" Width="200"
                                        x:Name="ScaleSlider"
                                        Minimum="70" Maximum="130"
                                        TickFrequency="10" IsSnapToTickEnabled="True"
                                        SmallChange="10" LargeChange="10"
                                        ValueChanged="OnScaleChanged"
                                        PointerEntered="OnScaleSliderEntered"
                                        PointerExited="OnScaleSliderExited" />

                                <!-- Пузырёк со значением над ползунком: текущий масштаб в процентах. -->
                                <Popup x:Name="ScaleValuePopup"
                                       PlacementTarget="{Binding #ScaleSlider}"
                                       Placement="Top" VerticalOffset="-6"
                                       IsLightDismissEnabled="False">
                                    <Border Background="{DynamicResource ToolTipBackground}"
                                            BorderBrush="{StaticResource BrushSeparator}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            BoxShadow="0 2 8 0 #1A000000">
                                        <TextBlock x:Name="ScaleValueText" Text="100 %"
                                                   Foreground="{DynamicResource ToolTipForeground}"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Размер шрифта -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Размер шрифта" />
                                <TextBlock Classes="desc"
                                           Text="Общий размер текста интерфейса. Диапазон −3…+3 пикселя от стандарта; кнопка-стрелка возвращает стандарт." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        Spacing="14" VerticalAlignment="Center">
                                <Button Classes="icon" Width="24" Height="24"
                                        x:Name="FontResetBtn" Click="OnFontSizeReset"
                                        ToolTip.Tip="Сбросить">
                                    <Viewbox Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}">
                                        <Canvas Width="24" Height="24">
                                            <!-- rotate-ccw -->
                                            <Path Data="{StaticResource IconRotateCcw}"
                                                  Stroke="{Binding $parent[Button].Foreground}"
                                                  StrokeThickness="1.8"
                                                  StrokeLineCap="Round" StrokeJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Slider Classes="setting" Width="200"
                                        x:Name="FontSizeSlider"
                                        Minimum="-3" Maximum="3"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        SmallChange="1" LargeChange="1"
                                        ValueChanged="OnFontSizeChanged"
                                        PointerEntered="OnFontSliderEntered"
                                        PointerExited="OnFontSliderExited" />

                                <!-- Пузырёк со значением над ползунком: показывает итоговый
                                     базовый размер текста (стандарт ± дельта). -->
                                <Popup x:Name="FontValuePopup"
                                       PlacementTarget="{Binding #FontSizeSlider}"
                                       Placement="Top" VerticalOffset="-6"
                                       IsLightDismissEnabled="False">
                                    <!-- Квадратная плашка-индикатор: сторона считается от текущего
                                         размера шрифта (масштабируется вместе с ним). Стиль — как у
                                         обычных подсказок (светлый фон + серая рамка). -->
                                    <Border x:Name="FontBadgeBorder"
                                            Background="{DynamicResource ToolTipBackground}"
                                            BorderBrush="{StaticResource BrushSeparator}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            BoxShadow="0 2 8 0 #1A000000">
                                        <TextBlock x:Name="FontValueText" Text="12"
                                                   Foreground="{DynamicResource ToolTipForeground}"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </Grid>
                    </Border>

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ── Управление базой данных ───────────────────────── -->
            <ScrollViewer x:Name="DatabasePanel" IsVisible="False"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1400" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="16,16,16,32" Spacing="16">

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                        <Button x:Name="CreateDatabaseBtn"
                                Content="Создать базу данных"
                                Click="OnCreateDatabaseClick" />
                        <Button x:Name="ConnectDatabaseBtn"
                                Content="Подключить существующую"
                                Click="OnConnectDatabaseClick" />
                    </StackPanel>

                    <ItemsControl x:Name="DatabaseList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DatabaseRow">
                                <Border Classes="settingRow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="3"
                                                    VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Name}"
 />
                                            <TextBlock Text="{Binding Path}"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       Foreground="{StaticResource BrushSecondaryText}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <!-- Файл недоступен / не смонтирована -->
                                            <TextBlock Text="Не подключена (файл недоступен)"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       Foreground="{StaticResource BrushRed}"
                                                       IsVisible="{Binding ShowNotMounted}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    Spacing="8" VerticalAlignment="Center">

                                            <!-- Дефолтная БД: метка -->
                                            <TextBlock Text="По умолчанию"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       Foreground="{StaticResource BrushSecondaryText}"
                                                       IsVisible="{Binding ShowDefaultBadge}" />

                                            <!-- Недоступна → попытка переподключения -->
                                            <Button Content="Подключить заново"
                                                    Tag="{Binding Id}"
                                                    Click="OnReconnectDatabaseClick"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding ShowNotMounted}" />

                                            <!-- Удалить из реестра (файл не удаляется) -->
                                            <Button Classes="icon"
                                                    Width="28" Height="28"
                                                    Tag="{Binding Id}"
                                                    Click="OnRemoveDatabaseClick"
                                                    ToolTip.Tip="Отключить (файл не удаляется)"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding ShowDeleteButton}">
                                                <Viewbox Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}">
                                                    <Canvas Width="24" Height="24">
                                                        <!-- trash -->
                                                        <Path Data="{StaticResource IconTrash}"
                                                              Stroke="{Binding $parent[Button].Foreground}"
                                                              StrokeThickness="1.6"
                                                              StrokeLineCap="Round" StrokeJoin="Round" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ── О программе ───────────────────────────────────── -->
            <ScrollViewer x:Name="AboutPanel" IsVisible="False"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1400" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="16,16,16,32" Spacing="6">
                    <TextBlock Text="DataBase"
                               FontSize="{DynamicResource FontSizeLarge}"
                               FontWeight="{StaticResource FontWeightBold}"
 />
                    <TextBlock x:Name="VersionText"
                               Text="Версия 1.0.0"
                               Foreground="{StaticResource BrushSecondaryText}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

        </Grid>

    </DockPanel>

</UserControl>
