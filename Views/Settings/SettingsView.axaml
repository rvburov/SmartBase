<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartBase.Views.Settings"
             xmlns:comp="using:SmartBase.Controls.Components"
             xmlns:w="using:SmartBase.Controls.Widgets"
             xmlns:grid="using:SmartBase.Controls.DrawnGrid"
             x:Class="SmartBase.Views.Settings.SettingsView"
             Background="{StaticResource BrushBg}">

    <UserControl.Resources>
        <ResourceDictionary>
        <!-- Ползунок-«таблетка»: белый прямоугольник со скруглением и мягкой тенью. -->
        <ControlTheme x:Key="SettingSliderThumb" TargetType="Thumb">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border CornerRadius="9"
                            Background="White"
                            BorderBrush="{StaticResource BrushSeparator}"
                            BorderThickness="{DynamicResource BorderLine}"
                            BoxShadow="0 1 3 0 #22000000" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!-- Половинки дорожки — прозрачные, чтобы под ними была видна единая линия. -->
        <ControlTheme x:Key="SettingSliderTrackButton" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Слайдер настроек: тонкая дорожка + ползунок-«таблетка» (как в Obsidian). -->
        <Style Selector="Slider.setting">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Height"   Value="24" />
            <Setter Property="Minimum"  Value="0" />
            <Setter Property="Maximum"  Value="100" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" VerticalAlignment="Center">
                        <Grid VerticalAlignment="Center">
                            <!-- единая дорожка -->
                            <Border Height="4" CornerRadius="2"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource BrushSeparator}" />
                            <Track Name="PART_Track" Orientation="Horizontal"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value, Mode=TwoWay}">
                                <Track.DecreaseButton>
                                    <RepeatButton Name="PART_DecreaseButton"
                                                  Theme="{StaticResource SettingSliderTrackButton}" />
                                </Track.DecreaseButton>
                                <Track.IncreaseButton>
                                    <RepeatButton Name="PART_IncreaseButton"
                                                  Theme="{StaticResource SettingSliderTrackButton}" />
                                </Track.IncreaseButton>
                                <Track.Thumb>
                                    <Thumb Width="26" Height="18"
                                           Theme="{StaticResource SettingSliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Строка настройки, ячейка с данными и строка таблицы — общие
             (Assets/Styles/SettingRows.axaml): те же строки показывает панель
             администратора, и вторая копия стилей разошлась бы с первой. -->

        <!-- Пункт панели «Содержание» (раздел «Инструкция пользователя»). Подсветка во всю
             ширину без скруглений, как строка сайдбара (SidebarList.axaml): панель — та же
             навигация, только внутри раздела. Строки строятся в code-behind (SettingsGuide). -->
        <Style Selector="Border.tocrow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor"     Value="Hand" />
        </Style>
        <Style Selector="Border.tocrow:pointerover">
            <Setter Property="Background" Value="{StaticResource BrushSecondaryBg}" />
        </Style>
        <Style Selector="Border.tocrow.selected, Border.tocrow.selected:pointerover">
            <Setter Property="Background" Value="{StaticResource BrushAccentLight}" />
        </Style>
        <Style Selector="Border.tocrow TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushPrimaryText}" />
        </Style>
        <Style Selector="Border.tocrow.sub TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushSecondaryText}" />
        </Style>
        <Style Selector="Border.tocrow.selected TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
        </Style>

        <!-- Карточки полей панели деталей — общий стиль Border.detailRow
             (Assets/Styles/Controls.axaml): тот же вид в «Истории изменений». -->
    </UserControl.Styles>

    <!-- В разделе «Диагностика» деталь строки открывается отдельной панелью во всю
         высоту справа (Column 2) — ее навбар «Детали» встает вровень с навбаром настроек
         (как навбар записи рядом с навбаром таблицы в конструкторе). Прочие разделы
         занимают всю ширину (Column 0). -->
    <Grid ColumnDefinitions="*,Auto,Auto">

    <DockPanel Grid.Column="0">

        <!-- Шапка раздела (вынесена в компонент-навбар). -->
        <comp:NavbarSettings DockPanel.Dock="Top" x:Name="HeaderBar" />

        <!-- Содержимое выбранного раздела -->
        <Grid>

            <!-- ── Общее ─────────────────────────────────────────── -->
            <ScrollViewer x:Name="GeneralPanel"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Во всю ширину окна: содержимое раздела заканчивается там же,
                             где заголовок и линия под ним. Прежний потолок в 1400 оставлял
                             на широком экране пустую полосу справа, и строки настроек
                             обрывались, не доходя до края. -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="16,0,16,32">

                    <!-- Уведомления: системные баннеры о событиях календаря + значок на иконке -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Уведомления календаря" />
                                <TextBlock Classes="desc"
                                           Text="Всплывающее уведомление о событии календаря появляется в момент начала события (по указанным дате и времени); на значке программы отображается число уведомлений." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="NotificationsToggle"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="OnNotificationsToggled" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Уведомления по задачам: назначение исполнителя -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Уведомления задачи «Исполнитель»" />
                                <TextBlock Classes="desc"
                                           Text="Всплывающее уведомление приходит, когда вас назначают исполнителем задачи: в разделе «Задачи», в таблице конструктора, на странице записи и в календаре. Задача, назначенная себе, уведомление не присылает." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="TaskAssignedToggle"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="OnTaskAssignedToggled" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Уведомления по задачам: смена стадии -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Уведомления задачи «Смена стадии»" />
                                <TextBlock Classes="desc"
                                           Text="Всплывающее уведомление о переходе задачи между стадиями («Запланировано», «В работе», «Выполнено» и обратно). Приходит тому, кто указан в свойстве «Назначил»." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="TaskStatusToggle"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="OnTaskStatusToggled" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Уведомления о резервных копиях" />
                                <TextBlock Classes="desc"
                                           Text="Всплывающее уведомление об успешном завершении или ошибке резервного копирования. Нажатие открывает настройки резервных копий." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="BackupNotificationsToggle"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="OnBackupNotificationsToggled" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Автозапуск при входе в систему -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Автозапуск при входе в систему" />
                                <TextBlock Classes="desc"
                                           Text="Запускать программу автоматически при входе в систему, чтобы напоминания приходили без ручного запуска. Доступно в установленном приложении." />
                                <!-- Видна, только когда запись автозагрузки отключена средствами
                                     системы (Диспетчер задач): тумблер включен, а старта нет. -->
                                <TextBlock x:Name="AutostartHint" Classes="desc" IsVisible="False" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="AutostartToggle"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="OnAutostartToggled" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Фоновый режим -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Фоновый режим" />
                                <TextBlock Classes="desc"
                                           Text="При закрытии окна программа не завершается, а сворачивается в значок в системной области и продолжает работать в фоне — уведомления календаря приходят даже с закрытым окном. Открыть окно снова — по значку, завершить программу — пункт «Выход»." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="BackgroundToggle"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="OnBackgroundToggled" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ── Оформление ────────────────────────────────────── -->
            <ScrollViewer x:Name="AppearancePanel" IsVisible="False"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Во всю ширину окна: содержимое раздела заканчивается там же,
                             где заголовок и линия под ним. Прежний потолок в 1400 оставлял
                             на широком экране пустую полосу справа, и строки настроек
                             обрывались, не доходя до края. -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="16,0,16,32">

                    <!-- ── Что открывается по умолчанию ────────────────────────
                         Пункты этих списков в разметке НЕ перечислены: их наполняет
                         code-behind из ViewCatalog, причем только видимыми — вид, скрытый
                         соседней настройкой, не должен предлагаться как стартовый. -->

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Отображение по умолчанию раздела навигации" />
                                <TextBlock Classes="desc"
                                           Text="Какой раздел панели навигации (слева) открывается при запуске программы." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="StartupModuleCombo"
                                      Width="240" Height="{StaticResource ControlHeightStandard}"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Строки календаря, задач и конструктора (стартовый вид, видимость видов)
                         переехали в свои разделы — CalendarPanel, TasksPanel и ConstructorPanel
                         ниже; механизм InitAppearance общий. -->

                    <!-- ── Что вообще показывать ───────────────────────────────
                         Галочки убирают лишние виды и разделы с глаз. Последнюю снять
                         нельзя — раздел без единого вида неработоспособен; правило держит
                         сам виджет (см. CheckListDropdown). -->

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Отображение раздела навигации" />
                                <TextBlock Classes="desc"
                                           Text="Какие разделы показывать в панели навигации слева. «Настройки» и «Профиль» скрыть нельзя." />
                            </StackPanel>
                            <w:CheckListDropdown Grid.Column="1" x:Name="NavigationVisibility"
                                                 Width="240" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Уровень масштабирования -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Уровень масштабирования" />
                                <TextBlock Classes="desc"
                                           Text="Общий масштаб интерфейса. Диапазон 70…130 %, шаг 10 %; кнопка-стрелка возвращает 100 %." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        Spacing="14" VerticalAlignment="Center">
                                <Button Classes="icon" Width="24" Height="24"
                                        x:Name="ScaleResetBtn" Click="OnScaleReset"
                                        ToolTip.Tip="Сбросить">
                                    <Viewbox Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}">
                                        <Canvas Width="24" Height="24">
                                            <!-- rotate-ccw -->
                                            <Path Data="{StaticResource IconRotateCcw}"
                                                  Stroke="{Binding $parent[Button].Foreground}"
                                                  StrokeThickness="{StaticResource IconStrokeSmall}"
                                                  StrokeLineCap="Round" StrokeJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Slider Classes="setting" Width="200"
                                        x:Name="ScaleSlider"
                                        Minimum="70" Maximum="130"
                                        TickFrequency="10" IsSnapToTickEnabled="True"
                                        SmallChange="10" LargeChange="10"
                                        ValueChanged="OnScaleChanged"
                                        PointerEntered="OnScaleSliderEntered"
                                        PointerMoved="OnScaleSliderMoved"
                                        PointerExited="OnScaleSliderExited" />

                                <!-- Пузырек со значением над ползунком: текущий масштаб в процентах. -->
                                <Popup x:Name="ScaleValuePopup" InheritsTransform="True"
                                       PlacementTarget="{Binding #ScaleSlider}"
                                       Placement="Top" VerticalOffset="-6"
                                       IsLightDismissEnabled="False">
                                    <Border Background="{DynamicResource ToolTipBackground}"
                                            BorderBrush="{StaticResource BrushSeparator}"
                                            BorderThickness="{DynamicResource BorderLine}"
                                            CornerRadius="{StaticResource RadiusXS}"
                                            Padding="8,4"
                                            BoxShadow="0 2 8 0 #1A000000">
                                        <TextBlock x:Name="ScaleValueText" Text="100 %"
                                                   Foreground="{DynamicResource ToolTipForeground}"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Размер шрифта -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Размер шрифта" />
                                <TextBlock Classes="desc"
                                           Text="Общий размер текста интерфейса. Диапазон −3…+3 пикселя от стандарта; кнопка-стрелка возвращает стандарт." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        Spacing="14" VerticalAlignment="Center">
                                <Button Classes="icon" Width="24" Height="24"
                                        x:Name="FontResetBtn" Click="OnFontSizeReset"
                                        ToolTip.Tip="Сбросить">
                                    <Viewbox Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}">
                                        <Canvas Width="24" Height="24">
                                            <!-- rotate-ccw -->
                                            <Path Data="{StaticResource IconRotateCcw}"
                                                  Stroke="{Binding $parent[Button].Foreground}"
                                                  StrokeThickness="{StaticResource IconStrokeSmall}"
                                                  StrokeLineCap="Round" StrokeJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Slider Classes="setting" Width="200"
                                        x:Name="FontSizeSlider"
                                        Minimum="-3" Maximum="3"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        SmallChange="1" LargeChange="1"
                                        ValueChanged="OnFontSizeChanged"
                                        PointerEntered="OnFontSliderEntered"
                                        PointerMoved="OnFontSliderMoved"
                                        PointerExited="OnFontSliderExited" />

                                <!-- Пузырек со значением над ползунком: показывает итоговый
                                     базовый размер текста (стандарт ± дельта). -->
                                <Popup x:Name="FontValuePopup" InheritsTransform="True"
                                       PlacementTarget="{Binding #FontSizeSlider}"
                                       Placement="Top" VerticalOffset="-6"
                                       IsLightDismissEnabled="False">
                                    <!-- Плашка-индикатор постоянного размера (как пузырек масштаба):
                                         меняется только число. Размер текста пришпилен StaticResource —
                                         иначе плашка росла бы вместе с примененным размером шрифта. -->
                                    <Border x:Name="FontBadgeBorder"
                                            Background="{DynamicResource ToolTipBackground}"
                                            BorderBrush="{StaticResource BrushSeparator}"
                                            BorderThickness="{DynamicResource BorderLine}"
                                            CornerRadius="{StaticResource RadiusXS}"
                                            Padding="8,4"
                                            BoxShadow="0 2 8 0 #1A000000">
                                        <TextBlock x:Name="FontValueText" Text="12"
                                                   FontSize="{StaticResource FontSizeBase}"
                                                   Foreground="{DynamicResource ToolTipForeground}"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ── Управление базой данных ───────────────────────── -->
            <ScrollViewer x:Name="DatabasePanel" IsVisible="False"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Во всю ширину окна: содержимое раздела заканчивается там же,
                             где заголовок и линия под ним. Прежний потолок в 1400 оставлял
                             на широком экране пустую полосу справа, и строки настроек
                             обрывались, не доходя до края. -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Отступ сверху — как в «Оформлении»: его дает Padding самих
                         settingRow-строк, у StackPanel верхнего отступа нет. -->
                    <StackPanel Margin="16,0,16,32">

                    <!-- Добавление БД — кнопка «Добавить базу данных» с меню в навбаре
                         (NavbarSettings, видна только в этом разделе): здесь только список. -->
                    <ItemsControl x:Name="DatabaseList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DatabaseRow">
                                <StackPanel>
                                <Border Classes="settingRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Viewbox Width="{StaticResource IconSizeMedium}"
                                                 Height="{StaticResource IconSizeMedium}"
                                                 Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource IconDatabase}"
                                                      IsVisible="{Binding !IsPostgres}"
                                                      Stroke="{StaticResource BrushSecondaryText}"
                                                      StrokeThickness="{StaticResource IconStrokeMedium}"
                                                      StrokeLineCap="Round" StrokeJoin="Round" />
                                                <Path Data="{StaticResource IconServer}"
                                                      IsVisible="{Binding IsPostgres}"
                                                      Stroke="{StaticResource BrushSecondaryText}"
                                                      StrokeThickness="{StaticResource IconStrokeMedium}"
                                                      StrokeLineCap="Round" StrokeJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel Grid.Column="1" Spacing="3"
                                                    VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Name}"
 />
                                            <TextBlock Text="{Binding Path}"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       Foreground="{StaticResource BrushSecondaryText}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <!-- Статус: очередь фонового монтирования (серым,
                                                 «в очереди…» / «Обновление · 45% · ≈ 2 мин»)
                                                 либо недоступна (красным) -->
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       Foreground="{Binding StatusBrush}"
                                                       IsVisible="{Binding ShowStatus}" />
                                            <!-- Сведения о файле смонтированной SQLite-базы: размер и
                                                 свободные (не возвращенные после удалений) страницы;
                                                 красным — когда их больше порога и файл стоит сжать -->
                                            <TextBlock Text="{Binding StorageText}"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       Foreground="{Binding StorageBrush}"
                                                       IsVisible="{Binding ShowStorage}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    Spacing="8" VerticalAlignment="Center">

                                            <!-- Чем база хранится, и не она ли по умолчанию:
                                                 «SQLite», «PostgreSQL», «SQLite (По умолчанию)».
                                                 Метка стоит у КАЖДОЙ строки — без нее строка
                                                 SQLite рядом с помеченной PostgreSQL читается
                                                 как недоделанная -->
                                            <TextBlock Text="{Binding EngineBadge}"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       Foreground="{StaticResource BrushSecondaryText}" />

                                            <!-- Недоступна → попытка переподключения (ждущим
                                                 в очереди кнопка не нужна — подключатся сами) -->
                                            <Button Content="Подключить заново"
                                                    Tag="{Binding Id}"
                                                    Click="OnReconnectDatabaseClick"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding ShowReconnect}" />

                                            <Button Classes="dialog auto"
                                                    Content="Проверить связи"
                                                    Tag="{Binding Id}"
                                                    Click="OnRelationIntegrityClick"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding IsMounted}" />

                                            <!-- Настройки базы: имя, файл/сервер, пароль —
                                                 действия строки переехали в это окно (копия —
                                                 в разделе «Резервное копирование») -->
                                            <Button Classes="icon"
                                                    Width="28" Height="28"
                                                    Tag="{Binding Id}"
                                                    Click="OnDbSettingsClick"
                                                    ToolTip.Tip="Настройки базы данных"
                                                    VerticalAlignment="Center">
                                                <Viewbox Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}">
                                                    <Canvas Width="24" Height="24">
                                                        <!-- lucide settings -->
                                                        <Path Data="{StaticResource IconSettings}"
                                                              Stroke="{Binding $parent[Button].Foreground}"
                                                              StrokeThickness="{StaticResource IconStrokeSmall}"
                                                              StrokeLineCap="Round" StrokeJoin="Round" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>

                                            <!-- Удалить из реестра (файл не удаляется) -->
                                            <Button Classes="icon red"
                                                    Width="28" Height="28"
                                                    Tag="{Binding Id}"
                                                    Click="OnRemoveDatabaseClick"
                                                    ToolTip.Tip="Отключить (файл не удаляется)"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding ShowDeleteButton}">
                                                <Viewbox Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}">
                                                    <Canvas Width="24" Height="24">
                                                        <!-- trash -->
                                                        <Path Data="{StaticResource IconTrash}"
                                                              Stroke="{Binding $parent[Button].Foreground}"
                                                              StrokeThickness="{StaticResource IconStrokeSmall}"
                                                              StrokeLineCap="Round" StrokeJoin="Round" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Classes="separator h" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ── Резервное копирование ─────────────────────────── -->
            <!-- Общие настройки (папка, глубина ротации) — статикой здесь; список баз с
                 расписаниями строится в code-behind (SettingsBackupPanel.RefreshBackupList):
                 состав редакторов строки зависит от периодичности, разметке его не описать. -->
            <ScrollViewer x:Name="BackupPanel" IsVisible="False"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="16,0,16,32">

                    <!-- Папка, куда складываются копии всех баз -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Папка резервных копий" />
                                <TextBlock Classes="desc"
                                           Text="Сюда складываются копии всех баз данных. Стандарт — папка Backups в папке данных программы." />
                                <TextBlock x:Name="BackupFolderText" Classes="desc" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        Spacing="8" VerticalAlignment="Center">
                                <!-- «Сбросить» видна только при выбранной своей папке -->
                                <Button x:Name="BackupFolderResetBtn"
                                        Classes="dialog" Content="Сбросить"
                                        VerticalAlignment="Center"
                                        Click="OnBackupFolderResetClick" />
                                <Button Classes="dialog" Content="Выбрать…"
                                        VerticalAlignment="Center"
                                        Click="OnBackupFolderPickClick" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Глубина ротации: старые копии сверх лимита удаляются автоматически -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Хранить последних копий" />
                                <TextBlock Classes="desc"
                                           Text="Сколько копий каждой базы держать в папке: более старые удаляются автоматически после успешного копирования." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="BackupKeepCombo"
                                      Width="90"
                                      VerticalAlignment="Center"
                                      SelectionChanged="OnBackupKeepChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Базы с расписаниями: строки строит code-behind -->
                    <StackPanel x:Name="BackupList" />

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ── Календарь ─────────────────────────────────────── -->
            <!-- Все настройки раздела «Календарь» в одном месте: строки стартового вида и
                 видимости видов переехали из «Оформления» (контролы те же, проводка —
                 общий InitAppearance), остальное наполняет SettingsCalendarPanel. -->
            <ScrollViewer x:Name="CalendarPanel" IsVisible="False"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="16,0,16,32">

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Отображение по умолчанию" />
                                <TextBlock Classes="desc"
                                           Text="Какой вид календаря открывается при переходе в раздел." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="CalendarViewCombo"
                                      Width="240" Height="{StaticResource ControlHeightStandard}"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Отображаемые виды" />
                                <TextBlock Classes="desc"
                                           Text="Какие виды календаря показывать в переключателе навбара." />
                            </StackPanel>
                            <w:CheckListDropdown Grid.Column="1" x:Name="CalendarVisibility"
                                                 Width="240" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Только коллекции с датами в календаре" />
                                <TextBlock Classes="desc"
                                           Text="Боковая панель показывает только коллекции, у которых включено хотя бы одно свойство-дата. Базы без таких коллекций скрыты. Выключено — видны все базы и коллекции." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="CalendarSidebarOnlyToggle"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="OnCalendarSidebarOnlyToggled" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Дней в неделе" />
                                <TextBlock Classes="desc"
                                           Text="7 — обычная неделя. 5 — рабочая: «Расписание», «День» и «Неделя» листают только Пн–Пт, новые события не попадают на выходные, а перетягивание и растягивание перепрыгивает их во всех видах." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="CalendarDaysCombo"
                                      Width="240" Height="{StaticResource ControlHeightStandard}"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}"
                                      SelectionChanged="OnCalendarDaysChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="День начинается в" />
                                <TextBlock Classes="desc"
                                           Text="Начало рабочих часов: перетягивание, растягивание и создание событий укладываются в период от начала до конца дня. Шкала часов при этом показывается целиком, события вне периода остаются на своих местах." />
                            </StackPanel>
                            <w:TimeField Grid.Column="1" x:Name="CalendarDayStartField"
                                         Width="96" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="День заканчивается в" />
                                <TextBlock Classes="desc"
                                           Text="Конец рабочих часов: растягивание события за эту границу продолжается с начала следующего дня. 00:00 в обоих полях — без ограничений." />
                            </StackPanel>
                            <w:TimeField Grid.Column="1" x:Name="CalendarDayEndField"
                                         Width="96" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Длинные события в сетке" />
                                <TextBlock Classes="desc"
                                           Text="Событие длиннее 24 часов остается в часовой сетке блоками по дням, а растягивание и перетягивание работают через несколько дней. Стандартно (выключено) такое событие уходит в полосу «весь день» — независимо от того, растянули его мышью или ввели время вручную." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="CalendarMultiDayToggle"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="OnCalendarMultiDayToggled" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Прокрутка в неделе" />
                                <TextBlock Classes="desc"
                                           Text="Как листает вид «Неделя»: по целой неделе, по одному дню или по неделе с остановкой на «Сегодня» — сегодняшний день встает посередине." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="CalendarWeekScrollCombo"
                                      Width="240" Height="{StaticResource ControlHeightStandard}"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}"
                                      SelectionChanged="OnCalendarWeekScrollChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Длительность нового события" />
                                <TextBlock Classes="desc"
                                           Text="Сколько длится событие, созданное из сетки календаря, пока длительность не поменяли вручную." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="CalendarDurationCombo"
                                      Width="240" Height="{StaticResource ControlHeightStandard}"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}"
                                      SelectionChanged="OnCalendarDurationChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ── Задачи ────────────────────────────────────────── -->
            <!-- Раздел «Задачи»: стартовый вид и видимость видов (контролы те же, что были в
                 «Оформлении», механизм InitAppearance общий), остальное наполняет
                 SettingsTasksPanel и пишет в живой сервис TaskSettings — раздел перечитывается
                 сразу. Тумблеры уведомлений по задачам остаются в «Общее». -->
            <ScrollViewer x:Name="TasksPanel" IsVisible="False"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="16,0,16,32">

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Отображение по умолчанию" />
                                <TextBlock Classes="desc"
                                           Text="Какой вид открывается при переходе в раздел «Задачи»." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="TasksViewCombo"
                                      Width="240" Height="{StaticResource ControlHeightStandard}"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Отображаемые виды" />
                                <TextBlock Classes="desc"
                                           Text="Какие виды задач показывать в переключателе навбара. Пока вид один — Список." />
                            </StackPanel>
                            <w:CheckListDropdown Grid.Column="1" x:Name="TasksVisibility"
                                                 Width="240" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Только коллекции с исполнителем" />
                                <TextBlock Classes="desc"
                                           Text="Боковая панель показывает только коллекции, у которых выбрано свойство-исполнитель. Базы без таких коллекций скрыты. Выключено — видны все базы и коллекции." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="TasksSidebarOnlyToggle"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="OnTasksSidebarOnlyToggled" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Фильтр при открытии раздела" />
                                <TextBlock Classes="desc"
                                           Text="Какой быстрый фильтр стоит при входе в раздел. «Последний выбранный» — тот, на котором раздел оставили в прошлый раз, в том числе стадия." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="TasksStartFilterCombo"
                                      Width="240" Height="{StaticResource ControlHeightStandard}"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}"
                                      SelectionChanged="OnTasksStartFilterChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Показывать выполненные" />
                                <TextBlock Classes="desc"
                                           Text="Выполненные задачи видны во всех фильтрах. Выключено — они остаются только в стадии «Выполнено» списка фильтров, а в заголовке коллекции по-прежнему считаются." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="TasksShowDoneToggle"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="OnTasksShowDoneToggled" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Момент просрочки" />
                                <TextBlock Classes="desc"
                                           Text="«С момента срока» — задача на 10:00 просрочена уже в 10:01. «Со следующего дня» — просрочена, только когда день срока прошел; до конца дня карточка показывает «Сегодня». Влияет на чип карточки и фильтр «Просрочено»." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="TasksOverdueCombo"
                                      Width="240" Height="{StaticResource ControlHeightStandard}"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}"
                                      SelectionChanged="OnTasksOverdueChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Стадия новой задачи" />
                                <TextBlock Classes="desc"
                                           Text="Какую стадию получает задача при быстром добавлении и в окне задачи. В списке — стадии всех подключенных баз; если у коллекции такой стадии нет, берется первая из ее списка." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="TasksDefaultStageCombo"
                                      Width="240" Height="{StaticResource ControlHeightStandard}"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}"
                                      SelectionChanged="OnTasksDefaultStageChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Исполнитель в быстром добавлении" />
                                <TextBlock Classes="desc"
                                           Text="Кто стоит исполнителем в строке быстрого добавления: вы или никто. «Не назначен» — задача заводится нераспределенной, раздать ее можно потом; выбор в строке всегда можно поменять перед добавлением." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="TasksQuickExecutorCombo"
                                      Width="240" Height="{StaticResource ControlHeightStandard}"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}"
                                      SelectionChanged="OnTasksQuickExecutorChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Срок в быстром добавлении" />
                                <TextBlock Classes="desc"
                                           Text="Какая дата подставляется в строку быстрого добавления: без срока, сегодня или завтра. Подставляется при открытии раздела и после каждого добавления; дату всегда можно поменять перед добавлением." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="TasksQuickDueCombo"
                                      Width="240" Height="{StaticResource ControlHeightStandard}"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}"
                                      SelectionChanged="OnTasksQuickDueChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ── Библиотека документов ─────────────────────────── -->
            <!-- Раздел «Библиотека документов»: стартовый вид и видимость видов (механизм
                 InitAppearance общий), остальное наполняет SettingsLibraryPanel и пишет в живой
                 сервис LibrarySettings — раздел перечитывается сразу. -->
            <ScrollViewer x:Name="LibraryPanel" IsVisible="False"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="16,0,16,32">

                    <!-- Блок видов — такой же, как у календаря, задач и конструктора: раздел не
                         должен отличаться от соседей набором настроек. Переключателя вида в
                         навбаре у библиотеки при этом нет: вид один, и выпадашка на один пункт
                         в рабочей полосе — орган управления, который ничем не управляет.
                         Появится второй вид — вернется и переключатель. -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Отображение по умолчанию" />
                                <TextBlock Classes="desc"
                                           Text="Какой вид открывается при переходе в раздел «Библиотека документов»." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="LibraryViewCombo"
                                      Width="240" Height="{StaticResource ControlHeightStandard}"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Отображаемые виды" />
                                <TextBlock Classes="desc"
                                           Text="Какие виды библиотеки показывать в переключателе навбара. Пока вид один — Список." />
                            </StackPanel>
                            <w:CheckListDropdown Grid.Column="1" x:Name="LibraryVisibility"
                                                 Width="240" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Только подключенные коллекции" />
                                <TextBlock Classes="desc"
                                           Text="Боковая панель показывает только коллекции, у которых включено свойство типа «Файл». Базы без таких коллекций скрыты. Выключено — видны все базы и коллекции." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="LibrarySidebarOnlyToggle"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="OnLibrarySidebarOnlyToggled" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Изображение документа" />
                                <TextBlock Classes="desc"
                                           Text="Показывать шапку первой страницы PDF на плитке карточки. Выключено — плитка целиком в цвете формата, с названием посередине. Картинки рисуются в фоне и хранятся отдельным кешем на диске." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="LibraryThumbsToggle"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="OnLibraryThumbsToggled" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Размер карточки" />
                                <TextBlock Classes="desc"
                                           Text="Высота строки в ленте и размер изображения документа. Заодно решает, сколько строк найденного текста видно при поиске: маленькая — одну, средняя — три, большая — шесть." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="LibraryCardSizeCombo"
                                      Width="240" Height="{StaticResource ControlHeightStandard}"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}"
                                      SelectionChanged="OnLibraryCardSizeChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Тумблера «Индексировать текст документов» здесь БОЛЬШЕ НЕТ. Чтение
                         запускает человек кнопкой в самом разделе: настройка, включающая
                         многочасовую фоновую работу, — это та же неожиданная нагрузка, только
                         спрятанная. Что именно читается и что найти не получится — написано
                         в строке «Кеш документов» ниже. -->

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Не читать файлы тяжелее" />
                                <TextBlock Classes="desc"
                                           Text="Порог размера документа для чтения текста. Тяжелые файлы читаются долго и в поиске нужны редко." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="LibraryIndexMaxCombo"
                                      Width="240" Height="{StaticResource ControlHeightStandard}"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}"
                                      SelectionChanged="OnLibraryIndexMaxChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Кеш документов" />
                                <TextBlock Classes="desc" x:Name="LibraryCacheDesc" />
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="LibraryClearCacheBtn"
                                    Content="Очистить"
                                    Width="240" Height="{StaticResource ControlHeightStandard}"
                                    VerticalAlignment="Center"
                                    Click="OnLibraryClearCacheClick" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ── Конструктор базы данных ───────────────────────── -->
            <!-- Раздел «Конструктор базы данных»: стартовый вид и видимость видов (контролы те
                 же, что были в «Оформлении», механизм InitAppearance общий), остальное наполняет
                 SettingsConstructorPanel и пишет в живой сервис ConstructorSettings — таблица и
                 панель записи перечитываются сразу. Строки идут группами: сначала виды, потом
                 создание и удаление, затем таблица, панель записи и память. -->
            <ScrollViewer x:Name="ConstructorPanel" IsVisible="False"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="16,0,16,32">

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Отображение по умолчанию" />
                                <TextBlock Classes="desc"
                                           Text="Какой вид коллекции открывается в конструкторе базы данных. Если у коллекции выбран свой вид, он сохраняется за ней." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="ConstructorViewCombo"
                                      Width="240" Height="{StaticResource ControlHeightStandard}"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Отображаемые виды" />
                                <TextBlock Classes="desc"
                                           Text="Какие виды коллекции показывать в переключателе навбара." />
                            </StackPanel>
                            <w:CheckListDropdown Grid.Column="1" x:Name="ConstructorVisibility"
                                                 Width="240" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Тип нового свойства" />
                                <TextBlock Classes="desc"
                                           Text="Какой тип стоит в окне «Создание свойства». Типы «Связь» и «Пользователь» и вычисляемые типы стандартными не бывают: им нужна цель или готовые данные записи, поэтому в списке их нет." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="ConstructorNewFieldTypeCombo"
                                      Width="240" Height="{StaticResource ControlHeightStandard}"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}"
                                      SelectionChanged="OnConstructorNewFieldTypeChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Открывать новую запись" />
                                <TextBlock Classes="desc"
                                           Text="Созданная запись сразу открывается в панели справа. Выключено — запись появляется в таблице, а панель не выезжает: так удобно заводить строки подряд." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="ConstructorOpenNewRecordToggle"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="OnConstructorOpenNewRecordToggled" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Спрашивать подтверждение при удалении" />
                                <TextBlock Classes="desc"
                                           Text="Вопрос перед удалением записей и столбцов. Выключено — удаление происходит сразу, но предупреждение о том, что удаление оборвет связи или снимет роль раздела, остается: это про потерю данных, а не про рутину." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="ConstructorConfirmDeleteToggle"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="OnConstructorConfirmDeleteToggled" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Цвет новой коллекции" />
                                <TextBlock Classes="desc"
                                           Text="Каким цветом помечается коллекция, созданная в конструкторе. Цвет каждой коллекции всегда можно поменять в ее меню." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="ConstructorColorCombo"
                                      Width="240" Height="{StaticResource ControlHeightStandard}"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}"
                                      SelectionChanged="OnConstructorColorChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Плотность строк таблицы" />
                                <TextBlock Classes="desc"
                                           Text="Высота строки таблицы и дерева коллекций в панели слева — они выровнены друг с другом и меняются вместе, в том числе в «Календаре» и «Задачах» (дерево там то же самое). Своя высота строки, заданная перетягиванием, сохраняется за коллекцией." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="ConstructorRowHeightCombo"
                                      Width="240" Height="{StaticResource ControlHeightStandard}"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}"
                                      SelectionChanged="OnConstructorRowHeightChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Стандартная ширина столбца" />
                                <TextBlock Classes="desc"
                                           Text="Ширина столбца, которому ее еще не задавали вручную. Она же — предел, ниже которого столбцы не сжимаются сами при нехватке места; вручную столбец по-прежнему можно сузить сильнее." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="ConstructorColWidthCombo"
                                      Width="240" Height="{StaticResource ControlHeightStandard}"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}"
                                      SelectionChanged="OnConstructorColWidthChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Ручная ширина столбцов" />
                                <TextBlock Classes="desc"
                                           Text="Включено — границы столбцов можно тянуть мышью. Действует на коллекции, в которых этот режим не переключали вручную: у тех, где переключали, он хранится за коллекцией и сильнее настройки." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="ConstructorColResizeToggle"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="OnConstructorColResizeToggled" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Ручная высота строк" />
                                <TextBlock Classes="desc"
                                           Text="То же для высоты строк: включено — у нижней границы строки появляются полоски-захваты. Коллекции, где режим переключали вручную, живут по своему значению." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="ConstructorRowResizeToggle"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="OnConstructorRowResizeToggled" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Раскрывать ячейку при вводе" />
                                <TextBlock Classes="desc"
                                           Text="Включено — поле правки ячейки растет под набранный текст: вправо поверх соседних столбцов и вниз строками, и длинный текст виден целиком. Выключено — поле остается в границах ячейки." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="ConstructorExpandCellEditorToggle"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="OnConstructorExpandCellEditorToggled" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Досоздавать строки и столбцы при вставке" />
                                <TextBlock Classes="desc"
                                           Text="Включено — если вставленный блок не помещается в таблицу, недостающие записи добавляются в конец, а недостающие столбцы — текстовыми свойствами «Колонка 1», «Колонка 2». Выключено — все, что не поместилось, отбрасывается." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="ConstructorPasteGrowsTableToggle"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="OnConstructorPasteGrowsTableToggled" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Открывать запись" />
                                <TextBlock Classes="desc"
                                           Text="Клик по номеру строки (первый столбец «№») открывает запись в панели справа. «Двойным кликом» — одиночный клик только выделяет строку; так проще выделять и копировать, не открывая запись каждый раз." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="ConstructorOpenClickCombo"
                                      Width="240" Height="{StaticResource ControlHeightStandard}"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}"
                                      SelectionChanged="OnConstructorOpenClickChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Описание записи открывается" />
                                <TextBlock Classes="desc"
                                           Text="В каком виде показывать описание записи при открытии панели: в редакторе разметки или в готовом виде. Переключатель внизу панели работает как и раньше — настройка задает только начальное состояние." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="ConstructorDescriptionCombo"
                                      Width="240" Height="{StaticResource ControlHeightStandard}"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}"
                                      SelectionChanged="OnConstructorDescriptionChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Восстанавливать открытую запись при запуске" />
                                <TextBlock Classes="desc"
                                           Text="Программа откроется с той же записью в панели, на которой вы закончили. Если запись удалили или ее база отключена, панель просто останется закрытой." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="ConstructorRestoreRecordToggle"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="OnConstructorRestoreRecordToggled" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Запоминать раскладку панели записи" />
                                <TextBlock Classes="desc"
                                           Text="Высота блока свойств и ширина колонки названий переживут перезапуск. Выключено — панель каждый раз открывается в стандартной раскладке, а запомненная стирается." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="ConstructorRememberLayoutToggle"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="OnConstructorRememberLayoutToggled" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Запоминать фильтры и сортировку" />
                                <TextBlock Classes="desc"
                                           Text="Фильтры и сортировка столбцов сохраняются за коллекцией и возвращаются при следующем открытии. Выключено — коллекция всегда открывается полным списком в своем порядке." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="ConstructorRememberFiltersToggle"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="OnConstructorRememberFiltersToggled" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Проверка чужих изменений" />
                                <TextBlock Classes="desc"
                                           Text="Как часто программа спрашивает базу о правках других людей. Реже — меньше обращений к сетевой папке или серверу, но чужая правка появится на экране позже. Когда окно свернуто, период в пять раз больше." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="ConstructorPollCombo"
                                      Width="240" Height="{StaticResource ControlHeightStandard}"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}"
                                      SelectionChanged="OnConstructorPollChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ── Расширения ────────────────────────────────────── -->
            <!-- Содержимое собирается в code-behind (BuildExtensionsPanel) по
                 ExtensionRegistry.All и объявленным настройкам IExtension.Settings: здесь
                 только контейнеры. Разметка не знает ни одного расширения по имени — иначе
                 удаление расширения требовало бы правки этого файла. Строка видимости —
                 такая же, как «Отображение раздела …» в «Оформлении», но живет здесь:
                 она про состав раздела расширений, а не про виды. -->
            <ScrollViewer x:Name="ExtensionsPanel" IsVisible="False"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="16,0,16,32">

                        <StackPanel x:Name="ExtensionsVisibilityBlock">
                            <Border Classes="settingRow">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4"
                                                VerticalAlignment="Center" Margin="0,0,32,0">
                                        <TextBlock Classes="title" Text="Отображение раздела расширений" />
                                        <TextBlock Classes="desc"
                                                   Text="Какие расширения показывать. Снятые исчезают из списка раздела «Расширения» и из настроек ниже." />
                                    </StackPanel>
                                    <w:CheckListDropdown Grid.Column="1" x:Name="ExtensionsVisibility"
                                                         Width="240" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Classes="separator h" />
                        </StackPanel>

                        <StackPanel x:Name="ExtensionsSettingsList" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ── Интеграции ────────────────────────────────────── -->
            <!-- Раздел один, а внутри вкладки; переключатель между ними — выпадающий список
                 в навбаре, как виды календаря (docs/ROADMAP-API.md, раздел 4). Каждая
                 вкладка — своя панель ниже, содержимое собирает SettingsIntegrationsPanel. -->
            <ScrollViewer x:Name="IntegrationsPanel" IsVisible="False"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="16,0,16,32">

                        <!-- Соединения: куда и под кем ходим. Карточки правятся в своем окне,
                             здесь только список и действия — как у подключения баз данных. -->
                        <StackPanel x:Name="IntegrationsConnectionsTab" Spacing="0" />

                        <!-- Запросы: что дергаем. Заводятся руками или вставкой строки cURL. -->
                        <StackPanel x:Name="IntegrationsRequestsTab" Spacing="0" />

                        <!-- Потоки: что нам присылают. Соединение открываем мы, а говорит та
                             сторона; в строке — слушается ли поток сейчас и почему нет. -->
                        <StackPanel x:Name="IntegrationsStreamsTab" Spacing="0" />

                        <!-- Сценарии: что запускается само и когда. Тумблер прямо в строке —
                             выключить обмен нужно чаще, чем править его. -->
                        <StackPanel x:Name="IntegrationsScenariosTab" Spacing="0" />

                        <!-- Прием: папка, куда сторонняя программа кладет файлы. Единственный
                             канал без двери — он асинхронный, и файл дождется, пока приемник
                             включат (см. integrations/inbox.md). -->
                        <StackPanel x:Name="IntegrationsInboxTab" Spacing="0" />

                        <!-- Журнал: что уже происходило с обменом и почему кончилось так.
                             Первой строкой — расход по потолкам: считается он по этому же
                             журналу, и без него отказ шлюза нечем проверить. -->
                        <StackPanel x:Name="IntegrationsJournalTab" Spacing="0" />

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ── Заметки ───────────────────────────────────────── -->
            <!-- Сочетания клавиш: строки собираются кодом из реестра действий
                 (SettingsShortcutsPanel.cs) — список зависит от состава программы. -->
            <ScrollViewer x:Name="ShortcutsPanel" IsVisible="False"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ShortcutsList" Margin="16,0,16,32" />
            </ScrollViewer>

            <ScrollViewer x:Name="NotesPanel" IsVisible="False"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="16,0,16,32">

                        <!-- Папка-хранилище: до ее выбора раздел «Заметки» пуст и в диск не лезет. -->
                        <Border Classes="settingRow">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="title" Text="Папка хранилища" />
                                    <TextBlock Classes="desc"
                                               Text="Папка с файлами Markdown на этом компьютере. Раздел «Заметки» читает ее вместе со всеми вложенными папками и показывает деревом. Файлы остаются вашими: программа их не копирует и не переносит в базу данных." />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <!-- MinHeight=30 снимает дефолтную min-высоту Fluent (~32px),
                                         иначе поле выше кнопок рядом. Как у «Пути обновления». -->
                                    <TextBox x:Name="NotesVaultBox" Grid.Column="0"
                                             Height="{StaticResource ControlHeightStandard}" VerticalContentAlignment="Center"
                                             Margin="0,0,8,0"
                                             Background="{StaticResource BrushSecondaryBg}"
                                             CornerRadius="{StaticResource RadiusBase}"
                                             Watermark="Путь к папке с заметками"
                                             LostFocus="OnNotesVaultChanged" />
                                    <Button x:Name="NotesVaultBrowseBtn" Grid.Column="1"
                                            Classes="dialog" Content="Обзор…"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            Click="OnNotesVaultBrowse" />
                                    <Button x:Name="NotesVaultClearBtn" Grid.Column="2"
                                            Classes="dialog" Content="Отключить"
                                            VerticalAlignment="Center"
                                            Click="OnNotesVaultClear" />
                                </Grid>
                                <!-- Состояние пути: папка найдена или нет. Без этого человек
                                     видит пустое дерево и не понимает, дело в пути или в папке. -->
                                <TextBlock x:Name="NotesVaultStatus" Classes="desc"
                                           Text="" IsVisible="False" />
                            </StackPanel>
                        </Border>
                        <Border Classes="separator h" />

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ── О программе ───────────────────────────────────── -->
            <ScrollViewer x:Name="AboutPanel" IsVisible="False"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Во всю ширину окна: содержимое раздела заканчивается там же,
                             где заголовок и линия под ним. Прежний потолок в 1400 оставлял
                             на широком экране пустую полосу справа, и строки настроек
                             обрывались, не доходя до края. -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="16,16,16,32" Spacing="0">

                    <!-- Название, версия (со сборкой) и краткое описание -->
                    <StackPanel Spacing="6" Margin="0,0,0,8">
                        <TextBlock Text="SmartBase"
                                   FontSize="{DynamicResource FontSizeLarge}"
                                   FontWeight="{StaticResource FontWeightBold}" />
                        <TextBlock x:Name="VersionText"
                                   Text="Версия 1.0.0"
                                   Foreground="{StaticResource BrushSecondaryText}" />
                        <TextBlock Text="Локальная база данных с календарем и конструктором коллекций. Все данные хранятся на вашем устройстве — в локальных файлах базы данных."
                                   Foreground="{StaticResource BrushSecondaryText}"
                                   TextWrapping="Wrap" MaxWidth="640"
                                   HorizontalAlignment="Left" />
                    </StackPanel>

                    <!-- Обновления: путь к папке с новой версией + проверка.
                         Полное ТЗ — docs/guides/auto-update.md. -->
                    <Border Classes="settingRow">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="title" Text="Обновления" />
                                <TextBlock Classes="desc"
                                           Text="Путь к папке (можно сетевой), где лежит новая версия SmartBase.exe. Нажмите «Проверить» — программа сравнит версию файла в папке с текущей. По умолчанию путь не задан." />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <!-- MinHeight=30 снимает дефолтную min-высоту Fluent (~32px),
                                     иначе поле выше кнопки «Проверить» (30px). Как у ComboBox. -->
                                <TextBox x:Name="UpdatePathBox" Grid.Column="0"
                                         Height="{StaticResource ControlHeightStandard}" VerticalContentAlignment="Center"
                                         Margin="0,0,8,0"
                                         Background="{StaticResource BrushSecondaryBg}"
                                         CornerRadius="{StaticResource RadiusBase}"
                                         Watermark="\\server\share\SmartBase   или   Z:\SmartBase"
                                         LostFocus="OnUpdatePathChanged" />
                                <Button x:Name="UpdateCheckBtn" Grid.Column="1"
                                        Classes="dialog" Content="Проверить"
                                        VerticalAlignment="Center"
                                        Click="OnCheckUpdateClick" />
                            </Grid>
                            <!-- Автообновление: тихая проверка папки при запуске приложения;
                                 при наличии новой версии — та же модалка «Обновить/Отмена».
                                 Проверка идет сразу: окно показано при любом старте, в том
                                 числе из автозапуска — см. MainWindow. -->
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                                <ToggleSwitch x:Name="AutoUpdateToggle"
                                              OnContent="" OffContent=""
                                              VerticalAlignment="Center"
                                              IsCheckedChanged="OnAutoUpdateToggled" />
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Автообновление"
                                               FontWeight="{StaticResource FontWeightBold}"
                                               Foreground="{StaticResource BrushSecondaryText}" />
                                    <TextBlock Classes="desc"
                                               Text="При запуске программа проверит наличие обновления и предложит установить его." />
                                </StackPanel>
                            </StackPanel>
                            <!-- Результат проверки («доступна версия…»/«актуальная»/ошибка).
                                 Сама загрузка идет в отдельном ОКНЕ (ProgressDialog), не инлайн. -->
                            <TextBlock x:Name="UpdateStatusText" Classes="desc"
                                       Text="" IsVisible="False" />
                        </StackPanel>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Папка с данными (где лежат database.db / app.db) -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Папка с данными" />
                                <TextBlock x:Name="DataPathText" Classes="desc"
                                           Text="—" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="dialog" Content="Открыть"
                                    VerticalAlignment="Center"
                                    Click="OnOpenDataFolder" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Система (ОС и версия рантайма — пригодится при обращении в поддержку) -->
                    <Border Classes="settingRow">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="title" Text="Система" />
                            <TextBlock x:Name="SystemInfoText" Classes="desc" Text="—" />
                        </StackPanel>
                    </Border>
                    <Border Classes="separator h" />

                    <Border Classes="settingRow">
                        <Expander x:Name="ComponentLicensesExpander" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  Expanded="OnComponentLicensesExpanded">
                            <Expander.Header>
                                <TextBlock Classes="title" Text="Лицензии компонентов" />
                            </Expander.Header>
                            <StackPanel Spacing="8" Margin="0,12,0,0">
                                <TextBox x:Name="ComponentLicensesText" Classes="multiline"
                                         IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="Wrap" Height="320" />
                                <Button x:Name="CopyComponentLicensesButton" Classes="dialog" Content="Копировать"
                                        HorizontalAlignment="Left"
                                        Click="OnCopyComponentLicenses" />
                            </StackPanel>
                        </Expander>
                    </Border>
                    <Border Classes="separator h" />

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ── Инструкция пользователя ───────────────────────
                 Документы docs/user/*.md, вшитые в сборку (AvaloniaResource). Текст
                 собирается в code-behind (SettingsGuide) секциями в GuideHost: прокрутка
                 общая и НАША — так известна Y-координата каждого заголовка, и оглавление
                 умеет к нему прокручивать. Оглавление —
                 отдельной панелью справа (Column 2 корневой сетки), как «Детали» журнала. -->
            <ScrollViewer x:Name="GuidePanel" IsVisible="False"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="GuideHost" Margin="16,16,16,32" />
            </ScrollViewer>

            <!-- ── Диагностика ───────────────────────────────────
                 Журнал logs.db (Serilog): единый файл на приложение, без выбора базы.
                 Таблица — рисованная сетка служебных таблиц (Controls/DrawnGrid/ServiceGrid):
                 колонки и строки задает code-behind (SettingsLogsTable.cs).
                 Деталь строки — отдельной панелью справа (Column 2 корневой сетки). -->
            <Panel x:Name="LogsPanel" IsVisible="False">
                <grid:ServiceGrid x:Name="LogsGrid" />
                <TextBlock x:Name="LogsEmptyText"
                           Text="Записей пока нет."
                           IsVisible="False"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{StaticResource BrushSecondaryText}"
                           HorizontalAlignment="Center"
                           Margin="0,48,0,0" />
            </Panel>

        </Grid>

    </DockPanel>

    <!-- Вертикальный разделитель между разделом и деталями (во всю высоту). Разделителя
         два — по одному на панель Column 2 («Детали» журнала и «Содержание» инструкции):
         разделы не показываются одновременно, поэтому видна всегда ровно одна пара. -->
    <Border Grid.Column="1" x:Name="LogsDetailDivider"
            Classes="separator v" IsVisible="False" />
    <Border Grid.Column="1" x:Name="GuideTocDivider"
            Classes="separator v" IsVisible="False" />

    <!-- ── Содержание инструкции (во всю высоту) ────────────────────────────
         Устроено как панель «Детали» журнала: навбар высотой 56 встает вровень с навбаром
         настроек, своей линии под ним нет (ее рисует общая линия окна на y=56 в MainWindow —
         вторая при зуме дала бы двойную). Пункты строятся в code-behind по заголовкам
         документов; ширина меняется ручкой GuideTocResizeGrip ниже. -->
    <Border Grid.Column="2" x:Name="GuideTocPanel"
            IsVisible="False"
            Background="{StaticResource BrushBg}">
        <Grid RowDefinitions="Auto,*">

            <Grid Grid.Row="0" Height="56" Margin="16,0">
                <TextBlock Text="Содержание"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeLarge}"
                           FontWeight="{StaticResource FontWeightBold}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- Боковых отступов у хоста нет: подсветка пункта идет во всю ширину панели,
                 воздух дает Padding самой строки (как в сайдбаре). -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="GuideTocHost" Margin="0,0,0,16" />
            </ScrollViewer>
        </Grid>
    </Border>

    <!-- Ручка перетягивания ширины панели «Содержание» — копия ручки «Деталей» ниже. -->
    <Border Grid.Column="2" x:Name="GuideTocResizeGrip"
            Width="11" Height="34"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Margin="-5,0,0,0"
            CornerRadius="4"
            Background="{StaticResource BrushBg}"
            BorderBrush="{StaticResource BrushSeparator}"
            BorderThickness="{DynamicResource BorderLine}"
            Cursor="SizeWestEast"
            IsVisible="False">
        <StackPanel Orientation="Vertical" Spacing="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
            <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
            <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
        </StackPanel>
    </Border>

    <!-- ── Детали строки журнала (во всю высоту) ───────────────────────────
         Навбар «Детали» встает вровень с навбаром настроек. Карточки полей сверху,
         полный текст снизу — как «Страница записи» (RecordPageView). Нижнюю границу
         навбара рисует общая линия окна на y=56 (MainWindow), своей линии под шапкой
         нет (иначе удвоение). Ширина — в code-behind (_logsDetailWidth), меняется
         ручкой LogsDetailResizeGrip ниже. -->
    <Border Grid.Column="2" x:Name="LogsDetailPanel"
            IsVisible="False"
            Background="{StaticResource BrushBg}">
        <Grid x:Name="LogsDetailGrid" RowDefinitions="Auto,*,Auto,*">

            <!-- Шапка-навбар панели: заголовок слева + крестик справа —
                 как навбар «Страницы записи» (NavbarPage): высота 56,
                 крупный жирный заголовок, кнопка navbtn. -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto"
                  Height="56" Margin="16,0">
                <TextBlock Grid.Column="0" Text="Детали"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeLarge}"
                           FontWeight="{StaticResource FontWeightBold}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,12,0" />
                <Button Grid.Column="1" x:Name="LogsDetailCloseBtn"
                        Classes="navbtn" Width="30" Height="30"
                        VerticalAlignment="Center"
                        CornerRadius="{StaticResource RadiusMedium}"
                        ToolTip.Tip="Закрыть">
                    <Viewbox Width="{StaticResource IconSizeMedium}"
                             Height="{StaticResource IconSizeMedium}">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconClose}"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="{StaticResource IconStrokeMedium}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>

            <!-- Карточки полей строятся в code-behind (BuildLogsDetailCards).
                 Строка карточек ресайзится ручкой-пилюлей ниже.
                 Фон блока серый — как у блока свойств «Страницы записи»: белые карточки
                 читаются на нем как отдельные плашки. Серым залита вся строка (она
                 звездная), поэтому блок отбит от белой шапки сверху и текста снизу. -->
            <ScrollViewer Grid.Row="1"
                          Background="{StaticResource BrushSecondaryBg}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="LogsDetailCardsHost"
                            Margin="16,16,16,16" Spacing="6" />
            </ScrollViewer>

            <!-- Линия-разделитель между карточками и текстом (в своей строке). -->
            <Border Grid.Row="2" Classes="separator h"
                    VerticalAlignment="Center" />

            <!-- Ручка-пилюля: плавает поверх линии (лежит в строке карточек у
                 нижнего края), тянет высоту блока карточек — как PropsResizeGrip
                 «Страницы записи». -->
            <Border Grid.Row="1"
                    x:Name="LogsPropsResizeGrip"
                    Width="34" Height="11"
                    Margin="0,0,0,-5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    CornerRadius="4"
                    Background="{StaticResource BrushBg}"
                    BorderBrush="{StaticResource BrushSeparator}"
                    BorderThickness="{DynamicResource BorderLine}"
                    Cursor="SizeNorthSouth">
                <StackPanel Orientation="Horizontal" Spacing="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
                    <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
                    <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
                </StackPanel>
            </Border>

            <!-- Полный текст выбранного поля. Отступы/крошка/редактор — 1-в-1 как нижний
                 блок «Страницы записи» (RecordPageView): 16px по кругу, крошка отбита
                 на 16px, безбордерный переносящий редактор. Отличие одно — иконка
                 копирования справа от крошки. -->
            <Grid Grid.Row="3" RowDefinitions="Auto,*"
                  Margin="16,16,16,16">
                <!-- Крошка «Поле › Имя» + копирование -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto"
                      Margin="0,0,0,16">
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Поле"
                                   Foreground="{StaticResource BrushSecondaryText}"
                                   VerticalAlignment="Center" />
                        <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconChevronRight}"
                                      Stroke="{StaticResource BrushSecondaryText}"
                                      StrokeThickness="1.6"
                                      StrokeLineCap="Round" StrokeJoin="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="LogsDetailFieldName"
                                   Foreground="{StaticResource BrushSecondaryText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="LogsDetailCopyBtn"
                            Classes="icon" Width="28" Height="28"
                            ToolTip.Tip="Скопировать">
                        <Viewbox Width="{StaticResource IconSizeSmall}"
                                 Height="{StaticResource IconSizeSmall}">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconCopy}"
                                      Stroke="{StaticResource BrushSecondaryText}"
                                      StrokeThickness="{StaticResource IconStrokeSmall}"
                                      StrokeLineCap="Round" StrokeJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>

                <!-- Read-only, но выделяемый/копируемый. Класс notesEditor — безбордерный
                     во ВСЕХ состояниях (в т.ч. в фокусе), как редактор записи. Перенос по
                     словам, без горизонтального скролла — длинные строки стектрейса
                     переносятся, как текст в записи (полный текст — по кнопке копирования). -->
                <TextBox Grid.Row="1" x:Name="LogsDetailFullText"
                         Classes="notesEditor"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap" />
            </Grid>
        </Grid>
    </Border>

    <!-- Ручка перетягивания ширины панели «Детали» — вертикальная пилюля у ее левого
         края, плавает поверх разделителя (Margin -5), курсор ↔. Как ручка панели записи
         (RecordResizeGrip в MainWindow). Видна вместе с панелью; drag меняет ширину. -->
    <Border Grid.Column="2" x:Name="LogsDetailResizeGrip"
            Width="11" Height="34"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Margin="-5,0,0,0"
            CornerRadius="4"
            Background="{StaticResource BrushBg}"
            BorderBrush="{StaticResource BrushSeparator}"
            BorderThickness="{DynamicResource BorderLine}"
            Cursor="SizeWestEast"
            IsVisible="False">
        <StackPanel Orientation="Vertical" Spacing="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
            <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
            <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
        </StackPanel>
    </Border>

    </Grid>

</UserControl>
