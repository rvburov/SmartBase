<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartBase.Views.Settings"
             xmlns:comp="using:SmartBase.Controls.Components"
             x:Class="SmartBase.Views.Settings.SettingsView"
             Background="{StaticResource BrushBg}">

    <UserControl.Resources>
        <!-- Ползунок-«таблетка»: белый прямоугольник со скруглением и мягкой тенью. -->
        <ControlTheme x:Key="SettingSliderThumb" TargetType="Thumb">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border CornerRadius="9"
                            Background="White"
                            BorderBrush="{StaticResource BrushSeparator}"
                            BorderThickness="{DynamicResource BorderLine}"
                            BoxShadow="0 1 3 0 #22000000" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!-- Половинки дорожки — прозрачные, чтобы под ними была видна единая линия. -->
        <ControlTheme x:Key="SettingSliderTrackButton" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Слайдер настроек: тонкая дорожка + ползунок-«таблетка» (как в Obsidian). -->
        <Style Selector="Slider.setting">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Height"   Value="24" />
            <Setter Property="Minimum"  Value="0" />
            <Setter Property="Maximum"  Value="100" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" VerticalAlignment="Center">
                        <Grid VerticalAlignment="Center">
                            <!-- единая дорожка -->
                            <Border Height="4" CornerRadius="2"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource BrushSeparator}" />
                            <Track Name="PART_Track" Orientation="Horizontal"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value, Mode=TwoWay}">
                                <Track.DecreaseButton>
                                    <RepeatButton Name="PART_DecreaseButton"
                                                  Theme="{StaticResource SettingSliderTrackButton}" />
                                </Track.DecreaseButton>
                                <Track.IncreaseButton>
                                    <RepeatButton Name="PART_IncreaseButton"
                                                  Theme="{StaticResource SettingSliderTrackButton}" />
                                </Track.IncreaseButton>
                                <Track.Thumb>
                                    <Thumb Width="26" Height="18"
                                           Theme="{StaticResource SettingSliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Строка одной настройки. Линия под строкой — отдельный separator h ПОСЛЕ
             каждой строки (не бордер контейнера с текстом: отдельную линию можно
             алиасить, она чёткая при любом зуме). -->
        <Style Selector="Border.settingRow">
            <Setter Property="Padding" Value="0,16" />
        </Style>
        <Style Selector="Border.settingRow TextBlock.title">
            <Setter Property="Foreground" Value="{StaticResource BrushPrimaryText}" />
        </Style>
        <Style Selector="Border.settingRow TextBlock.desc">
            <Setter Property="FontSize"     Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground"   Value="{StaticResource BrushSecondaryText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <!-- Шапка раздела (вынесена в компонент-навбар). -->
        <comp:NavbarSettings DockPanel.Dock="Top" x:Name="HeaderBar" />

        <!-- Содержимое выбранного раздела -->
        <Grid>

            <!-- ── Оформление ────────────────────────────────────── -->
            <ScrollViewer x:Name="AppearancePanel"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1400" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="16,0,16,32">

                    <!-- Отображение раздела навигации -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Отображение раздела навигации" />
                                <TextBlock Classes="desc"
                                           Text="Какой раздел панели навигации (слева) открывается при запуске программы: Календарь, Конструктор базы данных или Расширения." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="StartupModuleCombo"
                                      Width="240" Height="34"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}"
                                      SelectionChanged="OnStartupModuleChanged">
                                <ComboBoxItem Tag="calendar"    Content="Календарь" />
                                <ComboBoxItem Tag="constructor" Content="Конструктор базы данных" />
                                <ComboBoxItem Tag="extensions"  Content="Расширения" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Отображение раздела календаря -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Отображение раздела календаря" />
                                <TextBlock Classes="desc"
                                           Text="Какой вид календаря открывается при переходе в раздел: Расписание, Журнал, День, Неделя, Месяц, Год или Диаграмма." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="CalendarViewCombo"
                                      Width="240" Height="34"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}"
                                      SelectionChanged="OnCalendarViewChanged">
                                <ComboBoxItem Tag="0" Content="Расписание" />
                                <ComboBoxItem Tag="1" Content="Журнал" />
                                <ComboBoxItem Tag="2" Content="День" />
                                <ComboBoxItem Tag="3" Content="Неделя" />
                                <ComboBoxItem Tag="4" Content="Месяц" />
                                <ComboBoxItem Tag="5" Content="Год" />
                                <ComboBoxItem Tag="6" Content="Диаграмма" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Отображение раздела конструктора -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Отображение раздела конструктора" />
                                <TextBlock Classes="desc"
                                           Text="Какой вид коллекции открывается в конструкторе базы данных: Таблица или Список. Если у коллекции выбран свой вид, он сохраняется за ней." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="ConstructorViewCombo"
                                      Width="240" Height="34"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}"
                                      SelectionChanged="OnConstructorViewChanged">
                                <ComboBoxItem Tag="table" Content="Таблица" />
                                <ComboBoxItem Tag="list"  Content="Список" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Уровень масштабирования -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Уровень масштабирования" />
                                <TextBlock Classes="desc"
                                           Text="Общий масштаб интерфейса. Диапазон 70…130 %, шаг 10 %; кнопка-стрелка возвращает 100 %." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        Spacing="14" VerticalAlignment="Center">
                                <Button Classes="icon" Width="24" Height="24"
                                        x:Name="ScaleResetBtn" Click="OnScaleReset"
                                        ToolTip.Tip="Сбросить">
                                    <Viewbox Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}">
                                        <Canvas Width="24" Height="24">
                                            <!-- rotate-ccw -->
                                            <Path Data="{StaticResource IconRotateCcw}"
                                                  Stroke="{Binding $parent[Button].Foreground}"
                                                  StrokeThickness="1.8"
                                                  StrokeLineCap="Round" StrokeJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Slider Classes="setting" Width="200"
                                        x:Name="ScaleSlider"
                                        Minimum="70" Maximum="130"
                                        TickFrequency="10" IsSnapToTickEnabled="True"
                                        SmallChange="10" LargeChange="10"
                                        ValueChanged="OnScaleChanged"
                                        PointerEntered="OnScaleSliderEntered"
                                        PointerMoved="OnScaleSliderMoved"
                                        PointerExited="OnScaleSliderExited" />

                                <!-- Пузырёк со значением над ползунком: текущий масштаб в процентах. -->
                                <Popup x:Name="ScaleValuePopup" InheritsTransform="True"
                                       PlacementTarget="{Binding #ScaleSlider}"
                                       Placement="Top" VerticalOffset="-6"
                                       IsLightDismissEnabled="False">
                                    <Border Background="{DynamicResource ToolTipBackground}"
                                            BorderBrush="{StaticResource BrushSeparator}"
                                            BorderThickness="{DynamicResource BorderLine}"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            BoxShadow="0 2 8 0 #1A000000">
                                        <TextBlock x:Name="ScaleValueText" Text="100 %"
                                                   Foreground="{DynamicResource ToolTipForeground}"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Размер шрифта -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Размер шрифта" />
                                <TextBlock Classes="desc"
                                           Text="Общий размер текста интерфейса. Диапазон −3…+3 пикселя от стандарта; кнопка-стрелка возвращает стандарт." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        Spacing="14" VerticalAlignment="Center">
                                <Button Classes="icon" Width="24" Height="24"
                                        x:Name="FontResetBtn" Click="OnFontSizeReset"
                                        ToolTip.Tip="Сбросить">
                                    <Viewbox Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}">
                                        <Canvas Width="24" Height="24">
                                            <!-- rotate-ccw -->
                                            <Path Data="{StaticResource IconRotateCcw}"
                                                  Stroke="{Binding $parent[Button].Foreground}"
                                                  StrokeThickness="1.8"
                                                  StrokeLineCap="Round" StrokeJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Slider Classes="setting" Width="200"
                                        x:Name="FontSizeSlider"
                                        Minimum="-3" Maximum="3"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        SmallChange="1" LargeChange="1"
                                        ValueChanged="OnFontSizeChanged"
                                        PointerEntered="OnFontSliderEntered"
                                        PointerMoved="OnFontSliderMoved"
                                        PointerExited="OnFontSliderExited" />

                                <!-- Пузырёк со значением над ползунком: показывает итоговый
                                     базовый размер текста (стандарт ± дельта). -->
                                <Popup x:Name="FontValuePopup" InheritsTransform="True"
                                       PlacementTarget="{Binding #FontSizeSlider}"
                                       Placement="Top" VerticalOffset="-6"
                                       IsLightDismissEnabled="False">
                                    <!-- Плашка-индикатор постоянного размера (как пузырёк масштаба):
                                         меняется только число. Размер текста пришпилен StaticResource —
                                         иначе плашка росла бы вместе с применённым размером шрифта. -->
                                    <Border x:Name="FontBadgeBorder"
                                            Background="{DynamicResource ToolTipBackground}"
                                            BorderBrush="{StaticResource BrushSeparator}"
                                            BorderThickness="{DynamicResource BorderLine}"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            BoxShadow="0 2 8 0 #1A000000">
                                        <TextBlock x:Name="FontValueText" Text="12"
                                                   FontSize="{StaticResource FontSizeBase}"
                                                   Foreground="{DynamicResource ToolTipForeground}"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ── Управление базой данных ───────────────────────── -->
            <ScrollViewer x:Name="DatabasePanel" IsVisible="False"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1400" />
                    </Grid.ColumnDefinitions>
                    <!-- Отступ сверху — как в «Оформлении»: его даёт Padding самих
                         settingRow-строк, у StackPanel верхнего отступа нет. -->
                    <StackPanel Margin="16,0,16,32">

                    <!-- Добавление БД — кнопка «Добавить базу данных» с меню в навбаре
                         (NavbarSettings, видна только в этом разделе): здесь только список. -->
                    <ItemsControl x:Name="DatabaseList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DatabaseRow">
                                <StackPanel>
                                <Border Classes="settingRow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="3"
                                                    VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Name}"
 />
                                            <TextBlock Text="{Binding Path}"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       Foreground="{StaticResource BrushSecondaryText}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <!-- Статус: очередь фонового монтирования (серым,
                                                 «в очереди…» / «Обновление · 45% · ≈ 2 мин»)
                                                 либо недоступна (красным) -->
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       Foreground="{Binding StatusBrush}"
                                                       IsVisible="{Binding ShowStatus}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    Spacing="8" VerticalAlignment="Center">

                                            <!-- Серверная БД PostgreSQL: метка провайдера -->
                                            <TextBlock Text="PostgreSQL"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       Foreground="{StaticResource BrushSecondaryText}"
                                                       IsVisible="{Binding IsPostgres}" />

                                            <!-- Дефолтная БД: метка -->
                                            <TextBlock Text="По умолчанию"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       Foreground="{StaticResource BrushSecondaryText}"
                                                       IsVisible="{Binding ShowDefaultBadge}" />

                                            <!-- Недоступна → попытка переподключения (ждущим
                                                 в очереди кнопка не нужна — подключатся сами) -->
                                            <Button Content="Подключить заново"
                                                    Tag="{Binding Id}"
                                                    Click="OnReconnectDatabaseClick"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding ShowReconnect}" />

                                            <!-- Удалить из реестра (файл не удаляется) -->
                                            <Button Classes="icon red"
                                                    Width="28" Height="28"
                                                    Tag="{Binding Id}"
                                                    Click="OnRemoveDatabaseClick"
                                                    ToolTip.Tip="Отключить (файл не удаляется)"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding ShowDeleteButton}">
                                                <Viewbox Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}">
                                                    <Canvas Width="24" Height="24">
                                                        <!-- trash -->
                                                        <Path Data="{StaticResource IconTrash}"
                                                              Stroke="{Binding $parent[Button].Foreground}"
                                                              StrokeThickness="1.6"
                                                              StrokeLineCap="Round" StrokeJoin="Round" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Classes="separator h" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ── О программе ───────────────────────────────────── -->
            <ScrollViewer x:Name="AboutPanel" IsVisible="False"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1400" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="16,16,16,32" Spacing="0">

                    <!-- Название, версия (со сборкой) и краткое описание -->
                    <StackPanel Spacing="6" Margin="0,0,0,8">
                        <TextBlock Text="SmartBase"
                                   FontSize="{DynamicResource FontSizeLarge}"
                                   FontWeight="{StaticResource FontWeightBold}" />
                        <TextBlock x:Name="VersionText"
                                   Text="Версия 1.0.0"
                                   Foreground="{StaticResource BrushSecondaryText}" />
                        <TextBlock Text="Локальная база данных с календарём и конструктором коллекций. Все данные хранятся на вашем устройстве — в локальных файлах базы данных."
                                   Foreground="{StaticResource BrushSecondaryText}"
                                   TextWrapping="Wrap" MaxWidth="640"
                                   HorizontalAlignment="Left" />
                    </StackPanel>

                    <!-- Обновления: путь к папке с новой версией + проверка.
                         Полное ТЗ — docs/guides/auto-update.md. -->
                    <Border Classes="settingRow">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="title" Text="Обновления" />
                                <TextBlock Classes="desc"
                                           Text="Путь к папке (можно сетевой), где лежит новая версия SmartBase.exe. Нажмите «Проверить» — программа сравнит версию файла в папке с текущей. По умолчанию путь не задан." />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="UpdatePathBox" Grid.Column="0"
                                         Height="34" VerticalContentAlignment="Center"
                                         Margin="0,0,8,0"
                                         Background="{StaticResource BrushSecondaryBg}"
                                         CornerRadius="{StaticResource RadiusBase}"
                                         Watermark="\\server\share\SmartBase   или   Z:\SmartBase"
                                         LostFocus="OnUpdatePathChanged" />
                                <Button x:Name="UpdateCheckBtn" Grid.Column="1"
                                        Classes="dialog" Content="Проверить"
                                        VerticalAlignment="Center"
                                        Click="OnCheckUpdateClick" />
                            </Grid>
                            <!-- Автообновление: тихая проверка папки при запуске приложения;
                                 при наличии новой версии — та же модалка «Обновить/Отмена». -->
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                                <ToggleSwitch x:Name="AutoUpdateToggle"
                                              OnContent="" OffContent=""
                                              VerticalAlignment="Center"
                                              IsCheckedChanged="OnAutoUpdateToggled" />
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Автообновление"
                                               FontWeight="{StaticResource FontWeightBold}"
                                               Foreground="{StaticResource BrushSecondaryText}" />
                                    <TextBlock Classes="desc"
                                               Text="При запуске программа проверит наличие обновления и предложит установить его." />
                                </StackPanel>
                            </StackPanel>
                            <!-- Результат проверки («доступна версия…»/«актуальная»/ошибка).
                                 Сама загрузка идёт в отдельном ОКНЕ (ProgressDialog), не инлайн. -->
                            <TextBlock x:Name="UpdateStatusText" Classes="desc"
                                       Text="" IsVisible="False" />
                        </StackPanel>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Папка с данными (где лежат database.db / app.db) -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Папка с данными" />
                                <TextBlock x:Name="DataPathText" Classes="desc"
                                           Text="—" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="dialog" Content="Открыть"
                                    VerticalAlignment="Center"
                                    Click="OnOpenDataFolder" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Система (ОС и версия рантайма — пригодится при обращении в поддержку) -->
                    <Border Classes="settingRow">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="title" Text="Система" />
                            <TextBlock x:Name="SystemInfoText" Classes="desc" Text="—" />
                        </StackPanel>
                    </Border>
                    <Border Classes="separator h" />

                    </StackPanel>
                </Grid>
            </ScrollViewer>

        </Grid>

    </DockPanel>

</UserControl>
