<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:comp="using:SmartBase.Controls.Components"
        xmlns:cal="using:SmartBase.Views.ConstructorDb.Calendar"
        xmlns:con="using:SmartBase.Views.ConstructorDb"
        xmlns:settings="using:SmartBase.Views.Settings"
        xmlns:ext="using:SmartBase.Views.Extensions"
        xmlns:profile="using:SmartBase.Views.Profile"
        xmlns:tasks="using:SmartBase.Views.Tasks"
        xmlns:notes="using:SmartBase.Views.Notes"
        xmlns:lib="using:SmartBase.Views.Library"
        xmlns:b="using:SmartBase.Controls.Behaviors"
        x:Class="SmartBase.Views.MainWindow"
        Classes="main"
        Title="SmartBase"
        Width="1331" Height="813"
        Background="{StaticResource BrushBg}"
        WindowStartupLocation="CenterScreen"
        b:LineMetrics.FollowsAppZoom="True">

    <!-- Хост масштабирования: LayoutTransform на корне → весь интерфейс перекомпоновывается
         в логических пикселях и заполняет окно (см. Utils/Scaling + MainWindow.ApplyScale). -->
    <LayoutTransformControl x:Name="ScaleHost">
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <!-- ActivityBar | разделитель | сайдбар | контент | разделитель | панель записи -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="220" MinWidth="180" MaxWidth="500" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="0" />
        </Grid.ColumnDefinitions>

        <!-- Подложка под ActivityBar и разделитель ЕДИНОЙ заливкой (Aliased): заливка
             панели и защелкнутая в целый пиксель линия — разные элементы, на дробных
             позициях (зум ≠ 1) их края расходились и между ними оставалась белая щель.
             Подложка снапится к тому же пикселю, что и линия, — стык закрыт. -->
        <Rectangle Grid.Column="0" Grid.ColumnSpan="2"
                   RenderOptions.EdgeMode="Aliased"
                   Fill="{StaticResource BrushSecondaryBg}" />

        <!-- Левая панель активности (48px) -->
        <comp:ActivityBar Grid.Column="0"
                          x:Name="ActivityBarControl" />

        <!-- Вертикальный разделитель справа от ActivityBar -->
        <Border Grid.Column="1"
                Classes="separator v" />

        <!-- Боковые панели (скрываются/показываются по модулю).
             Разделительная линия — отдельный separator v у правого края (не бордер
             контейнера: контейнер с контентом алиасить нельзя, а отдельная линия
             защелкивается в целый пиксель — четкая при любом зуме).
             Ручка вынесена в колонку 3 (как у панели записи). -->
        <Grid Grid.Column="2">
            <comp:SidebarTree x:Name="CalendarSidebar" />
            <comp:SidebarTree x:Name="TasksSidebar" IsVisible="False" />
            <comp:SidebarTree x:Name="ConstructorSidebar" IsVisible="False" />
            <comp:SidebarTree x:Name="LibrarySidebar" IsVisible="False" />
            <comp:SidebarList x:Name="SettingsSidebar" IsVisible="False" />
            <comp:SidebarList x:Name="ExtensionsSidebar" IsVisible="False" />
            <comp:SidebarList x:Name="ProfileSidebar" IsVisible="False" />
            <comp:SidebarFiles x:Name="NotesSidebar" IsVisible="False" />
        </Grid>
        <Border Grid.Column="2"
                Classes="separator v"
                HorizontalAlignment="Right" />

        <!-- Основная область контента -->
        <Grid Grid.Column="3">
            <cal:CalendarControllerView x:Name="CalendarModule" />
            <tasks:TasksControllerView x:Name="TasksModule" IsVisible="False" />
            <con:ConstructorControllerView x:Name="ConstructorModule" IsVisible="False" />
            <settings:SettingsView x:Name="SettingsModule" IsVisible="False" />
            <ext:ExtensionsView x:Name="ExtensionsModule" IsVisible="False" />
            <profile:ProfileView x:Name="ProfileModule" IsVisible="False" />
            <notes:NotesControllerView x:Name="NotesModule" IsVisible="False" />
            <lib:LibraryControllerView x:Name="LibraryModule" IsVisible="False" />
        </Grid>

        <!-- Вертикальный разделитель слева от панели записи -->
        <Border Grid.Column="4"
                x:Name="RecordPanelSeparator"
                Classes="separator v"
                IsVisible="False" />

        <!-- Правая панель «Страница записи» (Obsidian-style) -->
        <Grid Grid.Column="5">
            <con:RecordPageView x:Name="RecordPanel" IsVisible="False" />

            <!-- Ручка перетаскивания у левого края панели — аналогично сайдбару -->
            <Border x:Name="RecordResizeGrip"
                    Width="11" Height="34"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="-5,0,0,0"
                    CornerRadius="4"
                    Background="{StaticResource BrushBg}"
                    BorderBrush="{StaticResource BrushSeparator}"
                    BorderThickness="{DynamicResource BorderLine}"
                    Cursor="SizeWestEast"
                    IsVisible="False"
                    PointerPressed="OnRecordGripPressed"
                    PointerMoved="OnRecordGripMoved"
                    PointerReleased="OnRecordGripReleased">
                <StackPanel Orientation="Vertical" Spacing="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
                    <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
                    <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Линия под титульной зоной (на высоте навбара = 56px) через сайдбар,
             контент и панель записи. ActivityBar имеет собственный короткий разделитель. -->
        <Border Grid.Column="1" Grid.ColumnSpan="5"
                Classes="separator h"
                VerticalAlignment="Top"
                Margin="0,56,0,0" />

        <!-- Самая верхняя линия окна — единой полосой над всеми колонками.
             На macOS скрыта: системная рамка уже рисует кромку под тайтлбаром,
             своя линия давала бы двойную. На остальных платформах — как была. -->
        <Border Grid.Column="0" Grid.ColumnSpan="6"
                Classes="separator h"
                VerticalAlignment="Top"
                IsVisible="{OnPlatform True, macOS=False}" />

        <!-- Ручка ресайза сайдбара. Закреплена у правого края колонки сайдбара и висит
             поверх соседнего блока (коллекции или записи) за счет отрицательного отступа —
             поэтому видна при любом из них. Объявлена последней → рисуется над панелями. -->
        <Border x:Name="ResizeGrip"
                Grid.Column="2"
                Width="11" Height="34"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,-5,0"
                CornerRadius="4"
                Background="{StaticResource BrushBg}"
                BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="{DynamicResource BorderLine}"
                Cursor="SizeWestEast"
                PointerPressed="OnGripPressed"
                PointerMoved="OnGripMoved"
                PointerReleased="OnGripReleased">
            <StackPanel Orientation="Vertical" Spacing="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
                <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
                <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
            </StackPanel>
        </Border>

    </Grid>
    </LayoutTransformControl>

</Window>
