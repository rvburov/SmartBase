<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartBase.Views.ConstructorDb.ConstructorListView"
             Background="{StaticResource BrushBg}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="RecordsList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="12,0"
                            Height="38"
                            Command="{Binding ClickCommand}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Открыть"        Command="{Binding OpenCommand}" />
                                <MenuItem Header="Создать запись" Command="{Binding CreateCommand}" />
                                <Separator />
                                <MenuItem Command="{Binding DeleteCommand}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="{StaticResource IconTrash}"
                                                          Stroke="{StaticResource BrushRed}"
                                                          StrokeThickness="{StaticResource IconStrokeMedium}"
                                                          StrokeLineCap="Round" StrokeJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="Удалить"
                                                       Foreground="{StaticResource BrushRed}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <!-- Полоска сквозного цвета записи — как у события календаря
                                 и карточки задачи; без цвета место не занимает. -->
                            <Border Grid.Column="0"
                                    Width="3"
                                    CornerRadius="{StaticResource RadiusXS}"
                                    Margin="0,4,8,4"
                                    IsVisible="{Binding HasColor}"
                                    Background="{Binding ColorBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="2"
                                    IsVisible="{Binding HasStatus}"
                                    Background="{StaticResource BrushAccentLight}"
                                    CornerRadius="{StaticResource RadiusXS}"
                                    Padding="8,1"
                                    Margin="8,0,0,0">
                                <TextBlock Text="{Binding Status}"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Foreground="{StaticResource BrushAccent}" />
                            </Border>
                            <TextBlock Grid.Column="3"
                                       IsVisible="{Binding HasDate}"
                                       Text="{Binding Date}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{StaticResource BrushSecondaryText}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>

</UserControl>
