<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="using:MyPlanner.Controls.Components"
             xmlns:con="using:MyPlanner.Views.ConstructorDb"
             x:Class="MyPlanner.Views.ConstructorDb.ConstructorControllerView">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Navbar конструктора -->
        <comp:ConstructorNavbar Grid.Row="0" x:Name="ConstructorNavbar" />

        <!-- Контент: таблица или список -->
        <Grid Grid.Row="1">
            <con:TableView          x:Name="TableViewCtrl"    IsVisible="True" />
            <con:ConstructorListView x:Name="ListViewCtrl"    IsVisible="False" />

            <!-- Подсказка пустого состояния: видна, когда коллекция не выбрана -->
            <StackPanel x:Name="EmptyStateHint"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        IsVisible="False">
                <TextBlock Text="Откройте навигацию, нажмите на"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeBase}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <!-- panel-left-open: иконка сайдбара (как в ActivityBar) -->
                        <Path Data="M5 3 H19 A2 2 0 0 1 21 5 V19 A2 2 0 0 1 19 21 H5 A2 2 0 0 1 3 19 V5 A2 2 0 0 1 5 3 Z M9 3 V21 M14 9 L17 12 L14 15"
                              Stroke="{StaticResource BrushSecondaryText}"
                              StrokeThickness="1.4"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                    </Canvas>
                </Viewbox>
                <TextBlock Text="и выберите коллекцию"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeBase}"
                           Foreground="{StaticResource BrushSecondaryText}" />
            </StackPanel>
        </Grid>

        <!-- Нижняя панель (statusbar): добавление, счётчик, навигация -->
        <comp:ConstructorFooter Grid.Row="2" x:Name="ConstructorFooter" Margin="0,-1,0,0" />

    </Grid>

</UserControl>
