<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="using:DataBase.Controls.Components"
             xmlns:con="using:DataBase.Views.ConstructorDb"
             x:Class="DataBase.Views.ConstructorDb.ConstructorControllerView">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Navbar конструктора -->
        <comp:NavbarConstructor Grid.Row="0" x:Name="NavbarConstructor" />

        <!-- Контент: таблица или список -->
        <Grid Grid.Row="1">
            <con:TableView          x:Name="TableViewCtrl"    IsVisible="True" />
            <con:ConstructorListView x:Name="ListViewCtrl"    IsVisible="False" />

            <!-- Подсказка пустого состояния: видна, когда коллекция не выбрана -->
            <StackPanel x:Name="EmptyStateHint"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        IsVisible="False">
                <TextBlock Text="Откройте навигацию, нажмите на"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <Viewbox Width="{StaticResource IconSizeLarge}" Height="{StaticResource IconSizeLarge}" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <!-- panel-left-open: иконка сайдбара (как в ActivityBar) -->
                        <Path Data="{StaticResource IconPanelOpen}"
                              Stroke="{StaticResource BrushSecondaryText}"
                              StrokeThickness="1.4"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                    </Canvas>
                </Viewbox>
                <TextBlock Text="и выберите коллекцию"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushSecondaryText}" />
            </StackPanel>
        </Grid>

        <!-- Нижняя панель (statusbar): добавление, счётчик, навигация -->
        <comp:FooterConstructor Grid.Row="2" x:Name="FooterConstructor" Margin="0,-1,0,0" />

    </Grid>

</UserControl>
