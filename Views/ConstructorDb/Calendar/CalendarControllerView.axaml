<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="using:SmartBase.Controls.Components"
             xmlns:cal="using:SmartBase.Views.ConstructorDb.Calendar"
             x:Class="SmartBase.Views.ConstructorDb.Calendar.CalendarControllerView">

    <Grid RowDefinitions="Auto,*">

        <!-- Навбар с навигацией и поиском. Линию под навбаром НЕ рисуем: ее уже рисует
             MainWindow (линия титульной зоны через все колонки) — вторая линия в том же
             месте давала визуальное удвоение толщины. -->
        <comp:NavbarCalendar Grid.Row="0" x:Name="NavbarControl" />

        <!-- Стек вьюх: 0-Расписание, 1-Журнал, 2-День, 3-Неделя, 4-Месяц, 5-Год, 6-Диаграмма -->
        <Grid Grid.Row="1">
            <cal:ListView    x:Name="ListViewCtrl"    IsVisible="False" />
            <cal:JournalView x:Name="JournalViewCtrl" IsVisible="False" />
            <cal:DayView     x:Name="DayViewCtrl"     IsVisible="False" />
            <cal:WeekView    x:Name="WeekViewCtrl"    IsVisible="False" />
            <cal:MonthView   x:Name="MonthViewCtrl"   IsVisible="True"  />
            <cal:YearView    x:Name="YearViewCtrl"    IsVisible="False" />
            <cal:DiagramView x:Name="DiagramViewCtrl" IsVisible="False" />

            <!-- Оверлей сетки (День/Неделя/Месяц/Год/Диаграмма): окно читается в фоне, оверлей появляется,
                 только если загрузка дольше 400 мс (холодный день-гигант — секунды). -->
            <Border x:Name="GridLoadingOverlay" IsVisible="False" Background="{StaticResource BrushBg}">
                <TextBlock Text="Загрузка…"
                           Foreground="{StaticResource BrushSecondaryText}"
                           Margin="24,16"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top" />
            </Border>

            <!-- Пустое состояние: ни одно свойство «Дата» не отмечено для показа. Тумблер снят
                 по умолчанию, поэтому у новой базы календарь пуст законно, и молчащий раздел
                 читался бы как поломка. Плашка НЕ перехватывает ввод (IsHitTestVisible=False):
                 клик по дню под ней должен по-прежнему создавать событие — это единственный
                 путь, который настраивает поле-дату сам. -->
            <Border x:Name="NoCalendarDatesHint" IsVisible="False"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="24" Padding="16,12"
                    MaxWidth="520"
                    Background="{StaticResource BrushSecondaryBg}"
                    CornerRadius="{StaticResource RadiusBase}">
                <StackPanel Spacing="4">
                    <TextBlock Text="В календаре нечего показывать"
                               FontWeight="{StaticResource FontWeightBold}" />
                    <TextBlock TextWrapping="Wrap"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{StaticResource BrushSecondaryText}"
                               Text="Ни у одного свойства «Дата» не включен показ в календаре. Включите тумблер «Отображать в календаре» в свойствах столбца — или создайте событие прямо здесь, свойство настроится само." />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>

</UserControl>
