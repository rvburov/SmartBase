<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="using:SmartBase.Controls.Components"
             xmlns:shapes="using:Avalonia.Controls.Shapes"
             xmlns:local="using:SmartBase.Views.ConstructorDb.Calendar"
             xmlns:u="clr-namespace:SmartBase.Utils"
             x:Class="SmartBase.Views.ConstructorDb.Calendar.WeekView"
             Background="{StaticResource BrushBg}">

    <UserControl.Resources>
        <local:HourLineBorderConverter x:Key="HourBorderConv" />
    </UserControl.Resources>

    <!-- Колонка 1 — полоса прокрутки на всю высоту, вместе с шапкой дней и AllDayBar. -->
    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,Auto">

        <!-- Заголовки дней недели — 72px пустой отступ + 7 равных колонок.
             Нижняя линия — отдельный separator (не бордер контейнера с текстом):
             чёткая при любом зуме. -->
        <Grid Grid.Row="0">
            <Grid ColumnDefinitions="72,*"
                  Background="{StaticResource BrushSecondaryBg}">
                <UniformGrid Grid.Column="1" x:Name="WeekHeaderDays" Columns="7" />
            </Grid>
            <Border Classes="separator h" VerticalAlignment="Bottom" />
        </Grid>

        <!-- AllDayBar -->
        <comp:AllDayBar Grid.Row="1" x:Name="AllDayBarCtrl" />

        <!-- Прокручиваемая сетка событий. Своей полосы нет (Hidden) — её роль играет
             ScrollBar ниже, стоящий и на строках шапки, чтобы полоса начиналась сверху,
             как в таблице. -->
        <ScrollViewer Grid.Row="2" x:Name="TimeScroll"
                      VerticalScrollBarVisibility="Hidden">
            <Grid ColumnDefinitions="72,*">

                <!-- Метки часов: каждая метка прижата к низу 60px-слота,
                     чтобы "01:00" совпадал с линией между 00:xx и 01:xx -->
                <Border Grid.Column="0">
                <ItemsControl x:Name="HourLabels">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="60">
                                <TextBlock Text="{Binding}"
                                           VerticalAlignment="Bottom"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,8,-8"
                                           Foreground="{StaticResource BrushSecondaryText}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </Border>

                <!-- Правая часть: линии сетки + 7 колонок -->
                <Grid Grid.Column="1" x:Name="EventsGrid">

                    <!-- Линии часов: сплошная сверху + светлая пунктирная на получасе. -->
                    <ItemsControl x:Name="HourRows"
                                  IsHitTestVisible="False"
                                  Height="1440"
                                  VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="60" ClipToBounds="True">
                                    <!-- сплошная линия часа (скрыта для 00:00). EdgeMode=Aliased:
                                         на дробных позициях (зум ≠ 1) линия защёлкивается в целый
                                         пиксель, а не размазывается. -->
                                    <Border BorderBrush="{StaticResource BrushSeparator}"
                                            BorderThickness="{Binding Converter={StaticResource HourBorderConv}}"
                                            RenderOptions.EdgeMode="Aliased"
                                            VerticalAlignment="Top" />
                                    <!-- пунктирная линия получаса -->
                                    <shapes:Line StartPoint="0,0.5" EndPoint="10000,0.5"
                                                 Margin="0,30,0,0"
                                                 VerticalAlignment="Top"
                                                 HorizontalAlignment="Left"
                                                 Stroke="{StaticResource BrushSeparator}"
                                                 StrokeThickness="{DynamicResource SeparatorThickness}"
                                                 RenderOptions.EdgeMode="Aliased"
                                                 StrokeDashArray="3,3" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Вертикальные линии колонок — отдельный слой пустых Border
                         (колонки с событиями алиасить нельзя: EdgeMode наследуется и
                         переключил бы сглаживание текста). Конструкция как у делителей
                         AllDayBar → линии совпадают пиксель-в-пиксель. -->
                    <UniformGrid x:Name="ColumnLines"
                                 Columns="7" Height="1440"
                                 VerticalAlignment="Top"
                                 IsHitTestVisible="False" />

                    <!-- 7 колонок с событиями -->
                    <UniformGrid x:Name="WeekColumns"
                                 Columns="7" Height="1440"
                                 VerticalAlignment="Top" />

                    <!-- оверлей для drag-ghost -->
                    <Canvas x:Name="DragOverlay"
                            IsHitTestVisible="False"
                            Height="1440"
                            VerticalAlignment="Top" />

                </Grid>

            </Grid>
        </ScrollViewer>

        <!-- Полоса прокрутки сетки событий — на всю высоту, включая шапку дней. -->
        <ScrollBar Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                   Orientation="Vertical"
                   u:ScrollBarLink.Source="{Binding #TimeScroll}" />

        <!-- Ручка ресайза AllDayBar — «пилюля» как у сайдбара. Вынесена на уровень
             вида и объявлена последней → рисуется поверх сетки и наезжает на
             разделительную линию снизу (отрицательный отступ), не обрезаясь. -->
        <Border x:Name="AllDayResizeGrip"
                Grid.Row="1"
                Width="34" Height="11"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,-6"
                CornerRadius="4"
                Background="{StaticResource BrushBg}"
                BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="{DynamicResource BorderLine}"
                Cursor="SizeNorthSouth">
            <StackPanel Orientation="Horizontal" Spacing="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
                <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
                <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
            </StackPanel>
        </Border>

    </Grid>

</UserControl>
