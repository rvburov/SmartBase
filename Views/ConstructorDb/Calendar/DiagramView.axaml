<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:SmartBase.Utils"
             x:Class="SmartBase.Views.ConstructorDb.Calendar.DiagramView"
             Background="{StaticResource BrushBg}">


    <!-- Диаграмма (гант на месяц или год — комбобокс масштаба в шапке): слева панель
         коллекций, справа таймлайн.
         Ширина левой панели 230 продублирована константой LeftW в code-behind.
         Колонка 1 — полоса прокрутки на всю высоту, вместе с шапкой шкалы. -->
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">

        <!-- Фиксированная шапка: заголовок панели + шкала (дни месяца или месяцы года).
             Нижняя линия — отдельный separator (не бордер контейнера с текстом):
             чёткая при любом зуме. -->
        <Grid Grid.Row="0">
            <Grid ColumnDefinitions="230,*" Background="{StaticResource BrushSecondaryBg}">
                <Grid Grid.Column="0" ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Text="ВСЕ КОЛЛЕКЦИИ"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{StaticResource BrushSecondaryText}"
                               VerticalAlignment="Center"
                               Margin="12,0,4,0" />
                    <!-- Масштаб таймлайна — лесенка месяц → год → 5 лет → 10 лет:
                         «−» мельче, «+» крупнее (кнопки в стиле «+» навбара); крайняя
                         кнопка гаснет, тултип называет масштаб, куда ведёт нажатие. -->
                    <Button Grid.Column="1" x:Name="ScaleMinusBtn" Classes="navbtn"
                            Width="28" Height="28" Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            CornerRadius="{StaticResource RadiusMedium}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconMinus}"
                                      Stroke="{Binding $parent[Button].Foreground}"
                                      StrokeThickness="{StaticResource IconStrokeMediumBold}"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Grid.Column="2" x:Name="ScalePlusBtn" Classes="navbtn"
                            Width="28" Height="28" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            CornerRadius="{StaticResource RadiusMedium}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconPlus}"
                                      Stroke="{Binding $parent[Button].Foreground}"
                                      StrokeThickness="{StaticResource IconStrokeMediumBold}"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
                <Canvas Grid.Column="1" x:Name="DayHeaderCanvas"
                        Height="44" ClipToBounds="True" />
            </Grid>
            <Border Classes="separator h" VerticalAlignment="Bottom" />
        </Grid>

        <!-- Тело: ОДИН вертикальный ScrollViewer — левая панель и таймлайн едут вместе,
             шапка шкалы и заголовок панели стоят. Горизонтального скролла нет: период
             всегда растянут на всю ширину (dayW = ширина / дней периода). -->
        <Grid Grid.Row="1">
            <!-- Своей полосы нет (Hidden): её роль играет ScrollBar в колонке 1, стоящий
                 и на строке шапки, — полоса начинается сверху, как в таблице. -->
            <ScrollViewer x:Name="RowsScroll" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Hidden">
                <Grid ColumnDefinitions="230,*" VerticalAlignment="Top">
                    <Canvas Grid.Column="0" x:Name="LeftRowsCanvas" ClipToBounds="True" />
                    <!-- Приёмник указателя таймлайна: слои под ним не хит-тестятся,
                         попадание в бары ищется вручную по хит-листу (как в Неделе). -->
                    <Grid Grid.Column="1" x:Name="TimelinePane"
                          Background="Transparent" ClipToBounds="True">
                        <Canvas x:Name="BgCanvas"     IsHitTestVisible="False" />
                        <Canvas x:Name="BarsCanvas"   IsHitTestVisible="False" />
                        <Canvas x:Name="TodayOverlay" IsHitTestVisible="False" />
                        <Canvas x:Name="DragOverlay"  IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </ScrollViewer>

            <TextBlock x:Name="EmptyHint"
                       IsVisible="False"
                       Text="Нет записей"
                       Foreground="{StaticResource BrushSecondaryText}"
                       Margin="24,16"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" />
        </Grid>

        <!-- Вертикальный разделитель панели и таймлайна — в шапке. Продолжение в теле
             рисует BuildBackground: оно обрывается на последней строке. -->
        <Border Classes="separator v" Grid.Row="0"
                HorizontalAlignment="Left" Margin="230,0,0,0" />

        <!-- Полоса прокрутки строк — на всю высоту, включая шапку шкалы. -->
        <ScrollBar Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                   Orientation="Vertical"
                   u:ScrollBarLink.Source="{Binding #RowsScroll}" />

    </Grid>

</UserControl>
