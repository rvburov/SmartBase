<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DataBase.Views.ConstructorDb.Calendar.ListView"
             Background="{StaticResource BrushBg}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  DoubleTapped="OnBackgroundDoubleTapped"
                  ContextRequested="OnBackgroundContextRequested">
        <Border BorderThickness="0"
                BorderBrush="{StaticResource BrushSeparator}"
                Margin="0">
            <Panel>
                <ItemsControl x:Name="EventsList" Padding="4,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,1"
                                    Height="36"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="6"
                                    Background="{Binding BackgroundBrush}"
                                    Tag="{Binding}"
                                    Cursor="Hand"
                                    Tapped="OnEventTapped"
                                    DoubleTapped="OnEventDoubleTapped"
                                    PointerEntered="OnEventPointerEntered"
                                    PointerExited="OnEventPointerExited"
                                    PointerPressed="OnEventPointerPressed"
                                    ContextRequested="OnEventContextRequested">
                                <Grid Margin="0" ColumnDefinitions="Auto,12,*">
                                    <!-- Цветная полоска: отступы слева и сверху/снизу -->
                                    <Border Grid.Column="0" Width="4" CornerRadius="2"
                                            Margin="8,4,0,4"
                                            Background="{Binding ColorBrush}" />
                                    <!-- Информация о событии -->
                                    <StackPanel Grid.Column="2" Spacing="2"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="{StaticResource FontSizeBase}"
                                                   Foreground="{Binding TitleBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DateTimeText}"
                                                   FontSize="{StaticResource FontSizeBase}"
                                                   Foreground="{StaticResource BrushSecondaryText}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyHint"
                           IsVisible="False"
                           Text="Нет записей"
                           FontSize="{StaticResource FontSizeBase}"
                           Foreground="{StaticResource BrushSecondaryText}"
                           Margin="24,16"
                           VerticalAlignment="Top" />
            </Panel>
        </Border>
    </ScrollViewer>

</UserControl>
