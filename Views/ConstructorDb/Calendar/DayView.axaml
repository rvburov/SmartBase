<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="using:SmartBase.Controls.Components"
             xmlns:shapes="using:Avalonia.Controls.Shapes"
             xmlns:local="using:SmartBase.Views.ConstructorDb.Calendar"
             xmlns:b="clr-namespace:SmartBase.Controls.Behaviors"
             x:Class="SmartBase.Views.ConstructorDb.Calendar.DayView"
             Background="{StaticResource BrushBg}">

    <UserControl.Resources>
        <local:HourLineBorderConverter x:Key="HourBorderConv" />
    </UserControl.Resources>

    <!-- Колонка 1 — полосы прокрутки: у блока «весь день» и у сетки времени она СВОЯ,
         каждая напротив своего блока (прокручиваются они независимо). -->
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">

        <!-- AllDayBar -->
        <comp:AllDayBar Grid.Row="0" x:Name="AllDayBarCtrl" />

        <!-- Прокручиваемая сетка событий. Своей полосы нет (Hidden) — ее роль играет
             ScrollBar ниже, напротив сетки: полоса начинается у верхнего края своего
             блока, ниже блока «весь день» с его собственной полосой. -->
        <ScrollViewer Grid.Row="1" x:Name="TimeScroll"
                      VerticalScrollBarVisibility="Hidden">
            <Grid ColumnDefinitions="72,*">

                <!-- Метки часов -->
                <Border Grid.Column="0">
                <ItemsControl x:Name="HourLabels">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="60">
                                <TextBlock Text="{Binding}"
                                           VerticalAlignment="Bottom"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,8,-8"
                                           Foreground="{StaticResource BrushSecondaryText}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </Border>

                <!-- Правая часть: линии + колонка событий -->
                <Grid Grid.Column="1" x:Name="EventsGrid">

                    <!-- Линии часов -->
                    <ItemsControl x:Name="HourRows"
                                  IsHitTestVisible="False"
                                  Height="1440"
                                  VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="60" ClipToBounds="True">
                                    <!-- EdgeMode=Aliased: на дробных позициях (зум ≠ 1) линия
                                         защелкивается в целый пиксель, а не размазывается. -->
                                    <Border BorderBrush="{StaticResource BrushSeparator}"
                                            BorderThickness="{Binding Converter={StaticResource HourBorderConv}}"
                                            RenderOptions.EdgeMode="Aliased"
                                            VerticalAlignment="Top" />
                                    <shapes:Line StartPoint="0,0.5" EndPoint="10000,0.5"
                                                 Margin="0,30,0,0"
                                                 VerticalAlignment="Top"
                                                 HorizontalAlignment="Left"
                                                 Stroke="{StaticResource BrushSeparator}"
                                                 StrokeThickness="{DynamicResource SeparatorThickness}"
                                                 RenderOptions.EdgeMode="Aliased"
                                                 StrokeDashArray="3,3" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 1 колонка с событиями -->
                    <UniformGrid x:Name="WeekColumns"
                                 Columns="1" Height="1440"
                                 VerticalAlignment="Top" />

                    <!-- Оверлей для drag-ghost -->
                    <Canvas x:Name="DragOverlay"
                            IsHitTestVisible="False"
                            Height="1440"
                            VerticalAlignment="Top" />

                </Grid>

            </Grid>
        </ScrollViewer>

        <!-- Дорожка во всю высоту колонки: полоса, которой нечего прокручивать, прячется
             (ScrollBarLink), и без этой подложки на ее месте была бы белая прореха.
             Объявлена ДО полос — они рисуются поверх. -->
        <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                Background="{StaticResource BrushScrollbarTrack}" />

        <!-- Полоса блока «весь день» — напротив него. -->
        <ScrollBar Grid.Column="1" Grid.Row="0"
                   Orientation="Vertical"
                   b:ScrollBarLink.Source="{Binding #AllDayBarCtrl.Scroller}" />

        <!-- Полоса сетки событий — напротив сетки. -->
        <ScrollBar Grid.Column="1" Grid.Row="1"
                   Orientation="Vertical"
                   b:ScrollBarLink.Source="{Binding #TimeScroll}" />

        <!-- Ручка ресайза AllDayBar — «пилюля» как у сайдбара. Вынесена на уровень
             вида и объявлена последней → рисуется поверх сетки и наезжает на
             разделительную линию снизу (отрицательный отступ), не обрезаясь. -->
        <Border x:Name="AllDayResizeGrip"
                Grid.Row="0"
                Width="34" Height="11"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,-6"
                CornerRadius="4"
                Background="{StaticResource BrushBg}"
                BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="{DynamicResource BorderLine}"
                Cursor="SizeNorthSouth">
            <StackPanel Orientation="Horizontal" Spacing="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
                <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
                <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
            </StackPanel>
        </Border>

    </Grid>

</UserControl>
