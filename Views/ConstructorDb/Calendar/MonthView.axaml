<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartBase.Views.ConstructorDb.Calendar.MonthView"
             Background="{StaticResource BrushBg}">

    <Grid RowDefinitions="Auto,*">

        <!-- Заголовки дней недели (линию под ними рисует top верхнего ряда ячеек) -->
        <Border Grid.Row="0">
        <UniformGrid Columns="7"
                     Background="{StaticResource BrushSecondaryBg}">
            <TextBlock Text="Пн" HorizontalAlignment="Center" Padding="0,6"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <TextBlock Text="Вт" HorizontalAlignment="Center" Padding="0,6"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <TextBlock Text="Ср" HorizontalAlignment="Center" Padding="0,6"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <TextBlock Text="Чт" HorizontalAlignment="Center" Padding="0,6"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <TextBlock Text="Пт" HorizontalAlignment="Center" Padding="0,6"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <TextBlock Text="Сб" HorizontalAlignment="Center" Padding="0,6"
                       Foreground="{StaticResource BrushRed}" />
            <TextBlock Text="Вс" HorizontalAlignment="Center" Padding="0,6"
                       Foreground="{StaticResource BrushRed}" />
        </UniformGrid>
        </Border>

        <!-- Сетка дней (рисованные ячейки, см. MonthSurfaces — вставляются в код) + слой линий
             сетки + полосы многодневных (тоже рисованные) + холст призрака перетаскивания.
             Линии — отдельным слоем НАД ячейками (ячейки с текстом алиасить нельзя,
             а hover-заливка ячейки не должна закрашивать линии). -->
        <Grid Grid.Row="1" x:Name="GridContainer">
            <UniformGrid x:Name="GridLines" Columns="7" IsHitTestVisible="False" />
            <Canvas x:Name="SpanCanvas" />
        </Grid>

    </Grid>

</UserControl>
