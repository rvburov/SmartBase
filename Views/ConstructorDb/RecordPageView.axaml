<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
             x:Class="DataBase.Views.ConstructorDb.RecordPageView"
             Background="{StaticResource BrushBg}">

    <Grid x:Name="PageGrid" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Шапка: редактируемое название записи + кнопка «закрыть».
             Стиль текста — как у заголовка коллекции в навбаре конструктора
             (FontSizeLarge, Bold, PrimaryText) — высота 57, отступ 16. -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Height="57"
              Margin="16,0">

            <TextBlock Grid.Column="0" x:Name="TitleDisplay"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Center"
                       FontSize="{StaticResource FontSizeLarge}"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushPrimaryText}"
                       TextTrimming="CharacterEllipsis"
                       Cursor="IBeam"
                       Margin="0,0,12,0" />

            <TextBox Grid.Column="0" x:Name="TitleBox"
                     Classes="titleEditor"
                     IsVisible="False"
                     Watermark="Без названия"
                     VerticalAlignment="Center"
                     FontSize="{StaticResource FontSizeLarge}"
                     FontWeight="{StaticResource FontWeightBold}"
                     Foreground="{StaticResource BrushPrimaryText}"
                     Margin="0,0,12,0" />

            <!-- Toggle блока коллекции -->
            <ToggleButton Grid.Column="1" x:Name="CollectionPanelBtn" Classes="navbtn"
                          Width="30" Height="30"
                          VerticalAlignment="Center"
                          CornerRadius="{StaticResource RadiusMedium}"
                          ToolTip.Tip="Открыть коллекцию">
                <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <!-- arrow-right-from-line: коллекция закрыта → клик откроет (→) -->
                        <Path x:Name="CollectionOpenIcon"
                              Data="M3 5 V19 M21 12 H7 M15 18 L21 12 L15 6"
                              Stroke="{Binding $parent[ToggleButton].Foreground}"
                              StrokeThickness="1.6"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                        <!-- arrow-left-to-line: коллекция открыта → клик закроет (←) -->
                        <Path x:Name="CollectionCloseIcon"
                              IsVisible="False"
                              Data="M3 19 V5 M13 6 L7 12 L13 18 M7 12 H21"
                              Stroke="{Binding $parent[ToggleButton].Foreground}"
                              StrokeThickness="1.6"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                    </Canvas>
                </Viewbox>
            </ToggleButton>

        </Grid>

        <Border Grid.Row="0"
                Height="1"
                VerticalAlignment="Bottom"
                Background="{StaticResource BrushSeparator}" />

        <!-- Свойства (всё кроме системного «Название» и markdown).
             В ScrollViewer: когда ручкой ниже задана пиксельная высота строки и
             свойств больше, чем влезает, — список прокручивается. -->
        <ScrollViewer Grid.Row="1" x:Name="PropertiesScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,20,8">
                <ItemsControl x:Name="PropertiesList" />
            </StackPanel>
        </ScrollViewer>

        <!-- Ручка перетаскивания: делит свойства (сверху) и описание (снизу).
             Тонкая линия-разделитель на всю ширину + плавающая пилюля с точками
             (горизонтальная — как вертикальные ручки сайдбара/панели записи). -->
        <Border Grid.Row="2"
                Height="1"
                VerticalAlignment="Center"
                Background="{StaticResource BrushSeparator}" />

        <Border Grid.Row="2"
                x:Name="PropsResizeGrip"
                Width="34" Height="11"
                Margin="0,3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="4"
                Background="{StaticResource BrushBg}"
                BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="1"
                Cursor="SizeNorthSouth"
                PointerPressed="OnPropsGripPressed"
                PointerMoved="OnPropsGripMoved"
                PointerReleased="OnPropsGripReleased">
            <StackPanel Orientation="Horizontal" Spacing="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
                <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
                <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
            </StackPanel>
        </Border>

        <!-- Markdown-описание -->
        <Grid Grid.Row="3" RowDefinitions="Auto,*" Margin="20,8,20,12">

            <TextBlock Grid.Row="0"
                       Text="Описание"
                       Margin="0,0,0,6"
                       FontSize="{StaticResource FontSizeBase}"
                       Foreground="{StaticResource BrushSecondaryText}"
                       VerticalAlignment="Center" />

            <!-- Редактор: безбордерный (как письмо в заметках) -->
            <TextBox Grid.Row="1" x:Name="MarkdownEditor"
                     Classes="notesEditor"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Watermark="Пишите в Markdown..."
                     FontSize="{StaticResource FontSizeBase}"
                     Background="Transparent" />

            <!-- Превью: тоже без рамки -->
            <Border Grid.Row="1" x:Name="MarkdownPreviewBox"
                    IsVisible="False"
                    Background="Transparent">
                <md:MarkdownScrollViewer x:Name="MarkdownPreview"
                                        Markdown="" />
            </Border>
        </Grid>

        <!-- Нижняя панель записи (как футер коллекции): переключатель режима markdown -->
        <Border Grid.Row="4" Height="57" Background="{StaticResource BrushBg}">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Height="1"
                        Background="{StaticResource BrushSeparator}" />

                <Grid Margin="16,0">
                    <ToggleButton x:Name="PreviewToggle" Classes="navbtn"
                                  Width="30" Height="30"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  CornerRadius="{StaticResource RadiusMedium}"
                                  ToolTip.Tip="Динамический просмотр">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <!-- pencil-line: режим динамического просмотра (виден в режиме редактора) -->
                                <Path x:Name="IconToPreview"
                                      Data="M13 21 H21 M15 5 L19 9 M21.174 6.812 A1 1 0 0 0 17.188 2.825 L3.842 16.174 A2 2 0 0 0 3.342 17.004 L2.021 21.356 A0.5 0.5 0 0 0 2.644 21.978 L6.997 20.658 A2 2 0 0 0 7.827 20.161 Z"
                                      Stroke="{Binding $parent[ToggleButton].Foreground}"
                                      StrokeThickness="1.6"
                                      StrokeLineCap="Round" StrokeJoin="Round" />
                                <!-- code-xml: просмотр исходного текста (виден в режиме просмотра) -->
                                <Path x:Name="IconToSource"
                                      IsVisible="False"
                                      Data="M18 16 L22 12 L18 8 M6 8 L2 12 L6 16 M14.5 4 L9.5 20"
                                      Stroke="{Binding $parent[ToggleButton].Foreground}"
                                      StrokeThickness="1.6"
                                      StrokeLineCap="Round" StrokeJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>
                </Grid>
            </DockPanel>
        </Border>

    </Grid>

</UserControl>
