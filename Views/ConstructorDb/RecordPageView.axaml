<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
             xmlns:comp="using:DataBase.Controls.Components"
             x:Class="DataBase.Views.ConstructorDb.RecordPageView"
             Background="{StaticResource BrushBg}">

    <Grid x:Name="PageGrid" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Шапка записи (вынесена в компонент NavbarPage). -->
        <comp:NavbarPage Grid.Row="0" x:Name="HeaderBar" />

        <!-- Свойства (всё кроме системного «Название» и markdown).
             В ScrollViewer: когда ручкой ниже задана пиксельная высота строки и
             свойств больше, чем влезает, — список прокручивается. -->
        <ScrollViewer Grid.Row="1" x:Name="PropertiesScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,20,0">
                <ItemsControl x:Name="PropertiesList" />
            </StackPanel>
        </ScrollViewer>

        <!-- Ручка перетаскивания: делит свойства (сверху) и описание (снизу).
             Линия-разделитель живёт в своей 1px-строке (Row 2) и не даёт белой полосы.
             Пилюля-ручка ПЛАВАЕТ поверх линии: лежит в строке свойств (Row 1) у нижнего
             края с отрицательным нижним отступом, поэтому центрируется на линии, не
             занимает высоту и не отодвигает контент (как ручки сайдбара/панели записи). -->
        <Border Grid.Row="2"
                Classes="separator h"
                VerticalAlignment="Center" />

        <Border Grid.Row="1"
                x:Name="PropsResizeGrip"
                Width="34" Height="11"
                Margin="0,0,0,-5"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                CornerRadius="4"
                Background="{StaticResource BrushBg}"
                BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="1"
                Cursor="SizeNorthSouth"
                PointerPressed="OnPropsGripPressed"
                PointerMoved="OnPropsGripMoved"
                PointerReleased="OnPropsGripReleased">
            <StackPanel Orientation="Horizontal" Spacing="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
                <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
                <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
            </StackPanel>
        </Border>

        <!-- Markdown-описание -->
        <Grid Grid.Row="3" RowDefinitions="Auto,*" Margin="20,0,20,12">

            <TextBlock Grid.Row="0"
                       Text="Описание"
                       Margin="0,0,0,6"
                       Foreground="{StaticResource BrushSecondaryText}"
                       VerticalAlignment="Center" />

            <!-- Редактор: безбордерный (как письмо в заметках) -->
            <TextBox Grid.Row="1" x:Name="MarkdownEditor"
                     Classes="notesEditor"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Watermark="Пишите в Markdown..."
                     Background="Transparent" />

            <!-- Превью: тоже без рамки -->
            <Border Grid.Row="1" x:Name="MarkdownPreviewBox"
                    IsVisible="False"
                    Background="Transparent">
                <md:MarkdownScrollViewer x:Name="MarkdownPreview"
                                        Markdown="" />
            </Border>
        </Grid>

        <!-- Футер записи (вынесен в компонент FooterPage). -->
        <comp:FooterPage Grid.Row="4" x:Name="FooterBar" />

    </Grid>

</UserControl>
