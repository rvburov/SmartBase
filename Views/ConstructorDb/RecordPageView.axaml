<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="using:SmartBase.Controls.Widgets"
             xmlns:comp="using:SmartBase.Controls.Components"
             xmlns:grid="using:SmartBase.Controls.DrawnGrid"
             x:Class="SmartBase.Views.ConstructorDb.RecordPageView"
             Background="{StaticResource BrushBg}">

    <UserControl.Styles>
        <!-- Карточки свойств рисует поверхность списка (Controls/DrawnGrid/PropertySurface): белая
             плашка на серой подложке блока, hover — чуть притемненный белый, выделение — голубой
             фон + синяя рамка, подпись и иконка синеют; те же токены, что у карточек панели деталей
             (Border.detailRow в Controls.axaml). Стилей карточек здесь больше нет: контролов у
             карточек нет, редакторы значений (TextBox.propValue и другие) ставятся над карточкой
             под указателем. -->

        <!-- Нижний воздух редактора описания — ВНУТРИ его прокрутки, на самом тексте: он
             уезжает вместе со строками, поэтому в середине прокрутки текст доходит до линии
             футера, а отступ виден только в крайнем нижнем положении. Margin'ом снаружи так
             не сделать — там остался бы мертвый зазор (тот же прием, что у класса multiline,
             см. docs/developer/ui/theming.md). -->
        <Style Selector="TextBox#MarkdownEditor /template/ TextPresenter#PART_TextPresenter">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style Selector="TextBox#MarkdownEditor /template/ TextBlock#PART_Watermark">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="PageGrid" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Шапка записи (вынесена в компонент NavbarPage). -->
        <comp:NavbarPage Grid.Row="0" x:Name="HeaderBar" />

        <!-- Свойства, включая системное «Название» (оно же в шапке).
             В ScrollViewer: когда ручкой ниже задана пиксельная высота строки и
             свойств больше, чем влезает, — список прокручивается.
             Фон блока серый: белые карточки свойств читаются на нем как отдельные
             плашки. Серым залита вся строка (по умолчанию 1*, а не высота контента) —
             блок свойств отбит от белой шапки сверху и белого описания снизу. -->
        <ScrollViewer Grid.Row="1" x:Name="PropertiesScroll"
                      Background="{StaticResource BrushSecondaryBg}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <!-- Список свойств рисованный (этап 7 плана drawn-grid.md): карточки и строка
                 «Добавить свойство» — описания из модели (BuildProperties), рисуются только в
                 окне прокрутки; поля списка 16 сверху и по бокам, 10 снизу, зазор 6 — как у
                 прежнего хоста карточек. Панель прокручивается логически внутри этого ScrollViewer:
                 полоса, колесо и смещение — его. -->
            <grid:PropertyList x:Name="PropertiesHost" />
        </ScrollViewer>

        <!-- Ручка перетаскивания: делит свойства (сверху) и описание (снизу).
             Линия-разделитель живет в своей 1px-строке (Row 2) и не дает белой полосы.
             Пилюля-ручка ПЛАВАЕТ поверх линии: лежит в строке свойств (Row 1) у нижнего
             края с отрицательным нижним отступом, поэтому центрируется на линии, не
             занимает высоту и не отодвигает контент (как ручки сайдбара/панели записи). -->
        <Border Grid.Row="2"
                Classes="separator h"
                VerticalAlignment="Center" />

        <Border Grid.Row="1"
                x:Name="PropsResizeGrip"
                Width="34" Height="11"
                Margin="0,0,0,-5"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                CornerRadius="4"
                Background="{StaticResource BrushBg}"
                BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="{DynamicResource BorderLine}"
                Cursor="SizeNorthSouth"
                PointerPressed="OnPropsGripPressed"
                PointerMoved="OnPropsGripMoved"
                PointerReleased="OnPropsGripReleased">
            <StackPanel Orientation="Horizontal" Spacing="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
                <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
                <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
            </StackPanel>
        </Border>

        <!-- Markdown-описание: отступов у САМОГО блока нет — они висят на его содержимом
             (крошка, редактор, превью), по 16px. Иначе полоса прокрутки отошла бы от линий
             сверху и снизу, а текст при прокрутке обрывался бы, не доходя до линии
             (правило ui/theming.md, «полоса прилегает к краю»).

             Полоса вынесена отдельной колонкой (ScrollBarLink, см. ниже): она идет ОТ ЛИНИИ
             ДО ЛИНИИ — от разделителя над крошкой до линии футера, включая строку крошки.
             Собственная полоса редактора/превью выше своих границ подняться не может. -->
        <!-- ClipToBounds — для замороженной ширины (FreezeContentWidth): пока тянут ручку
             ширины панели, редактор шире блока просто подрезается по краю, а не залезает
             на таблицу. -->
        <Grid Grid.Row="3" RowDefinitions="Auto,*" ColumnDefinitions="*,Auto"
              ClipToBounds="True">

            <!-- Заголовок нижнего блока — «хлебная крошка»: «Свойство» › [иконка типа] Имя.
                 Все серым (BrushSecondaryText). Часть [иконка типа + имя] (BottomTitleHost)
                 заполняется в code-behind по активному свойству; «Описание» по умолчанию. -->
            <!-- Нижний зазор крошки (до текста) = верхнему (от линии-разделителя до
                 «Свойство»): «Свойство» отбито сверху и снизу одинаково. -->
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6"
                        Margin="16,16,16,16" VerticalAlignment="Center">
                <TextBlock Text="Свойство"
                           Foreground="{StaticResource BrushSecondaryText}"
                           VerticalAlignment="Center" />
                <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource IconChevronRight}"
                              Stroke="{StaticResource BrushSecondaryText}"
                              StrokeThickness="1.6"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                    </Canvas>
                </Viewbox>
                <StackPanel x:Name="BottomTitleHost" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center" />
            </StackPanel>

            <!-- Редактор: безбордерный (как письмо в заметках). Своей полосы не рисует —
                 ее роль играет вынесенная (Hidden = прокрутка есть, полосы нет). Нижний
                 воздух задан не здесь, а Margin'ом текста ВНУТРИ прокрутки (стиль
                 TextBox#MarkdownEditor выше): снаружи он оставил бы зазор над линией, в
                 который текст не заезжает. -->
            <TextBox Grid.Row="1" Grid.Column="0" x:Name="MarkdownEditor"
                     Classes="notesEditor"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Watermark="Пишите в Markdown..."
                     Margin="16,0,16,0"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     Background="Transparent" />

            <!-- Превью: обычный ScrollViewer приложения, markdown внутри него разворачивается
                 на весь текст (см. docs/developer/ui/markdown.md). Виджет AppMarkdown — тот же
                 разбор и тот же вид, что в инструкции пользователя и в описаниях расширений.
                 Воздух — на содержимом ВНУТРИ прокрутки, поэтому нижние 16px уезжают вместе
                 с текстом и в середине прокрутки текст идет по линии. -->
            <ScrollViewer Grid.Row="1" Grid.Column="0" x:Name="MarkdownPreviewBox"
                          IsVisible="False"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <Panel>
                    <w:AppMarkdown x:Name="MarkdownPreview"
                                   Markdown=""
                                   Margin="16,0,16,16" />
                    <!-- «Название» в просмотре — простым текстом: разметку оно не несет, и
                         «1. Позвонить» не должно становиться списком. Высота строки — как у
                         абзаца Markdown (ставит UpdatePreviewVisibility). -->
                    <SelectableTextBlock x:Name="PlainPreview"
                                         IsVisible="False"
                                         TextWrapping="Wrap"
                                         FontSize="{DynamicResource FontSizeBase}"
                                         Foreground="{StaticResource BrushPrimaryText}"
                                         Margin="16,0,16,16" />
                </Panel>
            </ScrollViewer>

            <!-- Общая полоса блока: одна на редактор и превью (виден всегда ровно один),
                 источник переключается вместе с режимом — UpdatePreviewVisibility. -->
            <ScrollBar Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                       x:Name="BottomScrollBar"
                       Orientation="Vertical"
                       IsVisible="False" />
        </Grid>

        <!-- Футер записи (вынесен в компонент FooterPage). -->
        <comp:FooterPage Grid.Row="4" x:Name="FooterBar" />

    </Grid>

</UserControl>
