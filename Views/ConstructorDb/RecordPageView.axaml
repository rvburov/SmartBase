<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="using:SmartBase.Controls.Widgets"
             xmlns:comp="using:SmartBase.Controls.Components"
             x:Class="SmartBase.Views.ConstructorDb.RecordPageView"
             Background="{StaticResource BrushBg}">

    <UserControl.Styles>
        <!-- Карточка свойства: иконка типа + название · ручка-разделитель · значение.
             Карточка белая на серой подложке блока свойств (PropertiesScroll) — фон нужен
             явный, прозрачный дал бы серый. Hover — чуть притемненный белый (на сером фоне
             серая подложка hover'а слила бы карточку с подложкой блока); выделение (клик) —
             голубой фон + синяя рамка, как выбранная строка сайдбара. -->
        <Style Selector="Border.proprow">
            <Setter Property="Background"      Value="{StaticResource BrushBg}" />
            <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderLine}" />
            <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
            <Setter Property="Padding"         Value="10,3" />
            <Setter Property="MinHeight"       Value="40" />
            <Setter Property="Cursor"          Value="Hand" />
        </Style>
        <Style Selector="Border.proprow:pointerover">
            <Setter Property="Background" Value="{StaticResource BrushInactiveBg}" />
        </Style>
        <Style Selector="Border.proprow.selected, Border.proprow.selected:pointerover">
            <Setter Property="Background"  Value="{StaticResource BrushAccentLight}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
        </Style>

        <!-- Иконка типа и подпись свойства: серые по умолчанию, синие в выделенной карточке. -->
        <Style Selector="Border.proprow TextBlock.propname">
            <Setter Property="Foreground" Value="{StaticResource BrushSecondaryText}" />
        </Style>
        <Style Selector="Border.proprow Path.propicon">
            <Setter Property="Stroke" Value="{StaticResource BrushSecondaryText}" />
        </Style>
        <Style Selector="Border.proprow.selected TextBlock.propname">
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
        </Style>
        <Style Selector="Border.proprow.selected Path.propicon">
            <Setter Property="Stroke" Value="{StaticResource BrushAccent}" />
        </Style>

        <!-- Ручка-разделитель (три вертикальные точки ⋮) между названием и значением.
             Тянем влево/вправо — меняем общую ширину колонки названий у всех свойств. -->
        <Style Selector="Border.propgrip">
            <Setter Property="Background"          Value="Transparent" />
            <Setter Property="Width"               Value="18" />
            <Setter Property="VerticalAlignment"   Value="Stretch" />
            <Setter Property="Cursor"              Value="SizeWestEast" />
        </Style>

        <!-- Строка «Добавить свойство» — такая же карточка, как у свойств (белая на серой
             подложке, рамка, скругление, высота, отступы), только с иконкой «+» и подписью. -->
        <Style Selector="Border.addprop">
            <Setter Property="Background"      Value="{StaticResource BrushBg}" />
            <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderLine}" />
            <Setter Property="CornerRadius"    Value="{StaticResource RadiusMedium}" />
            <Setter Property="Padding"         Value="10,3" />
            <Setter Property="MinHeight"       Value="40" />
            <Setter Property="Cursor"          Value="Hand" />
        </Style>
        <Style Selector="Border.addprop:pointerover">
            <Setter Property="Background" Value="{StaticResource BrushInactiveBg}" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="PageGrid" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Шапка записи (вынесена в компонент NavbarPage). -->
        <comp:NavbarPage Grid.Row="0" x:Name="HeaderBar" />

        <!-- Свойства (все кроме системного «Название» и markdown).
             В ScrollViewer: когда ручкой ниже задана пиксельная высота строки и
             свойств больше, чем влезает, — список прокручивается.
             Фон блока серый: белые карточки свойств читаются на нем как отдельные
             плашки. Серым залита вся строка (по умолчанию 1*, а не высота контента) —
             блок свойств отбит от белой шапки сверху и белого описания снизу. -->
        <ScrollViewer Grid.Row="1" x:Name="PropertiesScroll"
                      Background="{StaticResource BrushSecondaryBg}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <!-- Карточки свойств и строка «Добавить свойство» строятся в code-behind
                 (BuildProperties). Отступ снизу равен верхнему — блок не липнет к описанию. -->
            <StackPanel x:Name="PropertiesHost" Margin="16,16,16,16" Spacing="6" />
        </ScrollViewer>

        <!-- Ручка перетаскивания: делит свойства (сверху) и описание (снизу).
             Линия-разделитель живет в своей 1px-строке (Row 2) и не дает белой полосы.
             Пилюля-ручка ПЛАВАЕТ поверх линии: лежит в строке свойств (Row 1) у нижнего
             края с отрицательным нижним отступом, поэтому центрируется на линии, не
             занимает высоту и не отодвигает контент (как ручки сайдбара/панели записи). -->
        <Border Grid.Row="2"
                Classes="separator h"
                VerticalAlignment="Center" />

        <Border Grid.Row="1"
                x:Name="PropsResizeGrip"
                Width="34" Height="11"
                Margin="0,0,0,-5"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                CornerRadius="4"
                Background="{StaticResource BrushBg}"
                BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="{DynamicResource BorderLine}"
                Cursor="SizeNorthSouth"
                PointerPressed="OnPropsGripPressed"
                PointerMoved="OnPropsGripMoved"
                PointerReleased="OnPropsGripReleased">
            <StackPanel Orientation="Horizontal" Spacing="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
                <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
                <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
            </StackPanel>
        </Border>

        <!-- Markdown-описание: отступы 16px по кругу (крошка «Свойство» и редактор вровень с
             левым краем блока свойств и заголовком записи). Правого отступа у Grid нет — он
             вернулся крошке и превью отдельно, чтобы полоса прокрутки редактора/превью
             прилегала к краю панели. -->
        <Grid Grid.Row="3" RowDefinitions="Auto,*" Margin="16,16,0,16">

            <!-- Заголовок нижнего блока — «хлебная крошка»: «Свойство» › [иконка типа] Имя.
                 Все серым (BrushSecondaryText). Часть [иконка типа + имя] (BottomTitleHost)
                 заполняется в code-behind по активному свойству; «Описание» по умолчанию. -->
            <!-- Нижний зазор крошки (до текста) = верхнему отступу блока (Margin.Top=16,
                 от линии-разделителя до «Свойство»): «Свойство» отбито сверху и снизу одинаково. -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6"
                        Margin="0,0,16,16" VerticalAlignment="Center">
                <TextBlock Text="Свойство"
                           Foreground="{StaticResource BrushSecondaryText}"
                           VerticalAlignment="Center" />
                <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource IconChevronRight}"
                              Stroke="{StaticResource BrushSecondaryText}"
                              StrokeThickness="1.6"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                    </Canvas>
                </Viewbox>
                <StackPanel x:Name="BottomTitleHost" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center" />
            </StackPanel>

            <!-- Редактор: безбордерный (как письмо в заметках) -->
            <TextBox Grid.Row="1" x:Name="MarkdownEditor"
                     Classes="notesEditor"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Watermark="Пишите в Markdown..."
                     Background="Transparent" />

            <!-- Превью: тоже без рамки -->
            <Border Grid.Row="1" x:Name="MarkdownPreviewBox"
                    IsVisible="False"
                    Background="Transparent">
                <!-- Виджет AppMarkdown, а не голый MarkdownScrollViewer: вид берется из общего
                     Assets/Styles/Markdown.axaml — тот же, что в инструкции пользователя и в
                     описаниях расширений (см. docs/developer/ui/markdown.md).
                     Без правого отступа: полоса прокрутки превью прилегает к краю панели
                     (Padding у контрола нет — отбить только текст нечем). -->
                <w:AppMarkdown x:Name="MarkdownPreview"
                               Markdown="" />
            </Border>
        </Grid>

        <!-- Футер записи (вынесен в компонент FooterPage). -->
        <comp:FooterPage Grid.Row="4" x:Name="FooterBar" />

    </Grid>

</UserControl>
