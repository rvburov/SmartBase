<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyPlanner.Views.ConstructorDb.TableView"
             Background="{StaticResource BrushBg}">

    <!-- Переопределяем встроенные кисти линий DataGrid из темы Fluent на единый
         цвет BrushSeparator — иначе тема рисует разделитель под шапкой более тёмным,
         чем горизонтальные линии между строками. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="DataGridGridLinesBrush"             Color="{StaticResource ColorSeparator}" />
        <SolidColorBrush x:Key="DataGridFillerColumnGridLinesBrush" Color="{StaticResource ColorSeparator}" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="DataGridCell">
            <Setter Property="Padding"         Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize"        Value="{StaticResource FontSizeBase}" />
            <Setter Property="Foreground"      Value="{StaticResource BrushPrimaryText}" />
        </Style>
        <Style Selector="DataGridCell:current /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill"    Value="{StaticResource BrushSecondaryBg}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill"    Value="{StaticResource BrushAccentLight}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill"    Value="{StaticResource BrushAccentLight}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="DataGridRow:selected DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
        </Style>

        <!-- Левый бордер контента совпадает с той же координатой X, где DataGrid рисует
             вертикальные линии строк — гарантированное выравнивание без субпиксельных артефактов. -->
        <Style Selector="DataGridColumnHeader">
            <Setter Property="UseLayoutRounding"          Value="True" />
            <Setter Property="Background"                 Value="{StaticResource BrushInactiveBg}" />
            <Setter Property="Padding"                    Value="0" />
            <Setter Property="Height"                     Value="{StaticResource RowHeightStandard}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment"   Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- Нижнюю линию под шапкой рисуем сами тем же цветом, что и линии сетки
                         (BrushSeparator), чтобы она не отличалась от межстрочных. Встроенный
                         разделитель темы Fluent гасится переопределением ресурсов ниже. -->
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BrushSeparator}"
                            BorderThickness="0,0,0,1">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <!-- DataGrid + накладная рамка выделенной колонки (позиционируется в коде). -->
    <Panel>
        <DataGrid x:Name="RecordsGrid"
                  AutoGenerateColumns="False"
                  RowHeight="{StaticResource RowHeightStandard}"
                  CanUserResizeColumns="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="False"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="{StaticResource BrushSeparator}"
                  VerticalGridLinesBrush="{StaticResource BrushSeparator}"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  IsReadOnly="False"
                  Background="Transparent"
                  UseLayoutRounding="True"
                  RowBackground="{StaticResource BrushBg}"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Foreground="{StaticResource BrushPrimaryText}" />

        <!-- Слой голубых рамок выделенных колонок (по одной на колонку). Рамки
             добавляются в коде (RefreshColumnHighlights). IsHitTestVisible=False —
             клики проходят сквозь слой в таблицу. -->
        <Canvas x:Name="ColumnHighlightLayer"
                IsHitTestVisible="False" />

        <!-- Слой прозрачных полосок-«грипперов» у нижней границы строк для ручного
             изменения высоты. В отличие от слоя рамок — кликабельный (ловит drag).
             Полоски строятся в коде (RefreshRowResizeHandles) только в ручном режиме. -->
        <Canvas x:Name="RowResizeLayer"
                IsHitTestVisible="True" />
    </Panel>

</UserControl>
