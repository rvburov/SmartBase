<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:grid="using:SmartBase.Views.ConstructorDb.DrawnGrid"
             x:Class="SmartBase.Views.ConstructorDb.TableView"
             Background="{StaticResource BrushBg}">

    <!-- Таблица коллекции — рисованная сетка (Views/ConstructorDb/DrawnGrid, план drawn-grid.md):
         шапку, ячейки, линии, цвета, выделение и наведение рисует GridSurface, контролов в кадре
         нет. Единственный контрол над ячейкой — накладной редактор (EditorHost, холст с классом
         cellEditor), и стили ниже — только про него. -->
    <UserControl.Styles>
        <!-- Шрифт и цвет текста редактора — те же, что у нарисованных ячеек. -->
        <Style Selector="Canvas.cellEditor">
            <Setter Property="TextElement.FontSize"   Value="{DynamicResource FontSizeBase}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource BrushPrimaryText}" />
        </Style>

        <!-- Редакторы В ЯЧЕЙКЕ — без скруглений. Рамка правки стоит там же, где рамка выделения
             ячейки, а та прямоугольная (садится на линии сетки): одно и то же место таблицы не
             должно выглядеть то квадратным, то круглым. Скругления остаются у тех же полей вне
             таблицы — в панели записи и в окнах. -->
        <!-- Фон редактора — прозрачный по умолчанию и цвет ячейки у окрашенной (его ставит
             ApplyEditorCellStyle прямо редактору). Серая плашка поля формы перекрывала бы и цвет
             ячейки, и подсветку выделенной колонки/строки — ячейка на клике «выцветала».

             Тема Fluent в состояниях :pointerover и :focus подменяет фон внутренней рамки СВОЕЙ
             кистью, перебивая TemplateBinding, — поэтому во всех трех состояниях возвращаем ее
             на фон самого редактора. Иначе фокус (а он в правке всегда) красил бы ячейку белым. -->
        <!-- СВОЕЙ рамки у редактора ячейки нет ни в одном состоянии. Тема Fluent рисует
             сфокусированному полю синюю рамку в 2px прямо в шаблоне, перебивая BorderThickness
             самого поля, — и она на линию сетки УЖЕ ячейки. Рамка ровно одна — рамка выделения,
             ее рисует слой сетки над редактором (SelectionOverlay), и в правке она не гаснет.

             MinHeight — ноль: стандарт поля формы (30) выше «компактной» строки таблицы (28), и
             редактор распирал бы строку. Высоту задает ячейка. -->
        <Style Selector="Canvas.cellEditor TextBox">
            <Setter Property="CornerRadius"    Value="0" />
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="MinHeight"       Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="LineHeight"      Value="{DynamicResource LineHeightBase}" />
        </Style>
        <!-- ЦЕЛАЯ высота строки — одна на показ и правку. Естественная высота строки шрифта
             дробная, и надпись с полем округляют ее по разным сеткам (целый DIP против
             1/RenderScaling): боксы выходили разной высоты, каждый центрировался в ячейке своим
             округлением, и текст опускался на пиксель при входе в правку. Целый LineHeight (токен
             пишет FontScale.Write) уравнивает боксы на любой сетке; сетка рисует текст ячеек той
             же высотой строки. Стережет Tests/EditGeometry. -->
        <Style Selector="Canvas.cellEditor TextBlock">
            <Setter Property="LineHeight" Value="{DynamicResource LineHeightBase}" />
        </Style>
        <Style Selector="Canvas.cellEditor TextBox /template/ Border#PART_BorderElement">
            <Setter Property="CornerRadius"    Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background"      Value="{Binding $parent[TextBox].Background}" />
        </Style>
        <Style Selector="Canvas.cellEditor TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background"      Value="{Binding $parent[TextBox].Background}" />
        </Style>
        <Style Selector="Canvas.cellEditor TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background"      Value="{Binding $parent[TextBox].Background}" />
        </Style>
        <Style Selector="Canvas.cellEditor ComboBox">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background"   Value="Transparent" />
        </Style>
        <!-- То же для списка: копия темы подменяет фон рамки по наведению и нажатию. -->
        <Style Selector="Canvas.cellEditor ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{Binding $parent[ComboBox].Background}" />
        </Style>
        <Style Selector="Canvas.cellEditor ComboBox:pressed /template/ Border#Background">
            <Setter Property="Background" Value="{Binding $parent[ComboBox].Background}" />
        </Style>
        <Style Selector="Canvas.cellEditor Border.timeField">
            <Setter Property="CornerRadius" Value="0" />
        </Style>
    </UserControl.Styles>

    <!-- Сетка и над ней — плашки (например, «Папка недоступна» под ячейкой файла). -->
    <Panel x:Name="Root">
        <grid:GridPanel x:Name="RecordsGrid" />
    </Panel>

</UserControl>
