<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyPlanner.Views.ConstructorDb.TableView"
             Background="{StaticResource BrushBg}">

    <UserControl.Styles>
        <!-- Высота строки фиксируется через DataGrid.RowHeight (пробивает тему Fluent).
             Вертикальные линии — встроенные (GridLinesVisibility=All); они не «схлопываются»,
             потому что ширины колонок вычисляются в целых пикселях (см. ApplyColumnWidths). -->
        <Style Selector="DataGridCell">
            <Setter Property="Padding"         Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize"        Value="{StaticResource FontSizeBase}" />
            <Setter Property="Foreground"      Value="{StaticResource BrushPrimaryText}" />
        </Style>
        <Style Selector="DataGridCell:current /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Эффекты как в SidebarTree -->
        <!-- Наведение на строку → светло-серый фон (#F2F2F7) -->
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill"    Value="{StaticResource BrushSecondaryBg}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- Выбор строки → голубой фон (#E5F0FF) -->
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill"    Value="{StaticResource BrushAccentLight}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- Выбранная строка имеет приоритет над наведением -->
        <Style Selector="DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill"    Value="{StaticResource BrushAccentLight}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- Текст ячеек выбранной строки → синий (#007AFF) -->
        <Style Selector="DataGridRow:selected DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
        </Style>
    </UserControl.Styles>

    <!-- Двухрядная разметка: фиксированный кастомный header сверху + скроллируемый DataGrid.
         Нативная шапка DataGrid отключена (HeadersVisibility="None"), потому что
         DataGridColumnHeader в Avalonia ненадёжно рендерит узкие/Control-заголовки. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Sticky header: ширины колонок синхронизируются с RecordsGrid в SyncHeaderWidths. -->
        <Border Grid.Row="0"
                x:Name="HeaderRowHost"
                Background="{StaticResource BrushInactiveBg}"
                Height="{StaticResource RowHeightStandard}" />

        <!-- Margin Bottom=-1 прячет лишнюю линию: при скролле до конца под последней
             строкой видна её BottomGridLine + нижний край DataGrid области, что
             выглядит как двойная линия. Сдвигаем DataGrid на 1px вниз, лишняя
             линия уходит за пределы видимости. -->
        <DataGrid Grid.Row="1"
                  x:Name="RecordsGrid"
                  Margin="0,0,0,-1"
                  AutoGenerateColumns="False"
                  RowHeight="{StaticResource RowHeightStandard}"
                  CanUserResizeColumns="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="False"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="{StaticResource BrushSeparator}"
                  VerticalGridLinesBrush="{StaticResource BrushSeparator}"
                  HeadersVisibility="None"
                  SelectionMode="Single"
                  IsReadOnly="False"
                  Background="Transparent"
                  BorderThickness="0"
                  RowBackground="{StaticResource BrushBg}"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Foreground="{StaticResource BrushPrimaryText}" />
    </Grid>

</UserControl>
