<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartBase.Views.ConstructorDb.TableView"
             Background="{StaticResource BrushBg}">

    <!-- Переопределяем встроенные кисти линий DataGrid из темы Fluent на единый
         цвет BrushSeparator — иначе тема рисует разделитель под шапкой более тёмным,
         чем горизонтальные линии между строками. Локальные копии тем DataGrid
         (TableViewDataGridThemes.axaml) дают линиям сетки динамическую толщину
         SeparatorThickness — см. комментарий в том файле. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://SmartBase/Views/ConstructorDb/TableViewDataGridThemes.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="DataGridGridLinesBrush"             Color="{StaticResource ColorSeparator}" />
            <SolidColorBrush x:Key="DataGridFillerColumnGridLinesBrush" Color="{StaticResource ColorSeparator}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="DataGridCell">
            <Setter Property="Padding"         Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeBase}" />
            <Setter Property="Foreground"      Value="{StaticResource BrushPrimaryText}" />
        </Style>
        <Style Selector="DataGridCell:current /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- Фокус-рамку ячейки не показываем и когда ячейка получает клавиатурный фокус
             (интерактивный контент read-only-колонок: «файл» и т.п. — иначе тема рисует
             чёрный прямоугольник вокруг ячейки). -->
        <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Толщина линий сетки — динамический токен LineMetrics (визуально ~1 пиксель
             при любом зуме/DPI). Задаётся стилями, а не в шаблоне: локальные Width/Height
             из копий тем убраны (TableViewDataGridThemes.axaml, отличие 1).
             EdgeMode=Aliased (атрибутом в самих шаблонах — сеттеру стиля RenderOptions
             недоступен) — без сглаживания: на дробных позициях (зум ≠ 1) линия
             защёлкивается в целый физический пиксель вместо размазывания по соседним. -->
        <Style Selector="DataGridCell /template/ Rectangle#PART_RightGridLine">
            <Setter Property="Width"             Value="{DynamicResource SeparatorThickness}" />
            <Setter Property="UseLayoutRounding" Value="{DynamicResource LineUseLayoutRounding}" />
        </Style>
        <Style Selector="DataGridRow /template/ Rectangle#PART_BottomGridLine">
            <Setter Property="Height"            Value="{DynamicResource SeparatorThickness}" />
            <Setter Property="UseLayoutRounding" Value="{DynamicResource LineUseLayoutRounding}" />
        </Style>
        <Style Selector="DataGrid /template/ Rectangle#PART_ColumnHeadersAndRowsSeparator">
            <Setter Property="Height"            Value="{DynamicResource SeparatorThickness}" />
            <Setter Property="UseLayoutRounding" Value="{DynamicResource LineUseLayoutRounding}" />
        </Style>

        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill"    Value="{StaticResource BrushSecondaryBg}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill"    Value="{StaticResource BrushAccentLight}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill"    Value="{StaticResource BrushAccentLight}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- ВНИМАНИЕ: этот сеттер до текста НЕ доходит и цвет выделенной строки не меняет.
             Foreground ячейки тема отдаёт ContentPresenter'у, а дальше значение только
             НАСЛЕДУЕТСЯ — и проигрывает глобальному стилю «Style Selector="TextBlock"»
             (Typography.axaml), который задаёт цвет всем надписям приложения. Оставлен как
             есть: заработает сам, если тот глобальный сеттер когда-нибудь уберут. Цвет
             текста ячейки, выбранный пользователем, ставится по-другому — локальным
             значением самим надписям, см. CellStyleHost в code-behind. -->
        <Style Selector="DataGridRow:selected DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
        </Style>

        <!-- Заголовки ПРОЗРАЧНЫЕ: фон строки заголовков рисуется одним прямоугольником
             на всю ширину в шаблоне DataGrid (TableViewDataGridThemes.axaml) — иначе
             непрозрачный сосед закрашивал правую линию предыдущего заголовка (ячейка
             при округлении растёт вверх). Линию под шапкой рисует нативный
             PART_ColumnHeadersAndRowsSeparator той же толщины, что линии строк. -->
        <Style Selector="DataGridColumnHeader">
            <!-- Округление раскладки — динамическое, СИНХРОННО с ячейками и DataGrid:
                 при зуме ≠ 1 ширины колонок кратны физическому пикселю (снап), а сетка
                 округления другая (1/DPI) — округление растягивало бы ячейки вверх,
                 и непрозрачный сосед закрашивал линию предыдущей колонки. -->
            <Setter Property="UseLayoutRounding"          Value="{DynamicResource LineUseLayoutRounding}" />
            <Setter Property="Background"                 Value="Transparent" />
            <Setter Property="Padding"                    Value="0" />
            <Setter Property="Height"                     Value="{StaticResource RowHeightStandard}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment"   Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <!-- ВНИМАНИЕ по линиям сетки. Линии рисует НАТИВНАЯ сетка DataGrid
         (GridLinesVisibility="All"): цвет — BrushSeparator, толщина — динамический токен
         SeparatorThickness через локальные копии тем (TableViewDataGridThemes.axaml),
         те же, что у линий всего приложения (Border.separator, Controls.axaml).
         НЕ переводить на линии-Border в ячейках без проверки на Windows.
         Вертикальные линии ЗАГОЛОВКОВ — Rectangle в тех же слотах Grid
         "*,Auto", что и в ячейках (MakeCenteredHeader/MakeTextHeader) — округляются
         одинаково с линиями строк и совпадают с ними по X при любом зуме/DPI.
         Выделение колонки — голубая ЗАЛИВКА ячеек значений (как у выделенной записи):
         фон ContentPresenter'а ячейки, звёздная колонка её сетки, поэтому линии не
         перекрываются. Шапка не красится (см. ColumnSelectionBrush в code-behind). -->
    <Panel>
        <DataGrid x:Name="RecordsGrid"
                  AutoGenerateColumns="False"
                  RowHeight="{StaticResource RowHeightStandard}"
                  CanUserResizeColumns="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="False"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="{StaticResource BrushSeparator}"
                  VerticalGridLinesBrush="{StaticResource BrushSeparator}"
                  HeadersVisibility="Column"
                  SelectionMode="Extended"
                  IsReadOnly="False"
                  Background="Transparent"
                  UseLayoutRounding="{DynamicResource LineUseLayoutRounding}"
                  RowBackground="{StaticResource BrushBg}"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  />

        <!-- Слой прозрачных полосок-«грипперов» у нижней границы строк для ручного
             изменения высоты — кликабельный (ловит drag). Полоски строятся в коде
             (RefreshRowResizeHandles) только в ручном режиме. -->
        <Canvas x:Name="RowResizeLayer"
                IsHitTestVisible="True" />
    </Panel>

</UserControl>
