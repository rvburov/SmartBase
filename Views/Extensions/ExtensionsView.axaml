<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="using:SmartBase.Controls.Widgets"
             xmlns:comp="using:SmartBase.Controls.Components"
             x:Class="SmartBase.Views.Extensions.ExtensionsView"
             Background="{StaticResource BrushBg}">

    <DockPanel>

        <!-- Навбар (вынесен в компонент NavbarExtensions). -->
        <comp:NavbarExtensions DockPanel.Dock="Top" x:Name="HeaderBar" />

        <!-- Тело блока: описание расширения в Markdown. Виджет AppMarkdown — единственный
             способ показывать разметку: и разбор, и вид у него одни на все приложение
             (см. docs/developer/ui/markdown.md).

             Прокрутка — ОБЫЧНЫЙ ScrollViewer приложения, а не собственная у контрола
             markdown: полоса тогда идет во всю высоту блока (от линии навбара до низа) и
             прилегает к краю, а воздух вокруг текста висит на содержимом ВНУТРИ прокрутки
             и уезжает вместе с ним — сверху и снизу отступ виден только в крайних
             положениях, в середине текст идет от линии (правило theming.md, эталон —
             панели настроек и «Инструкция пользователя»).

             Своя прокрутка контролу при этом не мешает: внутри ScrollViewer высота не
             ограничена, поэтому он разворачивается на весь текст, а прокручивает внешний.
             Отступ содержимого задан здесь еще и потому, что у типа нет Padding вовсе. -->
        <ScrollViewer x:Name="DescriptionScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <w:AppMarkdown x:Name="DescriptionMd"
                           Markdown=""
                           Margin="16,16,16,32" />
        </ScrollViewer>

    </DockPanel>

</UserControl>
