<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
             x:Class="DataBase.Views.Extensions.ExtensionsView"
             Background="{StaticResource BrushBg}">

    <DockPanel>

        <!-- Навбар (высота 56): слева — имя расширения, справа — кнопка запуска -->
        <Border DockPanel.Dock="Top" Height="56" Padding="32,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="TitleText"
                           Grid.Column="0"
                           Text="Расширения"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeLarge}"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushPrimaryText}" />

                <Button x:Name="RunBtn"
                        Grid.Column="1"
                        Classes="dialog"
                        Content="Запустить"
                        VerticalAlignment="Center"
                        Click="OnRunClick" />
            </Grid>
        </Border>

        <!-- Тело блока: описание расширения в Markdown -->
        <md:MarkdownScrollViewer x:Name="DescriptionMd"
                                 Markdown=""
                                 Margin="32,16,32,32" />

    </DockPanel>

</UserControl>
