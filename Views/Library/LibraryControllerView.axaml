<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="using:SmartBase.Controls.Components"
             xmlns:lib="using:SmartBase.Views.Library"
             x:Class="SmartBase.Views.Library.LibraryControllerView">

    <Grid RowDefinitions="Auto,*">

        <!-- Навбар: заголовок, выпадашка типов документа, поиск, вид. Линию под навбаром не
             рисуем — ее рисует MainWindow (как в календаре и задачах). -->
        <comp:NavbarLibrary Grid.Row="0" x:Name="NavbarControl" />

        <!-- Оверлея на весь блок здесь нет намеренно: долгая загрузка говорит о себе строкой
             в подвале блока поиска, а лента остается на экране. См. DocStatus. -->
        <lib:DocListView Grid.Row="1" x:Name="DocList" />

    </Grid>

</UserControl>
