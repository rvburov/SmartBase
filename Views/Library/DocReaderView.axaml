<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="using:SmartBase.Controls.Behaviors"
             x:Class="SmartBase.Views.Library.DocReaderView"
             Background="{StaticResource BrushBg}">

    <!-- Панель чтения документа — правая панель раздела «Библиотека документов», та же
         колонка главного окна, что у страницы записи в конструкторе (MainWindow.axaml).
         Разделитель слева, ручка ширины и сохранение ширины — общие с ней, здесь только
         содержимое панели.

         Режима два. «Текст» есть у всякого документа, который мы умеем читать. «Как в
         документе» показывает настоящие страницы PDF либо настоящую таблицу листа Excel —
         кнопка одна, потому что для человека это одно желание: увидеть документ, а не его
         текст.

         Текст читается заново из файла, а НЕ берется из кеша поиска: кеш хранит текст, у
         которого схлопнут всякий пробельный знак, включая переводы строк (так надо индексу),
         и на экране это была бы одна бесконечная строка без абзацев. Разбор для чтения живет
         в Core/Documents/DocReadText.cs. -->

    <UserControl.Styles>
        <!-- Строки документа: список без всякого вида списка. ListBox взят не ради выделения,
             а ради ДВУХ вещей, которых нет у ItemsControl: виртуализации (документ бывает в
             миллион знаков) и ScrollIntoView — им панель прыгает к следующему совпадению. -->
        <Style Selector="ListBox.reader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding"    Value="0" />
        </Style>
        <Style Selector="ListBox.reader ListBoxItem">
            <Setter Property="Padding"   Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Cursor"    Value="IBeam" />
        </Style>
        <!-- Выделения у строк нет вовсе: текущее совпадение видно по самой подсветке слова,
             а синяя строка поверх желтого слова читалась бы как «выбрано», хотя выбирать тут
             нечего. -->
        <Style Selector="ListBox.reader ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.reader ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">

        <!-- ── Шапка: название документа и раскрытие панели ─────────────────────────── -->
        <Grid Grid.Row="0" Height="56" Margin="16,0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1" Margin="0,0,8,0">
                <TextBlock x:Name="TitleLabel"
                           Text="Документ"
                           FontSize="{DynamicResource FontSizeLarge}"
                           FontWeight="{StaticResource FontWeightBold}"
                           TextTrimming="CharacterEllipsis" />
                <!-- Подпись говорит, ЧТО открыто: имя файла и где он лежит. Без нее у двух
                     одноименных записей панель выглядит одинаково. -->
                <TextBlock x:Name="SubtitleLabel"
                           Text=""
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{StaticResource BrushSecondaryText}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <ToggleButton Grid.Column="1" x:Name="ListPanelBtn" Classes="navbtn"
                          Width="30" Height="30"
                          VerticalAlignment="Center"
                          CornerRadius="{StaticResource RadiusMedium}"
                          ToolTip.Tip="Развернуть документ">
                <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="ListOpenIcon"
                              Data="{StaticResource IconArrowRightFromLine}"
                              Stroke="{Binding $parent[ToggleButton].Foreground}"
                              StrokeThickness="{StaticResource IconStrokeMedium}"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                        <Path x:Name="ListCloseIcon"
                              Data="{StaticResource IconArrowLeftToLine}"
                              Stroke="{Binding $parent[ToggleButton].Foreground}"
                              StrokeThickness="{StaticResource IconStrokeMedium}"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                    </Canvas>
                </Viewbox>
            </ToggleButton>
        </Grid>

        <Border Grid.Row="1" Classes="separator h" />

        <!-- ── Режим показа ─────────────────────────────────────────────────── -->
        <!-- «Текст» есть у всякого документа, который мы умеем читать. «Как в документе» —
             у PDF (страницы) и у книг Excel (таблица листа). У Word и текстовых файлов кнопка
             видна, но погашена: верстку Word нам нечем воспроизвести, а у текстового файла
             «настоящего вида» и не бывает. Спрятать кнопку значило бы менять ширину полосы от
             документа к документу.

             Почему кнопка погашена, говорит подсказка (DocModeHint). ShowOnDisabled — не
             украшение: у погашенной кнопки подсказка по умолчанию не показывается, и все
             объяснения молчали. -->
        <Border Grid.Row="2" Classes="modeseg"
                HorizontalAlignment="Left"
                Margin="16,12,16,0">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <ToggleButton x:Name="TextModeBtn"  Classes="modeseg" Content="Текст" IsChecked="True" />
                <ToggleButton x:Name="DocModeBtn" Classes="modeseg" Content="Как в документе"
                              ToolTip.ShowOnDisabled="True" />
            </StackPanel>
        </Border>

        <!-- ── Строка поиска внутри документа ───────────────────────────────── -->
        <!-- Запрос приезжает из поиска раздела: человек нашел документ по слову и нажал
             «Прочитать» — искать это слово второй раз руками он не должен. Дальше строку
             можно править, и это уже поиск ПО ЭТОМУ документу. -->
        <Border Grid.Row="3" Classes="searchBlock" Margin="16,10,16,12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="10,0" Height="{StaticResource ControlHeightStandard}">
                <Viewbox Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource IconSearch}"
                              Stroke="{StaticResource BrushSecondaryText}"
                              StrokeThickness="{StaticResource IconStrokeSmall}"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                    </Canvas>
                </Viewbox>

                <!-- Рамку держит блок; у поля своей нет ни в одном состоянии (класс borderless),
                     иначе при вводе синих рамок было бы две, одна в другой. -->
                <TextBox Grid.Column="1" x:Name="FindBox"
                         Classes="borderless"
                         Watermark="Найти в документе"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Margin="8,0,8,0" />

                <!-- «3 из 17»: ширина фиксированная, иначе смена числа двигала бы кнопки
                     переходов влево-вправо на каждом совпадении. -->
                <TextBlock Grid.Column="2" x:Name="CounterLabel"
                           Text=""
                           MinWidth="64"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{StaticResource BrushSecondaryText}" />

                <Button Grid.Column="3" x:Name="PrevBtn"
                        Classes="icon" Width="26" Height="26" Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        CornerRadius="{StaticResource RadiusBase}"
                        IsEnabled="False"
                        ToolTip.Tip="Предыдущее совпадение">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconChevronUp}"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="{StaticResource IconStrokeSmall}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button Grid.Column="4" x:Name="NextBtn"
                        Classes="icon" Width="26" Height="26" Margin="2,0,0,0"
                        VerticalAlignment="Center"
                        CornerRadius="{StaticResource RadiusBase}"
                        IsEnabled="False"
                        ToolTip.Tip="Следующее совпадение">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconChevronDown}"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="{StaticResource IconStrokeSmall}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="4" Classes="separator h" />

        <!-- ── Что показано не целиком ──────────────────────────────────────── -->
        <!-- Потолки панели (страницы тома, строки и колонки листа, знаки текста) и скрытые
             листы книги. Строка видна, только когда есть о чем сказать, и стоит НАД
             содержимым, а не в его конце: до конца обрезанного тома человек может и не
             долистать, а прочитать обрезанное как целое — легко. -->
        <TextBlock Grid.Row="5" x:Name="CutLabel"
                   IsVisible="False"
                   Margin="16,8,16,0"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <!-- ── Тело: строки документа либо его страницы ─────────────────────── -->
        <!-- Полоса прокрутки вынесена отдельной колонкой и прилегает к правому краю панели —
             стандарт прокрутки проекта (ui/scrolling.md): своя полоса списка жила бы внутри
             его отступов и отошла бы от края.

             Списка два, а не один с разными шаблонами: у них разная прокрутка, и переключение
             режима не должно терять место, на котором человек читал. -->
        <Grid Grid.Row="6" ColumnDefinitions="*,Auto">
            <ListBox Grid.Column="0" x:Name="LinesList"
                     Classes="reader"
                     Margin="16,12,16,12"
                     SelectionMode="Single"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

            <ScrollBar Grid.Column="1" x:Name="LinesBar"
                       Orientation="Vertical"
                       IsVisible="False" />

            <!-- Страницы документа. Серая подложка — как лист бумаги на столе: белую страницу
                 на белом фоне не видно вовсе. -->
            <ListBox Grid.Column="0" x:Name="PagesList"
                     Classes="reader pages"
                     IsVisible="False"
                     Background="{StaticResource BrushSecondaryBg}"
                     Margin="0"
                     Padding="16,12"
                     SelectionMode="Single"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

            <ScrollBar Grid.Column="1" x:Name="PagesBar"
                       Orientation="Vertical"
                       IsVisible="False" />

            <!-- Лист книги Excel: вкладки листов сверху, полоса букв колонок под ними, строки
                 таблицы ниже. Строка рисует свои ячейки сама (см. code-behind): у таблицы на
                 тысячу строк контролы на каждую ячейку означали бы десятки тысяч элементов
                 дерева.

                 Буквы колонок и номера строк — не украшение: по ним человек понимает, ЧТО он
                 видит. Без них таблица из середины листа выглядит как таблица с начала. -->
            <Grid Grid.Column="0" x:Name="SheetHost"
                  IsVisible="False"
                  RowDefinitions="Auto,Auto,Auto,*,Auto"
                  ColumnDefinitions="*,Auto">
                <!-- Корешки листов. Полоса идет во всю ширину блока и без полей: она — край
                     книги, а не плашка на нем.

                     Листов в книге бывает два десятка, и в ширину панели они не помещаются,
                     поэтому подписи уезжают под стрелки. Стрелки листают книгу, а не двигают
                     полосу: человеку нужен следующий лист, а не следующая подпись; открытый
                     лист полоса подвозит к глазам сама. -->
                <Border Grid.Row="0" Grid.ColumnSpan="2" x:Name="SheetTabsBox"
                        Classes="sheettabs">
                    <Grid ColumnDefinitions="Auto,Auto,*">
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="SheetPrevBtn" Classes="sheetnav"
                                    ToolTip.Tip="Предыдущий лист">
                                <Viewbox Width="{StaticResource IconSizeSmall}"
                                         Height="{StaticResource IconSizeSmall}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource IconChevronLeft}"
                                              Stroke="{Binding $parent[Button].Foreground}"
                                              StrokeThickness="{StaticResource IconStrokeSmallBold}"
                                              StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button x:Name="SheetNextBtn" Classes="sheetnav"
                                    ToolTip.Tip="Следующий лист">
                                <Viewbox Width="{StaticResource IconSizeSmall}"
                                         Height="{StaticResource IconSizeSmall}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource IconChevronRight}"
                                              Stroke="{Binding $parent[Button].Foreground}"
                                              StrokeThickness="{StaticResource IconStrokeSmallBold}"
                                              StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>

                        <Border Grid.Column="1" Classes="sheetsplit" />

                        <ScrollViewer Grid.Column="2" x:Name="SheetTabsScroll"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="SheetTabs" Orientation="Horizontal" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Отступов у таблицы нет вовсе, и это не небрежность: лист занимает блок
                     целиком, как в самом Excel. Поля вокруг сетки читались бы как край листа,
                     которого на деле нет, — лист продолжается дальше.

                     Полоса букв колонок. Содержимое ей ставит code-behind: рисует она то же
                     самое, что строка таблицы, и знать про это разметке незачем. -->
                <Decorator Grid.Row="1" x:Name="SheetHead" />

                <Decorator Grid.Row="2" x:Name="FrozenRowsBox" Width="0" ClipToBounds="True">
                    <StackPanel x:Name="FrozenRows" />
                </Decorator>

                <ListBox Grid.Row="3" x:Name="SheetRows"
                         Classes="reader"
                         SelectionMode="Single"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" />

                <!-- Обе полосы листа живут ВНУТРИ его сетки, а не снаружи, как у текста и
                     страниц: только так между ними получается угол. Вертикальная начинается на
                     уровне полосы букв — стандарт прокрутки проекта (ui/scrolling.md). -->
                <ScrollBar Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" x:Name="SheetBar"
                           Orientation="Vertical"
                           IsVisible="False" />

                <!-- Горизонтальная полоса: таблица шире панели почти всегда, и без нее
                      правые колонки было бы не достать. -->
                <ScrollBar Grid.Row="4" Grid.Column="0" x:Name="SheetHBar"
                           Orientation="Horizontal"
                           IsVisible="False" />

                <!-- Квадрат на пересечении полос — иначе там белое пятно. Схлопывается сам
                     вместе со спрятанной полосой: своя строка и своя колонка у него Auto. -->
                <Border Grid.Row="4" Grid.Column="1" x:Name="SheetCorner"
                        Background="{DynamicResource BrushScrollbarTrack}" />
            </Grid>

            <!-- Состояние вместо текста: читаем, текста нет, формат не читается, файл пропал.
                 Лежит поверх списка в той же ячейке — списка в этот момент все равно нет. -->
            <TextBlock Grid.Column="0" x:Name="StateLabel"
                       Text=""
                       IsVisible="False"
                       Margin="24"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="{StaticResource BrushSecondaryText}" />
        </Grid>
    </Grid>

</UserControl>
