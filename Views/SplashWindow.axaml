<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="using:DataBase.Controls.Components"
        x:Class="DataBase.Views.SplashWindow"
        Width="460" Height="230"
        CanResize="False"
        ShowInTaskbar="True"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBg}"
        Title="DataBase">

    <!-- Тонкая рамка вокруг окна (у сплэша нет системной рамки) -->
    <Border BorderBrush="{StaticResource BrushSeparator}" BorderThickness="1">
        <DockPanel>

            <!-- Шапка как у установщика: название + версия -->
            <Border DockPanel.Dock="Top" Height="76"
                    Background="{StaticResource BrushSecondaryBg}"
                    BorderBrush="{StaticResource BrushSeparator}" BorderThickness="0,0,0,1">
                <StackPanel VerticalAlignment="Center" Margin="24,0">
                    <TextBlock Text="DataBase"
                               FontSize="{DynamicResource FontSizeLarge}"
                               FontWeight="{StaticResource FontWeightBold}"
                               Foreground="{StaticResource BrushPrimaryText}" />
                    <TextBlock x:Name="VersionText" Text="Версия"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{StaticResource BrushSecondaryText}" />
                </StackPanel>
            </Border>

            <!-- Тело: единый индикатор загрузки (плавный smooth-режим) -->
            <StackPanel Margin="24,20" Spacing="14" VerticalAlignment="Center">
                <TextBlock Text="Запуск приложения"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <components:ProgressIndicator x:Name="Indicator" />
            </StackPanel>

        </DockPanel>
    </Border>
</Window>
