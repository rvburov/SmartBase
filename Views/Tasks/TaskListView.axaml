<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:SmartBase.Controls.Widgets"
             xmlns:b="clr-namespace:SmartBase.Controls.Behaviors"
             x:Class="SmartBase.Views.Tasks.TaskListView"
             Background="{StaticResource BrushBg}">

    <UserControl.Styles>
        <Style Selector="TextBox.quickTaskTitle /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderLine}" />
        </Style>
        <Style Selector="TextBox.quickTaskTitle:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderLine}" />
        </Style>
        <Style Selector="TextBox.quickTaskTitle:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
            <Setter Property="BorderThickness" Value="{DynamicResource BorderLineFocus}" />
        </Style>
    </UserControl.Styles>

    <!-- Правого отступа у Grid нет: он вернулся отдельным Margin строкам 1-2 и содержимому
         списка, чтобы полоса прокрутки прилегала к краю панели, а не висела в 16px от него.
         Колонка 1 — полоса прокрутки на всю высоту панели (см. ScrollBar ниже).
         Верхний отступ — пустой строкой 0, а не Margin сетки: иначе полоса начиналась бы
         на 8px ниже верхнего края панели, а по стандарту она идет от самого края. -->
    <Grid RowDefinitions="8,Auto,Auto,*" ColumnDefinitions="*,Auto" Margin="16,0,0,0">

        <!-- Ошибка (нет прав и т.п.) — тот же баннер, что в диалогах -->
        <w:NoticeBanner Grid.Row="1" x:Name="NoticeBanner" Margin="0,0,16,8" />

        <!-- Быстрое добавление: название + Enter на всю ширину сверху, срок, исполнитель
             и коллекция слева ниже, «Добавить» — у правого края.
             Коллекция выбирается явно: раньше задача молча уезжала в первую
             отмеченную, и попасть в нужную можно было только через окно задачи. -->
        <Border Grid.Row="2"
                Background="{StaticResource BrushBg}"
                BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="{DynamicResource BorderLine}"
                CornerRadius="{StaticResource RadiusMedium}"
                Padding="12,8"
                Margin="0,0,16,12">
            <Grid RowDefinitions="Auto,8,Auto">

                <TextBox Grid.Row="0" x:Name="QuickTitle" Classes="quickTaskTitle"
                         Watermark="Новая задача — название и Enter"
                         BorderBrush="{DynamicResource BrushAccent}"
                         BorderThickness="{DynamicResource BorderLine}"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         MinHeight="34"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled" />

                <!-- При широком сайдбаре параметры переносятся целыми группами:
                     подпись остается рядом со своим редактором, кнопка доступна в узком разделе. -->
                <Grid Grid.Row="2" ColumnDefinitions="*,12,Auto">
                    <WrapPanel Grid.Column="0" Orientation="Horizontal">
                        <Grid ColumnDefinitions="Auto,6,Auto,6,Auto" Margin="0,0,12,8">
                            <TextBlock Grid.Column="0" Text="Срок"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource BrushSecondaryText}" />
                            <w:DateField Grid.Column="2" x:Name="QuickDateField" Width="130" />
                            <w:TimeField Grid.Column="4" x:Name="QuickTimeField" Width="90" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,6,Auto" Margin="0,0,12,8">
                            <TextBlock Grid.Column="0" Text="Исполнитель"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource BrushSecondaryText}" />
                            <ComboBox Grid.Column="2" x:Name="QuickExecutor"
                                      Width="150" Height="34"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,6,Auto" Margin="0,0,12,8">
                            <TextBlock Grid.Column="0" Text="Коллекция"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource BrushSecondaryText}" />
                            <ComboBox Grid.Column="2" x:Name="QuickCollection"
                                      Width="150" Height="34"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}" />
                        </Grid>
                    </WrapPanel>

                    <Button Grid.Column="2" x:Name="QuickAddBtn" Classes="accent"
                            Content="Добавить" Height="34"
                            Padding="14,0" Margin="0,0,0,8"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            VerticalContentAlignment="Center"
                            CornerRadius="{StaticResource RadiusPill}" />
                </Grid>
            </Grid>
        </Border>

        <!-- Список карточек задач. Своей полосы нет (Hidden) — ее роль играет ScrollBar ниже,
             стоящий на всю высоту панели, чтобы полоса начиналась сверху, как в таблице.

             ItemsControl — ПРЯМОЙ ребенок ScrollViewer'а, без промежуточной панели. Иначе
             VirtualizingStackPanel получает неограниченную высоту и материализует ВСЕ строки:
             виртуализация есть на бумаге и отсутствует на деле. Раньше здесь стоял StackPanel
             ради подписи «Нет задач» — теперь она лежит поверх списка отдельной строкой сетки
             (показывать ее все равно не с чем: пустой список пуст). -->
        <ScrollViewer Grid.Row="3" x:Name="CardsScroll"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden">
            <ItemsControl x:Name="CardsHost" Margin="0,0,16,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3" x:Name="EmptyLabel"
                   Text="Нет задач"
                   IsVisible="False"
                   Foreground="{StaticResource BrushSecondaryText}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,32,16,16" />

        <!-- Полоса прокрутки списка — отдельной колонкой на всю высоту панели (строка
             быстрого добавления + список), как вертикальная полоса таблицы стоит на
             уровне шапки колонок. -->
        <ScrollBar Grid.Column="1" Grid.Row="0" Grid.RowSpan="4"
                   Orientation="Vertical"
                   b:ScrollBarLink.Source="{Binding #CardsScroll}" />

    </Grid>

</UserControl>
