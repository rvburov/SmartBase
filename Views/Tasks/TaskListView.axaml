<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:SmartBase.Controls.Widgets"
             xmlns:b="clr-namespace:SmartBase.Controls.Behaviors"
             x:Class="SmartBase.Views.Tasks.TaskListView"
             Background="{StaticResource BrushBg}">

    <!-- Правого отступа у Grid нет: он вернулся отдельным Margin строкам 1-2 и содержимому
         списка, чтобы полоса прокрутки прилегала к краю панели, а не висела в 16px от него.
         Колонка 1 — полоса прокрутки на всю высоту панели (см. ScrollBar ниже).
         Верхний отступ — пустой строкой 0, а не Margin сетки: иначе полоса начиналась бы
         на 8px ниже верхнего края панели, а по стандарту она идёт от самого края. -->
    <Grid RowDefinitions="8,Auto,Auto,*" ColumnDefinitions="*,Auto" Margin="16,0,0,0">

        <!-- Ошибка (нет прав и т.п.) — тот же баннер, что в диалогах -->
        <w:ErrorBanner Grid.Row="1" x:Name="ErrorBanner" Margin="0,0,16,8" />

        <!-- Строка быстрого добавления: название + Enter, срок, исполнитель, «Добавить» -->
        <Border Grid.Row="2"
                Background="{StaticResource BrushBg}"
                BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="{DynamicResource BorderLine}"
                CornerRadius="{StaticResource RadiusMedium}"
                Padding="12,8"
                Margin="0,0,16,12">
            <Grid ColumnDefinitions="*,12,Auto,6,Auto,6,Auto,12,Auto,6,Auto,12,Auto"
                  VerticalAlignment="Center">

                <TextBox Grid.Column="0" x:Name="QuickTitle"
                         Watermark="Новая задача — название и Enter"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         MinHeight="34"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled" />

                <TextBlock Grid.Column="2" Text="Срок"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushSecondaryText}" />

                <w:DateField Grid.Column="4" x:Name="QuickDateField" Width="130" />

                <w:TimeField Grid.Column="6" x:Name="QuickTimeField" Width="90" />

                <TextBlock Grid.Column="8" Text="Исполнитель"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushSecondaryText}" />

                <ComboBox Grid.Column="10" x:Name="QuickExecutor"
                          Width="150" Height="34"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}" />

                <Button Grid.Column="12" x:Name="QuickAddBtn" Classes="accent"
                        Content="Добавить" Height="34"
                        Padding="14,0"
                        VerticalContentAlignment="Center"
                        CornerRadius="{StaticResource RadiusPill}" />
            </Grid>
        </Border>

        <!-- Список карточек задач (виртуализация — как список сайдбара).
             Своей полосы нет (Hidden) — её роль играет ScrollBar ниже, стоящий на всю
             высоту панели, чтобы полоса начиналась сверху, как в таблице. -->
        <ScrollViewer Grid.Row="3" x:Name="CardsScroll"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="0,0,16,0">
                <ItemsControl x:Name="CardsHost">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="EmptyLabel"
                           Text="Нет задач"
                           IsVisible="False"
                           Foreground="{StaticResource BrushSecondaryText}"
                           HorizontalAlignment="Center"
                           Margin="0,32,0,16" />
            </StackPanel>
        </ScrollViewer>

        <!-- Полоса прокрутки списка — отдельной колонкой на всю высоту панели (строка
             быстрого добавления + список), как вертикальная полоса таблицы стоит на
             уровне шапки колонок. -->
        <ScrollBar Grid.Column="1" Grid.Row="0" Grid.RowSpan="4"
                   Orientation="Vertical"
                   b:ScrollBarLink.Source="{Binding #CardsScroll}" />

    </Grid>

</UserControl>
