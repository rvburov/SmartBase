<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:SmartBase.Controls.Widgets"
             x:Class="SmartBase.Views.Tasks.TaskListView"
             Background="{StaticResource BrushBg}">

    <!-- Правого отступа у Grid нет: он вернулся отдельным Margin строкам 0-1 и содержимому
         списка, чтобы полоса прокрутки прилегала к краю панели, а не висела в 16px от него. -->
    <Grid RowDefinitions="Auto,Auto,*" Margin="16,8,0,0">

        <!-- Ошибка (нет прав и т.п.) — тот же баннер, что в диалогах -->
        <w:ErrorBanner Grid.Row="0" x:Name="ErrorBanner" Margin="0,0,16,8" />

        <!-- Строка быстрого добавления: название + Enter, срок, исполнитель, «Добавить» -->
        <Border Grid.Row="1"
                Background="{StaticResource BrushBg}"
                BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="{DynamicResource BorderLine}"
                CornerRadius="{StaticResource RadiusMedium}"
                Padding="12,8"
                Margin="0,0,16,12">
            <Grid ColumnDefinitions="*,12,Auto,6,Auto,6,Auto,12,Auto,6,Auto,12,Auto"
                  VerticalAlignment="Center">

                <TextBox Grid.Column="0" x:Name="QuickTitle"
                         Watermark="Новая задача — название и Enter"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         MinHeight="34"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled" />

                <TextBlock Grid.Column="2" Text="Срок"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushSecondaryText}" />

                <w:DateField Grid.Column="4" x:Name="QuickDateField" Width="130" />

                <w:TimeField Grid.Column="6" x:Name="QuickTimeField" Width="90" />

                <TextBlock Grid.Column="8" Text="Исполнитель"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushSecondaryText}" />

                <ComboBox Grid.Column="10" x:Name="QuickExecutor"
                          Width="150" Height="34"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}" />

                <Button Grid.Column="12" x:Name="QuickAddBtn" Classes="accent"
                        Content="Добавить" Height="34"
                        Padding="14,0"
                        VerticalContentAlignment="Center"
                        CornerRadius="{StaticResource RadiusPill}" />
            </Grid>
        </Border>

        <!-- Список карточек задач (виртуализация — как список сайдбара) -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,16,0">
                <ItemsControl x:Name="CardsHost">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="EmptyLabel"
                           Text="Нет задач"
                           IsVisible="False"
                           Foreground="{StaticResource BrushSecondaryText}"
                           HorizontalAlignment="Center"
                           Margin="0,32,0,16" />
            </StackPanel>
        </ScrollViewer>

    </Grid>

</UserControl>
