<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyPlanner.Views.Calendar.JournalView"
             Background="{StaticResource BrushBg}">

    <ScrollViewer x:Name="JournalScroll" VerticalScrollBarVisibility="Auto"
                  DoubleTapped="OnBackgroundDoubleTapped">
        <ItemsControl x:Name="GroupsList" Padding="8">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="0" Margin="0,0,0,0">
                        <!-- Заголовок даты -->
                        <TextBlock Text="{Binding DateHeader}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{Binding HeaderBrush}"
                                   Margin="8,8,0,8" />
                        <!-- Подсказка для пустого сегодня -->
                        <TextBlock Text="Нет событий на сегодня"
                                   IsVisible="{Binding ShowEmptyHint}"
                                   FontSize="13"
                                   Foreground="{StaticResource BrushSecondaryText}"
                                   Margin="24,0,0,8" />
                        <!-- Список событий дня -->
                        <ItemsControl ItemsSource="{Binding Events}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0"
                                            HorizontalAlignment="Stretch"
                                            CornerRadius="6"
                                            Background="{Binding BackgroundBrush}"
                                            Tag="{Binding}"
                                            Cursor="Hand"
                                            Tapped="OnEventTapped"
                                            DoubleTapped="OnEventDoubleTapped"
                                            PointerEntered="OnEventPointerEntered"
                                            PointerExited="OnEventPointerExited">
                                        <Grid Margin="16,8" ColumnDefinitions="Auto,12,*">
                                            <!-- Цветная полоска -->
                                            <Border Grid.Column="0" Width="4" CornerRadius="2"
                                                    Background="{Binding ColorBrush}" />
                                            <!-- Информация о событии -->
                                            <StackPanel Grid.Column="2" Spacing="2">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="13"
                                                           Foreground="{Binding TitleBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding TimeText}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource BrushSecondaryText}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>

</UserControl>
