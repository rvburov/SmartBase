<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyPlanner.Views.Calendar.JournalView"
             Background="{StaticResource BrushBg}">

    <ScrollViewer x:Name="JournalScroll" VerticalScrollBarVisibility="Auto"
                  DoubleTapped="OnBackgroundDoubleTapped">
        <ItemsControl x:Name="GroupsList" Padding="4,4">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="0" Margin="0,0,0,0">
                        <!-- Заголовок даты: высота и отступы как у блока события -->
                        <Border Margin="0,1" Height="36">
                            <TextBlock Text="{Binding DateHeader}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{Binding HeaderBrush}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </Border>
                        <!-- Подсказка для пустого сегодня -->
                        <Border Margin="0,1" Height="36"
                                IsVisible="{Binding ShowEmptyHint}">
                            <TextBlock Text="Нет событий на сегодня"
                                       FontSize="13"
                                       Foreground="{StaticResource BrushSecondaryText}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </Border>
                        <!-- Список событий дня -->
                        <ItemsControl ItemsSource="{Binding Events}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,1"
                                            Height="36"
                                            HorizontalAlignment="Stretch"
                                            CornerRadius="6"
                                            Background="{Binding BackgroundBrush}"
                                            Tag="{Binding}"
                                            Cursor="Hand"
                                            Tapped="OnEventTapped"
                                            DoubleTapped="OnEventDoubleTapped"
                                            PointerEntered="OnEventPointerEntered"
                                            PointerExited="OnEventPointerExited">
                                        <Grid Margin="0" ColumnDefinitions="Auto,12,*">
                                            <!-- Цветная полоска: отступы слева и сверху/снизу -->
                                            <Border Grid.Column="0" Width="4" CornerRadius="2"
                                                    Margin="8,4,0,4"
                                                    Background="{Binding ColorBrush}" />
                                            <!-- Информация о событии -->
                                            <StackPanel Grid.Column="2" Spacing="2"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="13"
                                                           Foreground="{Binding TitleBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding TimeText}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource BrushSecondaryText}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>

</UserControl>
