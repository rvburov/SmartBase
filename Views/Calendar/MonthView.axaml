<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyPlanner.Views.Calendar.MonthView"
             Background="{StaticResource BrushBg}">

    <Grid RowDefinitions="Auto,*">

        <!-- Заголовки дней недели -->
        <Border Grid.Row="0"
                BorderBrush="#E8E8E8"
                BorderThickness="0">
        <UniformGrid Columns="7"
                     Background="{StaticResource BrushSecondaryBg}">
            <TextBlock Text="Пн" HorizontalAlignment="Center" Padding="0,6"
                       FontSize="13"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <TextBlock Text="Вт" HorizontalAlignment="Center" Padding="0,6"
                       FontSize="13"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <TextBlock Text="Ср" HorizontalAlignment="Center" Padding="0,6"
                       FontSize="13"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <TextBlock Text="Чт" HorizontalAlignment="Center" Padding="0,6"
                       FontSize="13"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <TextBlock Text="Пт" HorizontalAlignment="Center" Padding="0,6"
                       FontSize="13"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <TextBlock Text="Сб" HorizontalAlignment="Center" Padding="0,6"
                       FontSize="13"
                       Foreground="{StaticResource BrushRed}" />
            <TextBlock Text="Вс" HorizontalAlignment="Center" Padding="0,6"
                       FontSize="13"
                       Foreground="{StaticResource BrushRed}" />
        </UniformGrid>
        </Border>

        <!-- Сетка дней + прозрачный оверлей для многодневных событий -->
        <Grid Grid.Row="1" x:Name="GridContainer">
            <UniformGrid x:Name="DayGrid" Columns="7" />
            <Canvas x:Name="SpanCanvas" />
        </Grid>

    </Grid>

</UserControl>
