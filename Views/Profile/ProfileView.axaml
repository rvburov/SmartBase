<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="using:SmartBase.Controls.Components"
             x:Class="SmartBase.Views.Profile.ProfileView"
             Background="{StaticResource BrushBg}">

    <!-- Таблица «Истории изменений» — тот же вид, что таблица конструктора (TableView):
         локальные копии тем DataGrid и переопределение кистей линий на BrushSeparator.
         Подробные комментарии по линиям/округлению — в TableView.axaml. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://SmartBase/Views/ConstructorDb/TableViewDataGridThemes.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="DataGridGridLinesBrush"             Color="{StaticResource ColorSeparator}" />
            <SolidColorBrush x:Key="DataGridFillerColumnGridLinesBrush" Color="{StaticResource ColorSeparator}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Строка одного пункта, ячейка с данными и строка таблицы — общие
             (Assets/Styles/SettingRows.axaml): панель администратора показывает те же
             строки, что раздел «Интеграции», и вторая копия стилей разошлась бы с первой. -->

        <!-- Стили DataGrid таблицы истории — копии стилей TableView.axaml (там же
             объяснено, почему линии/шапка устроены именно так). -->
        <Style Selector="DataGridCell">
            <Setter Property="Padding"         Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeBase}" />
            <Setter Property="Foreground"      Value="{StaticResource BrushPrimaryText}" />
        </Style>
        <Style Selector="DataGridCell:current /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="DataGridCell /template/ Rectangle#PART_RightGridLine">
            <Setter Property="Width"             Value="{DynamicResource SeparatorThickness}" />
            <Setter Property="UseLayoutRounding" Value="{DynamicResource LineUseLayoutRounding}" />
        </Style>
        <Style Selector="DataGridRow /template/ Rectangle#PART_BottomGridLine">
            <Setter Property="Height"            Value="{DynamicResource SeparatorThickness}" />
            <Setter Property="UseLayoutRounding" Value="{DynamicResource LineUseLayoutRounding}" />
        </Style>
        <Style Selector="DataGrid /template/ Rectangle#PART_ColumnHeadersAndRowsSeparator">
            <Setter Property="Height"            Value="{DynamicResource SeparatorThickness}" />
            <Setter Property="UseLayoutRounding" Value="{DynamicResource LineUseLayoutRounding}" />
        </Style>
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill"    Value="{StaticResource BrushSecondaryBg}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill"    Value="{StaticResource BrushAccentLight}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill"    Value="{StaticResource BrushAccentLight}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="DataGridRow:selected DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="UseLayoutRounding"          Value="{DynamicResource LineUseLayoutRounding}" />
            <Setter Property="Background"                 Value="Transparent" />
            <Setter Property="Padding"                    Value="0" />
            <Setter Property="Height"                     Value="{StaticResource RowHeightStandard}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment"   Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Горизонтальная полоса таблицы пользователей — во всю ширину. У таблицы
             закреплена первая колонка, а DataGrid под закрепленными ставит распорку
             (PART_FrozenColumnScrollBarSpacer) и полоса начинается только после них.
             Распорку прячем: ее колонка Auto схлопывается в ноль, полоса идет от края
             до края, как в остальных таблицах приложения. Ширину распорки DataGrid
             задает из кода, поэтому гасим именно видимость, а не Width. -->
        <Style Selector="DataGrid#UsersGrid /template/ Rectangle#PART_FrozenColumnScrollBarSpacer">
            <Setter Property="IsVisible" Value="False" />
        </Style>

    </UserControl.Styles>

    <!-- В разделе «История изменений» строка раскрывается панелью «Детали» во всю высоту
         справа (Column 2) — как в «Настройки → Диагностика»: ее навбар встает вровень
         с навбаром профиля. Прочие разделы занимают всю ширину (Column 0). -->
    <Grid ColumnDefinitions="*,Auto,Auto">

    <DockPanel Grid.Column="0">

        <!-- Шапка раздела (вынесена в компонент-навбар). Список пользователей открывается
             ВМЕСТО панели администратора и приносит свою шапку — тогда навбар скрывается,
             чтобы заголовков не было два. -->
        <comp:NavbarProfile DockPanel.Dock="Top" x:Name="HeaderBar" />

        <!-- Содержимое выбранного раздела -->
        <Grid>

            <!-- ── Общие данные ──────────────────────────────────── -->
            <ScrollViewer x:Name="GeneralPanel"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Во всю ширину окна: содержимое раздела заканчивается там же,
                             где заголовок и линия под ним. Прежний потолок в 1400 оставлял
                             на широком экране пустую полосу справа, и строки обрывались,
                             не доходя до края. -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="16,0,16,32">

                    <!-- Имя компьютера (определяется автоматически) -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Имя компьютера" />
                                <TextBlock Classes="desc"
                                           Text="Определяется автоматически и вместе с учетной записью системы служит идентификатором пользователя в базах данных и истории изменений." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="MachineNameText" Text="—"
                                           HorizontalAlignment="Right" />
                                <TextBlock x:Name="UserKeyText" Text="—"
                                           HorizontalAlignment="Right"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Foreground="{StaticResource BrushSecondaryText}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Фамилия -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Фамилия" />
                            </StackPanel>
                            <TextBox Grid.Column="1" x:Name="LastNameBox"
                                     Width="240" Height="{StaticResource ControlHeightStandard}"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Background="{StaticResource BrushSecondaryBg}"
                                     CornerRadius="{StaticResource RadiusBase}"
                                     Watermark="Не указана"
                                     LostFocus="OnProfileFieldChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Имя -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Имя" />
                            </StackPanel>
                            <TextBox Grid.Column="1" x:Name="FirstNameBox"
                                     Width="240" Height="{StaticResource ControlHeightStandard}"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Background="{StaticResource BrushSecondaryBg}"
                                     CornerRadius="{StaticResource RadiusBase}"
                                     Watermark="Не указано"
                                     LostFocus="OnProfileFieldChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Отчество -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Отчество" />
                            </StackPanel>
                            <TextBox Grid.Column="1" x:Name="MiddleNameBox"
                                     Width="240" Height="{StaticResource ControlHeightStandard}"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Background="{StaticResource BrushSecondaryBg}"
                                     CornerRadius="{StaticResource RadiusBase}"
                                     Watermark="Не указано"
                                     LostFocus="OnProfileFieldChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Как пользователь будет подписан в базах и истории -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Отображаемое имя" />
                                <TextBlock Classes="desc"
                                           Text="Под этим именем пользователь виден другим участникам базы данных и в истории изменений. Пока ФИО не заполнено, используется идентификатор." />
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="DisplayNameText" Text="—"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Подразделение (по желанию) -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Подразделение" />
                                <TextBlock Classes="desc"
                                           Text="Необязательное справочное поле: отдел, служба или филиал. На доступ к базам данных и отображаемое имя не влияет." />
                            </StackPanel>
                            <TextBox Grid.Column="1" x:Name="DepartmentBox"
                                     Width="240" Height="{StaticResource ControlHeightStandard}"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Background="{StaticResource BrushSecondaryBg}"
                                     CornerRadius="{StaticResource RadiusBase}"
                                     Watermark="Не указано"
                                     LostFocus="OnProfileFieldChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Должность (по желанию) -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Должность" />
                                <TextBlock Classes="desc"
                                           Text="Необязательное справочное поле. На доступ к базам данных и отображаемое имя не влияет." />
                            </StackPanel>
                            <TextBox Grid.Column="1" x:Name="PositionBox"
                                     Width="240" Height="{StaticResource ControlHeightStandard}"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Background="{StaticResource BrushSecondaryBg}"
                                     CornerRadius="{StaticResource RadiusBase}"
                                     Watermark="Не указана"
                                     LostFocus="OnProfileFieldChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ── Панель администратора ─────────────────────────── -->
            <ScrollViewer x:Name="AdminPanel" IsVisible="False"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Во всю ширину окна: содержимое раздела заканчивается там же,
                             где заголовок и линия под ним. Прежний потолок в 1400 оставлял
                             на широком экране пустую полосу справа, и строки обрывались,
                             не доходя до края. -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="16,0,16,32">

                    <!-- Пользователь не администрирует ни одну базу -->
                    <Border Classes="settingRow" x:Name="AdminNoAccessRow" IsVisible="False">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="title" Text="Нет прав администратора" />
                            <TextBlock Classes="desc"
                                       Text="Вы не являетесь администратором ни одной из подключенных баз данных. Администратор — тот, кто создал базу (открыл ее первым); он выдает допуск и настраивает права остальных пользователей." />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="AdminContent">

                    <!-- Выбор базы данных -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="База данных" />
                                <TextBlock Classes="desc"
                                           Text="Панель управляет доступом к выбранной базе. В списке — базы, где вы администратор." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="AdminDbCombo"
                                      Width="240" Height="{StaticResource ControlHeightStandard}"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}"
                                      SelectionChanged="OnAdminDbChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Пароль базы -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Пароль базы данных" />
                                <TextBlock Classes="desc"
                                           Text="Пароль позволяет новому пользователю получить доступ к базе самостоятельно, не дожидаясь подтверждения администратором." />
                                <TextBlock x:Name="PasswordStateText" Classes="desc" Text="" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        Spacing="8" VerticalAlignment="Center">
                                <!-- Width=NaN: подписи длиннее фикс-ширины стиля dialog (110px) —
                                     кнопка растет под текст, узкие добирают MinWidth. -->
                                <Button x:Name="PasswordSetBtn" Classes="dialog"
                                        Width="NaN" MinWidth="110" Padding="14,0"
                                        Content="Установить пароль"
                                        Click="OnPasswordSet" />
                                <Button x:Name="PasswordRemoveBtn" Classes="dialog"
                                        Width="NaN" MinWidth="110" Padding="14,0"
                                        Content="Убрать"
                                        Click="OnPasswordRemove" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Автоочистка журнала (политика хранится в самой базе, применяется
                         при открытии на любой машине). -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Автоочистка журнала" />
                                <TextBlock Classes="desc"
                                           Text="Старые записи истории изменений автоматически удаляются при открытии базы. Настройка хранится в базе — действует на всех машинах." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        Spacing="10" VerticalAlignment="Center">
                                <!-- SelectedIndex по умолчанию — 12 месяцев (индекс 2);
                                     при загрузке базы RefreshRetentionRow синхронизирует
                                     со значением из db_meta. Список никогда не пуст. -->
                                <ComboBox x:Name="RetentionPeriodCombo"
                                          Width="180" Height="{StaticResource ControlHeightStandard}"
                                          SelectedIndex="2"
                                          VerticalAlignment="Center"
                                          Background="{StaticResource BrushSecondaryBg}"
                                          CornerRadius="{StaticResource RadiusBase}"
                                          SelectionChanged="OnRetentionPeriodChanged">
                                    <ComboBoxItem Tag="3"  Content="Хранить 3 месяца" />
                                    <ComboBoxItem Tag="6"  Content="Хранить 6 месяцев" />
                                    <ComboBoxItem Tag="12" Content="Хранить 12 месяцев" />
                                    <ComboBoxItem Tag="24" Content="Хранить 24 месяца" />
                                </ComboBox>
                                <ToggleSwitch x:Name="RetentionToggle"
                                              OnContent="" OffContent=""
                                              VerticalAlignment="Center"
                                              IsCheckedChanged="OnRetentionToggled" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Разовая очистка журнала за выбранный период. -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Очистить журнал" />
                                <TextBlock Classes="desc"
                                           Text="Разово удалить историю изменений выбранной базы за выбранный период. Отменить нельзя." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        Spacing="10" VerticalAlignment="Center">
                                <!-- SelectedIndex по умолчанию — «Старше 12 месяцев» (индекс 3);
                                     список никогда не пуст. -->
                                <ComboBox x:Name="PurgePeriodCombo"
                                          Width="200" Height="{StaticResource ControlHeightStandard}"
                                          SelectedIndex="3"
                                          VerticalAlignment="Center"
                                          Background="{StaticResource BrushSecondaryBg}"
                                          CornerRadius="{StaticResource RadiusBase}">
                                    <ComboBoxItem Tag="1"   Content="Старше 1 месяца" />
                                    <ComboBoxItem Tag="3"   Content="Старше 3 месяцев" />
                                    <ComboBoxItem Tag="6"   Content="Старше 6 месяцев" />
                                    <ComboBoxItem Tag="12"  Content="Старше 12 месяцев" />
                                    <ComboBoxItem Tag="all" Content="Весь журнал" />
                                </ComboBox>
                                <Button x:Name="PurgeBtn" Classes="dialog"
                                        Width="NaN" MinWidth="110" Padding="14,0"
                                        Content="Очистить"
                                        Click="OnPurgeChangeLog" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Пользователи базы: сами пользователи, их роли и права живут в правой
                         панели во всю высоту (UsersPanel ниже) — таблица «пользователь ×
                         действия» на странице не помещается. -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Пользователи" />
                                <TextBlock Classes="desc"
                                           Text="Все, кто открывал эту базу данных. Новые пользователи ждут допуска. В таблице — роли, допуск и права каждого пользователя." />
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="UsersOpenBtn" Classes="dialog"
                                    Width="NaN" MinWidth="110" Padding="14,0"
                                    VerticalAlignment="Center"
                                    Content="Открыть"
                                    Click="OnOpenUsersPanel" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    </StackPanel>

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ── История изменений ─────────────────────────────────
                 Таблица журнала как в конструкторе: колонки с фильтром/сортировкой
                 в шапке (строятся в коде — ProfileHistoryTable.cs), страницы
                 подгружаются при прокрутке. Выбор базы — в навбаре (NavbarProfile).
                 Без боковых полей остальных панелей — таблица вплотную к краю,
                 как TableView в конструкторе. -->
            <Panel x:Name="HistoryPanel" IsVisible="False">
                <DataGrid x:Name="HistoryGrid"
                          AutoGenerateColumns="False"
                          RowHeight="{StaticResource RowHeightStandard}"
                          CanUserResizeColumns="False"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="False"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="{StaticResource BrushSeparator}"
                          VerticalGridLinesBrush="{StaticResource BrushSeparator}"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          IsReadOnly="True"
                          Background="Transparent"
                          UseLayoutRounding="{DynamicResource LineUseLayoutRounding}"
                          RowBackground="{StaticResource BrushBg}"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto" />
                <TextBlock x:Name="HistoryEmptyText"
                           Text="Записей в журнале пока нет."
                           IsVisible="False"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{StaticResource BrushSecondaryText}"
                           HorizontalAlignment="Center"
                           Margin="0,48,0,0" />
            </Panel>

            <!-- ── Пользователи выбранной базы ──────────────────────────────
                 Открывается кнопкой «Открыть» ВМЕСТО панели администратора и занимает
                 ее место целиком; крестик возвращает панель администратора (клик по
                 разделу в сайдбаре — тоже). Своя шапка высотой 56 встает на место
                 навбара модуля (тот скрывается): заголовок слева, область действия прав
                 и крестик справа. Нижнюю границу шапки рисует общая линия окна на y=56
                 (MainWindow) — своей линии нет, иначе удвоение. -->
            <Grid x:Name="UsersPanel" IsVisible="False"
                  RowDefinitions="Auto,*"
                  Background="{StaticResource BrushBg}">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto"
                      Height="56" Margin="16,0">
                    <TextBlock Grid.Column="0" Text="Пользователи"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeLarge}"
                               FontWeight="{StaticResource FontWeightBold}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0" />
                    <!-- Область действия прав: «Вся база данных» + коллекции. Настройки
                         коллекции приоритетнее настроек базы (PermissionService.GetMask). -->
                    <ComboBox Grid.Column="1" x:Name="ScopeCombo"
                              Width="240" Height="{StaticResource ControlHeightStandard}"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"
                              Background="{StaticResource BrushSecondaryBg}"
                              CornerRadius="{StaticResource RadiusBase}"
                              SelectionChanged="OnScopeChanged" />
                    <Button Grid.Column="2" x:Name="UsersPanelCloseBtn"
                            Classes="navbtn" Width="30" Height="30"
                            VerticalAlignment="Center"
                            CornerRadius="{StaticResource RadiusMedium}"
                            ToolTip.Tip="Закрыть"
                            Click="OnCloseUsersPanel">
                        <Viewbox Width="{StaticResource IconSizeMedium}"
                                 Height="{StaticResource IconSizeMedium}">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconClose}"
                                      Stroke="{Binding $parent[Button].Foreground}"
                                      StrokeThickness="{StaticResource IconStrokeMedium}"
                                      StrokeLineCap="Round" StrokeJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>

                <!-- Матрица «пользователь × действия»: колонки строятся в коде
                     (ProfileAdminUsers.cs) — вид таблицы конструктора: иконка типа
                     в шапке, шеврон фильтра/сортировки, те же линии и высота строки.
                     Первая колонка закреплена — имя видно при горизонтальной прокрутке
                     (полосу под ней освобождает стиль на PART_FrozenColumnScrollBarSpacer
                     выше). -->
                <Panel Grid.Row="1">
                    <DataGrid x:Name="UsersGrid"
                              AutoGenerateColumns="False"
                              RowHeight="{StaticResource RowHeightStandard}"
                              FrozenColumnCount="1"
                              CanUserResizeColumns="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="False"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="{StaticResource BrushSeparator}"
                              VerticalGridLinesBrush="{StaticResource BrushSeparator}"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              IsReadOnly="True"
                              Background="Transparent"
                              UseLayoutRounding="{DynamicResource LineUseLayoutRounding}"
                              RowBackground="{StaticResource BrushBg}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto" />
                </Panel>
            </Grid>

        </Grid>

    </DockPanel>

    <!-- Вертикальный разделитель между разделом и деталями (во всю высоту). -->
    <Border Grid.Column="1" x:Name="HistoryDetailDivider"
            Classes="separator v" IsVisible="False" />

    <!-- ── Детали строки журнала (во всю высоту) ───────────────────────────
         Зеркало панели «Детали» из «Диагностики» (SettingsView): навбар вровень
         с навбаром профиля, карточки полей сверху, полный текст снизу — как
         «Страница записи». Нижнюю границу навбара рисует общая линия окна на y=56
         (MainWindow), своей линии под шапкой нет (иначе удвоение). Ширина —
         в code-behind (_historyDetailWidth), меняется ручкой ниже. -->
    <Border Grid.Column="2" x:Name="HistoryDetailPanel"
            IsVisible="False"
            Background="{StaticResource BrushBg}">
        <Grid x:Name="HistoryDetailGrid" RowDefinitions="Auto,*,Auto,*">

            <!-- Шапка-навбар панели: заголовок слева + крестик справа. -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto"
                  Height="56" Margin="16,0">
                <TextBlock Grid.Column="0" Text="Детали"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeLarge}"
                           FontWeight="{StaticResource FontWeightBold}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,12,0" />
                <Button Grid.Column="1" x:Name="HistoryDetailCloseBtn"
                        Classes="navbtn" Width="30" Height="30"
                        VerticalAlignment="Center"
                        CornerRadius="{StaticResource RadiusMedium}"
                        ToolTip.Tip="Закрыть">
                    <Viewbox Width="{StaticResource IconSizeMedium}"
                             Height="{StaticResource IconSizeMedium}">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconClose}"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="{StaticResource IconStrokeMedium}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>

            <!-- Карточки полей строятся в code-behind (BuildHistoryDetailCards).
                 Фон блока серый — как у блока свойств «Страницы записи» и панели деталей
                 диагностики: белые карточки читаются на нем как отдельные плашки. Серым
                 залита вся строка (она звездная) — блок отбит от шапки и текста снизу. -->
            <ScrollViewer Grid.Row="1"
                          Background="{StaticResource BrushSecondaryBg}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="HistoryDetailCardsHost"
                            Margin="16,16,16,16" Spacing="6" />
            </ScrollViewer>

            <!-- Линия-разделитель между карточками и текстом (в своей строке). -->
            <Border Grid.Row="2" Classes="separator h"
                    VerticalAlignment="Center" />

            <!-- Ручка-пилюля: плавает поверх линии, тянет высоту блока карточек. -->
            <Border Grid.Row="1"
                    x:Name="HistoryPropsResizeGrip"
                    Width="34" Height="11"
                    Margin="0,0,0,-5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    CornerRadius="4"
                    Background="{StaticResource BrushBg}"
                    BorderBrush="{StaticResource BrushSeparator}"
                    BorderThickness="{DynamicResource BorderLine}"
                    Cursor="SizeNorthSouth">
                <StackPanel Orientation="Horizontal" Spacing="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
                    <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
                    <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
                </StackPanel>
            </Border>

            <!-- Полный текст выбранного поля: крошка «Поле › Имя» + копирование
                 и безбордерный переносящий редактор (только чтение). -->
            <Grid Grid.Row="3" RowDefinitions="Auto,*"
                  Margin="16,16,16,16">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto"
                      Margin="0,0,0,16">
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Поле"
                                   Foreground="{StaticResource BrushSecondaryText}"
                                   VerticalAlignment="Center" />
                        <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconChevronRight}"
                                      Stroke="{StaticResource BrushSecondaryText}"
                                      StrokeThickness="1.6"
                                      StrokeLineCap="Round" StrokeJoin="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="HistoryDetailFieldName"
                                   Foreground="{StaticResource BrushSecondaryText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="HistoryDetailCopyBtn"
                            Classes="icon" Width="28" Height="28"
                            ToolTip.Tip="Скопировать">
                        <Viewbox Width="{StaticResource IconSizeSmall}"
                                 Height="{StaticResource IconSizeSmall}">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconCopy}"
                                      Stroke="{StaticResource BrushSecondaryText}"
                                      StrokeThickness="{StaticResource IconStrokeSmall}"
                                      StrokeLineCap="Round" StrokeJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>

                <TextBox Grid.Row="1" x:Name="HistoryDetailFullText"
                         Classes="notesEditor"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap" />
            </Grid>
        </Grid>
    </Border>

    <!-- Ручка перетягивания ширины панели «Детали» — вертикальная пилюля у ее левого
         края, плавает поверх разделителя (Margin -5). Видна вместе с панелью. -->
    <Border Grid.Column="2" x:Name="HistoryDetailResizeGrip"
            Width="11" Height="34"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Margin="-5,0,0,0"
            CornerRadius="4"
            Background="{StaticResource BrushBg}"
            BorderBrush="{StaticResource BrushSeparator}"
            BorderThickness="{DynamicResource BorderLine}"
            Cursor="SizeWestEast"
            IsVisible="False">
        <StackPanel Orientation="Vertical" Spacing="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
            <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
            <Ellipse Width="2.5" Height="2.5" Fill="{StaticResource BrushSecondaryText}" />
        </StackPanel>
    </Border>

    </Grid>

</UserControl>
