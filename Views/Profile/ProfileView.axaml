<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="using:SmartBase.Controls.Components"
             x:Class="SmartBase.Views.Profile.ProfileView"
             Background="{StaticResource BrushBg}">

    <!-- Таблица «Истории изменений» — тот же вид, что таблица конструктора (TableView):
         локальные копии тем DataGrid и переопределение кистей линий на BrushSeparator.
         Подробные комментарии по линиям/округлению — в TableView.axaml. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://SmartBase/Views/ConstructorDb/TableViewDataGridThemes.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="DataGridGridLinesBrush"             Color="{StaticResource ColorSeparator}" />
            <SolidColorBrush x:Key="DataGridFillerColumnGridLinesBrush" Color="{StaticResource ColorSeparator}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Строка одного пункта. Линия под строкой — отдельный separator h ПОСЛЕ каждой
             строки (не бордер контейнера с текстом: отдельную линию можно алиасить,
             она чёткая при любом зуме). Стили — как settingRow в SettingsView. -->
        <Style Selector="Border.settingRow">
            <Setter Property="Padding" Value="0,16" />
        </Style>
        <Style Selector="Border.settingRow TextBlock.title">
            <Setter Property="Foreground" Value="{StaticResource BrushPrimaryText}" />
        </Style>
        <Style Selector="Border.settingRow TextBlock.desc">
            <Setter Property="FontSize"     Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground"   Value="{StaticResource BrushSecondaryText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Стили DataGrid таблицы истории — копии стилей TableView.axaml (там же
             объяснено, почему линии/шапка устроены именно так). -->
        <Style Selector="DataGridCell">
            <Setter Property="Padding"         Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize"        Value="{DynamicResource FontSizeBase}" />
            <Setter Property="Foreground"      Value="{StaticResource BrushPrimaryText}" />
        </Style>
        <Style Selector="DataGridCell:current /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="DataGridCell /template/ Rectangle#PART_RightGridLine">
            <Setter Property="Width"             Value="{DynamicResource SeparatorThickness}" />
            <Setter Property="UseLayoutRounding" Value="{DynamicResource LineUseLayoutRounding}" />
        </Style>
        <Style Selector="DataGridRow /template/ Rectangle#PART_BottomGridLine">
            <Setter Property="Height"            Value="{DynamicResource SeparatorThickness}" />
            <Setter Property="UseLayoutRounding" Value="{DynamicResource LineUseLayoutRounding}" />
        </Style>
        <Style Selector="DataGrid /template/ Rectangle#PART_ColumnHeadersAndRowsSeparator">
            <Setter Property="Height"            Value="{DynamicResource SeparatorThickness}" />
            <Setter Property="UseLayoutRounding" Value="{DynamicResource LineUseLayoutRounding}" />
        </Style>
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill"    Value="{StaticResource BrushSecondaryBg}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill"    Value="{StaticResource BrushAccentLight}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill"    Value="{StaticResource BrushAccentLight}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="DataGridRow:selected DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="UseLayoutRounding"          Value="{DynamicResource LineUseLayoutRounding}" />
            <Setter Property="Background"                 Value="Transparent" />
            <Setter Property="Padding"                    Value="0" />
            <Setter Property="Height"                     Value="{StaticResource RowHeightStandard}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment"   Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <!-- Шапка раздела (вынесена в компонент-навбар). -->
        <comp:NavbarProfile DockPanel.Dock="Top" x:Name="HeaderBar" />

        <!-- Содержимое выбранного раздела -->
        <Grid>

            <!-- ── Общие данные ──────────────────────────────────── -->
            <ScrollViewer x:Name="GeneralPanel"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1400" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="16,0,16,32">

                    <!-- Имя компьютера (определяется автоматически) -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Имя компьютера" />
                                <TextBlock Classes="desc"
                                           Text="Определяется автоматически и вместе с учётной записью системы служит идентификатором пользователя в базах данных и истории изменений." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="MachineNameText" Text="—"
                                           HorizontalAlignment="Right" />
                                <TextBlock x:Name="UserKeyText" Text="—"
                                           HorizontalAlignment="Right"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Foreground="{StaticResource BrushSecondaryText}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Фамилия -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Фамилия" />
                            </StackPanel>
                            <TextBox Grid.Column="1" x:Name="LastNameBox"
                                     Width="240" Height="{StaticResource ControlHeightStandard}"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Background="{StaticResource BrushSecondaryBg}"
                                     CornerRadius="{StaticResource RadiusBase}"
                                     Watermark="Не указана"
                                     LostFocus="OnProfileFieldChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Имя -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Имя" />
                            </StackPanel>
                            <TextBox Grid.Column="1" x:Name="FirstNameBox"
                                     Width="240" Height="{StaticResource ControlHeightStandard}"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Background="{StaticResource BrushSecondaryBg}"
                                     CornerRadius="{StaticResource RadiusBase}"
                                     Watermark="Не указано"
                                     LostFocus="OnProfileFieldChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Отчество -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Отчество" />
                            </StackPanel>
                            <TextBox Grid.Column="1" x:Name="MiddleNameBox"
                                     Width="240" Height="{StaticResource ControlHeightStandard}"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Background="{StaticResource BrushSecondaryBg}"
                                     CornerRadius="{StaticResource RadiusBase}"
                                     Watermark="Не указано"
                                     LostFocus="OnProfileFieldChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Как пользователь будет подписан в базах и истории -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Отображаемое имя" />
                                <TextBlock Classes="desc"
                                           Text="Под этим именем пользователь виден другим участникам базы данных и в истории изменений. Пока ФИО не заполнено, используется идентификатор." />
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="DisplayNameText" Text="—"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ── Панель администратора ─────────────────────────── -->
            <ScrollViewer x:Name="AdminPanel" IsVisible="False"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1400" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="16,0,16,32">

                    <!-- Пользователь не администрирует ни одну базу -->
                    <Border Classes="settingRow" x:Name="AdminNoAccessRow" IsVisible="False">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="title" Text="Нет прав администратора" />
                            <TextBlock Classes="desc"
                                       Text="Вы не являетесь администратором ни одной из подключённых баз данных. Администратор — тот, кто создал базу (открыл её первым); он выдаёт допуск и настраивает права остальных пользователей." />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="AdminContent">

                    <!-- Выбор базы данных -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="База данных" />
                                <TextBlock Classes="desc"
                                           Text="Панель управляет доступом к выбранной базе. В списке — базы, где вы администратор." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="AdminDbCombo"
                                      Width="240" Height="{StaticResource ControlHeightStandard}"
                                      VerticalAlignment="Center"
                                      Background="{StaticResource BrushSecondaryBg}"
                                      CornerRadius="{StaticResource RadiusBase}"
                                      SelectionChanged="OnAdminDbChanged" />
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Пароль базы -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Пароль базы данных" />
                                <TextBlock Classes="desc"
                                           Text="Пароль позволяет новому пользователю получить доступ к базе самостоятельно, не дожидаясь подтверждения администратором." />
                                <TextBlock x:Name="PasswordStateText" Classes="desc" Text="" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        Spacing="8" VerticalAlignment="Center">
                                <!-- Width=NaN: подписи длиннее фикс-ширины стиля dialog (110px) —
                                     кнопка растёт под текст, узкие добирают MinWidth. -->
                                <Button x:Name="PasswordSetBtn" Classes="dialog"
                                        Width="NaN" MinWidth="110" Padding="14,0"
                                        Content="Установить пароль"
                                        Click="OnPasswordSet" />
                                <Button x:Name="PasswordRemoveBtn" Classes="dialog"
                                        Width="NaN" MinWidth="110" Padding="14,0"
                                        Content="Убрать"
                                        Click="OnPasswordRemove" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Автоочистка журнала (политика хранится в самой базе, применяется
                         при открытии на любой машине). -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Автоочистка журнала" />
                                <TextBlock Classes="desc"
                                           Text="Старые записи истории изменений автоматически удаляются при открытии базы. Настройка хранится в базе — действует на всех машинах." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        Spacing="10" VerticalAlignment="Center">
                                <!-- SelectedIndex по умолчанию — 12 месяцев (индекс 2);
                                     при загрузке базы RefreshRetentionRow синхронизирует
                                     со значением из db_meta. Список никогда не пуст. -->
                                <ComboBox x:Name="RetentionPeriodCombo"
                                          Width="180" Height="{StaticResource ControlHeightStandard}"
                                          SelectedIndex="2"
                                          VerticalAlignment="Center"
                                          Background="{StaticResource BrushSecondaryBg}"
                                          CornerRadius="{StaticResource RadiusBase}"
                                          SelectionChanged="OnRetentionPeriodChanged">
                                    <ComboBoxItem Tag="3"  Content="Хранить 3 месяца" />
                                    <ComboBoxItem Tag="6"  Content="Хранить 6 месяцев" />
                                    <ComboBoxItem Tag="12" Content="Хранить 12 месяцев" />
                                    <ComboBoxItem Tag="24" Content="Хранить 24 месяца" />
                                </ComboBox>
                                <ToggleSwitch x:Name="RetentionToggle"
                                              OnContent="" OffContent=""
                                              VerticalAlignment="Center"
                                              IsCheckedChanged="OnRetentionToggled" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Разовая очистка журнала за выбранный период. -->
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4"
                                        VerticalAlignment="Center" Margin="0,0,32,0">
                                <TextBlock Classes="title" Text="Очистить журнал" />
                                <TextBlock Classes="desc"
                                           Text="Разово удалить историю изменений выбранной базы за выбранный период. Отменить нельзя." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        Spacing="10" VerticalAlignment="Center">
                                <!-- SelectedIndex по умолчанию — «Старше 12 месяцев» (индекс 3);
                                     список никогда не пуст. -->
                                <ComboBox x:Name="PurgePeriodCombo"
                                          Width="200" Height="{StaticResource ControlHeightStandard}"
                                          SelectedIndex="3"
                                          VerticalAlignment="Center"
                                          Background="{StaticResource BrushSecondaryBg}"
                                          CornerRadius="{StaticResource RadiusBase}">
                                    <ComboBoxItem Tag="1"   Content="Старше 1 месяца" />
                                    <ComboBoxItem Tag="3"   Content="Старше 3 месяцев" />
                                    <ComboBoxItem Tag="6"   Content="Старше 6 месяцев" />
                                    <ComboBoxItem Tag="12"  Content="Старше 12 месяцев" />
                                    <ComboBoxItem Tag="all" Content="Весь журнал" />
                                </ComboBox>
                                <Button x:Name="PurgeBtn" Classes="dialog"
                                        Width="NaN" MinWidth="110" Padding="14,0"
                                        Content="Очистить"
                                        Click="OnPurgeChangeLog" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="separator h" />

                    <!-- Пользователи базы -->
                    <Border Classes="settingRow">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="title" Text="Пользователи" />
                            <TextBlock Classes="desc"
                                       Text="Все, кто открывал эту базу данных. Новые пользователи ждут допуска. Выберите пользователя, чтобы настроить его права." />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="UsersHost" Margin="0,0,0,8" />
                    <Border Classes="separator h" />

                    <!-- Права выбранного пользователя -->
                    <StackPanel x:Name="RightsBlock" IsVisible="False">
                        <Border Classes="settingRow">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4"
                                            VerticalAlignment="Center" Margin="0,0,32,0">
                                    <TextBlock Classes="title" x:Name="RightsTitle"
                                               Text="Права пользователя" />
                                    <TextBlock Classes="desc"
                                               Text="Область действия: вся база данных или отдельная коллекция. Настройки коллекции имеют приоритет над настройками базы." />
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="ScopeCombo"
                                          Width="240" Height="{StaticResource ControlHeightStandard}"
                                          VerticalAlignment="Center"
                                          Background="{StaticResource BrushSecondaryBg}"
                                          CornerRadius="{StaticResource RadiusBase}"
                                          SelectionChanged="OnScopeChanged" />
                            </Grid>
                        </Border>

                        <!-- Сетка чекбоксов: три группы действий (строится в коде) -->
                        <Grid x:Name="ChecksGrid" ColumnDefinitions="*,*,*" Margin="0,4,0,16" />
                        <Border Classes="separator h" />
                    </StackPanel>

                    </StackPanel>

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ── История изменений ─────────────────────────────────
                 Таблица журнала как в конструкторе: колонки с фильтром/сортировкой
                 в шапке (строятся в коде — ProfileHistoryTable.cs), страницы
                 подгружаются при прокрутке. Выбор базы — в навбаре (NavbarProfile).
                 Без боковых полей и MaxWidth остальных панелей — таблица от края
                 до края, как TableView в конструкторе. -->
            <Panel x:Name="HistoryPanel" IsVisible="False">
                <DataGrid x:Name="HistoryGrid"
                          AutoGenerateColumns="False"
                          RowHeight="{StaticResource RowHeightStandard}"
                          CanUserResizeColumns="False"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="False"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="{StaticResource BrushSeparator}"
                          VerticalGridLinesBrush="{StaticResource BrushSeparator}"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          IsReadOnly="True"
                          Background="Transparent"
                          UseLayoutRounding="{DynamicResource LineUseLayoutRounding}"
                          RowBackground="{StaticResource BrushBg}"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto" />
                <TextBlock x:Name="HistoryEmptyText"
                           Text="Записей в журнале пока нет."
                           IsVisible="False"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{StaticResource BrushSecondaryText}"
                           HorizontalAlignment="Center"
                           Margin="0,48,0,0" />
            </Panel>

            <!-- Диагностика: журнал logs.db (Serilog). Оформление — как у «Истории
                 изменений»; отличие: единый файл на приложение, без выбора базы. -->
            <Panel x:Name="LogsPanel" IsVisible="False">
                <DataGrid x:Name="LogsGrid"
                          AutoGenerateColumns="False"
                          RowHeight="{StaticResource RowHeightStandard}"
                          CanUserResizeColumns="False"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="False"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="{StaticResource BrushSeparator}"
                          VerticalGridLinesBrush="{StaticResource BrushSeparator}"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          IsReadOnly="True"
                          Background="Transparent"
                          UseLayoutRounding="{DynamicResource LineUseLayoutRounding}"
                          RowBackground="{StaticResource BrushBg}"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto" />
                <TextBlock x:Name="LogsEmptyText"
                           Text="Записей пока нет."
                           IsVisible="False"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{StaticResource BrushSecondaryText}"
                           HorizontalAlignment="Center"
                           Margin="0,48,0,0" />
            </Panel>

        </Grid>

    </DockPanel>

</UserControl>
