<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="using:SmartBase.Controls.Widgets"
             xmlns:comp="using:SmartBase.Controls.Components"
             x:Class="SmartBase.Views.Notes.NotesControllerView"
             Background="{StaticResource BrushBg}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Шапка: имя заметки с правкой по клику -->
        <comp:NavbarNotes Grid.Row="0" x:Name="HeaderBar" />

        <!-- Тело: редактор ЛИБО готовый вид — рядом они не показываются никогда, поэтому лежат
             в одной колонке и переключаются видимостью.

             Прокручиваемый блок в каждый момент ровно один, и полоса у него одна — вынесена
             отдельной колонкой и идет от линии шапки до линии футера (правило
             docs/developer/ui/scrolling.md). Источник полосы переставляет ApplyMode. Отступов у
             самого ScrollViewer нет: воздух висит на содержимом внутри. -->
        <Panel Grid.Row="1">

            <Grid x:Name="BodyGrid" ClipToBounds="True" ColumnDefinitions="*,Auto">

                <!-- Редактор: безбордерный, как письмо в заметках. Вид, отступы и оформление
                     разметки берет на себя сам виджет — см. его паспорт. -->
                <w:NoteEditorBox Grid.Column="0" x:Name="NoteEditor"
                                 Watermark="Пишите в Markdown..."
                                 IsVisible="False" />

                <!-- Просмотр: виджет AppMarkdown, а не голый MarkdownScrollViewer — вид берется
                     из общего Assets/Styles/Markdown.axaml, тот же, что в инструкции. -->
                <ScrollViewer Grid.Column="0" x:Name="NotePreviewBox"
                              IsVisible="False"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                    <w:AppMarkdown x:Name="NotePreview"
                                   Markdown=""
                                   Margin="16,16,16,16" />
                </ScrollViewer>

                <ScrollBar Grid.Column="1" x:Name="BodyScrollBar"
                           Orientation="Vertical"
                           IsVisible="False" />
            </Grid>

            <!-- ── Пустые состояния ─────────────────────────────────────────────
                 Пока заметка не открыта, тело пусто, и человеку нужно объяснить, чего не хватает.

                 Лежат ОТДЕЛЬНЫМ слоем поверх BodyGrid, а не внутри него спаном по колонкам:
                 когда заметка не открыта, ApplyMode схлопывает обе колонки со звездой в 0, и
                 подсказка получила бы ячейку нулевой ширины — текст прижался бы к левому краю,
                 а кнопка сжалась бы до минимума. Здесь ширина всегда полная. -->

            <!-- Хранилище не выбрано или недоступно -->
            <StackPanel x:Name="VaultHint"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="12" IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock x:Name="VaultHintLead"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource BrushSecondaryText}" />
                    <Viewbox Width="{StaticResource IconSizeLarge}" Height="{StaticResource IconSizeLarge}"
                             VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconSettings}"
                                  Stroke="{StaticResource BrushSecondaryText}"
                                  StrokeThickness="{StaticResource IconStrokeLarge}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="VaultHintTail"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource BrushSecondaryText}" />
                </StackPanel>
                <!-- Стандартная кнопка диалогов, вариант «auto»: вид тот же, ширина по подписи —
                     «Открыть настройки» в дежурные 110 px не влезает. -->
                <Button x:Name="OpenSettingsBtn"
                        Classes="dialog auto"
                        Content="Открыть настройки"
                        HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Хранилище есть, заметка не открыта — подсказка такая же, как в конструкторе -->
            <StackPanel x:Name="PickHint"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="8" IsVisible="False">
                <TextBlock Text="Откройте навигацию, нажмите на"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <Viewbox Width="{StaticResource IconSizeLarge}" Height="{StaticResource IconSizeLarge}"
                         VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource IconPanelOpen}"
                              Stroke="{StaticResource BrushSecondaryText}"
                              StrokeThickness="{StaticResource IconStrokeLarge}"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                    </Canvas>
                </Viewbox>
                <TextBlock Text="и выберите заметку"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushSecondaryText}" />
            </StackPanel>

            <!-- Выбран файл, который раздел не открывает -->
            <TextBlock x:Name="UnsupportedHint"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                       Foreground="{StaticResource BrushSecondaryText}"
                       IsVisible="False" />

        </Panel>

        <!-- Футер: переключатель режима показа -->
        <comp:FooterNotes Grid.Row="2" x:Name="FooterBar" />

    </Grid>

</UserControl>
