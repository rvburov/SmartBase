<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DataBase.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DataBase/Assets/Styles/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!-- Иконка приложения для ВСЕХ окон (главное + все диалоги, в т.ч. будущие).
             На Windows/Linux это иконка в заголовке окна, таскбаре и Alt-Tab.
             На macOS иконка окна не отображается — там она берётся из .app-бандла.

             Указываем .ico, а не .png: backend Win32 разбирает ICONDIR и через
             CreateIconFromResourceEx отдаёт Windows ГОТОВЫЙ слой нужного размера
             (16/24/32/48), а не масштабирует на лету одиночный 512px PNG. Без этого
             иконка в заголовке и таскбаре выглядит мыльной. -->
        <Style Selector="Window">
            <Setter Property="Icon" Value="/Assets/Branding/icon.ico" />
        </Style>
        <StyleInclude Source="avares://DataBase/Assets/Styles/Typography.axaml" />
        <StyleInclude Source="avares://DataBase/Assets/Styles/Controls.axaml" />
        <StyleInclude Source="avares://DataBase/Controls/Widgets/AppCheckBox.axaml" />
    </Application.Styles>

</Application>
