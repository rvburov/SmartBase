<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="clr-namespace:SmartBase.Controls.Components"
             x:Class="SmartBase.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://SmartBase/Assets/Styles/Colors.axaml" />
                <ResourceInclude Source="avares://SmartBase/Assets/Styles/Icons.axaml" />
                <!-- Копии тем ContextMenu/ToolTip с зум-оберткой (см. паспорт файла):
                     попапы меню и тултипов иначе не масштабируются зумом приложения. -->
                <ResourceInclude Source="avares://SmartBase/Assets/Styles/ZoomPopupThemes.axaml" />
                <!-- Копия темы ComboBox (см. паспорт файла): заглушка «Список пуст»,
                     выпадашка не шире поля, высота ≈8 пунктов вместо 504px. -->
                <ResourceInclude Source="avares://SmartBase/Assets/Styles/ComboBoxTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- База в списке: иконка рода хранения (цилиндр — файл, сервер — база на сервере)
                 и имя. Тем же шаблоном ComboBox рисует и выбранный пункт, поэтому иконка видна
                 и в закрытом списке. Шаблон общий на навбар профиля (выбор базы в «Панели
                 администратора» и «Истории изменений») и шапку таблицы пользователей — списки
                 показывают одно и то же и обязаны выглядеть одинаково. Данные — NavbarDb. -->
            <DataTemplate x:Key="NavbarDbTemplate" DataType="comp:NavbarDb">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Viewbox Width="{StaticResource IconSizeSmall}"
                             Height="{StaticResource IconSizeSmall}"
                             VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="{Binding Icon}"
                                  Stroke="{StaticResource BrushSecondaryText}"
                                  StrokeThickness="{StaticResource IconStrokeSmall}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="{Binding Name}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!-- Иконка приложения для ВСЕХ окон (главное + все диалоги, в т.ч. будущие).
             На Windows/Linux это иконка в заголовке окна, таскбаре и Alt-Tab.
             На macOS иконка окна не отображается — там она берется из .app-бандла.

             Указываем .ico, а не .png: backend Win32 разбирает ICONDIR и через
             CreateIconFromResourceEx отдает Windows ГОТОВЫЙ слой нужного размера
             (16/24/32/48), а не масштабирует на лету одиночный 512px PNG. Без этого
             иконка в заголовке и таскбаре выглядит мыльной. -->
        <Style Selector="Window">
            <Setter Property="Icon" Value="/Assets/Branding/icon.ico" />
        </Style>
        <StyleInclude Source="avares://SmartBase/Assets/Styles/Typography.axaml" />
        <!-- Стандарт габаритов диалоговых окон (расширений не касается) -->
        <StyleInclude Source="avares://SmartBase/Assets/Styles/WindowMetrics.axaml" />
        <StyleInclude Source="avares://SmartBase/Assets/Styles/Controls.axaml" />
        <!-- Вид строки настройки, ячейки с данными и строки таблицы: нужен и «Настройкам»,
             и панели администратора (контур безопасности, журнал безопасности). -->
        <StyleInclude Source="avares://SmartBase/Assets/Styles/SettingRows.axaml" />
        <StyleInclude Source="avares://SmartBase/Controls/Widgets/AppCheckBox.axaml" />
    </Application.Styles>

</Application>
