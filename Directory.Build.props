<Project>

  <!--
    Artifacts Output Layout (официальная фича .NET 8+).
    Все результаты сборки (bin/, obj/, publish/) собираются в одну папку
    artifacts\ в корне проекта вместо разбросанных bin\ и obj\.
    Корень проекта остается чистым — только код.
    Папка artifacts\ исключена в .gitignore.
    Кэш NuGet-пакетов лежит отдельно в packages\ (см. nuget.config).
  -->
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
  </PropertyGroup>

  <!--
    Рабочая папка агента (git worktree, см. Scripts/worktree.sh и AGENTS.md) берет пакеты из
    кэша основной папки, а не качает свои ~2 ГБ. В рабочей папке .git — файл со строкой
    «gitdir: <основная>/.git/worktrees/<имя>», в основной — каталог, и File.Exists отличает одну
    от другой; где бы ни лежала рабочая папка, основная — три уровня выше ее gitdir.
    Ссылку на кэш внутри рабочей папки не ставить: git worktree remove на Windows проходит по
    ссылке и стирает содержимое кэша.
  -->
  <PropertyGroup Condition="$([System.IO.File]::Exists('$(MSBuildThisFileDirectory).git'))">
    <SbWorktreeGitDir>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory).git').Trim().Substring(7).Trim())</SbWorktreeGitDir>
    <SbWorktreeGitDir>$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', '$(SbWorktreeGitDir)'))</SbWorktreeGitDir>
    <RestorePackagesPath>$([System.IO.Path]::GetFullPath('$(SbWorktreeGitDir)/../../../packages/packages'))</RestorePackagesPath>
  </PropertyGroup>

</Project>
