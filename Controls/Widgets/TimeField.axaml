<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartBase.Controls.Widgets.TimeField">

    <Border x:Name="Box" Classes="timeField" Height="34">
        <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" x:Name="Input" Classes="timeInput" />
            <Button Grid.Column="1" x:Name="Arrow" Classes="timeArrow">
                <Viewbox Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}">
                    <Canvas Width="24" Height="24">
                        <!-- стандартная иконка «время» (часы), в пару к иконке даты -->
                        <Path Data="{StaticResource IconClock}"
                              Stroke="{StaticResource BrushSecondaryText}"
                              StrokeThickness="{StaticResource IconStrokeSmall}"
                              StrokeLineCap="Round"
                              StrokeJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Button>
            <Popup Grid.Column="0" x:Name="Pop" InheritsTransform="True"
                   PlacementTarget="{Binding #Box}"
                   Placement="BottomEdgeAlignedLeft"
                   IsLightDismissEnabled="True">
                <!-- Padding НУЛЕВОЙ (перебивает «0,2» стиля timePopup): полоса прокрутки
                     идет вплотную к верхнему и нижнему краю попапа, без белых зазоров.
                     Воздух над первым и под последним пунктом дает Padding самого списка —
                     он внутри ScrollViewer и полосу не двигает. ClipToBounds — квадратные
                     концы полосы срезаются скруглением рамки. -->
                <Border Classes="timePopup" MinWidth="{Binding #Box.Bounds.Width}"
                        Padding="0" ClipToBounds="True">
                    <ScrollViewer MaxHeight="240">
                        <ListBox x:Name="List" Classes="timeList" />
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
    </Border>

</UserControl>
