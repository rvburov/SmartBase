<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DataBase.Controls.Widgets.DateField">

    <!-- Поле даты по образцу TimeField: свой Popup, внутрь которого Calendar
         создаётся ЗАНОВО при каждом открытии (иначе он сохраняет «зажатое»
         состояние указателя между открытиями и выбирает дату по наведению). -->
    <Border x:Name="Box" Classes="timeField" Height="34">
        <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" x:Name="Input" Classes="timeInput"
                     Watermark="дд.мм.гггг" />
            <Button Grid.Column="1" x:Name="Arrow" Classes="timeArrow">
                <Viewbox Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource IconCalendar}"
                              Stroke="{StaticResource BrushSecondaryText}"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              StrokeJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Button>
            <Popup Grid.Column="0" x:Name="Pop"
                   PlacementTarget="{Binding #Box}"
                   Placement="BottomEdgeAlignedLeft"
                   IsLightDismissEnabled="True">
                <Border x:Name="PopHost" Classes="timePopup" Padding="4" />
            </Popup>
        </Grid>
    </Border>

</UserControl>
