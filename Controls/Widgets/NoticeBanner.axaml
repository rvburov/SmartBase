<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartBase.Controls.Widgets.NoticeBanner"
             IsVisible="False">

    <!-- ЕДИНЫЙ вид уведомления на все приложение: иконка-восклицание + красная рамка +
         светло-красная подложка + красный текст. Любая новая «красная плашка» (ошибка
         валидации, пояснение в диалоге, тост) делается ЭТИМ виджетом, а не своей версткой.
         Цвета — только из палитры (Colors.axaml), размер текста — из Typography.axaml. -->
    <Border Background="{StaticResource BrushRedLight}"
            BorderBrush="{StaticResource BrushRed}"
            BorderThickness="{DynamicResource BorderLine}"
            CornerRadius="{StaticResource RadiusBase}"
            Padding="10,7">
        <!-- Иконка — своя колонка слева, по центру ВСЕЙ плашки (не по первой строке):
             текст многострочный, и иконка стоит напротив его середины. -->
        <Grid ColumnDefinitions="Auto,8,*">
            <Viewbox Grid.Column="0" Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}"
                     VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Ellipse Width="24" Height="24" Fill="{StaticResource BrushRed}" />
                    <Path Data="{StaticResource IconAlertMark}"
                          Stroke="White" StrokeThickness="2"
                          StrokeLineCap="Round" />
                </Canvas>
            </Viewbox>
            <TextBlock Grid.Column="2" x:Name="MessageText"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource BrushRed}" />
        </Grid>
    </Border>
</UserControl>
