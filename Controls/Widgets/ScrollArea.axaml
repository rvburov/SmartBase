<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DataBase.Controls.Widgets.ScrollArea">

    <!-- Тонкий скроллбар — аналог CustomScrollBar из scroll_area.py -->
    <ScrollViewer x:Name="PART_Scroll"
                  HorizontalScrollBarVisibility="{Binding HScrollVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  VerticalScrollBarVisibility="{Binding VScrollVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <ContentPresenter Content="{Binding InnerContent, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    </ScrollViewer>

</UserControl>
