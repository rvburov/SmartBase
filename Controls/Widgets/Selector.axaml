<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartBase.Controls.Widgets.Selector">

    <!-- Выпадающий список: обертка над ComboBox со стилем приложения -->
    <ComboBox x:Name="PART_Combo"
              ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType=UserControl}}"
              SelectedIndex="{Binding SelectedIndex, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
              DisplayMemberBinding="{Binding Label}"
              Background="{StaticResource BrushSecondaryBg}"
              BorderBrush="{StaticResource BrushSeparator}"
              CornerRadius="{StaticResource RadiusBase}"
              Height="32"
              HorizontalAlignment="Stretch" />

</UserControl>
