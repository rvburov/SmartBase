<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:DataBase.Controls.Widgets"
             x:Class="DataBase.Controls.Widgets.DateEditor">

    <Border x:Name="Box" Classes="timeField" Height="34">
        <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" x:Name="Input" Classes="timeInput"
                     Watermark="дд.мм.гггг" />
            <Button Grid.Column="1" x:Name="Arrow" Classes="timeArrow">
                <Viewbox Width="16" Height="16">
                    <Canvas Width="24" Height="24">
                        <!-- иконка календаря -->
                        <Path Data="M7 4 L7 7 M17 4 L17 7 M4 9 L20 9
                                    M5 6 L19 6 A1 1 0 0 1 20 7 L20 19
                                    A1 1 0 0 1 19 20 L5 20 A1 1 0 0 1 4 19
                                    L4 7 A1 1 0 0 1 5 6 Z"
                              Stroke="{StaticResource BrushSecondaryText}"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              StrokeJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Button>

            <Popup Grid.Column="0" x:Name="Pop"
                   PlacementTarget="{Binding #Box}"
                   Placement="BottomEdgeAlignedLeft"
                   IsLightDismissEnabled="False">
                <Border Classes="timePopup" Background="{StaticResource BrushBg}"
                        Padding="14" MinWidth="320">
                    <StackPanel Spacing="8">

                        <!-- Начало -->
                        <TextBlock Text="Начало"
                                   FontWeight="{StaticResource FontWeightBold}"
                                   FontSize="{StaticResource FontSizeBase}"
                                   Foreground="{StaticResource BrushSecondaryText}" />
                        <Grid x:Name="StartRow" ColumnDefinitions="2*,8,*">
                            <CalendarDatePicker Grid.Column="0" x:Name="StartDate"
                                                Height="34" HorizontalAlignment="Stretch"
                                                SelectedDateFormat="Custom"
                                                CustomDateFormatString="dd.MM.yyyy" />
                            <w:TimeField Grid.Column="2" x:Name="StartTime" />
                        </Grid>

                        <!-- Конец -->
                        <TextBlock Text="Конец"
                                   Margin="0,4,0,0"
                                   FontWeight="{StaticResource FontWeightBold}"
                                   FontSize="{StaticResource FontSizeBase}"
                                   Foreground="{StaticResource BrushSecondaryText}" />
                        <Grid x:Name="EndRow" ColumnDefinitions="2*,8,*">
                            <CalendarDatePicker Grid.Column="0" x:Name="EndDate"
                                                Height="34" HorizontalAlignment="Stretch"
                                                SelectedDateFormat="Custom"
                                                CustomDateFormatString="dd.MM.yyyy" />
                            <w:TimeField Grid.Column="2" x:Name="EndTime" />
                        </Grid>

                        <CheckBox x:Name="AllDayCheck"
                                  Content="Весь день"
                                  Margin="0,6,0,2"
                                  FontSize="{StaticResource FontSizeBase}"
                                  Foreground="{StaticResource BrushPrimaryText}" />

                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Grid.Column="0" x:Name="ClearBtn" Classes="dialog"
                                    Content="Очистить" />
                            <Button Grid.Column="2" x:Name="DoneBtn" Classes="dialog"
                                    Content="Готово" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>

</UserControl>
