<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:DataBase.Controls.Widgets"
             x:Class="DataBase.Controls.Widgets.DateEditor">

    <Border x:Name="Box" Classes="timeField" Height="34">
        <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" x:Name="Input" Classes="timeInput"
                     Watermark="дд.мм.гггг" />
            <Button Grid.Column="1" x:Name="Arrow" Classes="timeArrow">
                <Viewbox Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}">
                    <Canvas Width="24" Height="24">
                        <!-- стандартная иконка «дата» (календарь с цифрой 1), как в шапке колонки -->
                        <Path Data="{StaticResource IconCalendarDate}"
                              Stroke="{StaticResource BrushSecondaryText}"
                              StrokeThickness="1.8"
                              StrokeLineCap="Round"
                              StrokeJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Button>

            <Popup Grid.Column="0" x:Name="Pop"
                   PlacementTarget="{Binding #Box}"
                   Placement="BottomEdgeAlignedLeft"
                   IsLightDismissEnabled="False">
                <Border Classes="timePopup" Background="{StaticResource BrushBg}"
                        Padding="14" MinWidth="320">
                    <StackPanel Spacing="8">

                        <!-- Начало -->
                        <TextBlock Text="Начало"
                                   FontWeight="{StaticResource FontWeightBold}"
                                   Foreground="{StaticResource BrushSecondaryText}" />
                        <Grid x:Name="StartRow" ColumnDefinitions="2*,8,*">
                            <w:DateField Grid.Column="0" x:Name="StartDate" />
                            <w:TimeField Grid.Column="2" x:Name="StartTime" />
                        </Grid>

                        <!-- Конец -->
                        <TextBlock Text="Конец"
                                   Margin="0,4,0,0"
                                   FontWeight="{StaticResource FontWeightBold}"
                                   Foreground="{StaticResource BrushSecondaryText}" />
                        <Grid x:Name="EndRow" ColumnDefinitions="2*,8,*">
                            <w:DateField Grid.Column="0" x:Name="EndDate" />
                            <w:TimeField Grid.Column="2" x:Name="EndTime" />
                        </Grid>

                        <CheckBox x:Name="AllDayCheck"
                                  Content="Весь день"
                                  Margin="0,6,0,2"
                                  />

                        <!-- Уведомление об ошибке валидации (как в RecordDialog) -->
                        <w:ErrorBanner x:Name="ErrorBanner" Margin="0,2,0,2" />

                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Grid.Column="0" x:Name="ClearBtn" Classes="dialog"
                                    Content="Очистить" />
                            <Button Grid.Column="2" x:Name="DoneBtn" Classes="dialog"
                                    Content="Готово" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>

</UserControl>
