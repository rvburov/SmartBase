<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="using:SmartBase.Controls.Components"
             x:Class="SmartBase.Controls.Components.SidebarFiles"
             Background="{StaticResource BrushBg}">

  <Border>
    <DockPanel>

        <!-- Тулбар: создать + развернуть/свернуть + сортировка. Геометрия и стили — те же, что
             у дерева конструктора (SidebarTree.axaml): раздел накладывается на программу, а не
             заводит собственный вид. -->
        <Border DockPanel.Dock="Top"
                Height="56"
                Padding="10,13">
            <StackPanel Orientation="Horizontal" Spacing="6">

                <!-- Создать папку или заметку -->
                <Button x:Name="CreateBtn" Classes="navbtn"
                        Width="30" Height="30"
                        CornerRadius="{StaticResource RadiusMedium}"
                        ToolTip.Tip="Создать">
                    <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconPlus}"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="{StaticResource IconStrokeMediumBold}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Развернуть/свернуть все -->
                <ToggleButton x:Name="ExpandBtn" Classes="navbtn"
                              Width="30" Height="30"
                              CornerRadius="{StaticResource RadiusMedium}"
                              ToolTip.Tip="Развернуть все">
                    <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="ExpandIcon"
                                  Data="{StaticResource IconExpandAll}"
                                  Stroke="{Binding $parent[ToggleButton].Foreground}"
                                  StrokeThickness="{StaticResource IconStrokeMedium}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                            <Path x:Name="CollapseIcon"
                                  IsVisible="False"
                                  Data="{StaticResource IconCollapseAll}"
                                  Stroke="{Binding $parent[ToggleButton].Foreground}"
                                  StrokeThickness="{StaticResource IconStrokeMedium}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </ToggleButton>

                <!-- Сортировка по имени. Положений два, а не три, как в конструкторе: у файлов
                     нет собственной позиции, а порядок файловой системы произволен. -->
                <Button x:Name="SortBtn" Classes="navbtn"
                        Width="30" Height="30"
                        CornerRadius="{StaticResource RadiusMedium}"
                        ToolTip.Tip="А → Я">
                    <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="SortAscIcon"
                                  Data="{StaticResource IconSortAsc}"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="{StaticResource IconStrokeMedium}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                            <Path x:Name="SortDescIcon"
                                  IsVisible="False"
                                  Data="{StaticResource IconSortDesc}"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="{StaticResource IconStrokeMedium}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

            </StackPanel>
        </Border>

        <!-- Плоский список с виртуализацией — как в дереве конструктора.
             Горизонтальная прокрутка: длинные имена с отступом вложенности перестают упираться
             в правый край. Ширина строки при этом ПОСТОЯННАЯ (SidebarFileRow.MinRowWidth,
             считает MeasureRowWidth), иначе экстент считался бы по видимым строкам и полоса
             прыгала бы при вертикальной прокрутке. -->
        <Panel>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Background="Transparent"
                          ContextRequested="OnEmptyContextRequested">
                <!-- UseLayoutRounding отключается при зуме≠1 (тот же токен, что у DataGrid): иначе
                     округление раздувает толщину линии-разделителя и копит сдвиг строк вниз. -->
                <ItemsControl x:Name="RowsHost" Padding="0"
                              UseLayoutRounding="{DynamicResource LineUseLayoutRounding}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="comp:SidebarFileRow">
                            <!-- Строка повторяет структуру строки DataGrid: контент = высота ячейки
                                 (RowHeightStandard = 36) в Row 0, линия-разделитель — компенсированный
                                 по зуму SeparatorThickness в Auto-строке Row 1. У ПЕРВОЙ строки (= шапка
                                 колонок) Row 1 схлопнут в 0, а линия лежит ПОВЕРХ контента. -->
                            <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="{Binding LineRowHeight}" />
                            </Grid.RowDefinitions>
                            <Border x:Name="RowRoot"
                                    Grid.Row="0"
                                    Background="{Binding RowBackground}"
                                    Padding="10,0,0,0"
                                    Height="{Binding RowContentHeight}"
                                    MinHeight="{StaticResource RowHeightStandard}"
                                    MinWidth="{Binding MinRowWidth}"
                                    Tapped="OnRowTapped"
                                    PointerEntered="OnRowEnter"
                                    PointerExited="OnRowExit"
                                    ContextRequested="OnRowContextRequested">
                                <Grid VerticalAlignment="Stretch"
                                      ColumnDefinitions="Auto,Auto,Auto,*"
                                      Margin="{Binding IndentMargin}">

                                    <!-- Слот стрелки: 22 у папок, 0 у файлов -->
                                    <Border Grid.Column="0"
                                            Width="{Binding ChevronSlot}"
                                            VerticalAlignment="Stretch"
                                            Background="Transparent"
                                            Tapped="OnChevronTapped">
                                        <Viewbox Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Center"
                                                 IsVisible="{Binding ShowChevron}">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{Binding ChevronGeometry}"
                                                      Stroke="{StaticResource BrushSecondaryText}"
                                                      StrokeThickness="{StaticResource IconStrokeSmall}"
                                                      StrokeLineCap="Round" StrokeJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>

                                    <!-- Слот чекбокса: в заметках всегда 0. Колонка сохранена, чтобы
                                         формула ширины строки совпадала с конструкторской. -->
                                    <Border Grid.Column="1"
                                            Width="{Binding CheckboxSlot}"
                                            VerticalAlignment="Stretch"
                                            Background="Transparent" />

                                    <!-- Иконка папки/заметки/прочего файла -->
                                    <Viewbox Grid.Column="2" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"
                                             Margin="2,0,0,0"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{Binding IconGeometry}"
                                                  Stroke="{Binding IconBrush}"
                                                  StrokeThickness="{StaticResource IconStrokeMedium}"
                                                  StrokeLineCap="Round" StrokeJoin="Round" />
                                        </Canvas>
                                    </Viewbox>

                                    <!-- Имя с расширением: в дереве видно, что за файл, даже если
                                         открыть его нельзя. -->
                                    <TextBlock Grid.Column="3"
                                               VerticalAlignment="Center"
                                               Margin="6,4,8,4"
                                               Text="{Binding Name}"
                                               Foreground="{Binding NameBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                            <!-- Линия-разделитель: белая (цвет фона), aliased, толщина = компенсированный
                                 SeparatorThickness (1 физ. пиксель), на всю ширину. -->
                            <Rectangle Grid.Row="{Binding LineGridRow}"
                                       Fill="{StaticResource BrushBg}"
                                       Height="{DynamicResource SeparatorThickness}"
                                       VerticalAlignment="Bottom"
                                       UseLayoutRounding="{DynamicResource LineUseLayoutRounding}"
                                       RenderOptions.EdgeMode="Aliased"
                                       IsHitTestVisible="False" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Пустое состояние поверх списка: без него человек видит белое поле и не понимает,
                 хранилище не выбрано, папка пуста или программа сломалась.

                 Нижний отступ 72 = 16 воздуха + 56 футера раздела. Сайдбар идет до самого низа
                 окна, а тело заметок обрывается о футер, поэтому «по центру» у них разный центр —
                 и две подсказки, стоящие рядом, разъезжались бы по высоте. Отступ уравнивает
                 коробки: у обеих верх на линии шапки, низ на линии футера. -->
            <TextBlock x:Name="EmptyHint"
                       IsVisible="False"
                       Text=""
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="16,16,16,72"
                       MaxWidth="200"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{StaticResource BrushSecondaryText}"
                       IsHitTestVisible="False" />
        </Panel>

    </DockPanel>
  </Border>

</UserControl>
