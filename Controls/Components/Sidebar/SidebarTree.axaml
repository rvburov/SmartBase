<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="using:SmartBase.Controls.Components"
             x:Class="SmartBase.Controls.Components.SidebarTree"
             Background="{StaticResource BrushBg}">

  <Border>
    <DockPanel>

        <!-- Тулбар: создать (всегда) + развернуть/свернуть + сортировка + включить/выключить (только календарь) -->
        <Border DockPanel.Dock="Top"
                Height="56"
                Padding="10,13">
            <StackPanel Orientation="Horizontal" Spacing="6">

                <!-- Создать -->
                <Button x:Name="CreateBtn" Classes="navbtn"
                        Width="30" Height="30"
                        CornerRadius="{StaticResource RadiusMedium}"
                        ToolTip.Tip="Создать">
                    <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconPlus}"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="{StaticResource IconStrokeMediumBold}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Развернуть/свернуть все -->
                <ToggleButton x:Name="ExpandBtn" Classes="navbtn"
                              Width="30" Height="30"
                              CornerRadius="{StaticResource RadiusMedium}"
                              ToolTip.Tip="Развернуть все">
                    <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="ExpandIcon"
                                  Data="{StaticResource IconExpandAll}"
                                  Stroke="{Binding $parent[ToggleButton].Foreground}"
                                  StrokeThickness="{StaticResource IconStrokeMedium}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                            <Path x:Name="CollapseIcon"
                                  IsVisible="False"
                                  Data="{StaticResource IconCollapseAll}"
                                  Stroke="{Binding $parent[ToggleButton].Foreground}"
                                  StrokeThickness="{StaticResource IconStrokeMedium}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </ToggleButton>

                <!-- Сортировка -->
                <Button x:Name="SortBtn" Classes="navbtn"
                        Width="30" Height="30"
                        CornerRadius="{StaticResource RadiusMedium}"
                        ToolTip.Tip="Сортировка по имени">
                    <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconSortAsc}"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="{StaticResource IconStrokeMedium}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Включить/выключить все (только календарь) -->
                <Button x:Name="ToggleAllBtn" Classes="navbtn"
                        Width="30" Height="30"
                        CornerRadius="{StaticResource RadiusMedium}"
                        ToolTip.Tip="Включить все">
                    <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconSquareCheck}"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="{StaticResource IconStrokeMedium}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Импорт таблиц (Excel/CSV/JSON) в новые коллекции; экспорт пока отключен (lucide download) -->
                <Button x:Name="ImportExportBtn" Classes="navbtn"
                        Width="30" Height="30"
                        CornerRadius="{StaticResource RadiusMedium}"
                        ToolTip.Tip="Импорт/Экспорт">
                    <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconDownload}"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="{StaticResource IconStrokeMedium}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

            </StackPanel>
        </Border>

        <!-- Плоский список с виртуализацией.
             Горизонтальная прокрутка: длинные имена (вложенные группы и коллекции с
             отступом) перестают упираться в правый край — их можно домотать полосой снизу.
             Ширина строки при этом ПОСТОЯННАЯ (SidebarRow.MinRowWidth, считает
             MeasureRowWidth), иначе экстент считался бы по видимым строкам и полоса
             прыгала бы при вертикальной прокрутке. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Background="Transparent"
                      ContextRequested="OnEmptyContextRequested">
            <!-- UseLayoutRounding отключается при зуме≠1 (тот же токен, что у DataGrid): иначе
                 округление раздувает толщину линии-разделителя и копит сдвиг строк вниз. -->
            <ItemsControl x:Name="RowsHost" Padding="0"
                          UseLayoutRounding="{DynamicResource LineUseLayoutRounding}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="comp:SidebarRow">
                        <!-- Строка повторяет структуру строки DataGrid. Контент = высота ячейки
                             (токен RowHeightTable, настройка «Плотность строк таблицы») в Row 0.
                             Линия-разделитель — компенсированный по
                             зуму SeparatorThickness (ровно 1 физ. пиксель, как линия сетки таблицы):
                             у строк ДАННЫХ она в Auto-строке Row 1 → ДОБАВЛЯЕТСЯ (36 + линия); у ПЕРВОЙ
                             строки (= шапка колонок) Row 1 схлопнут в 0, а линия лежит ПОВЕРХ контента
                             (Row 0, снизу) → высота ровно 36, но линия видна. MinHeight держит нижний
                             предел, чтобы заглушки очереди со статусом могли вырасти под вторую строку. -->
                        <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{Binding LineRowHeight}" />
                        </Grid.RowDefinitions>
                        <Border x:Name="RowRoot"
                                Grid.Row="0"
                                Background="{Binding RowBackground}"
                                Padding="10,0,0,0"
                                Height="{Binding RowContentHeight}"
                                MinHeight="{DynamicResource RowHeightTable}"
                                MinWidth="{Binding MinRowWidth}"
                                Tapped="OnRowTapped"
                                PointerEntered="OnRowEnter"
                                PointerExited="OnRowExit"
                                ContextRequested="OnRowContextRequested">
                            <Grid VerticalAlignment="Stretch"
                                  ColumnDefinitions="Auto,Auto,Auto,*"
                                  Margin="{Binding IndentMargin}">

                                <!-- Слот стрелки (chevron): 22 для групп, 0 для коллекций -->
                                <Border Grid.Column="0"
                                        Width="{Binding ChevronSlot}"
                                        VerticalAlignment="Stretch"
                                        Background="Transparent"
                                        Tapped="OnChevronTapped">
                                    <Viewbox Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center"
                                             IsVisible="{Binding ShowChevron}">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{Binding ChevronGeometry}"
                                                  Stroke="{StaticResource BrushSecondaryText}"
                                                  StrokeThickness="{StaticResource IconStrokeSmall}"
                                                  StrokeLineCap="Round" StrokeJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>

                                <!-- Слот чекбокса: только в режиме календаря у коллекций; иначе 0 -->
                                <Border Grid.Column="1"
                                        Width="{Binding CheckboxSlot}"
                                        VerticalAlignment="Stretch"
                                        Background="Transparent"
                                        Tapped="OnCheckboxTapped">
                                    <Border Width="{StaticResource CheckBoxSize}"
                                            Height="{StaticResource CheckBoxSize}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            CornerRadius="{StaticResource CheckBoxRadius}"
                                            IsVisible="{Binding ShowCheckbox}"
                                            Background="{Binding CheckFill}"
                                            BorderBrush="{Binding CheckBorder}"
                                            BorderThickness="{DynamicResource BorderLine}">
                                        <Viewbox Width="{StaticResource CheckBoxGlyphSize}"
                                                 Height="{StaticResource CheckBoxGlyphSize}"
                                                 IsVisible="{Binding Checked}">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource CheckBoxGlyphGeometry}"
                                                      Stroke="White"
                                                      StrokeThickness="{StaticResource CheckBoxGlyphThickness}"
                                                      StrokeLineCap="Round" StrokeJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                </Border>

                                <!-- Иконка папки/файла (24px зона) -->
                                <Viewbox Grid.Column="2" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"
                                         Margin="2,0,0,0"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{Binding IconGeometry}"
                                              Stroke="{Binding IconBrush}"
                                              StrokeThickness="{StaticResource IconStrokeMedium}"
                                              StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Canvas>
                                </Viewbox>

                                <!-- Имя (+ статусная строка у немонтированных баз:
                                     «в очереди…» / «Обновление · 45% · ≈ 2 мин» / «недоступна…») -->
                                <StackPanel Grid.Column="3"
                                            VerticalAlignment="Center"
                                            Margin="6,4,8,4"
                                            Spacing="1">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{Binding NameBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Status}"
                                               IsVisible="{Binding HasStatus}"
                                               Foreground="{Binding StatusBrush}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Линия-разделитель: белая (цвет фона), aliased, толщина = компенсированный
                             SeparatorThickness (1 физ. пиксель), на всю ширину. Row 1 у строк данных
                             (добавляется под контент), Row 0 у первой строки (поверх контента снизу). -->
                        <Rectangle Grid.Row="{Binding LineGridRow}"
                                   Fill="{StaticResource BrushBg}"
                                   Height="{DynamicResource SeparatorThickness}"
                                   VerticalAlignment="Bottom"
                                   UseLayoutRounding="{DynamicResource LineUseLayoutRounding}"
                                   RenderOptions.EdgeMode="Aliased"
                                   IsHitTestVisible="False" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
  </Border>

</UserControl>
