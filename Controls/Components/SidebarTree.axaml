<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="using:MyPlanner.Controls.Components"
             x:Class="MyPlanner.Controls.Components.SidebarTree"
             Background="{StaticResource BrushBg}">

  <Border>
    <DockPanel>

        <!-- Кнопки: новая коллекция, новая группа, развернуть, сортировка.
             Нижняя линия рисуется единой полосой в MainWindow (на высоте навбара). -->
        <Border DockPanel.Dock="Top"
                Height="56"
                Padding="10,13">
            <StackPanel Orientation="Horizontal" Spacing="6">

                <!-- Создать (коллекцию или группу — выбор в диалоге) -->
                <Button x:Name="CreateBtn" Classes="navbtn"
                        Width="30" Height="30"
                        CornerRadius="{StaticResource RadiusMedium}"
                        ToolTip.Tip="Создать">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Path Data="M5 12 H19 M12 5 V19"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="2"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <ToggleButton x:Name="ExpandBtn" Classes="navbtn"
                              Width="30" Height="30"
                              CornerRadius="{StaticResource RadiusMedium}"
                              ToolTip.Tip="Развернуть все">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <!-- chevrons-up-down (развернуть) -->
                            <Path x:Name="ExpandIcon"
                                  Data="M7 15 L12 20 L17 15 M7 9 L12 4 L17 9"
                                  Stroke="{Binding $parent[ToggleButton].Foreground}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                            <!-- chevrons-down-up (свернуть) -->
                            <Path x:Name="CollapseIcon"
                                  IsVisible="False"
                                  Data="M7 20 L12 15 L17 20 M7 4 L12 9 L17 4"
                                  Stroke="{Binding $parent[ToggleButton].Foreground}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </ToggleButton>

                <Button x:Name="SortBtn" Classes="navbtn"
                        Width="30" Height="30"
                        CornerRadius="{StaticResource RadiusMedium}"
                        ToolTip.Tip="Сортировка по имени">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Path Data="M3 8 L7 4 L11 8 M7 4 V20 M11 12 H15 M11 16 H18 M11 20 H21"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

            </StackPanel>
        </Border>

        <!-- Кастомное дерево: плоский список видимых строк с виртуализацией.
             Все ширины фиксированы → выравнивание точное; тянет 1 млн записей. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Background="Transparent"
                      ContextRequested="OnEmptyContextRequested">
            <ItemsControl x:Name="RowsHost" Padding="0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="comp:FlatRow">
                        <!-- Высота строки = RowStepStandard (37px): контент 36px + линия 1px
                             снизу (рисуется внутри Height). Шаг строки совпадает с таблицей,
                             где линия сетки 1px между строками высотой 36px. -->
                        <Border x:Name="RowRoot"
                                Background="{Binding RowBackground}"
                                Margin="0"
                                Height="{StaticResource RowStepStandard}"
                                BorderBrush="{StaticResource BrushBg}"
                                BorderThickness="0,0,0,1"
                                Tapped="OnRowTapped"
                                PointerEntered="OnRowEnter"
                                PointerExited="OnRowExit"
                                ContextRequested="OnRowContextRequested">
                            <!-- Отступ уровня через Margin; слот стрелки фикс-ширины
                                 (0 у коллекций → иконка встаёт на место стрелки).
                                 Grid центрирует текст по вертикали штатно. -->
                            <Grid VerticalAlignment="Stretch"
                                  ColumnDefinitions="Auto,24,*"
                                  Margin="{Binding IndentMargin}">

                                <!-- Слот стрелки: 22px у групп, 0 у коллекций -->
                                <Border Grid.Column="0"
                                        Width="{Binding ChevronSlot}"
                                        VerticalAlignment="Stretch"
                                        Background="Transparent"
                                        Tapped="OnChevronTapped">
                                    <Viewbox Width="14" Height="14"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center"
                                             IsVisible="{Binding ShowChevron}">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{Binding ChevronGeometry}"
                                                  Stroke="{StaticResource BrushSecondaryText}"
                                                  StrokeThickness="2"
                                                  StrokeLineCap="Round" StrokeJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>

                                <!-- Иконка: папка / коллекция (зона 24px) -->
                                <Viewbox Grid.Column="1" Width="18" Height="18"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{Binding IconGeometry}"
                                              Stroke="{Binding IconBrush}"
                                              StrokeThickness="1.6"
                                              StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Canvas>
                                </Viewbox>

                                <!-- Имя -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Name}"
                                           FontSize="{StaticResource FontSizeBase}"
                                           Foreground="{Binding NameBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="2,0,8,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
  </Border>

</UserControl>
