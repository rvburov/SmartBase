<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyPlanner.Controls.Components.SidebarTree"
             Width="220"
             Background="{StaticResource BrushBg}">

    <DockPanel>

        <!-- Кнопки: новая коллекция, новая группа, развернуть, сортировка -->
        <Border DockPanel.Dock="Top"
                Height="56"
                BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="0,0,0,1"
                Padding="10,13">
            <StackPanel Orientation="Horizontal" Spacing="6">

                <Button x:Name="NewCollectionBtn"
                        Width="30" Height="30"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Background="{StaticResource BrushSecondaryBg}"
                        ToolTip.Tip="Новая коллекция">
                    <Path Data="M8,6 L16,6 L22,12 L22,24 Q22,25 21,25 L9,25 Q8,25 8,24 L8,6 Z M16,6 L16,12 L22,12 M13,18 L17,18 M15,16 L15,20"
                          Stroke="{StaticResource BrushSecondaryText}"
                          StrokeThickness="1.5" StrokeLineCap="Round" />
                </Button>

                <Button x:Name="NewGroupBtn"
                        Width="30" Height="30"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Background="{StaticResource BrushSecondaryBg}"
                        ToolTip.Tip="Новая группа">
                    <Path Data="M4,8 Q4,7 5,7 L11,7 L13,10 L25,10 Q26,10 26,11 L26,23 Q26,24 25,24 L5,24 Q4,24 4,23 Z M15,16 L15,20 M13,18 L17,18"
                          Stroke="{StaticResource BrushSecondaryText}"
                          StrokeThickness="1.5" StrokeLineCap="Round" />
                </Button>

                <ToggleButton x:Name="ExpandBtn"
                              Width="30" Height="30"
                              CornerRadius="{StaticResource RadiusMedium}"
                              ToolTip.Tip="Развернуть все">
                    <Path Data="M15,8 L15,12 M13,10 L15,8 L17,10 M15,22 L15,18 M13,20 L15,22 L17,20"
                          Stroke="{StaticResource BrushSecondaryText}"
                          StrokeThickness="1.5" StrokeLineCap="Round" />
                </ToggleButton>

                <Button x:Name="SortBtn"
                        Width="30" Height="30"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Background="{StaticResource BrushSecondaryBg}"
                        ToolTip.Tip="Сортировка по имени">
                    <Path Data="M11,8 L11,20 M8,10 L11,8 L14,10 M19,22 L19,10 M16,20 L19,22 L22,20"
                          Stroke="{StaticResource BrushSecondaryText}"
                          StrokeThickness="1.5" StrokeLineCap="Round" />
                </Button>

            </StackPanel>
        </Border>

        <!-- Дерево групп и коллекций -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TreeView x:Name="CollectionTree"
                      Background="Transparent"
                      Padding="4,4">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Icon}"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushSecondaryText}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}"
                                       FontSize="{StaticResource FontSizeBase}"
                                       Foreground="{StaticResource BrushPrimaryText}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </ScrollViewer>

    </DockPanel>

</UserControl>
