<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DataBase.Controls.Components.SettingsSidebar"
             Background="{StaticResource BrushBg}">

    <UserControl.Styles>
        <!-- Строка раздела — те же метрики, что и у строки сайдбара конструктора:
             подсветка во всю ширину без скруглений, hover #F2F2F7, выбор #E5F0FF. -->
        <Style Selector="Border.navrow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor"     Value="Hand" />
        </Style>
        <Style Selector="Border.navrow:pointerover">
            <Setter Property="Background" Value="{StaticResource BrushSecondaryBg}" />
        </Style>
        <Style Selector="Border.navrow.selected, Border.navrow.selected:pointerover">
            <Setter Property="Background" Value="{StaticResource BrushAccentLight}" />
        </Style>

        <!-- Невыбранная: тёмный текст + серая иконка. Выбранная: синий текст и иконка. -->
        <Style Selector="Border.navrow TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushPrimaryText}" />
        </Style>
        <Style Selector="Border.navrow Path">
            <Setter Property="Stroke" Value="{StaticResource BrushSecondaryText}" />
        </Style>
        <Style Selector="Border.navrow.selected TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
        </Style>
        <Style Selector="Border.navrow.selected Path">
            <Setter Property="Stroke" Value="{StaticResource BrushAccent}" />
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <!-- Заголовок раздела (высота 56 — выравнивание с линией навбара) -->
        <Border DockPanel.Dock="Top" Height="56" Padding="16,0">
            <TextBlock Text="Настройки"
                       VerticalAlignment="Center"
                       FontSize="{StaticResource FontSizeLarge}"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushPrimaryText}" />
        </Border>

        <!-- Список разделов: строки вплотную, как в конструкторе -->
        <StackPanel>

            <!-- Общие -->
            <Border x:Name="GeneralRow" Classes="navrow selected" Tag="general"
                    Height="{StaticResource RowStepStandard}"
                    Padding="10,0,0,0"
                    BorderBrush="{StaticResource BrushBg}" BorderThickness="0,0,0,1"
                    Tapped="OnRowTapped">
                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Stretch">
                    <Viewbox Grid.Column="0" Width="18" Height="18" Margin="2,0,0,0"
                             VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <!-- sliders-horizontal -->
                            <Path Data="M21 4 H14 M10 4 H3 M21 12 H12 M8 12 H3 M21 20 H16 M12 20 H3 M14 2 V6 M8 10 V14 M16 18 V22"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Column="1" Text="Общие" VerticalAlignment="Center"
                               Margin="6,0,8,0" FontSize="{StaticResource FontSizeBase}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <!-- Оформление -->
            <Border x:Name="AppearanceRow" Classes="navrow" Tag="appearance"
                    Height="{StaticResource RowStepStandard}"
                    Padding="10,0,0,0"
                    BorderBrush="{StaticResource BrushBg}" BorderThickness="0,0,0,1"
                    Tapped="OnRowTapped">
                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Stretch">
                    <Viewbox Grid.Column="0" Width="18" Height="18" Margin="2,0,0,0"
                             VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <!-- sun -->
                            <Path Data="M12 8 A4 4 0 1 0 12 16 A4 4 0 1 0 12 8 Z M12 2 V4 M12 20 V22 M4.93 4.93 L6.34 6.34 M17.66 17.66 L19.07 19.07 M2 12 H4 M20 12 H22 M4.93 19.07 L6.34 17.66 M17.66 6.34 L19.07 4.93"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Column="1" Text="Оформление" VerticalAlignment="Center"
                               Margin="6,0,8,0" FontSize="{StaticResource FontSizeBase}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <!-- Управление базой данных -->
            <Border x:Name="DatabaseRow" Classes="navrow" Tag="database"
                    Height="{StaticResource RowStepStandard}"
                    Padding="10,0,0,0"
                    BorderBrush="{StaticResource BrushBg}" BorderThickness="0,0,0,1"
                    Tapped="OnRowTapped">
                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Stretch">
                    <Viewbox Grid.Column="0" Width="18" Height="18" Margin="2,0,0,0"
                             VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <!-- database -->
                            <Path Data="M3 5 A9 3 0 1 0 21 5 A9 3 0 1 0 3 5 Z M3 5 V19 A9 3 0 0 0 21 19 V5 M3 12 A9 3 0 0 0 21 12"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Column="1" Text="Управление базой данных" VerticalAlignment="Center"
                               Margin="6,0,8,0" FontSize="{StaticResource FontSizeBase}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <!-- О программе -->
            <Border x:Name="AboutRow" Classes="navrow" Tag="about"
                    Height="{StaticResource RowStepStandard}"
                    Padding="10,0,0,0"
                    BorderBrush="{StaticResource BrushBg}" BorderThickness="0,0,0,1"
                    Tapped="OnRowTapped">
                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Stretch">
                    <Viewbox Grid.Column="0" Width="18" Height="18" Margin="2,0,0,0"
                             VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <!-- info -->
                            <Path Data="M12 2 A10 10 0 1 0 12 22 A10 10 0 1 0 12 2 Z M12 16 V11 M11.99 8 H12.01"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Grid.Column="1" Text="О программе" VerticalAlignment="Center"
                               Margin="6,0,8,0" FontSize="{StaticResource FontSizeBase}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

        </StackPanel>

    </DockPanel>

</UserControl>
