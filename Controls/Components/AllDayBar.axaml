<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartBase.Controls.Components.AllDayBar"
             MinHeight="40"
             Background="{StaticResource BrushSecondaryBg}">

    <!-- Нижняя граница — отдельный separator (не бордер контейнера с контентом:
         контейнер алиасить нельзя, отдельная линия чёткая при любом зуме).
         Контент занимает всю высоту; ручка-«пилюля» висит поверх линии. -->
    <Grid>
        <Grid>

            <!-- Основной контент: 72px метка слева + зона колонок справа. Скроллбар сетки
                 времени рисуется поверх контента (overlay) и место не отъедает, поэтому
                 здесь резерв не нужен — зона колонок занимает всю ширину, как у сетки. -->
            <Grid ColumnDefinitions="72,*">

                <!-- Метка "весь день" слева (правая линия — отдельный separator,
                     отделяет от зоны событий) -->
                <Border Grid.Column="0">
                    <TextBlock Text="весь день"
                               Foreground="{StaticResource BrushSecondaryText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,4,4,0" />
                </Border>
                <Border Grid.Column="0"
                        Classes="separator v"
                        HorizontalAlignment="Right" />

                <!-- Плашки all-day событий + оверлей для drag-ghost. Делители — UniformGrid
                     с такими же Border-колонками (левая граница), как WeekColumns в сетке
                     времени, чтобы вертикальные линии совпадали пиксель-в-пиксель. -->
                <Grid Grid.Column="1">
                    <UniformGrid x:Name="DividersPanel"
                                 IsHitTestVisible="False" />
                    <ScrollViewer x:Name="EventsScroll"
                                  Background="Transparent"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="EventsPanel"
                              VerticalAlignment="Top"
                              Margin="0,2,0,0" />
                    </ScrollViewer>
                    <Canvas x:Name="DragOverlay"
                            IsHitTestVisible="False" />
                </Grid>

            </Grid>

        </Grid>

        <!-- Нижняя разделительная линия поверх контента -->
        <Border Classes="separator h" VerticalAlignment="Bottom" />
    </Grid>

</UserControl>
