<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DataBase.Controls.Components.AllDayBar"
             MinHeight="40"
             Background="{StaticResource BrushSecondaryBg}">

    <!-- Нижняя граница — сплошная разделительная линия (как у сайдбара).
         Контент занимает всю высоту; ручка-«пилюля» висит поверх линии. -->
    <Border BorderBrush="{StaticResource BrushSeparator}" BorderThickness="{DynamicResource BorderLineBottom}">
        <Grid>

            <!-- Основной контент: 72px метка слева + зона колонок справа. Скроллбар сетки
                 времени рисуется поверх контента (overlay) и место не отъедает, поэтому
                 здесь резерв не нужен — зона колонок занимает всю ширину, как у сетки. -->
            <Grid ColumnDefinitions="72,*">

                <!-- Метка "весь день" слева (правая линия отделяет от зоны событий) -->
                <Border Grid.Column="0"
                        BorderBrush="{StaticResource BrushSeparator}"
                        BorderThickness="{DynamicResource BorderLineRight}">
                    <TextBlock Text="весь день"
                               Foreground="{StaticResource BrushSecondaryText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,4,4,0" />
                </Border>

                <!-- Плашки all-day событий + оверлей для drag-ghost. Делители — UniformGrid
                     с такими же Border-колонками (левая граница), как WeekColumns в сетке
                     времени, чтобы вертикальные линии совпадали пиксель-в-пиксель. -->
                <Grid Grid.Column="1">
                    <UniformGrid x:Name="DividersPanel"
                                 IsHitTestVisible="False" />
                    <ScrollViewer x:Name="EventsScroll"
                                  Background="Transparent"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="EventsPanel"
                              VerticalAlignment="Top"
                              Margin="0,2,0,0" />
                    </ScrollViewer>
                    <Canvas x:Name="DragOverlay"
                            IsHitTestVisible="False" />
                </Grid>

            </Grid>

        </Grid>
    </Border>

</UserControl>
