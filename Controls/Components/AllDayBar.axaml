<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyPlanner.Controls.Components.AllDayBar"
             MinHeight="40"
             Background="{StaticResource BrushSecondaryBg}">

    <Grid ColumnDefinitions="72,*">

        <!-- Метка "весь день" слева, выровнена по правому краю — как в PyQt5 -->
        <TextBlock Grid.Column="0"
                   Text="весь день"
                   FontSize="{StaticResource FontSizeBase}"
                   Foreground="{StaticResource BrushSecondaryText}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0" />

        <!-- Плашки all-day событий -->
        <ItemsControl Grid.Column="1"
                      x:Name="EventsList"
                      Padding="4,6,12,6">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Margin="0,2,4,2"
                            Height="24"
                            Padding="8,0"
                            CornerRadius="5"
                            Background="{Binding ChipBackground}"
                            Foreground="{Binding ChipForeground}"
                            Command="{Binding ClickCommand}"
                            ToolTip.Tip="{Binding Title}">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="{StaticResource FontSizeBase}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="160" />
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </Grid>

</UserControl>
