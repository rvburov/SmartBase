<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyPlanner.Controls.Components.AllDayBar"
             MinHeight="40"
             Background="{StaticResource BrushSecondaryBg}">

    <!-- Нижняя граница — сплошная разделительная линия (как у сайдбара).
         Контент занимает всю высоту; ручка-«пилюля» висит поверх линии. -->
    <Border BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
        <Grid>

            <!-- Основной контент -->
            <Grid ColumnDefinitions="72,*">

                <!-- Метка "весь день" слева (правая линия отделяет от зоны событий) -->
                <Border Grid.Column="0"
                        BorderBrush="#E8E8E8"
                        BorderThickness="0,0,1,0">
                    <TextBlock Text="весь день"
                               FontSize="{StaticResource FontSizeBase}"
                               Foreground="{StaticResource BrushSecondaryText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,4,4,0" />
                </Border>

                <!-- Плашки all-day событий + оверлей для drag-ghost -->
                <Grid Grid.Column="1">
                    <Grid x:Name="DividersPanel"
                          IsHitTestVisible="False" />
                    <ScrollViewer x:Name="EventsScroll"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="EventsPanel"
                              VerticalAlignment="Top"
                              Margin="0,2,0,0" />
                    </ScrollViewer>
                    <Canvas x:Name="DragOverlay"
                            IsHitTestVisible="False" />
                </Grid>

            </Grid>

        </Grid>
    </Border>

</UserControl>
