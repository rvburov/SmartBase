<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyPlanner.Controls.Components.Sidebar"
             Width="220"
             Background="{StaticResource BrushBg}">

    <DockPanel>

        <!-- Заголовок сайдбара -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <TextBlock Text="Коллекции"
                       FontWeight="{StaticResource FontWeightBold}"
                       FontSize="{StaticResource FontSizeBase}"
                       Foreground="{StaticResource BrushSecondaryText}" />
        </Border>

        <!-- Дерево коллекций -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TreeView x:Name="CollectionTree"
                      Background="Transparent"
                      Padding="8,4">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                            <Ellipse Width="10" Height="10"
                                     Fill="{Binding Color}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}"
                                       FontSize="{StaticResource FontSizeBase}"
                                       Foreground="{StaticResource BrushPrimaryText}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </ScrollViewer>

    </DockPanel>

</UserControl>
