<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="using:MyPlanner.Controls.Components"
             x:Class="MyPlanner.Controls.Components.Sidebar"
             Background="{StaticResource BrushBg}">

  <Border>
    <DockPanel>

        <!-- Тулбар: создать (всегда) + развернуть/свернуть + сортировка + включить/выключить (только календарь) -->
        <Border DockPanel.Dock="Top"
                Height="56"
                Padding="10,13">
            <StackPanel Orientation="Horizontal" Spacing="6">

                <!-- Создать -->
                <Button x:Name="CreateBtn" Classes="navbtn"
                        Width="30" Height="30"
                        CornerRadius="{StaticResource RadiusMedium}"
                        ToolTip.Tip="Создать">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Path Data="M5 12 H19 M12 5 V19"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="2"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Развернуть/свернуть всё -->
                <ToggleButton x:Name="ExpandBtn" Classes="navbtn"
                              Width="30" Height="30"
                              CornerRadius="{StaticResource RadiusMedium}"
                              ToolTip.Tip="Развернуть все">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="ExpandIcon"
                                  Data="M7 15 L12 20 L17 15 M7 9 L12 4 L17 9"
                                  Stroke="{Binding $parent[ToggleButton].Foreground}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                            <Path x:Name="CollapseIcon"
                                  IsVisible="False"
                                  Data="M7 20 L12 15 L17 20 M7 4 L12 9 L17 4"
                                  Stroke="{Binding $parent[ToggleButton].Foreground}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </ToggleButton>

                <!-- Сортировка -->
                <Button x:Name="SortBtn" Classes="navbtn"
                        Width="30" Height="30"
                        CornerRadius="{StaticResource RadiusMedium}"
                        ToolTip.Tip="Сортировка по имени">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Path Data="M3 8 L7 4 L11 8 M7 4 V20 M11 12 H15 M11 16 H18 M11 20 H21"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Включить/выключить всё (только календарь) -->
                <Button x:Name="ToggleAllBtn" Classes="navbtn"
                        Width="30" Height="30"
                        CornerRadius="{StaticResource RadiusMedium}"
                        ToolTip.Tip="Включить все">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Path Data="M21 10.656 V19 A2 2 0 0 1 19 21 H5 A2 2 0 0 1 3 19 V5 A2 2 0 0 1 5 3 H17.344 M9 11 L12 14 L22 4"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="1.8"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

            </StackPanel>
        </Border>

        <!-- Плоский список с виртуализацией -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Background="Transparent"
                      ContextRequested="OnEmptyContextRequested">
            <ItemsControl x:Name="RowsHost" Padding="0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="comp:SidebarRow">
                        <Border x:Name="RowRoot"
                                Background="{Binding RowBackground}"
                                Margin="0"
                                Padding="10,0,0,0"
                                Height="{StaticResource RowStepStandard}"
                                BorderBrush="{StaticResource BrushBg}"
                                BorderThickness="0,0,0,1"
                                Tapped="OnRowTapped"
                                PointerEntered="OnRowEnter"
                                PointerExited="OnRowExit"
                                ContextRequested="OnRowContextRequested">
                            <Grid VerticalAlignment="Stretch"
                                  ColumnDefinitions="Auto,Auto,Auto,*"
                                  Margin="{Binding IndentMargin}">

                                <!-- Слот стрелки (chevron): 22 для групп, 0 для коллекций -->
                                <Border Grid.Column="0"
                                        Width="{Binding ChevronSlot}"
                                        VerticalAlignment="Stretch"
                                        Background="Transparent"
                                        Tapped="OnChevronTapped">
                                    <Viewbox Width="14" Height="14"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center"
                                             IsVisible="{Binding ShowChevron}">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{Binding ChevronGeometry}"
                                                  Stroke="{StaticResource BrushSecondaryText}"
                                                  StrokeThickness="2"
                                                  StrokeLineCap="Round" StrokeJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>

                                <!-- Слот чекбокса: только в режиме календаря у коллекций; иначе 0 -->
                                <Border Grid.Column="1"
                                        Width="{Binding CheckboxSlot}"
                                        VerticalAlignment="Stretch"
                                        Background="Transparent"
                                        Tapped="OnCheckboxTapped">
                                    <Border Width="16" Height="16"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            CornerRadius="{StaticResource RadiusXS}"
                                            IsVisible="{Binding ShowCheckbox}"
                                            Background="{Binding CheckFill}"
                                            BorderBrush="{Binding CheckBorder}"
                                            BorderThickness="1.5">
                                        <Viewbox Width="12" Height="12"
                                                 IsVisible="{Binding Checked}">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M5 13 L10 18 L19 7"
                                                      Stroke="White"
                                                      StrokeThickness="2.5"
                                                      StrokeLineCap="Round" StrokeJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                </Border>

                                <!-- Иконка папки/файла (24px зона) -->
                                <Viewbox Grid.Column="2" Width="18" Height="18"
                                         Margin="2,0,0,0"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{Binding IconGeometry}"
                                              Stroke="{Binding IconBrush}"
                                              StrokeThickness="1.6"
                                              StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Canvas>
                                </Viewbox>

                                <!-- Имя -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Name}"
                                           FontSize="{StaticResource FontSizeBase}"
                                           Foreground="{Binding NameBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="6,0,8,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
  </Border>

</UserControl>
