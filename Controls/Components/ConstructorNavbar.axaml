<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyPlanner.Controls.Components.ConstructorNavbar"
             Height="57"
             Background="{StaticResource BrushBg}">

    <DockPanel>

        <!-- Линия-разделитель снизу -->
        <Border DockPanel.Dock="Bottom"
                Height="1"
                Background="{StaticResource BrushSeparator}" />

        <!-- Заголовок слева, переключатель вида справа (кнопки — в нижней панели) -->
        <Grid ColumnDefinitions="*,Auto" Margin="16,0">

            <TextBlock Grid.Column="0" x:Name="TitleLabel"
                       Text="Выберите коллекцию"
                       VerticalAlignment="Center"
                       FontSize="{StaticResource FontSizeLarge}"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushPrimaryText}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,12,0" />

            <!-- Переключатель вида (Таблица / Список) -->
            <ComboBox Grid.Column="1" x:Name="ViewSelector"
                      Width="130" Height="30"
                      VerticalAlignment="Center"
                      Background="{StaticResource BrushSecondaryBg}"
                      Foreground="{StaticResource BrushPrimaryText}"
                      CornerRadius="{StaticResource RadiusBase}" />

        </Grid>

    </DockPanel>

</UserControl>
