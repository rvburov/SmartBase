<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartBase.Controls.Components.ActivityBar"
             Width="48"
             Background="{StaticResource BrushSecondaryBg}">

    <!-- Вертикальная панель модулей: Календарь / Конструктор сверху, Настройки снизу -->
    <DockPanel LastChildFill="False">

    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="8,12,8,0">

        <!-- Кнопка сайдбара: panel-left-open (закрыт) / panel-right-open (открыт) -->
        <ToggleButton x:Name="SidebarBtn" Classes="icon"
                      Width="32" Height="32"
                      HorizontalAlignment="Center"
                      CornerRadius="{StaticResource RadiusMedium}"
                      ToolTip.Tip="Сайдбар">
            <Viewbox Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}">
                <Canvas Width="24" Height="24">
                    <!-- panel-left-open: сайдбар закрыт (стрелка →) -->
                    <Path x:Name="PanelOpenIcon"
                          Data="{StaticResource IconPanelOpen}"
                          Stroke="{Binding $parent[ToggleButton].Foreground}"
                          StrokeThickness="{StaticResource IconStrokeXLargeBold}"
                          StrokeLineCap="Round" StrokeJoin="Round" />
                    <!-- panel-right-open: сайдбар открыт (стрелка ←) -->
                    <Path x:Name="PanelCloseIcon"
                          IsVisible="False"
                          Data="{StaticResource IconPanelClose}"
                          Stroke="{Binding $parent[ToggleButton].Foreground}"
                          StrokeThickness="{StaticResource IconStrokeXLargeBold}"
                          StrokeLineCap="Round" StrokeJoin="Round" />
                </Canvas>
            </Viewbox>
        </ToggleButton>

        <!-- Короткий разделитель на высоте линии сайдбара (Y=56):
             12 (панель) + 32 (бургер) + 8 (Spacing) + 4 = 56 -->
        <Border Classes="separator h" Margin="0,4" />

        <!-- Модуль: Календарь -->
        <ToggleButton x:Name="CalendarBtn" Classes="icon module"
                      Width="32" Height="32"
                      HorizontalAlignment="Center"
                      CornerRadius="{StaticResource RadiusMedium}"
                      IsChecked="True"
                      ToolTip.Tip="Календарь">
            <Viewbox Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}">
                <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconCalendarDate}"
                          Stroke="{Binding $parent[ToggleButton].Foreground}"
                          StrokeThickness="{StaticResource IconStrokeXLargeBold}"
                          StrokeLineCap="Round"
                          StrokeJoin="Round" />
                </Canvas>
            </Viewbox>
        </ToggleButton>

        <!-- Модуль: Задачи -->
        <ToggleButton x:Name="TasksBtn" Classes="icon module"
                      Width="32" Height="32"
                      HorizontalAlignment="Center"
                      CornerRadius="{StaticResource RadiusMedium}"
                      ToolTip.Tip="Задачи">
            <Viewbox Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}">
                <Canvas Width="24" Height="24">
                    <!-- lucide square-check-big -->
                    <Path Data="{StaticResource IconSquareCheck}"
                          Stroke="{Binding $parent[ToggleButton].Foreground}"
                          StrokeThickness="{StaticResource IconStrokeXLargeBold}"
                          StrokeLineCap="Round"
                          StrokeJoin="Round" />
                </Canvas>
            </Viewbox>
        </ToggleButton>

        <!-- Модуль: Конструктор БД -->
        <ToggleButton x:Name="ConstructorBtn" Classes="icon module"
                      Width="32" Height="32"
                      HorizontalAlignment="Center"
                      CornerRadius="{StaticResource RadiusMedium}"
                      ToolTip.Tip="Конструктор БД">
            <Viewbox Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}">
                <Canvas Width="24" Height="24">
                    <!-- tabler database-check -->
                    <Path Data="{StaticResource IconDatabaseCheck}"
                          Stroke="{Binding $parent[ToggleButton].Foreground}"
                          StrokeThickness="{StaticResource IconStrokeXLargeBold}"
                          StrokeLineCap="Round"
                          StrokeJoin="Round" />
                </Canvas>
            </Viewbox>
        </ToggleButton>

        <!-- Модуль: Заметки -->
        <ToggleButton x:Name="NotesBtn" Classes="icon module"
                      Width="32" Height="32"
                      HorizontalAlignment="Center"
                      CornerRadius="{StaticResource RadiusMedium}"
                      ToolTip.Tip="Заметки">
            <Viewbox Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}">
                <Canvas Width="24" Height="24">
                    <!-- lucide notebook-pen -->
                    <Path Data="{StaticResource IconNotebook}"
                          Stroke="{Binding $parent[ToggleButton].Foreground}"
                          StrokeThickness="{StaticResource IconStrokeXLargeBold}"
                          StrokeLineCap="Round"
                          StrokeJoin="Round" />
                </Canvas>
            </Viewbox>
        </ToggleButton>

        <!-- Модуль: Расширения. Порядок кнопок здесь повторяет ViewCatalog.Navigation —
             панель и настройки «Оформления» должны перечислять модули одинаково. -->
        <ToggleButton x:Name="ExtensionsBtn" Classes="icon module"
                      Width="32" Height="32"
                      HorizontalAlignment="Center"
                      CornerRadius="{StaticResource RadiusMedium}"
                      ToolTip.Tip="Расширения">
            <Viewbox Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}">
                <Canvas Width="24" Height="24">
                    <!-- lucide blocks -->
                    <Path Data="{StaticResource IconBlocks}"
                          Stroke="{Binding $parent[ToggleButton].Foreground}"
                          StrokeThickness="{StaticResource IconStrokeXLargeBold}"
                          StrokeLineCap="Round"
                          StrokeJoin="Round" />
                </Canvas>
            </Viewbox>
        </ToggleButton>

    </StackPanel>

    <!-- Модуль: Настройки — закреплен внизу панели -->
    <ToggleButton x:Name="SettingsBtn" Classes="icon module"
                  DockPanel.Dock="Bottom"
                  Width="32" Height="32"
                  Margin="8,0,8,12"
                  HorizontalAlignment="Center"
                  CornerRadius="{StaticResource RadiusMedium}"
                  ToolTip.Tip="Настройки">
        <Viewbox Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}">
            <Canvas Width="24" Height="24">
                <!-- lucide settings -->
                <Path Data="{StaticResource IconSettings}"
                      Stroke="{Binding $parent[ToggleButton].Foreground}"
                      StrokeThickness="{StaticResource IconStrokeXLargeBold}"
                      StrokeLineCap="Round"
                      StrokeJoin="Round" />
            </Canvas>
        </Viewbox>
    </ToggleButton>

    <!-- Модуль: Профиль — над Настройками (второй Bottom-элемент DockPanel ложится ВЫШЕ первого) -->
    <ToggleButton x:Name="ProfileBtn" Classes="icon module"
                  DockPanel.Dock="Bottom"
                  Width="32" Height="32"
                  Margin="8,0,8,8"
                  HorizontalAlignment="Center"
                  CornerRadius="{StaticResource RadiusMedium}"
                  ToolTip.Tip="Профиль">
        <Viewbox Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}">
            <Canvas Width="24" Height="24">
                <!-- lucide circle-user-round -->
                <Path Data="{StaticResource IconUser}"
                      Stroke="{Binding $parent[ToggleButton].Foreground}"
                      StrokeThickness="{StaticResource IconStrokeXLargeBold}"
                      StrokeLineCap="Round"
                      StrokeJoin="Round" />
            </Canvas>
        </Viewbox>
    </ToggleButton>

    </DockPanel>

</UserControl>
