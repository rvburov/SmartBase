<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyPlanner.Controls.Components.EventsSidebar"
             Width="240"
             Background="{StaticResource BrushBg}">

    <DockPanel>

        <!-- Заголовок с датой -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <TextBlock x:Name="DateLabel"
                       FontWeight="{StaticResource FontWeightBold}"
                       FontSize="{StaticResource FontSizeBase}"
                       Foreground="{StaticResource BrushSecondaryText}" />
        </Border>

        <!-- Список событий дня -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="EventsList" Padding="8,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,2"
                                Padding="8,6"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                Command="{Binding ClickCommand}">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="8" Height="8"
                                            CornerRadius="4"
                                            Background="{Binding ColorBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="{StaticResource FontSizeBase}"
                                               Foreground="{StaticResource BrushPrimaryText}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Text="{Binding TimeText}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource BrushSecondaryText}"
                                           Margin="14,0,0,0" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>
