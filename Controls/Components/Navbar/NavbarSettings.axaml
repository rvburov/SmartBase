<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartBase.Controls.Components.NavbarSettings"
             Height="56"
             Background="{StaticResource BrushBg}">

    <!-- Заголовок слева, действия раздела справа — как в остальных навбарах
         (NavbarConstructor: переключатель вида справа тем же стилем). -->
    <Grid ColumnDefinitions="*,Auto,Auto" Margin="16,0">

        <TextBlock Grid.Column="0" x:Name="TitleText"
                   Text="Оформление"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource FontSizeLarge}"
                   FontWeight="{StaticResource FontWeightBold}"
 />

        <!-- «Добавить базу данных» — только в разделе «Управление базой данных».
             Это стандартный ComboBox (та же выпадашка, что у переключателей вида в
             навбарах), работающий как меню действий: выбранный пункт открывает своё
             окно, а выбор тут же сбрасывается (см. код-behind) — состояния у меню нет. -->
        <ComboBox Grid.Column="1" x:Name="AddDatabaseCombo"
                  IsVisible="False"
                  Width="210" Height="{StaticResource ControlHeightStandard}"
                  VerticalAlignment="Center"
                  PlaceholderText="Добавить базу данных"
                  PlaceholderForeground="{StaticResource BrushPrimaryText}">
            <ComboBoxItem Content="Создать базу данных SQLite" />
            <ComboBoxItem Content="Подключить базу данных SQLite" />
            <ComboBoxItem Content="Подключить сервер PostgreSQL" />
        </ComboBox>

        <!-- Выгрузка журнала диагностики в CSV — только в разделе «Диагностика».
             Вид кнопки — как «Импорт/Экспорт» в сайдбаре конструктора (navbtn 30×30,
             lucide download). -->
        <Button Grid.Column="2" x:Name="ExportLogsBtn"
                Classes="navbtn" Width="30" Height="30"
                IsVisible="False"
                VerticalAlignment="Center"
                Margin="8,0,0,0"
                CornerRadius="{StaticResource RadiusMedium}"
                ToolTip.Tip="Выгрузить в CSV"
                Click="OnExportLogsClick">
            <Viewbox Width="{StaticResource IconSizeMedium}"
                     Height="{StaticResource IconSizeMedium}">
                <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconDownload}"
                          Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="{StaticResource IconStrokeMedium}"
                          StrokeLineCap="Round" StrokeJoin="Round" />
                </Canvas>
            </Viewbox>
        </Button>

    </Grid>

</UserControl>
