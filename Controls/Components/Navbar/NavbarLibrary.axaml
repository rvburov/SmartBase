<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartBase.Controls.Components.NavbarLibrary"
             Height="56"
             Background="{StaticResource BrushBg}">

    <!-- Навбар раздела: слева заголовок, справа фильтр типов. Строки поиска здесь нет — она
         стоит блоком над лентой (DocListView.axaml). Переключателя вида тоже нет: вид один. -->
    <Grid ColumnDefinitions="Auto,*,Auto"
          Margin="16,0"
          VerticalAlignment="Center">

        <!-- Заголовок раздела -->
        <TextBlock Grid.Column="0" x:Name="TitleLabel"
                   Text="Библиотека документов"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource FontSizeLarge}"
                   FontWeight="{StaticResource FontWeightBold}" />

        <!-- Выпадашка типов документа. Это НЕ ComboBox: содержимое рисует общий
             ColumnFilterPanel — тот же чеклист с поиском, количествами справа и «Готово»,
             что у колонки таблицы. Здесь только кнопка-якорь, к которой он крепится. -->
        <!-- Вид и состояния — из класса navdrop (Controls.axaml), здесь только размер:
             ширина фиксированная, иначе подпись «Тип документа: 12» двигала бы правый
             край органа управления в навбаре. -->
        <Button Grid.Column="2" x:Name="TypeBtn"
                Classes="navdrop"
                VerticalAlignment="Center"
                Height="{StaticResource ControlHeightStandard}"
                Width="170">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" x:Name="TypeLabel"
                           Text="Тип документа"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <!-- Стрелка — тот же залитый шеврон 12×8, что рисует ComboBox своим
                     DropDownGlyph, и тем же цветом. -->
                <PathIcon Grid.Column="1"
                          Width="12" Height="8"
                          VerticalAlignment="Center" Margin="8,0,0,0"
                          Foreground="{StaticResource BrushSecondaryText}"
                          Data="{StaticResource IconChevronDownFilled}" />
            </Grid>
        </Button>
    </Grid>

</UserControl>
