<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DataBase.Controls.Components.NavbarCalendar"
             Height="56"
             Background="{StaticResource BrushBg}">

    <UserControl.Styles>
        <Style Selector="Button#TodayBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background"  Value="{StaticResource BrushSecondaryBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
        </Style>

    </UserControl.Styles>

    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto"
          Margin="16,0"
          VerticalAlignment="Center">

        <!-- Добавить запись -->
        <Button Grid.Column="0" x:Name="AddBtn" Classes="navbtn"
                Width="30" Height="30" Margin="0,0,8,0"
                VerticalAlignment="Center"
                CornerRadius="{StaticResource RadiusMedium}"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ToolTip.Tip="Добавить запись">
            <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconPlus}"
                          Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="2"
                          StrokeLineCap="Round"
                          StrokeJoin="Round" />
                </Canvas>
            </Viewbox>
        </Button>

        <!-- Сегодня -->
        <Button Grid.Column="1" x:Name="TodayBtn"
                Content="Сегодня" Width="80" Height="30" Margin="0,0,4,0"
                VerticalAlignment="Center"
                Padding="0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource BrushSecondaryBg}"
                Foreground="{StaticResource BrushPrimaryText}"
                BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="1.2" />

        <!-- Назад -->
        <Button Grid.Column="2" x:Name="PrevBtn" Classes="navbtn"
                Width="30" Height="30" Margin="0,0,4,0"
                VerticalAlignment="Center"
                CornerRadius="{StaticResource RadiusMedium}"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ToolTip.Tip="Назад">
            <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconArrowLeft}"
                          Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="2"
                          StrokeLineCap="Round"
                          StrokeJoin="Round" />
                </Canvas>
            </Viewbox>
        </Button>

        <!-- Вперёд -->
        <Button Grid.Column="3" x:Name="NextBtn" Classes="navbtn"
                Width="30" Height="30" Margin="0,0,12,0"
                VerticalAlignment="Center"
                CornerRadius="{StaticResource RadiusMedium}"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ToolTip.Tip="Вперёд">
            <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconArrowRight}"
                          Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="2"
                          StrokeLineCap="Round"
                          StrokeJoin="Round" />
                </Canvas>
            </Viewbox>
        </Button>

        <!-- Заголовок периода -->
        <TextBlock Grid.Column="4" x:Name="TitleLabel"
                   VerticalAlignment="Center"
                   FontSize="{StaticResource FontSizeLarge}"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushPrimaryText}" />

        <!-- Поиск -->
        <TextBox Grid.Column="5" x:Name="SearchBox"
                 Width="200" Height="30" MinHeight="30" Margin="0,0,8,0"
                 VerticalAlignment="Center"
                 VerticalContentAlignment="Center"
                 Watermark="Поиск..."
                 CornerRadius="{StaticResource RadiusPill}"
                 Background="{StaticResource BrushSecondaryBg}"
                 Foreground="{StaticResource BrushPrimaryText}" />

        <!-- Вид (Месяц/Неделя/День…) -->
        <ComboBox Grid.Column="6" x:Name="ViewSelector"
                  VerticalAlignment="Center"
                  Width="140" Height="30"
                  Background="{StaticResource BrushSecondaryBg}"
                  Foreground="{StaticResource BrushPrimaryText}"
                  CornerRadius="{StaticResource RadiusBase}" />
    </Grid>

</UserControl>
