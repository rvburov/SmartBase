<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartBase.Controls.Components.NavbarProfile"
             Height="56"
             Background="{StaticResource BrushBg}">

    <!-- Заголовок слева, действия раздела справа — как в остальных навбарах
         (NavbarSettings: «Добавить базу данных» тем же стилем). -->
    <Grid ColumnDefinitions="*,Auto,Auto" Margin="16,0">

        <TextBlock Grid.Column="0" x:Name="TitleText"
                   Text="Общие данные"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource FontSizeLarge}"
                   FontWeight="{StaticResource FontWeightBold}"
 />

        <!-- Выбор базы журнала — только в разделе «История изменений». Обычный
             стейтфул-ComboBox: выбранная база остается видимой (в отличие от
             меню-действий NavbarSettings). Наполняет ProfileView. -->
        <ComboBox Grid.Column="1" x:Name="HistoryDbCombo"
                  IsVisible="False"
                  Width="240" Height="{StaticResource ControlHeightStandard}"
                  VerticalAlignment="Center" />

        <!-- Выгрузка журнала в CSV — крайняя кнопка навбара, тем же видом, что
             «Импорт/Экспорт» в сайдбаре конструктора (navbtn 30×30, lucide download). -->
        <Button Grid.Column="2" x:Name="ExportHistoryBtn"
                Classes="navbtn" Width="30" Height="30"
                IsVisible="False"
                VerticalAlignment="Center"
                Margin="8,0,0,0"
                CornerRadius="{StaticResource RadiusMedium}"
                ToolTip.Tip="Выгрузить в CSV"
                Click="OnExportHistoryClick">
            <Viewbox Width="{StaticResource IconSizeMedium}"
                     Height="{StaticResource IconSizeMedium}">
                <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconDownload}"
                          Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="{StaticResource IconStrokeMedium}"
                          StrokeLineCap="Round" StrokeJoin="Round" />
                </Canvas>
            </Viewbox>
        </Button>

    </Grid>

</UserControl>
