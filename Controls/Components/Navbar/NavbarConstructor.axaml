<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartBase.Controls.Components.NavbarConstructor"
             Height="56"
             Background="{StaticResource BrushBg}">

    <!-- Своей линии-разделителя нет: нижнюю границу титульной зоны рисует общая линия
         окна на y=56 (MainWindow), иначе линии удваивались бы в 2px. -->
    <DockPanel>

        <!-- Заголовок слева, переключатель вида + toggle панели записи справа -->
        <Grid ColumnDefinitions="*,Auto,Auto" Margin="16,0">

            <TextBlock Grid.Column="0" x:Name="TitleDisplay"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource FontSizeLarge}"
                       FontWeight="{StaticResource FontWeightBold}"
                       TextTrimming="CharacterEllipsis"
                       Cursor="IBeam"
                       Margin="0,0,12,0" />

            <TextBox Grid.Column="0" x:Name="TitleBox"
                     Classes="titleEditor"
                     IsVisible="False"
                     Watermark="Выберите коллекцию"
                     VerticalAlignment="Center"
                     FontSize="{DynamicResource FontSizeLarge}"
                     FontWeight="{StaticResource FontWeightBold}"
                     Margin="0,0,12,0" />

            <!-- Переключатель вида (Таблица / Список) -->
            <ComboBox Grid.Column="1" x:Name="ViewSelector"
                      Width="130" Height="30"
                      VerticalAlignment="Center"
                      Background="{StaticResource BrushSecondaryBg}"
                      CornerRadius="{StaticResource RadiusBase}" />

            <!-- Toggle правой панели записи: arrow-right-from-line (открыть) /
                 arrow-left-to-line (закрыть). Логика как у SidebarBtn в ActivityBar. -->
            <ToggleButton Grid.Column="2" x:Name="RecordPanelBtn" Classes="navbtn"
                          Width="30" Height="30" Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          CornerRadius="{StaticResource RadiusMedium}"
                          ToolTip.Tip="Открыть запись">
                <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}">
                    <Canvas Width="24" Height="24">
                        <!-- arrow-left-from-line: панель закрыта → клик откроет (←) -->
                        <Path x:Name="RecordOpenIcon"
                              Data="{StaticResource IconArrowLeftFromLine}"
                              Stroke="{Binding $parent[ToggleButton].Foreground}"
                              StrokeThickness="{StaticResource IconStrokeMedium}"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                        <!-- arrow-right-to-line: панель открыта → клик закроет (→) -->
                        <Path x:Name="RecordCloseIcon"
                              IsVisible="False"
                              Data="{StaticResource IconArrowRightToLine}"
                              Stroke="{Binding $parent[ToggleButton].Foreground}"
                              StrokeThickness="{StaticResource IconStrokeMedium}"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                    </Canvas>
                </Viewbox>
            </ToggleButton>

        </Grid>

    </DockPanel>

</UserControl>
