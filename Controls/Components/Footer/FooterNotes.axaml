<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartBase.Controls.Components.FooterNotes"
             Height="56"
             Background="{StaticResource BrushBg}">

    <DockPanel>
        <!-- Линия-разделитель сверху -->
        <Border DockPanel.Dock="Top" Classes="separator h" />

        <Grid Margin="16,0">
            <!-- Кнопка режима показа. Иконка называет режим ТЕКУЩИЙ, клик открывает список из
                 трех вариантов с галочкой у выбранного — как переключатель вида в Obsidian.
                 Подписи рядом нет: в футерах приложения надписей не бывает, режим объясняют
                 иконка и тултип. -->
            <Button x:Name="ModeBtn" Classes="navbtn"
                    Width="30" Height="30"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    CornerRadius="{StaticResource RadiusMedium}">
                <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}">
                    <Canvas Width="24" Height="24">
                        <!-- code-xml: просмотр исходного кода -->
                        <Path x:Name="IconSource"
                              IsVisible="False"
                              Data="{StaticResource IconCode}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="{StaticResource IconStrokeMedium}"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                        <!-- pencil-line: динамический просмотр. Та же иконка, что у переключателя
                             в футере панели записи: там она тоже означает «правка, а не показ». -->
                        <Path x:Name="IconLive"
                              Data="{StaticResource IconPencil}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="{StaticResource IconStrokeMedium}"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                        <!-- book-open: просмотр -->
                        <Path x:Name="IconPreview"
                              IsVisible="False"
                              Data="{StaticResource IconBookOpen}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="{StaticResource IconStrokeMedium}"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>
    </DockPanel>

</UserControl>
