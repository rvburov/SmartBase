<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartBase.Controls.Components.FooterConstructor"
             Height="56"
             Background="{StaticResource BrushBg}">

    <DockPanel>

        <!-- Линия-разделитель сверху -->
        <Border DockPanel.Dock="Top"
                Classes="separator h" />

        <!-- Единственное содержимое панели — навигация по строкам, прижатая вправо.
             Кнопок «Фильтр» и «Сортировка» здесь больше нет: они ничего не делали
             (события никто не слушал), а живые фильтр и сортировка вызываются из меню
             заголовка колонки. Счетчик «Всего: N» убран как дубль — то же число стоит
             в индикаторе после «из», и лишний CountRecords на UI-потоке при каждом
             открытии коллекции и структурном обновлении больше не нужен. -->
        <Grid ColumnDefinitions="*,Auto"
              Margin="16,0">

            <!-- Размер выделения ячеек («Выделено: 3 × 2») — только когда выделено больше одной
                 ячейки: так видно, по скольким значениям пройдут копирование, вставка и очистка,
                 даже если прямоугольник уходит за экран. -->
            <TextBlock x:Name="SelectionLabel"
                       Grid.Column="0"
                       IsVisible="False"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{StaticResource BrushSecondaryText}" />

            <!-- Навигация по строкам: «в начало · экран назад · 10 – 50 из 125 437 ·
                 экран вперед · в конец». Страниц фиксированного размера у таблицы нет
                 (она виртуализирована и прокручивается непрерывно), поэтому индикатор
                 показывает НОМЕРА видимых строк — см. TableViewportRange. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" Spacing="2" Margin="0,0,8,0">
                <Button x:Name="FirstRowBtn" Classes="navbtn"
                        Width="30" Height="30"
                        CornerRadius="{StaticResource RadiusMedium}"
                        ToolTip.Tip="В начало таблицы">
                    <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconChevronsLeft}"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="{StaticResource IconStrokeMediumBold}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button x:Name="PrevPageBtn" Classes="navbtn"
                        Width="30" Height="30"
                        CornerRadius="{StaticResource RadiusMedium}"
                        ToolTip.Tip="Экран назад">
                    <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconChevronLeft}"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="{StaticResource IconStrokeMediumBold}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <TextBlock x:Name="PageLabel"
                           Text="Нет записей"
                           VerticalAlignment="Center"
                           Margin="4,0"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{StaticResource BrushSecondaryText}" />

                <Button x:Name="NextPageBtn" Classes="navbtn"
                        Width="30" Height="30"
                        CornerRadius="{StaticResource RadiusMedium}"
                        ToolTip.Tip="Экран вперед">
                    <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconChevronRight}"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="{StaticResource IconStrokeMediumBold}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button x:Name="LastRowBtn" Classes="navbtn"
                        Width="30" Height="30"
                        CornerRadius="{StaticResource RadiusMedium}"
                        ToolTip.Tip="В конец таблицы">
                    <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconChevronsRight}"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="{StaticResource IconStrokeMediumBold}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>

        </Grid>

    </DockPanel>

</UserControl>
