<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartBase.Controls.Components.FooterConstructor"
             Height="56"
             Background="{StaticResource BrushBg}">

    <DockPanel>

        <!-- Линия-разделитель сверху -->
        <Border DockPanel.Dock="Top"
                Classes="separator h" />

        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto"
              Margin="16,0">

            <!-- Фильтр -->
            <Button Grid.Column="0" x:Name="FilterBtn" Classes="navbtn"
                    Width="30" Height="30" Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    CornerRadius="{StaticResource RadiusMedium}"
                    ToolTip.Tip="Фильтр">
                <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource IconFilter}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="{StaticResource IconStrokeMedium}"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Button>

            <!-- Сортировка. Высота строк теперь переключается из контекстного меню записи. -->
            <Button Grid.Column="1" x:Name="SortBtn" Classes="navbtn"
                    Width="30" Height="30" Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    CornerRadius="{StaticResource RadiusMedium}"
                    ToolTip.Tip="Сортировка">
                <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource IconSortDesc}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="{StaticResource IconStrokeMedium}"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Button>

            <!-- Счетчик записей -->
            <TextBlock Grid.Column="2" x:Name="CountLabel"
                       Text="Всего: 0"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{StaticResource BrushSecondaryText}" />

            <!-- Навигация по страницам -->
            <StackPanel Grid.Column="4" Orientation="Horizontal"
                        VerticalAlignment="Center" Spacing="2" Margin="0,0,8,0">
                <Button x:Name="PrevPageBtn" Classes="navbtn"
                        Width="30" Height="30"
                        CornerRadius="{StaticResource RadiusMedium}"
                        ToolTip.Tip="Предыдущая страница">
                    <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconChevronLeft}"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="{StaticResource IconStrokeMediumBold}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <TextBlock x:Name="PageLabel"
                           Text="1 / 1"
                           VerticalAlignment="Center"
                           Margin="4,0"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{StaticResource BrushSecondaryText}" />

                <Button x:Name="NextPageBtn" Classes="navbtn"
                        Width="30" Height="30"
                        CornerRadius="{StaticResource RadiusMedium}"
                        ToolTip.Tip="Следующая страница">
                    <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconChevronRight}"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="{StaticResource IconStrokeMediumBold}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>

        </Grid>

    </DockPanel>

</UserControl>
