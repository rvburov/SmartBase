<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyPlanner.Controls.Components.Navbar"
             Height="56"
             Background="{StaticResource BrushBg}">

    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto"
          Margin="16,0"
          VerticalAlignment="Center">

        <!-- Добавить событие -->
        <Button Grid.Column="0" x:Name="AddBtn"
                Width="30" Height="30" Margin="0,0,8,0"
                VerticalAlignment="Center"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource BrushSecondaryBg}"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ToolTip.Tip="Добавить событие">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M5 12 H19 M12 5 V19"
                          Stroke="{StaticResource BrushSecondaryText}"
                          StrokeThickness="2"
                          StrokeLineCap="Round" />
                </Canvas>
            </Viewbox>
        </Button>

        <!-- Сегодня -->
        <Button Grid.Column="1" x:Name="TodayBtn"
                Content="Сегодня" Width="80" Height="30" Margin="0,0,4,0"
                VerticalAlignment="Center"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource BrushSecondaryBg}"
                Foreground="{StaticResource BrushPrimaryText}" />

        <!-- Назад -->
        <Button Grid.Column="2" x:Name="PrevBtn"
                Width="30" Height="30" Margin="0,0,4,0"
                VerticalAlignment="Center"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource BrushSecondaryBg}"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ToolTip.Tip="Назад">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M15 18 L9 12 L15 6"
                          Stroke="{StaticResource BrushSecondaryText}"
                          StrokeThickness="2"
                          StrokeLineCap="Round" StrokeJoin="Round" />
                </Canvas>
            </Viewbox>
        </Button>

        <!-- Вперёд -->
        <Button Grid.Column="3" x:Name="NextBtn"
                Width="30" Height="30" Margin="0,0,12,0"
                VerticalAlignment="Center"
                CornerRadius="{StaticResource RadiusMedium}"
                Background="{StaticResource BrushSecondaryBg}"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ToolTip.Tip="Вперёд">
            <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                    <Path Data="M9 18 L15 12 L9 6"
                          Stroke="{StaticResource BrushSecondaryText}"
                          StrokeThickness="2"
                          StrokeLineCap="Round" StrokeJoin="Round" />
                </Canvas>
            </Viewbox>
        </Button>

        <!-- Заголовок периода -->
        <TextBlock Grid.Column="4" x:Name="TitleLabel"
                   VerticalAlignment="Center"
                   FontSize="{StaticResource FontSizeLarge}"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushPrimaryText}" />

        <!-- Поиск -->
        <TextBox Grid.Column="5" x:Name="SearchBox"
                 Width="200" Height="30" Margin="0,0,8,0"
                 VerticalAlignment="Center"
                 VerticalContentAlignment="Center"
                 Watermark="Поиск..."
                 CornerRadius="{StaticResource RadiusPill}"
                 Background="{StaticResource BrushSecondaryBg}"
                 Foreground="{StaticResource BrushPrimaryText}" />

        <!-- Вид (Месяц/Неделя/День…) -->
        <Grid Grid.Column="6" VerticalAlignment="Center">
            <ComboBox x:Name="ViewSelector"
                      Width="140" Height="30"
                      Background="{StaticResource BrushSecondaryBg}"
                      Foreground="{StaticResource BrushPrimaryText}"
                      CornerRadius="{StaticResource RadiusBase}" />
            <Viewbox Width="16" Height="16"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0"
                     IsHitTestVisible="False">
                <Canvas Width="24" Height="24">
                    <Path Data="M6 9 L12 15 L18 9"
                          Stroke="{StaticResource BrushSecondaryText}"
                          StrokeThickness="2"
                          StrokeLineCap="Round"
                          StrokeJoin="Round" />
                </Canvas>
            </Viewbox>
        </Grid>
    </Grid>

</UserControl>
