<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:SmartBase.Controls.Behaviors"
        xmlns:w="clr-namespace:SmartBase.Controls.Widgets"
        x:Class="SmartBase.Controls.Dialogs.RelationIntegrityDialog"
        Title="Целостность связей"
        Width="{StaticResource DialogWidthData}"
        Height="{StaticResource DialogHeightData}"
        MinWidth="{StaticResource DialogMinWidthData}"
        MinHeight="{StaticResource DialogMinHeightData}"
        b:DialogFit.LimitToScreen="True"
        b:DialogSize.Remember="relation-integrity"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False"
        Background="{StaticResource BrushBg}">
    <Grid Margin="{StaticResource DialogPadding}" RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,12">
            <TextBlock x:Name="DatabaseText" Classes="title" TextWrapping="Wrap" />
            <TextBlock Text="Проверка не меняет данные. Исправить можно только подтвержденные ошибки после предварительного просмотра и создания резервной копии."
                       TextWrapping="Wrap" Foreground="{StaticResource BrushSecondaryText}" />
            <TextBlock x:Name="SummaryText" Text="Проверка еще не запускалась." TextWrapping="Wrap" />
            <TextBlock x:Name="CoverageText" TextWrapping="Wrap"
                       Foreground="{StaticResource BrushSecondaryText}" IsVisible="False" />
            <w:NoticeBanner x:Name="NoticeBanner" />
        </StackPanel>

        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <TextBox Grid.Column="0" x:Name="SearchBox" Watermark="Поиск в отчете…"
                         Height="34" VerticalContentAlignment="Center" />
                <ComboBox Grid.Column="1" x:Name="CategoryCombo" Width="280" Margin="8,0,0,0"
                          VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" />
            </Grid>
            <Border Grid.Row="1" BorderBrush="{StaticResource BrushSeparator}"
                    BorderThickness="{DynamicResource BorderLine}"
                    CornerRadius="{StaticResource RadiusBase}" ClipToBounds="True">
                <ListBox x:Name="FindingsList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBox#FindingsList ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                </ListBox>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="BackupLink" Classes="link" IsVisible="False"
                    HorizontalAlignment="Left" HorizontalContentAlignment="Left" />
            <TextBlock x:Name="BackupPathText" IsVisible="False" TextWrapping="Wrap"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" IsVisible="False" />
            <Grid ColumnDefinitions="Auto,*,Auto,8,Auto">
                <Button Grid.Column="0" x:Name="ScanBtn" Classes="dialog auto" Content="Проверить" />
                <Button Grid.Column="2" x:Name="RepairBtn" Classes="dialog auto" Content="Исправить выбранное" IsEnabled="False" />
                <Button Grid.Column="4" x:Name="CloseBtn" Classes="dialog" Content="Закрыть" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
