<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:DataBase.Controls.Widgets"
        x:Class="DataBase.Controls.Dialogs.ImportExportDialog"
        Title="Импорт/Экспорт"
        Width="420"
        MinWidth="420"
        MaxWidth="420"
        MinHeight="0"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBg}">

    <StackPanel Spacing="0" Margin="20,16" Width="380">

        <!-- Режим: импорт (по умолчанию) / экспорт (пока отключён) -->
        <TextBlock Text="Режим"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   FontSize="{StaticResource FontSizeBase}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <ComboBox x:Name="ModeCombo"
                  HorizontalAlignment="Stretch"
                  Height="34"
                  VerticalContentAlignment="Center"
                  Margin="0,0,0,12"
                  Background="{StaticResource BrushSecondaryBg}"
                  Foreground="{StaticResource BrushPrimaryText}"
                  CornerRadius="{StaticResource RadiusBase}">
            <ComboBoxItem Content="Импорт" />
            <ComboBoxItem Content="Экспорт (скоро)" IsEnabled="False" />
        </ComboBox>

        <!-- Файл: ручной ввод пути + выбор файла -->
        <TextBlock Text="Файл"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   FontSize="{StaticResource FontSizeBase}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <Grid ColumnDefinitions="*,8,Auto" Margin="0,0,0,12">
            <TextBox Grid.Column="0" x:Name="PathBox"
                     Watermark="Путь к файлу .xlsx / .xlsm / .csv"
                     Height="34"
                     VerticalContentAlignment="Center"
                     CornerRadius="{StaticResource RadiusMedium}" />
            <Button Grid.Column="2" x:Name="BrowseBtn" Classes="dialog"
                    Content="Обзор…"
                    Width="100" Height="34" />
        </Grid>

        <!-- Название создаваемой коллекции -->
        <TextBlock Text="Название коллекции"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   FontSize="{StaticResource FontSizeBase}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <TextBox x:Name="NameBox"
                 Watermark="Введите название"
                 Height="34"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,12"
                 CornerRadius="{StaticResource RadiusMedium}" />

        <!-- База данных -->
        <TextBlock Text="База данных"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   FontSize="{StaticResource FontSizeBase}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <ComboBox x:Name="DbCombo"
                  HorizontalAlignment="Stretch"
                  Height="34"
                  VerticalContentAlignment="Center"
                  Margin="0,0,0,12"
                  Background="{StaticResource BrushSecondaryBg}"
                  Foreground="{StaticResource BrushPrimaryText}"
                  CornerRadius="{StaticResource RadiusBase}" />

        <!-- Расположение (родительская группа) -->
        <TextBlock Text="Расположение"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   FontSize="{StaticResource FontSizeBase}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <ComboBox x:Name="LocationCombo"
                  HorizontalAlignment="Stretch"
                  Height="34"
                  VerticalContentAlignment="Center"
                  Margin="0,0,0,12"
                  Background="{StaticResource BrushSecondaryBg}"
                  Foreground="{StaticResource BrushPrimaryText}"
                  CornerRadius="{StaticResource RadiusBase}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               TextTrimming="LeadingCharacterEllipsis"
                               VerticalAlignment="Center" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
            <ComboBox.Styles>
                <Style Selector="ComboBoxItem">
                    <Setter Property="MaxWidth" Value="{Binding $parent[ComboBox].Bounds.Width}" />
                </Style>
            </ComboBox.Styles>
        </ComboBox>

        <!-- Тип импорта -->
        <TextBlock Text="Тип импорта"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   FontSize="{StaticResource FontSizeBase}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <ComboBox x:Name="TypeCombo"
                  HorizontalAlignment="Stretch"
                  Height="34"
                  VerticalContentAlignment="Center"
                  Margin="0,0,0,10"
                  Background="{StaticResource BrushSecondaryBg}"
                  Foreground="{StaticResource BrushPrimaryText}"
                  CornerRadius="{StaticResource RadiusBase}" />

        <!-- Пояснение к стандартному типу -->
        <TextBlock x:Name="StandardHelp"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   FontSize="{StaticResource FontSizeSmall}"
                   Foreground="{StaticResource BrushSecondaryText}"
                   Text="Берется первый лист (для CSV — весь файл). Первая строка — заголовки (имена свойств). Столбец 1 → название записи, остальные столбцы → текстовые свойства. Колонка «Описание» создается пустой в конце. Данные читаются со второй строки. Все значения сохраняются как текст." />

        <!-- Параметры ручного типа — отдельный блок (белая карточка с рамкой) -->
        <Border x:Name="ManualPanel" IsVisible="False"
                Background="{StaticResource BrushBg}"
                BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusBase}"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel Spacing="0">

                <TextBlock Text="Параметры ручного импорта"
                           Margin="0,0,0,10"
                           FontWeight="{StaticResource FontWeightBold}"
                           FontSize="{StaticResource FontSizeBase}"
                           Foreground="{StaticResource BrushPrimaryText}" />

                <TextBlock Text="Лист"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           FontSize="{StaticResource FontSizeBase}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <TextBox x:Name="SheetBox"
                         Watermark="Название листа (пусто — первый)"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,12"
                         CornerRadius="{StaticResource RadiusMedium}" />

                <TextBlock Text="Строка заголовков"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           FontSize="{StaticResource FontSizeBase}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <TextBox x:Name="HeaderRowBox"
                         Watermark="Например, 1"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,12"
                         CornerRadius="{StaticResource RadiusMedium}" />

                <TextBlock Text="Строка данных"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           FontSize="{StaticResource FontSizeBase}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <TextBox x:Name="DataRowBox"
                         Watermark="Например, 2"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,12"
                         CornerRadius="{StaticResource RadiusMedium}" />

                <TextBlock Text="Столбец названия"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           FontSize="{StaticResource FontSizeBase}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <TextBox x:Name="TitleColBox"
                         Watermark="Число или буква, например 1 или A"
                         Height="34"
                         VerticalContentAlignment="Center"
                         CornerRadius="{StaticResource RadiusMedium}" />

            </StackPanel>
        </Border>

        <!-- Уведомление об ошибке -->
        <w:ErrorBanner x:Name="ErrorBanner" Margin="0,0,0,12" />

        <!-- Кнопки -->
        <Grid ColumnDefinitions="*,Auto,8,Auto" Margin="0,4,0,0">
            <Button Grid.Column="1" x:Name="CancelBtn" Classes="dialog"
                    Content="Отмена" />
            <Button Grid.Column="3" x:Name="ConfirmBtn" Classes="dialog"
                    Content="Импортировать" Width="150" />
        </Grid>

    </StackPanel>

</Window>
