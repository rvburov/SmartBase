<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:DataBase.Controls.Widgets"
        x:Class="DataBase.Controls.Dialogs.ImportExportDialog"
        Title="Импорт/Экспорт"
        Width="420"
        MinWidth="420"
        MaxWidth="420"
        MinHeight="0"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBg}">

    <StackPanel Spacing="0" Margin="20,16" Width="380">

        <!-- Режим: импорт (по умолчанию) / экспорт (пока отключён) -->
        <TextBlock Text="Режим"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <ComboBox x:Name="ModeCombo"
                  HorizontalAlignment="Stretch"
                  Height="34"
                  VerticalContentAlignment="Center"
                  Margin="0,0,0,12"
                  Background="{StaticResource BrushSecondaryBg}"
                  CornerRadius="{StaticResource RadiusBase}">
            <ComboBoxItem Content="Импорт" />
            <ComboBoxItem Content="Экспорт (скоро)" IsEnabled="False" />
        </ComboBox>

        <!-- Файл: ручной ввод пути + выбор файла -->
        <TextBlock Text="Файл"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <Grid ColumnDefinitions="*,8,Auto" Margin="0,0,0,8">
            <TextBox Grid.Column="0" x:Name="PathBox"
                     Watermark="Путь к файлу (Excel, CSV, JSON)"
                     Height="34"
                     VerticalContentAlignment="Center"
                     CornerRadius="{StaticResource RadiusMedium}" />
            <Button Grid.Column="2" x:Name="BrowseBtn" Classes="dialog"
                    Content="Обзор…"
                    Width="100" Height="34" />
        </Grid>

        <!-- Импорт папки целиком: меняет смысл поля выше (файл ↔ папка), поэтому живёт при нём,
             а не в параметрах ручного типа — работает и со стандартным типом. -->
        <CheckBox x:Name="FolderCheck"
                  Content="Все файлы из папки (включая подпапки)"
                  Margin="0,0,0,12" />

        <!-- Название создаваемой коллекции -->
        <TextBlock Text="Название коллекции"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <TextBox x:Name="NameBox"
                 Watermark="Введите название"
                 Height="34"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,12"
                 CornerRadius="{StaticResource RadiusMedium}" />

        <!-- База данных -->
        <TextBlock Text="База данных"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <ComboBox x:Name="DbCombo"
                  HorizontalAlignment="Stretch"
                  Height="34"
                  VerticalContentAlignment="Center"
                  Margin="0,0,0,12"
                  Background="{StaticResource BrushSecondaryBg}"
                  CornerRadius="{StaticResource RadiusBase}" />

        <!-- Расположение (родительская группа) -->
        <TextBlock Text="Расположение"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <ComboBox x:Name="LocationCombo"
                  HorizontalAlignment="Stretch"
                  Height="34"
                  VerticalContentAlignment="Center"
                  Margin="0,0,0,12"
                  Background="{StaticResource BrushSecondaryBg}"
                  CornerRadius="{StaticResource RadiusBase}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               TextTrimming="LeadingCharacterEllipsis"
                               VerticalAlignment="Center" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
            <ComboBox.Styles>
                <Style Selector="ComboBoxItem">
                    <Setter Property="MaxWidth" Value="{Binding $parent[ComboBox].Bounds.Width}" />
                </Style>
            </ComboBox.Styles>
        </ComboBox>

        <!-- Тип импорта -->
        <TextBlock Text="Тип импорта"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <ComboBox x:Name="TypeCombo"
                  HorizontalAlignment="Stretch"
                  Height="34"
                  VerticalContentAlignment="Center"
                  Margin="0,0,0,10"
                  Background="{StaticResource BrushSecondaryBg}"
                  CornerRadius="{StaticResource RadiusBase}" />

        <!-- Пояснение к стандартному типу: текст подбирается под формат файла (код) -->
        <TextBlock x:Name="StandardHelp"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <!-- Параметры ручного типа — отдельный блок (белая карточка с рамкой) -->
        <Border x:Name="ManualPanel" IsVisible="False"
                Background="{StaticResource BrushCardBg}"
                BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="{DynamicResource BorderLine}"
                CornerRadius="{StaticResource RadiusBase}"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel Spacing="0">

                <TextBlock Text="Параметры ручного импорта"
                           Margin="0,0,0,10"
                           HorizontalAlignment="Center"
                           FontWeight="{StaticResource FontWeightBold}" />

                <TextBlock Text="Лист"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <TextBox x:Name="SheetBox" Classes="onCard"
                         Watermark="Название листа (пусто — первый)"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,12"
                         CornerRadius="{StaticResource RadiusMedium}" />

                <!-- Строка заголовков | Строка данных — в два столбца -->
                <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto" Margin="0,0,0,12">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Строка заголовков"
                               Margin="0,0,0,6"
                               FontWeight="{StaticResource FontWeightBold}"
                               Foreground="{StaticResource BrushSecondaryText}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Строка данных"
                               Margin="0,0,0,6"
                               FontWeight="{StaticResource FontWeightBold}"
                               Foreground="{StaticResource BrushSecondaryText}" />
                    <TextBox Grid.Row="1" Grid.Column="0" x:Name="HeaderRowBox" Classes="onCard"
                             Watermark="Например, 1"
                             Height="34"
                             VerticalContentAlignment="Center"
                             CornerRadius="{StaticResource RadiusMedium}" />
                    <TextBox Grid.Row="1" Grid.Column="2" x:Name="DataRowBox" Classes="onCard"
                             Watermark="Например, 2"
                             Height="34"
                             VerticalContentAlignment="Center"
                             CornerRadius="{StaticResource RadiusMedium}" />
                </Grid>

                <TextBlock Text="Столбец названия"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <TextBox x:Name="TitleColBox" Classes="onCard"
                         Watermark="Число или буква, например 1 или A"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,14"
                         CornerRadius="{StaticResource RadiusMedium}" />

                <Border Classes="separator h" Margin="0,0,0,12" />

                <!-- Исключения (не участвуют ни в данных, ни в границах импорта):
                     столбцы | строки — в два столбца, листы — на всю ширину -->
                <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto" Margin="0,0,0,12">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Исключить столбцы"
                               Margin="0,0,0,6"
                               FontWeight="{StaticResource FontWeightBold}"
                               Foreground="{StaticResource BrushSecondaryText}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Исключить строки"
                               Margin="0,0,0,6"
                               FontWeight="{StaticResource FontWeightBold}"
                               Foreground="{StaticResource BrushSecondaryText}" />
                    <TextBox Grid.Row="1" Grid.Column="0" x:Name="ExcludeColsBox" Classes="onCard"
                             Watermark="C, F или 3, 6"
                             Height="34"
                             VerticalContentAlignment="Center"
                             CornerRadius="{StaticResource RadiusMedium}" />
                    <TextBox Grid.Row="1" Grid.Column="2" x:Name="ExcludeRowsBox" Classes="onCard"
                             Watermark="3, 5-8"
                             Height="34"
                             VerticalContentAlignment="Center"
                             CornerRadius="{StaticResource RadiusMedium}" />
                </Grid>

                <TextBlock Text="Исключить листы"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <TextBox x:Name="ExcludeSheetsBox" Classes="onCard"
                         Watermark="Итоги, Служебный"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,14"
                         CornerRadius="{StaticResource RadiusMedium}" />

                <Border Classes="separator h" Margin="0,0,0,12" />

                <!-- Раскладка листов Excel (взаимоисключающие) -->
                <CheckBox x:Name="MergeSheetsCheck" Classes="onCard"
                          Content="Все листы в одну коллекцию"
                          Margin="0,0,0,4" />
                <CheckBox x:Name="SplitSheetsCheck" Classes="onCard"
                          Content="Все листы в разные коллекции" />

            </StackPanel>
        </Border>

        <!-- Уведомление об ошибке -->
        <w:ErrorBanner x:Name="ErrorBanner" Margin="0,0,0,12" />

        <!-- Кнопки -->
        <Grid ColumnDefinitions="*,Auto,8,Auto" Margin="0,4,0,0">
            <Button Grid.Column="1" x:Name="CancelBtn" Classes="dialog"
                    Content="Отмена" />
            <Button Grid.Column="3" x:Name="ConfirmBtn" Classes="dialog"
                    Content="Импортировать" Width="150" />
        </Grid>

    </StackPanel>

</Window>
