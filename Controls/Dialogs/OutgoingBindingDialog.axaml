<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:SmartBase.Controls.Behaviors"
        xmlns:w="clr-namespace:SmartBase.Controls.Widgets"
        x:Class="SmartBase.Controls.Dialogs.OutgoingBindingDialog"
        Title="Что уходит наружу"
        Width="{StaticResource DialogWidthWide}"
        MinWidth="{StaticResource DialogWidthWide}"
        MaxWidth="{StaticResource DialogWidthWide}"
        MinHeight="0"
        SizeToContent="Height"
        b:DialogFit.LimitToScreen="True"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBg}">

    <StackPanel Spacing="0" Margin="{StaticResource DialogPadding}">

        <!-- Главное правило этого окна, и сказать его надо до списка: уходит только то, что
             перечислено поименно. Ни «запись целиком», ни «все поля». -->
        <TextBlock Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{StaticResource BrushSecondaryText}"
                   Text="Наружу уйдет только отмеченное здесь. Имя справа — то, под которым поле ждет чужая программа: у нас «Номер заказа», у них order_no. Помеченные свойства выбрать нельзя." />

        <Grid ColumnDefinitions="*,12,*" Margin="0,0,0,12">
            <StackPanel Grid.Column="0">
                <TextBlock Text="База данных"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="DbCombo"
                          HorizontalAlignment="Stretch"
                          Height="34"
                          VerticalContentAlignment="Center"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Коллекция"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="CollectionCombo"
                          HorizontalAlignment="Stretch"
                          Height="34"
                          VerticalContentAlignment="Center"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       TextTrimming="LeadingCharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.Styles>
                        <Style Selector="ComboBoxItem">
                            <Setter Property="MaxWidth" Value="{Binding $parent[ComboBox].Bounds.Width}" />
                        </Style>
                    </ComboBox.Styles>
                </ComboBox>
            </StackPanel>
        </Grid>

        <TextBlock Text="Какие поля уходят"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <Border BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="{DynamicResource BorderLine}"
                CornerRadius="{StaticResource RadiusBase}"
                ClipToBounds="True"
                Margin="0,0,0,12"
                Padding="0">
            <ScrollViewer MaxHeight="260"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FieldsPanel" Spacing="6" Margin="10,8" />
            </ScrollViewer>
        </Border>

        <Grid ColumnDefinitions="*,12,*" Margin="0,0,0,10">
            <StackPanel Grid.Column="0">
                <TextBlock Text="Как обернуть"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="ShapeCombo"
                          HorizontalAlignment="Stretch"
                          Height="34"
                          VerticalContentAlignment="Center"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}" />
            </StackPanel>
            <StackPanel Grid.Column="2" x:Name="EnvelopeBox">
                <TextBlock Text="Имя поля с массивом"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <TextBox x:Name="EnvelopeInput"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Watermark="orders" />
            </StackPanel>
        </Grid>

        <!-- Вид тела, собранный из выбранного прямо сейчас. Состав выгрузки должен читаться
             глазами до отправки, а не после — в этом весь смысл явной привязки. -->
        <TextBlock x:Name="HintText"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   FontFamily="{StaticResource FontFamilyMono}"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <w:NoticeBanner x:Name="NoticeBanner" Margin="0,0,0,12" />

        <Grid ColumnDefinitions="Auto,*,Auto,8,Auto" Margin="0,4,0,0">
            <Button Grid.Column="0" x:Name="ClearBtn" Classes="dialog"
                    Content="Не отправлять" />
            <Button Grid.Column="2" x:Name="CancelBtn" Classes="dialog"
                    Content="Отмена" />
            <Button Grid.Column="4" x:Name="ConfirmBtn" Classes="dialog"
                    Content="Сохранить" />
        </Grid>

    </StackPanel>

</Window>
