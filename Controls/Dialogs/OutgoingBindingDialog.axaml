<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:SmartBase.Controls.Behaviors"
        xmlns:d="clr-namespace:SmartBase.Controls.Dialogs"
        xmlns:w="clr-namespace:SmartBase.Controls.Widgets"
        x:Class="SmartBase.Controls.Dialogs.OutgoingBindingDialog"
        Title="Что уходит наружу"
        Width="{StaticResource DialogWidthData}"
        Height="{StaticResource DialogHeightData}"
        MinWidth="{StaticResource DialogMinWidthData}"
        MinHeight="{StaticResource DialogMinHeightData}"
        b:DialogFit.LimitToScreen="True"
        b:DialogSize.Remember="binding-out"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{StaticResource BrushBg}">

    <!-- Окно КЛАССА «данные»: шапка и низ на месте, растет список полей — ради него окно и
         тянут, свойств в коллекции бывает под сотню. -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="{StaticResource DialogPadding}">

    <StackPanel Grid.Row="0" Spacing="0">

        <!-- Главное правило этого окна, и сказать его надо до списка: уходит только то, что
             перечислено поименно. Ни «запись целиком», ни «все поля». -->
        <TextBlock Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{StaticResource BrushSecondaryText}"
                   Text="Наружу уйдет только отмеченное здесь. Имя справа — то, под которым поле ждет чужая программа: у нас «Номер заказа», у них order_no. Помеченные свойства выбрать нельзя." />

        <Grid ColumnDefinitions="*,12,*" Margin="0,0,0,12">
            <StackPanel Grid.Column="0">
                <TextBlock Text="База данных"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="DbCombo"
                          HorizontalAlignment="Stretch"
                          Height="34"
                          VerticalContentAlignment="Center"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Коллекция"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="CollectionCombo"
                          HorizontalAlignment="Stretch"
                          Height="34"
                          VerticalContentAlignment="Center"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       TextTrimming="LeadingCharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.Styles>
                        <Style Selector="ComboBoxItem">
                            <Setter Property="MaxWidth" Value="{Binding $parent[ComboBox].Bounds.Width}" />
                        </Style>
                    </ComboBox.Styles>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="Auto,12,*,12,Auto" Margin="0,0,0,6">
            <TextBlock Grid.Column="0"
                       Text="Какие поля уходят"
                       VerticalAlignment="Center"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushSecondaryText}" />

            <!-- Поиск по свойствам: в коллекции их бывают сотни, и отметить два нужных, листая
                 весь список, — работа на пустом месте. -->
            <TextBox Grid.Column="2" x:Name="SearchBox"
                     Height="30"
                     Watermark="Поиск по свойствам"
                     VerticalContentAlignment="Center"
                     CornerRadius="{StaticResource RadiusBase}" />

            <TextBlock Grid.Column="4" x:Name="FoundText"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{StaticResource BrushSecondaryText}" />
        </Grid>

    </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="{DynamicResource BorderLine}"
                CornerRadius="{StaticResource RadiusBase}"
                ClipToBounds="True"
                Margin="0,0,0,12"
                Padding="0">
            <Panel>
                <!-- Строки виртуализуются: свойств в коллекции бывают сотни, и создавать на
                     каждое галочку с полем разом — заметная пауза на открытии окна. Состояние
                     живет в модели строки: виртуализация пересоздает контролы при прокрутке. -->
                <ItemsControl x:Name="FieldItems" Margin="10,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="d:OutgoingFieldRow">
                            <StackPanel Spacing="2" Margin="0,0,0,6">
                                <Grid ColumnDefinitions="*,12,*">
                                    <CheckBox Grid.Column="0"
                                              Content="{Binding Title}"
                                              IsChecked="{Binding Takes, Mode=TwoWay}"
                                              IsEnabled="{Binding Allowed}"
                                              VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2"
                                             Height="30"
                                             Text="{Binding Alias, Mode=TwoWay}"
                                             IsEnabled="{Binding Allowed}"
                                             Watermark="имя в JSON"
                                             VerticalContentAlignment="Center"
                                             HorizontalAlignment="Stretch" />
                                </Grid>

                                <!-- Почему галочки нет — прямо под строкой: узнать, что поле
                                     наружу не уходит, надо здесь, а не из пустой колонки у той
                                     стороны через неделю. -->
                                <TextBlock Text="{Binding Note}"
                                           IsVisible="{Binding HasNote}"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           Foreground="{StaticResource BrushSecondaryText}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="FieldsEmpty"
                           IsVisible="False"
                           Margin="10,8"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource BrushSecondaryText}" />
            </Panel>
        </Border>

    <StackPanel Grid.Row="2" Spacing="0">

        <!-- Отбор — строкой с кнопкой, а не списком: правка живет в своем окне, чтобы не
             отодвигать перечень уходящих полей, который и есть главное в этом окне. -->
        <Grid ColumnDefinitions="Auto,12,*" Margin="0,0,0,10">
            <Button Grid.Column="0" x:Name="FilterBtn" Classes="dialog"
                    Content="Какие записи…" />
            <TextBlock Grid.Column="2" x:Name="FilterText"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{StaticResource BrushSecondaryText}" />
        </Grid>

        <Grid ColumnDefinitions="*,12,*" Margin="0,0,0,10">
            <StackPanel Grid.Column="0">
                <TextBlock Text="Как обернуть"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="ShapeCombo"
                          HorizontalAlignment="Stretch"
                          Height="34"
                          VerticalContentAlignment="Center"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}" />
            </StackPanel>
            <StackPanel Grid.Column="2" x:Name="EnvelopeBox">
                <TextBlock Text="Имя поля с массивом"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <TextBox x:Name="EnvelopeInput"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Watermark="orders" />
            </StackPanel>
        </Grid>

        <!-- Вид тела, собранный из выбранного прямо сейчас. Состав выгрузки должен читаться
             глазами до отправки, а не после — в этом весь смысл явной привязки. -->
        <TextBlock x:Name="HintText"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   FontFamily="{StaticResource FontFamilyMono}"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <w:NoticeBanner x:Name="NoticeBanner" Margin="0,0,0,12" />

        <Grid ColumnDefinitions="Auto,*,Auto,8,Auto" Margin="0,4,0,0">
            <Button Grid.Column="0" x:Name="ClearBtn" Classes="dialog"
                    Content="Не отправлять" />
            <Button Grid.Column="2" x:Name="CancelBtn" Classes="dialog"
                    Content="Отмена" />
            <Button Grid.Column="4" x:Name="ConfirmBtn" Classes="dialog"
                    Content="Сохранить" />
        </Grid>

    </StackPanel>

    </Grid>

</Window>
