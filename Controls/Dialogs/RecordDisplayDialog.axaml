<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:SmartBase.Controls.Behaviors"
        x:Class="SmartBase.Controls.Dialogs.RecordDisplayDialog"
        Title="Отображение записей"
        Width="{StaticResource DialogWidthWide}"
        MinWidth="{StaticResource DialogWidthWide}"
        MaxWidth="{StaticResource DialogWidthWide}"
        Height="{StaticResource DialogHeightWide}"
        MinHeight="{StaticResource DialogHeightWide}"
        MaxHeight="{StaticResource DialogHeightWide}"
        b:DialogFit.LimitToScreen="True"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBg}">

    <!-- Два отдельных блока: слева контент, справа активитибар уровней; между ними черта -->
    <Grid ColumnDefinitions="*,Auto,Auto">

        <!-- Левый блок: поиск (сверху) · список (на всю высоту) · Отмена/Сохранить (внизу) -->
        <Grid Grid.Column="0" Margin="{StaticResource DialogPadding}" RowDefinitions="Auto,*,Auto">

            <!-- Поиск + кнопки перемещения выделенной записи (вверх/вниз) -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <TextBox Grid.Column="0" x:Name="SearchBox"
                         Watermark="Поиск записей..."
                         Height="34"
                         VerticalContentAlignment="Center"
                         CornerRadius="{StaticResource RadiusMedium}" />
                <StackPanel Grid.Column="1" x:Name="MoveButtons"
                            Orientation="Horizontal" Spacing="6"
                            Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>

            <!-- Список записей: № · чекбокс · уровень · название. Без внутренних отступов
                 и спейсинга — выделение строки идет во всю ширину до линии рамки и вплотную
                 сверху/снизу (как строки сайдбара). ClipToBounds — обрезка по скруглению. -->
            <Border Grid.Row="1"
                    BorderBrush="{StaticResource BrushSeparator}"
                    BorderThickness="{DynamicResource BorderLine}"
                    CornerRadius="{StaticResource RadiusBase}"
                    ClipToBounds="True"
                    Padding="0">
                <!-- Виртуализирующий список: рендерятся только видимые строки, поэтому окно
                     открывается мгновенно даже на коллекциях в сотни тысяч записей. -->
                <!-- Горизонтальная прокрутка: длинные названия не обрезаются многоточием,
                     их можно домотать полосой снизу. Ширина строки при этом постоянная
                     (MinWidth названия из FilterValueMetrics) — иначе экстент считался бы
                     по видимым строкам и полоса прыгала бы при вертикальной прокрутке. -->
                <ListBox x:Name="ListHost"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.Styles>
                        <Style Selector="ListBox#ListHost ListBoxItem">
                            <Setter Property="Padding"   Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                        <Style Selector="ListBox#ListHost ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource BrushSecondaryBg}" />
                        </Style>
                        <Style Selector="ListBox#ListHost ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource BrushAccentLight}" />
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </Border>

            <!-- Кнопки внизу -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,8,Auto" Margin="0,12,0,0">
                <Button Grid.Column="1" x:Name="CancelBtn" Classes="dialog" Content="Отмена" />
                <Button Grid.Column="3" x:Name="SaveBtn" Classes="dialog" Content="Сохранить" />
            </Grid>

        </Grid>

        <!-- Черта между блоками (на всю высоту) -->
        <Border Grid.Column="1"
                Classes="separator v" />

        <!-- Правый блок: активитибар уровней (на всю высоту, заподлицо).
             Числа — сверху; «+» и «−» прибиты к низу. -->
        <Border Grid.Column="2"
                Background="{StaticResource BrushSecondaryBg}"
                Width="48">
            <Grid RowDefinitions="*,Auto">
                <StackPanel Grid.Row="0" x:Name="LevelPanel"
                            Orientation="Vertical"
                            Spacing="8"
                            Margin="8,12,8,0"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center" />
                <StackPanel Grid.Row="1" x:Name="LevelActions"
                            Orientation="Vertical"
                            Spacing="8"
                            Margin="8,8,8,12"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center" />
            </Grid>
        </Border>

    </Grid>

</Window>
