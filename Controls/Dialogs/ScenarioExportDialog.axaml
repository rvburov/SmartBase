<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:SmartBase.Controls.Behaviors"
        xmlns:w="clr-namespace:SmartBase.Controls.Widgets"
        x:Class="SmartBase.Controls.Dialogs.ScenarioExportDialog"
        Title="Экспорт выборки"
        Width="{StaticResource DialogWidthBase}"
        MinWidth="{StaticResource DialogWidthBase}"
        MaxWidth="{StaticResource DialogWidthBase}"
        MinHeight="0"
        SizeToContent="Height"
        b:DialogFit.LimitToScreen="True"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBg}">

    <StackPanel Spacing="0" Margin="{StaticResource DialogPadding}">

        <!-- ── Что выгружать ────────────────────────────────────────────────── -->

        <TextBlock Text="Что выгружать"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <ComboBox x:Name="PlaceCombo"
                  Height="34"
                  Margin="0,0,0,6"
                  HorizontalAlignment="Stretch"
                  VerticalContentAlignment="Center"
                  Background="{StaticResource BrushSecondaryBg}"
                  CornerRadius="{StaticResource RadiusBase}" />

        <TextBlock Text="Уходят видимые колонки таблицы. Помеченное свойство останавливает выгрузку словами; убрать его из файла можно, скрыв колонку."
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <!-- ── Куда и в каком виде ──────────────────────────────────────────── -->

        <TextBlock Text="Файл"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <Grid ColumnDefinitions="Auto,8,*" Margin="0,0,0,6">
            <ComboBox Grid.Column="0" x:Name="FormatCombo"
                      Height="30"
                      MinWidth="120"
                      VerticalContentAlignment="Center"
                      Background="{StaticResource BrushSecondaryBg}"
                      CornerRadius="{StaticResource RadiusBase}" />
            <TextBox Grid.Column="2" x:Name="FolderBox"
                     Height="30"
                     Watermark="P:\Обмен\Выгрузки"
                     VerticalContentAlignment="Center"
                     CornerRadius="{StaticResource RadiusBase}" />
        </Grid>

        <TextBlock Text="Папка должна быть разрешена политикой организации: автоматическая выгрузка работает только внутри ее корней. Имя файла — коллекция и момент выгрузки."
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <!-- ── Отбор ────────────────────────────────────────────────────────── -->

        <TextBlock Text="Отбор строк"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <TextBlock Text="Без условий уходит вся коллекция. Колонка называется по имени; имя, которого в коллекции нет, останавливает шаг словами."
                   Margin="0,0,0,6"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <!-- Полоса идет во всю высоту блока, а воздух висит на содержимом ВНУТРИ прокрутки
             (docs/developer/ui/scrolling.md) — иначе она отходит от рамки. -->
        <Border BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="{DynamicResource BorderLine}"
                CornerRadius="{StaticResource RadiusBase}"
                ClipToBounds="True"
                Margin="0,0,0,8"
                Padding="0">
            <ScrollViewer MaxHeight="200"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="TestsPanel" Spacing="8" Margin="10,8" />
            </ScrollViewer>
        </Border>

        <WrapPanel Margin="0,0,0,8">
            <Button x:Name="AddTestBtn" Content="+ Условие" Height="30" Padding="12,0" />
        </WrapPanel>

        <w:NoticeBanner x:Name="NoticeBanner" Margin="0,0,0,12" />

        <Grid ColumnDefinitions="*,Auto,8,Auto" Margin="0,4,0,0">
            <Button Grid.Column="1" x:Name="CancelBtn" Classes="dialog" Content="Отмена" />
            <Button Grid.Column="3" x:Name="SaveBtn"   Classes="dialog" Content="Готово" />
        </Grid>

    </StackPanel>

</Window>
