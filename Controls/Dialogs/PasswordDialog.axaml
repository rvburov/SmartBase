<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:SmartBase.Controls.Widgets"
        x:Class="SmartBase.Controls.Dialogs.PasswordDialog"
        Title="Пароль базы данных"
        Width="420"
        MinWidth="420"
        MaxWidth="420"
        MinHeight="0"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBg}">

    <StackPanel Spacing="0" Margin="20,16" Width="380">

        <!-- Пояснение (у разблокировки — имя базы и статус). -->
        <TextBlock x:Name="InfoText"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <TextBlock x:Name="PasswordLabel"
                   Text="Пароль"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <TextBox x:Name="PasswordBox"
                 PasswordChar="●"
                 Watermark="Введите пароль"
                 Height="34"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,12"
                 CornerRadius="{StaticResource RadiusMedium}" />

        <!-- Повтор пароля — только при установке/смене. -->
        <StackPanel x:Name="RepeatBlock" Spacing="0">
            <TextBlock Text="Повторите пароль"
                       Margin="0,0,0,6"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <TextBox x:Name="RepeatBox"
                     PasswordChar="●"
                     Watermark="Введите пароль ещё раз"
                     Height="34"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,12"
                     CornerRadius="{StaticResource RadiusMedium}" />
        </StackPanel>

        <!-- Уведомление об ошибке (не совпадает / неверный пароль) -->
        <w:NoticeBanner x:Name="NoticeBanner" Margin="0,0,0,12" />

        <!-- Кнопки -->
        <Grid ColumnDefinitions="*,Auto,8,Auto" Margin="0,4,0,0">
            <Button Grid.Column="1" x:Name="CancelBtn" Classes="dialog"
                    Content="Отмена" />
            <Button Grid.Column="3" x:Name="ConfirmBtn" Classes="dialog"
                    Content="Сохранить" />
        </Grid>

    </StackPanel>

</Window>
