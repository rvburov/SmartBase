<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:SmartBase.Controls.Widgets"
        x:Class="SmartBase.Controls.Dialogs.TaskDialog"
        Title="Новая задача"
        Width="520"
        MinWidth="520"
        MaxWidth="520"
        MinHeight="0"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBg}">

    <DockPanel Margin="20,16">

        <!-- Кнопки внизу -->
        <Grid DockPanel.Dock="Bottom"
              ColumnDefinitions="Auto,*,Auto,8,Auto"
              Margin="0,16,0,4">
            <Button Grid.Column="0" x:Name="DeleteBtn" Classes="dialog"
                    Content="Удалить" IsVisible="False" />
            <Button Grid.Column="2" x:Name="CancelBtn" Classes="dialog"
                    Content="Отмена" />
            <Button Grid.Column="4" x:Name="SaveBtn" Classes="dialog"
                    Content="Сохранить" />
        </Grid>

        <!-- Уведомление об ошибке валидации -->
        <w:NoticeBanner x:Name="NoticeBanner" DockPanel.Dock="Bottom" Margin="0,0,0,12" />

        <StackPanel Spacing="0">

            <!-- Название -->
            <TextBlock Text="Название"
                       Margin="0,0,0,6"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <TextBox x:Name="TitleBox"
                     Watermark="Добавить название"
                     Height="34"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,12"
                     CornerRadius="{StaticResource RadiusMedium}" />

            <!-- Статус -->
            <TextBlock Text="Статус"
                       Margin="0,0,0,6"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <ComboBox x:Name="StatusCombo"
                      HorizontalAlignment="Stretch"
                      Height="34"
                      Margin="0,0,0,12"
                      Background="{StaticResource BrushSecondaryBg}"
                      CornerRadius="{StaticResource RadiusBase}" />

            <!-- Исполнитель -->
            <TextBlock Text="Исполнитель"
                       Margin="0,0,0,6"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <ComboBox x:Name="ExecutorCombo"
                      HorizontalAlignment="Stretch"
                      Height="34"
                      Margin="0,0,0,12"
                      Background="{StaticResource BrushSecondaryBg}"
                      CornerRadius="{StaticResource RadiusBase}" />

            <!-- Назначил -->
            <TextBlock Text="Назначил"
                       Margin="0,0,0,6"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <ComboBox x:Name="AssignerCombo"
                      HorizontalAlignment="Stretch"
                      Height="34"
                      Margin="0,0,0,12"
                      Background="{StaticResource BrushSecondaryBg}"
                      CornerRadius="{StaticResource RadiusBase}" />

            <!-- Срок: задача может быть без даты -->
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
                <CheckBox x:Name="NoDateCheck" Content="Без даты" />
                <CheckBox x:Name="AllDayCheck" Content="Весь день" />
            </StackPanel>

            <!-- Начало -->
            <StackPanel x:Name="StartSection" Spacing="0">
                <TextBlock x:Name="StartLabel"
                           Text="Начало"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <Grid x:Name="StartRow" ColumnDefinitions="2*,8,*" Margin="0,0,0,12">
                    <w:DateField Grid.Column="0" x:Name="StartDateField" />
                    <w:TimeField Grid.Column="2" x:Name="StartTimeField" />
                </Grid>
            </StackPanel>

            <!-- Конец -->
            <StackPanel x:Name="EndSection" Spacing="0">
                <TextBlock x:Name="EndLabel"
                           Text="Конец"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <Grid x:Name="EndRow" ColumnDefinitions="2*,8,*" Margin="0,0,0,12">
                    <w:DateField Grid.Column="0" x:Name="EndDateField" />
                    <w:TimeField Grid.Column="2" x:Name="EndTimeField" />
                </Grid>
            </StackPanel>

            <!-- База данных (видна только при создании, когда смонтировано несколько БД) -->
            <StackPanel x:Name="DbSection" IsVisible="False" Spacing="0">
                <TextBlock Text="База данных"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="DbCombo"
                          HorizontalAlignment="Stretch"
                          Height="34"
                          Margin="0,0,0,12"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}" />
            </StackPanel>

            <!-- Коллекция -->
            <TextBlock Text="Коллекция"
                       Margin="0,0,0,6"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <ComboBox x:Name="CollectionCombo"
                      HorizontalAlignment="Stretch"
                      Height="34"
                      Margin="0,0,0,6"
                      Background="{StaticResource BrushSecondaryBg}"
                      CornerRadius="{StaticResource RadiusBase}" />

            <!-- Видна, когда у существующей задачи снят срок: переноса не будет, и об этом
                 надо сказать прямо — раньше выбор молча пропадал при сохранении. -->
            <TextBlock x:Name="CollectionLockHint"
                       IsVisible="False"
                       TextWrapping="Wrap" LineHeight="16"
                       Margin="0,0,0,12"
                       Foreground="{StaticResource BrushSecondaryText}"
                       Text="Задачу без срока перенести в другую коллекцию нельзя — она останется в текущей. Укажите срок, чтобы сменить коллекцию." />

            <!-- Описание -->
            <TextBlock Text="Описание"
                       Margin="0,0,0,6"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <!-- Класс multiline (Controls.axaml): полоса прокрутки во всю высоту поля,
                 воздух текста — внутри области прокрутки. -->
            <TextBox x:Name="DescBox"
                     Classes="multiline"
                     Watermark="Добавить описание в Markdown (необязательно)"
                     Height="100"
                     Margin="0,0,0,4"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     CornerRadius="{StaticResource RadiusMedium}" />

        </StackPanel>

    </DockPanel>

</Window>
