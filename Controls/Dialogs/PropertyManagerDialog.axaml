<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MyPlanner.Controls.Dialogs.PropertyManagerDialog"
        Title="Свойства"
        Width="480"
        MinWidth="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBg}">

    <DockPanel>

        <!-- Заголовок с именем коллекции и кнопкой закрыть -->
        <Grid DockPanel.Dock="Top"
              ColumnDefinitions="*,Auto"
              Height="52"
              Margin="20,0">
            <TextBlock Grid.Column="0" x:Name="CollectionTitle"
                       VerticalAlignment="Center"
                       FontWeight="{StaticResource FontWeightBold}"
                       FontSize="{StaticResource FontSizeBase}"
                       Foreground="{StaticResource BrushPrimaryText}" />
            <Button Grid.Column="1" x:Name="CloseXBtn"
                    Content="×" Width="26" Height="26"
                    Background="Transparent"
                    Foreground="{StaticResource BrushSecondaryText}"
                    FontSize="18" Padding="0"
                    CornerRadius="5" />
        </Grid>

        <Border DockPanel.Dock="Top"
                Height="1" Background="{StaticResource BrushSeparator}" />

        <!-- Список существующих полей -->
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="20,16">
            <TextBlock Text="Поля"
                       FontWeight="{StaticResource FontWeightBold}"
                       FontSize="{StaticResource FontSizeBase}"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <ItemsControl x:Name="FieldsList"
                          MinHeight="40">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="44"
                                BorderBrush="{StaticResource BrushSeparator}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="20,*,Auto,Auto" Margin="12,0,8,0">
                                <TextBlock Grid.Column="0" Text="{Binding TypeIcon}"
                                           FontSize="12"
                                           Foreground="{StaticResource BrushSecondaryText}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           FontSize="{StaticResource FontSizeBase}"
                                           Foreground="{StaticResource BrushPrimaryText}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                                <TextBlock Grid.Column="2" Text="{Binding TypeLabel}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource BrushSecondaryText}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <Border Grid.Column="3" x:Name="RequiredBadge"
                                        IsVisible="{Binding IsRequired}"
                                        Background="{StaticResource BrushSecondaryBg}"
                                        CornerRadius="{StaticResource RadiusXS}"
                                        Padding="6,1">
                                    <TextBlock Text="обязательное"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{StaticResource BrushSecondaryText}" />
                                </Border>
                                <Button Grid.Column="3"
                                        IsVisible="{Binding !IsRequired}"
                                        Content="×"
                                        Width="20" Height="20"
                                        Background="Transparent"
                                        Foreground="{StaticResource BrushSecondaryText}"
                                        Padding="0"
                                        Command="{Binding DeleteCommand}"
                                        CornerRadius="{StaticResource RadiusXS}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Border DockPanel.Dock="Top"
                Height="1" Background="{StaticResource BrushSeparator}" />

        <!-- Добавление нового свойства -->
        <StackPanel DockPanel.Dock="Top"
                    Spacing="10"
                    Background="{StaticResource BrushSecondaryBg}"
                    Margin="0">
            <StackPanel Margin="20,14,20,0" Spacing="10">
                <TextBlock Text="НОВОЕ СВОЙСТВО"
                           FontWeight="{StaticResource FontWeightBold}"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{StaticResource BrushSecondaryText}" />

                <!-- Тип поля — сетка 3×2 -->
                <UniformGrid x:Name="TypeButtonsGrid"
                             Columns="3" Rows="2" />

                <TextBox x:Name="NewFieldNameBox"
                         Watermark="Название поля"
                         Height="34"
                         CornerRadius="{StaticResource RadiusMedium}" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                    <Button Grid.Column="1" x:Name="AddFieldBtn"
                            Content="Добавить" Width="110" Height="32"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Background="{StaticResource BrushAccent}"
                            Foreground="White"
                            FontWeight="{StaticResource FontWeightBold}" />
                </Grid>
            </StackPanel>
        </StackPanel>

        <!-- Кнопка «Закрыть» снизу -->
        <Grid DockPanel.Dock="Bottom"
              ColumnDefinitions="*,Auto"
              Margin="20,12,20,20">
            <Button Grid.Column="1" x:Name="CloseBtn"
                    Content="Закрыть" Width="110" Height="32"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Background="{StaticResource BrushSecondaryBg}"
                    Foreground="{StaticResource BrushPrimaryText}" />
        </Grid>

    </DockPanel>

</Window>
