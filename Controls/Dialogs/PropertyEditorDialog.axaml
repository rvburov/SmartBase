<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:SmartBase.Controls.Widgets"
        xmlns:b="clr-namespace:SmartBase.Controls.Behaviors"
        x:Class="SmartBase.Controls.Dialogs.PropertyEditorDialog"
        Title="Создание свойства"
        Width="{StaticResource DialogWidthBase}"
        MinWidth="{StaticResource DialogWidthBase}"
        MaxWidth="{StaticResource DialogWidthBase}"
        MinHeight="0"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        b:DialogFit.LimitToScreen="True"
        Background="{StaticResource BrushBg}">

    <Window.Styles>
        <!-- Строка-пункт: плоское поле без рамки во всех состояниях (в т.ч. фокус) —
             клик по тексту сразу редактирует, без синей обводки. -->
        <Style Selector="TextBox.optionRow">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="2,0" />
        </Style>
        <Style Selector="TextBox.optionRow /template/ Border">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush"     Value="Transparent" />
        </Style>
        <Style Selector="TextBox.optionRow:pointerover /template/ Border">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush"     Value="Transparent" />
            <Setter Property="Background"      Value="Transparent" />
        </Style>
        <Style Selector="TextBox.optionRow:focus /template/ Border">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush"     Value="Transparent" />
            <Setter Property="Background"      Value="Transparent" />
        </Style>

        <!-- Кнопка-ссылка «Добавить пункт»: без подложки/рамки во всех состояниях,
             при наведении меняется только цвет текста (без серой обводки). -->
        <Style Selector="Button.link">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="4,2" />
            <Setter Property="Foreground"      Value="{StaticResource BrushAccent}" />
            <Setter Property="Cursor"          Value="Hand" />
        </Style>
        <Style Selector="Button.link /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.link:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.link:pointerover">
            <Setter Property="Foreground" Value="#0062CC" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto" Margin="{StaticResource DialogPadding}">
    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="0">

        <TextBlock Text="Название"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <TextBox x:Name="NameBox"
                 Watermark="Введите название"
                 Height="34"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,12"
                 CornerRadius="{StaticResource RadiusMedium}" />

        <TextBlock Text="Тип"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <ComboBox x:Name="TypeCombo"
                  HorizontalAlignment="Stretch"
                  Height="34"
                  VerticalContentAlignment="Center"
                  Margin="0,0,0,12"
                  Background="{StaticResource BrushSecondaryBg}"
                  CornerRadius="{StaticResource RadiusBase}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="{Binding Icon}"
                                      Stroke="{StaticResource BrushPrimaryText}"
                                      StrokeThickness="{StaticResource IconStrokeMedium}"
                                      StrokeLineCap="Round" StrokeJoin="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>

            <!-- Контейнер элементов списка: применяется ТОЛЬКО к пунктам выпадашки (не к
                 свернутому боксу выбора), поэтому разделители групп никогда не попадают
                 в поле выбора. Черта вынесена НАД подсвечиваемым ContentPresenter (в зазор
                 между пунктами), поэтому hover/выбор ее не захватывает. Видна только у
                 первого элемента группы (StartsGroup) — групп четыре, подписей у них нет,
                 состав см. в FieldTypes. -->
            <ComboBox.ItemContainerTheme>
                <ControlTheme TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                    <Setter Property="Template">
                        <ControlTemplate>
                            <StackPanel Spacing="0">
                                <Border Height="1" Margin="6,0,6,6"
                                        Background="{StaticResource BrushSeparator}"
                                        IsVisible="{Binding StartsGroup}" />
                                <ContentPresenter Name="ContentPresenter"
                                                  Background="{TemplateBinding Background}"
                                                  BorderBrush="{TemplateBinding BorderBrush}"
                                                  BorderThickness="{TemplateBinding BorderThickness}"
                                                  CornerRadius="{TemplateBinding CornerRadius}"
                                                  Padding="{TemplateBinding Padding}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </StackPanel>
                        </ControlTemplate>
                    </Setter>
                </ControlTheme>
            </ComboBox.ItemContainerTheme>
        </ComboBox>

        <!-- Привязка к разделу: столбец несет роль («Исполнитель», «Назначил», «Статус»,
             «Дата», «Описание») — данные из него подтягиваются в календарь или задачи.
             Текст собирается по флагам поля в code-behind; роли нет — блока нет.
             Общий баннер (иконка + красная рамка), как у ошибок и пояснения SystemNote. -->
        <w:NoticeBanner x:Name="RoleNote" Margin="0,0,0,12" />

        <!-- Отображать в календаре: виден только для типа «Дата». Если включено — значения
             этого поля показываются в календаре как события. Несколько полей-дат коллекции
             могут быть включены одновременно (запись появится в календаре несколько раз). -->
        <StackPanel x:Name="CalDateSection" IsVisible="False"
                    Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
            <ToggleSwitch x:Name="CalDateToggle"
                          OnContent="" OffContent=""
                          VerticalAlignment="Center" />
            <TextBlock Text="Отображать в календаре"
                       VerticalAlignment="Center"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushSecondaryText}" />
        </StackPanel>

        <!-- Добавить в раздел задач: виден только для типа «Пользователь». Если включено —
             записи с непустым значением этого поля показываются в разделе задач (значение =
             исполнитель). При первом включении в коллекции авто-создаются недостающие поля
             «Назначил» и «Статус». -->
        <StackPanel x:Name="TaskSection" IsVisible="False" Spacing="6" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ToggleSwitch x:Name="TaskToggle"
                              OnContent="" OffContent=""
                              VerticalAlignment="Center" />
                <TextBlock Text="Добавить в раздел задач"
                           VerticalAlignment="Center"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
            </StackPanel>
            <!-- Исполнитель у коллекции один: когда роль занята другим свойством, тумблер гаснет
                 и подпись объясняет, каким именно (иначе выключенный переключатель выглядит
                 поломкой). Текст ставит code-behind — UpdateTaskToggleAvailability. -->
            <TextBlock x:Name="TaskToggleHint" IsVisible="False"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{StaticResource BrushSecondaryText}" />
        </StackPanel>

        <!-- Добавить в библиотеку документов: виден только для типа «Файл». Если включено —
             записи с непустой ссылкой на файл показываются в разделе «Библиотека документов».
             При первом включении в коллекции авто-создается недостающий «Тип документа».
             В отличие от исполнителя задач, таких столбцов у коллекции может быть НЕСКОЛЬКО:
             два файловых свойства — это два разных документа записи, и показать нужно оба. -->
        <StackPanel x:Name="LibrarySection" IsVisible="False" Spacing="6" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ToggleSwitch x:Name="LibraryToggle"
                              OnContent="" OffContent=""
                              VerticalAlignment="Center" />
                <TextBlock Text="Добавить в библиотеку документов"
                           VerticalAlignment="Center"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
            </StackPanel>
            <!-- Гаснет только в одном случае: свойство уже несет роль «Тип документа» — тогда
                 подпись объясняет, почему (выключенный переключатель без объяснения выглядит
                 поломкой). Текст ставит code-behind — UpdateLibraryToggleAvailability. -->
            <TextBlock x:Name="LibraryToggleHint" IsVisible="False"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{StaticResource BrushSecondaryText}" />
        </StackPanel>

        <!-- Пункты списка: видны для типов «Список» и «Статус». Пользователь сам формирует
             набор опций (добавить/переименовать/удалить). Хранится в ConfigJson поля как
             {"options":[...]}. Для нового «Статуса» засеиваются три статуса по умолчанию.
             Строки-опции добавляются из code-behind в OptionsList. -->
        <StackPanel x:Name="OptionsSection" IsVisible="False" Spacing="0" Margin="0,0,0,12">
            <TextBlock Text="Пункты списка"
                       Margin="0,0,0,6"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushSecondaryText}" />

            <!-- Один-в-один с дропдауном фильтра таблицы: серая подложка, белые карточки поиска
                 и списка. Строки-пункты (TextBox + удаление) добавляются в OptionsList из code-behind. -->
            <Border Background="{StaticResource BrushSecondaryBg}"
                    BorderBrush="{StaticResource BrushSeparator}"
                    BorderThickness="{DynamicResource BorderLine}"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Padding="8">
                <StackPanel Spacing="6">
                    <TextBox x:Name="OptionsSearch"
                             Watermark="Поиск пунктов..."
                             Height="34"
                             VerticalContentAlignment="Center"
                             Background="{StaticResource BrushBg}"
                             CornerRadius="{StaticResource RadiusBase}" />
                    <Border Background="{StaticResource BrushBg}"
                            BorderBrush="{StaticResource BrushSeparator}"
                            BorderThickness="{DynamicResource BorderLine}"
                            CornerRadius="{StaticResource RadiusBase}"
                            Padding="0"
                            ClipToBounds="True">
                        <!-- Фиксированная высота ровно на 4 строки (30px строка + 6px зазор):
                             блок не «схлопывается» на коротком списке и не растет на длинном —
                             дальше прокрутка. Padding рамки — 0, чтобы полоса прокрутки
                             прилегала к ней со всех сторон без зазора; весь воздух вокруг
                             содержимого дает Margin самого списка (полосу он не двигает —
                             она вне прокручиваемой области). -->
                        <ScrollViewer Height="138" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="OptionsList" Spacing="6" Margin="8,6,8,6" />
                        </ScrollViewer>
                    </Border>
                    <Button x:Name="AddOptionBtn"
                            Classes="link"
                            Content="+ Добавить пункт"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Формат записи значений «Мультисписка»: чем склеиваются выбранные пункты в
                 текстовом виде (ячейка таблицы, панель записи, экспорт CSV/XLSX). Виден только
                 для мультисписка — у «Списка»/«Статуса» значение одно, склеивать нечего. -->
            <StackPanel x:Name="SeparatorSection" IsVisible="False" Spacing="6" Margin="0,10,0,0">
                <TextBlock Text="Формат записи значений"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="SeparatorCombo"
                          HorizontalAlignment="Stretch"
                          Height="34"
                          VerticalContentAlignment="Center"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}">
                    <ComboBoxItem Content="Через запятую" />
                    <ComboBoxItem Content="Через точку" />
                    <ComboBoxItem Content="Через пробел" />
                    <ComboBoxItem Content="Через точку с запятой" />
                    <ComboBoxItem Content="С новой строки" />
                    <ComboBoxItem Content="Через запятую без пробела" />
                    <ComboBoxItem Content="Через точку без пробела" />
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <!-- Формат числа: виден только для типа «Число». Меняет ТОЛЬКО показ (ячейка таблицы,
             панель записи, значения фильтра) — в БД по-прежнему лежит сырое число; переключение
             формата обратимо и данные не трогает. Хранится в ConfigJson поля (ключи numberFormat/
             decimals/thousands/currency/symbolSuffix), не пересекается с опциями списка. -->
        <StackPanel x:Name="NumberSection" IsVisible="False" Spacing="10" Margin="0,0,0,12">
            <StackPanel Spacing="6">
                <TextBlock Text="Формат числа"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="NumberFormatCombo"
                          HorizontalAlignment="Stretch"
                          Height="34"
                          VerticalContentAlignment="Center"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}">
                    <ComboBoxItem Content="Обычное число" />
                    <ComboBoxItem Content="Число с разрядами" />
                    <ComboBoxItem Content="Деньги" />
                    <ComboBoxItem Content="Проценты" />
                </ComboBox>
            </StackPanel>

            <!-- Десятичный разделитель: влияет и на показ, и на хранение (значения приводятся к
                 выбранному символу). Виден для любого формата числа (в т.ч. «Обычное число»). -->
            <StackPanel Spacing="6">
                <TextBlock Text="Десятичный разделитель"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="DecimalSeparatorCombo"
                          HorizontalAlignment="Stretch"
                          Height="34"
                          VerticalContentAlignment="Center"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}">
                    <ComboBoxItem Content="Запятая" />
                    <ComboBoxItem Content="Точка" />
                </ComboBox>
            </StackPanel>

            <!-- Опции формата (кроме «Обычное число», где показ = сырому вводу). -->
            <StackPanel x:Name="NumberOptions" Spacing="10">
                <StackPanel Spacing="6">
                    <TextBlock Text="Знаков после запятой"
                               FontWeight="{StaticResource FontWeightBold}"
                               Foreground="{StaticResource BrushSecondaryText}" />
                    <ComboBox x:Name="DecimalsCombo"
                              HorizontalAlignment="Stretch"
                              Height="34"
                              VerticalContentAlignment="Center"
                              Background="{StaticResource BrushSecondaryBg}"
                              CornerRadius="{StaticResource RadiusBase}">
                        <ComboBoxItem Content="Авто" />
                        <ComboBoxItem Content="0" />
                        <ComboBoxItem Content="1" />
                        <ComboBoxItem Content="2" />
                        <ComboBoxItem Content="3" />
                        <ComboBoxItem Content="4" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ToggleSwitch x:Name="ThousandsToggle"
                                  OnContent="" OffContent=""
                                  VerticalAlignment="Center" />
                    <TextBlock Text="Разделять разряды"
                               VerticalAlignment="Center"
                               FontWeight="{StaticResource FontWeightBold}"
                               Foreground="{StaticResource BrushSecondaryText}" />
                </StackPanel>

                <!-- Валюта: символ и его положение — только для формата «Деньги». -->
                <StackPanel x:Name="CurrencySection" IsVisible="False" Spacing="6">
                    <TextBlock Text="Валюта"
                               FontWeight="{StaticResource FontWeightBold}"
                               Foreground="{StaticResource BrushSecondaryText}" />
                    <Grid ColumnDefinitions="Auto,8,*">
                        <TextBox Grid.Column="0" x:Name="CurrencyBox"
                                 Width="72" Height="34"
                                 MaxLength="3"
                                 Watermark="₽"
                                 VerticalContentAlignment="Center"
                                 CornerRadius="{StaticResource RadiusBase}" />
                        <ComboBox Grid.Column="2" x:Name="SymbolPosCombo"
                                  HorizontalAlignment="Stretch"
                                  Height="34"
                                  VerticalContentAlignment="Center"
                                  Background="{StaticResource BrushSecondaryBg}"
                                  CornerRadius="{StaticResource RadiusBase}">
                            <ComboBoxItem Content="Символ после числа" />
                            <ComboBoxItem Content="Символ перед числом" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Автоподстановка файлов включается явно. Выключение сохраняет настройки
             и найденные пути; параметры применяются после сохранения свойства. -->
        <StackPanel x:Name="FileSection" IsVisible="False" Spacing="10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ToggleSwitch x:Name="FileAutoToggle" IsChecked="False"
                              OnContent="" OffContent=""
                              VerticalAlignment="Center" />
                <TextBlock Text="Автоподстановка файлов"
                           VerticalAlignment="Center"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
            </StackPanel>
            <StackPanel x:Name="FileAutoOptions" Spacing="10" IsVisible="False">
                <TextBlock TextWrapping="Wrap" LineHeight="16"
                           Foreground="{StaticResource BrushSecondaryText}"
                           Text="Файл подбирается автоматически из папки по имени «значение столбца.формат». Столбец становится только для чтения." />

                <!-- Столбец-источник: «Название» и текстовые свойства, включая «Описание».
                     «Выбрать…» требует явного выбора перед сохранением включенного правила. -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Столбец-источник"
                               FontWeight="{StaticResource FontWeightBold}"
                               Foreground="{StaticResource BrushSecondaryText}" />
                    <ComboBox x:Name="FileSourceCombo"
                              HorizontalAlignment="Stretch" Height="34"
                              VerticalContentAlignment="Center"
                              Background="{StaticResource BrushSecondaryBg}"
                              CornerRadius="{StaticResource RadiusBase}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Папка с файлами"
                                   FontWeight="{StaticResource FontWeightBold}"
                                   Foreground="{StaticResource BrushSecondaryText}" />
                        <Grid ColumnDefinitions="*,8,Auto">
                            <TextBox Grid.Column="0" x:Name="FileFolderText"
                                     IsReadOnly="True" Height="34"
                                     Watermark="Папка не выбрана"
                                     VerticalContentAlignment="Center"
                                     CornerRadius="{StaticResource RadiusBase}" />
                            <Button Grid.Column="2" x:Name="FileFolderBtn" Classes="dialog"
                                    Content="Выбрать…" />
                        </Grid>
                        <CheckBox x:Name="FileRecursiveCheck"
                                  Content="Искать во вложенных папках"
                                  IsChecked="True" />
                    </StackPanel>

                    <CheckBox x:Name="FilePartialMatchCheck"
                              Content="Частичное совпадение имени"
                              IsChecked="False" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="Формат файла"
                                   FontWeight="{StaticResource FontWeightBold}"
                                   Foreground="{StaticResource BrushSecondaryText}" />
                        <ComboBox x:Name="FileFormatCombo"
                                  HorizontalAlignment="Stretch" Height="34"
                                  VerticalContentAlignment="Center"
                                  Background="{StaticResource BrushSecondaryBg}"
                                  CornerRadius="{StaticResource RadiusBase}">
                            <ComboBoxItem Content="pdf" />
                            <ComboBoxItem Content="doc" />
                            <ComboBoxItem Content="docx" />
                            <ComboBoxItem Content="xls" />
                            <ComboBoxItem Content="xlsx" />
                            <ComboBoxItem Content="xlsm" />
                            <ComboBoxItem Content="csv" />
                            <ComboBoxItem Content="txt" />
                            <ComboBoxItem Content="rtf" />
                            <ComboBoxItem Content="ppt" />
                            <ComboBoxItem Content="pptx" />
                            <ComboBoxItem Content="png" />
                            <ComboBoxItem Content="jpg" />
                            <ComboBoxItem Content="jpeg" />
                            <ComboBoxItem Content="gif" />
                            <ComboBoxItem Content="svg" />
                            <ComboBoxItem Content="heic" />
                            <ComboBoxItem Content="zip" />
                            <ComboBoxItem Content="rar" />
                            <ComboBoxItem Content="7z" />
                            <ComboBoxItem Content="json" />
                            <ComboBoxItem Content="Свой формат…" />
                        </ComboBox>
                        <TextBox x:Name="FileFormatCustom" IsVisible="False" Height="34"
                                 Watermark="например: dwg"
                                 VerticalContentAlignment="Center"
                                 CornerRadius="{StaticResource RadiusBase}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Связь (relation): целевая коллекция + сколько записей можно связать. -->
        <StackPanel x:Name="RelationSection" IsVisible="False" Spacing="10" Margin="0,0,0,12">
            <TextBlock Text="Связь"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <TextBlock TextWrapping="Wrap" LineHeight="16"
                       Foreground="{StaticResource BrushSecondaryText}"
                       Text="Выбирайте записи по нужному свойству или связывайте их автоматически по совпадению столбцов. Нажатие на связанную запись открывает ее." />
            <!-- Связь создана до постоянных номеров баз на другом компьютере: базу надо указать. -->
            <w:NoticeBanner x:Name="RelationLegacyNote" />

            <StackPanel Spacing="6">
                <TextBlock Text="Целевая база"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="RelationDbCombo"
                          HorizontalAlignment="Stretch" Height="34"
                          VerticalContentAlignment="Center"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Целевая коллекция"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="RelationTargetCombo"
                          HorizontalAlignment="Stretch" Height="34"
                          VerticalContentAlignment="Center"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}" />
            </StackPanel>

            <!-- Показ и поиск по нескольким свойствам: первое — в основном списке, остальные
                 строками ниже (PropertyEditorDialog.RelationKeys). -->
            <StackPanel Spacing="6">
                <TextBlock Text="Показывать свойства" FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="RelationDisplayCombo" HorizontalAlignment="Stretch"
                          Height="{StaticResource ControlHeightStandard}" />
                <StackPanel x:Name="RelationDisplayExtra" Spacing="6" />
                <Button x:Name="AddDisplayBtn" Classes="link" Content="+ Еще свойство"
                        HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Text="Искать по свойствам" FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="RelationSearchCombo" HorizontalAlignment="Stretch"
                          Height="{StaticResource ControlHeightStandard}" />
                <StackPanel x:Name="RelationSearchExtra" Spacing="6" />
                <Button x:Name="AddSearchBtn" Classes="link" Content="+ Еще свойство"
                        HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Text="Режим связи" FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="RelationModeCombo" HorizontalAlignment="Stretch"
                          Height="{StaticResource ControlHeightStandard}" SelectedIndex="0">
                    <ComboBoxItem Content="Ручной выбор" />
                    <ComboBoxItem Content="Автоматически по совпадению свойств" />
                </ComboBox>
            </StackPanel>
            <StackPanel x:Name="RelationAutoOptions" Spacing="10" IsVisible="False">
                <StackPanel Spacing="6">
                    <TextBlock Text="Свойство этой коллекции" FontWeight="{StaticResource FontWeightBold}"
                               Foreground="{StaticResource BrushSecondaryText}" />
                    <ComboBox x:Name="RelationAutoSourceCombo" HorizontalAlignment="Stretch"
                              Height="{StaticResource ControlHeightStandard}" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Совпадает со свойством целевой коллекции" FontWeight="{StaticResource FontWeightBold}"
                               Foreground="{StaticResource BrushSecondaryText}" />
                    <ComboBox x:Name="RelationAutoTargetCombo" HorizontalAlignment="Stretch"
                              Height="{StaticResource ControlHeightStandard}" />
                </StackPanel>
                <TextBlock Text="Пустые значения не связываются. Перед сохранением будет показан результат подбора."
                           TextWrapping="Wrap" Foreground="{StaticResource BrushSecondaryText}" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Количество связей"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="RelationCardinalityCombo"
                          HorizontalAlignment="Stretch" Height="34"
                          VerticalContentAlignment="Center"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}">
                    <ComboBoxItem Content="Несколько" />
                    <ComboBoxItem Content="Одну" />
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Разделитель названий"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="RelationSeparatorCombo"
                          HorizontalAlignment="Stretch" Height="34"
                          VerticalContentAlignment="Center"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}">
                    <ComboBoxItem Content="Через запятую" />
                    <ComboBoxItem Content="Через точку" />
                    <ComboBoxItem Content="Через пробел" />
                    <ComboBoxItem Content="Через точку с запятой" />
                    <ComboBoxItem Content="С новой строки" />
                    <ComboBoxItem Content="Через запятую без пробела" />
                    <ComboBoxItem Content="Через точку без пробела" />
                </ComboBox>
            </StackPanel>

            <!-- Что будет с записью-целью при ее удалении (RelationConfig.RestrictDelete). -->
            <StackPanel Spacing="6">
                <TextBlock Text="При удалении связанной записи"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="RelationDeleteCombo" HorizontalAlignment="Stretch"
                          Height="{StaticResource ControlHeightStandard}" SelectedIndex="0">
                    <ComboBoxItem Content="Снять связь" />
                    <ComboBoxItem Content="Запретить удаление" />
                </ComboBox>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushSecondaryText}"
                           Text="«Запретить удаление» не даст удалить или перенести в другую базу запись, на которую ссылается это свойство: сначала уберите ссылку." />
            </StackPanel>

            <!-- Данные из связанных записей: каждая строка — отдельный столбец только для чтения
                 (lookup или итог), он считается по этой связи и удаляется вместе с ней. Строки
                 строятся в code-behind (PropertyEditorDialog.RelationData). -->
            <StackPanel Spacing="6">
                <TextBlock Text="Данные из связанных записей"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource BrushSecondaryText}"
                           Text="Каждая строка — отдельный столбец только для чтения: значение свойства связанной записи или итог по ним. Столбец обновляется сам и удаляется вместе со связью." />
                <StackPanel x:Name="RelationDataList" Spacing="8" />
                <Button x:Name="AddRelationDataBtn"
                        Classes="link"
                        Content="+ Добавить столбец"
                        HorizontalAlignment="Left" />
            </StackPanel>
        </StackPanel>

        <!-- Столбец данных из связи, чья связь удалена до того, как они стали удаляться вместе:
             его можно привязать к другой связи этой коллекции. Обычные столбцы данных
             настраиваются в окне своей связи. -->
        <StackPanel x:Name="RelationComputedSection" IsVisible="False" Spacing="10" Margin="0,0,0,12">
            <TextBlock Text="Значения связанных записей" FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <TextBlock Text="Значение обновляется из связанной записи и доступно только для чтения."
                       TextWrapping="Wrap" Foreground="{StaticResource BrushSecondaryText}" />
            <StackPanel Spacing="6">
                <TextBlock Text="Поле-связь" FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="ComputedRelationCombo" HorizontalAlignment="Stretch"
                          Height="{StaticResource ControlHeightStandard}" />
            </StackPanel>
            <StackPanel x:Name="ComputedAggregateOptions" Spacing="6" IsVisible="False">
                <TextBlock Text="Итог" FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="ComputedAggregateCombo" HorizontalAlignment="Stretch"
                          Height="{StaticResource ControlHeightStandard}" SelectedIndex="0">
                    <ComboBoxItem Content="Количество" />
                    <ComboBoxItem Content="Сумма" />
                    <ComboBoxItem Content="Среднее" />
                    <ComboBoxItem Content="Минимум" />
                    <ComboBoxItem Content="Максимум" />
                </ComboBox>
            </StackPanel>
            <StackPanel x:Name="ComputedTargetOptions" Spacing="6">
                <TextBlock Text="Свойство связанной записи" FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="ComputedTargetCombo" HorizontalAlignment="Stretch"
                          Height="{StaticResource ControlHeightStandard}" />
            </StackPanel>
        </StackPanel>

        <!-- ── Конфиденциальность ─────────────────────────────────────────── -->
        <!-- Только у сохраненного свойства: у нового еще нет ключа, которому ставить метку. -->
        <StackPanel x:Name="LabelSection" Spacing="0" IsVisible="False" Margin="0,0,0,12">
            <TextBlock Text="Конфиденциальность"
                       Margin="0,0,0,6"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <ComboBox x:Name="LabelCombo"
                      Height="34" Margin="0,0,0,6"
                      HorizontalAlignment="Stretch"
                      VerticalContentAlignment="Center"
                      CornerRadius="{StaticResource RadiusMedium}" />
            <TextBlock x:Name="LabelHint"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{StaticResource BrushSecondaryText}" />
        </StackPanel>

        <!-- Пояснение для системных колонок «Название»/«Описание»: скрыто по умолчанию,
             показывается только в системном режиме (см. code-behind). Объясняет, почему
             тип заблокирован и свойство нельзя удалить. Тот же баннер, что у ошибок
             валидации: иконка + красная рамка, текст обычного размера. -->
        <w:NoticeBanner x:Name="SystemNote" Margin="0,0,0,12" />

        <!-- Уведомление об ошибке валидации -->
        <w:NoticeBanner x:Name="NoticeBanner" Margin="0,0,0,12" />

    </StackPanel>
    </ScrollViewer>

        <!-- Кнопки -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,8,Auto" Margin="0,4,0,0">
            <Button Grid.Column="1" x:Name="CancelBtn" Classes="dialog"
                    Content="Отмена" />
            <Button Grid.Column="3" x:Name="SaveBtn" Classes="dialog"
                    Content="Сохранить" />
        </Grid>

    </Grid>

</Window>
