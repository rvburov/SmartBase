<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:SmartBase.Controls.Widgets"
        x:Class="SmartBase.Controls.Dialogs.PropertyEditorDialog"
        Title="Создание свойства"
        Width="380"
        MinWidth="380"
        MaxWidth="380"
        MinHeight="0"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBg}">

    <StackPanel Spacing="0" Margin="20,16" Width="340">

        <TextBlock Text="Название"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <TextBox x:Name="NameBox"
                 Watermark="Введите название"
                 Height="34"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,12"
                 CornerRadius="{StaticResource RadiusMedium}" />

        <TextBlock Text="Тип"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <ComboBox x:Name="TypeCombo"
                  HorizontalAlignment="Stretch"
                  Height="34"
                  VerticalContentAlignment="Center"
                  Margin="0,0,0,12"
                  Background="{StaticResource BrushSecondaryBg}"
                  CornerRadius="{StaticResource RadiusBase}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="{Binding Icon}"
                                      Stroke="{StaticResource BrushPrimaryText}"
                                      StrokeThickness="1.6"
                                      StrokeLineCap="Round" StrokeJoin="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>

            <!-- Контейнер элементов списка: применяется ТОЛЬКО к пунктам выпадашки (не к
                 свёрнутому боксу выбора), поэтому разделитель над «вычисляемой» группой
                 никогда не попадает в поле выбора. Черта вынесена НАД подсвечиваемым
                 ContentPresenter (в зазор между пунктами), поэтому hover/выбор её не
                 захватывает. Видна только у первого элемента группы (StartsGroup). -->
            <ComboBox.ItemContainerTheme>
                <ControlTheme TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                    <Setter Property="Template">
                        <ControlTemplate>
                            <StackPanel Spacing="0">
                                <Border Height="1" Margin="6,0,6,6"
                                        Background="{StaticResource BrushSeparator}"
                                        IsVisible="{Binding StartsGroup}" />
                                <ContentPresenter Name="ContentPresenter"
                                                  Background="{TemplateBinding Background}"
                                                  BorderBrush="{TemplateBinding BorderBrush}"
                                                  BorderThickness="{TemplateBinding BorderThickness}"
                                                  CornerRadius="{TemplateBinding CornerRadius}"
                                                  Padding="{TemplateBinding Padding}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </StackPanel>
                        </ControlTemplate>
                    </Setter>
                </ControlTheme>
            </ComboBox.ItemContainerTheme>
        </ComboBox>

        <!-- Отображать в календаре: виден только для типа «Дата». Если включено — значения
             этого поля показываются в календаре как события. Несколько полей-дат коллекции
             могут быть включены одновременно (запись появится в календаре несколько раз). -->
        <StackPanel x:Name="CalDateSection" IsVisible="False"
                    Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
            <ToggleSwitch x:Name="CalDateToggle"
                          OnContent="" OffContent=""
                          VerticalAlignment="Center" />
            <TextBlock Text="Отображать в календаре"
                       VerticalAlignment="Center"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushSecondaryText}" />
        </StackPanel>

        <!-- Добавить в раздел задач: виден только для типа «Пользователь». Если включено —
             записи с непустым значением этого поля показываются в разделе задач (значение =
             исполнитель). При первом включении в коллекции авто-создаются недостающие поля
             «Назначил» и «Статус». -->
        <StackPanel x:Name="TaskSection" IsVisible="False"
                    Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
            <ToggleSwitch x:Name="TaskToggle"
                          OnContent="" OffContent=""
                          VerticalAlignment="Center" />
            <TextBlock Text="Добавить в раздел задач"
                       VerticalAlignment="Center"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushSecondaryText}" />
        </StackPanel>

        <!-- Пункты списка: видны для типов «Список» и «Статус». Пользователь сам формирует
             набор опций (добавить/переименовать/удалить). Хранится в ConfigJson поля как
             {"options":[...]}. Для нового «Статуса» засеиваются три статуса по умолчанию.
             Строки-опции добавляются из code-behind в OptionsList. -->
        <StackPanel x:Name="OptionsSection" IsVisible="False" Spacing="0" Margin="0,0,0,12">
            <TextBlock Text="Пункты списка"
                       Margin="0,0,0,6"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="OptionsList" Spacing="6" />
            </ScrollViewer>
            <Button x:Name="AddOptionBtn"
                    Content="+ Добавить пункт"
                    HorizontalAlignment="Left"
                    Margin="0,8,0,0"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{StaticResource BrushAccent}" />
        </StackPanel>

        <!-- Пояснение для системных колонок «Название»/«Описание»: скрыто по умолчанию,
             показывается только в системном режиме (см. code-behind). Объясняет, почему
             тип заблокирован и свойство нельзя удалить. -->
        <Border x:Name="SystemNote" IsVisible="False"
                Background="{StaticResource BrushRedLight}"
                CornerRadius="{StaticResource RadiusMedium}"
                Padding="12,10"
                Margin="0,0,0,12">
            <TextBlock TextWrapping="Wrap"
                       LineHeight="18"
                       Foreground="{StaticResource BrushRed}"
                       Text="Это базовое свойство записи — на нём держится целостность коллекции. Его нельзя удалить, а тип изменить: доступно только переименование." />
        </Border>

        <!-- Уведомление об ошибке валидации -->
        <w:ErrorBanner x:Name="ErrorBanner" Margin="0,0,0,12" />

        <!-- Кнопки -->
        <Grid ColumnDefinitions="*,Auto,8,Auto" Margin="0,4,0,0">
            <Button Grid.Column="1" x:Name="CancelBtn" Classes="dialog"
                    Content="Отмена" />
            <Button Grid.Column="3" x:Name="SaveBtn" Classes="dialog"
                    Content="Сохранить" />
        </Grid>

    </StackPanel>

</Window>
