<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:SmartBase.Controls.Widgets"
        x:Class="SmartBase.Controls.Dialogs.ShortcutCaptureDialog"
        Title="Сочетание клавиш"
        Width="{StaticResource DialogWidthCompact}"
        MinWidth="{StaticResource DialogWidthCompact}"
        MaxWidth="{StaticResource DialogWidthCompact}"
        MinHeight="0"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBg}">

    <StackPanel Spacing="0" Margin="{StaticResource DialogPadding}">

        <TextBlock x:Name="ActionText"
                   Margin="0,0,0,6"
                   TextWrapping="Wrap"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <!-- Зона захвата: пока клавиши не нажаты — подсказка, дальше нажатое сочетание.
             Focusable и получает фокус при открытии — без фокусируемого элемента внутри окна
             нажатия некуда маршрутизировать, и окно не увидело бы ни одной клавиши. -->
        <Border x:Name="CaptureBox"
                Classes="dataBox"
                Focusable="True"
                MinHeight="56"
                Margin="0,0,0,12">
            <!-- Цвет и размер заданы на самом блоке: у ячеек dataBox текст по стандарту
                 мелкий и вторичный, а захваченное сочетание — главное в этом окне. -->
            <TextBlock x:Name="GestureText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       FontSize="{DynamicResource FontSizeMedium}"
                       Foreground="{StaticResource BrushPrimaryText}" />
        </Border>

        <w:NoticeBanner x:Name="NoticeBanner" Margin="0,0,0,12" />

        <Grid ColumnDefinitions="*,Auto,8,Auto" Margin="0,4,0,0">
            <Button Grid.Column="1" x:Name="CancelBtn" Classes="dialog"
                    Content="Отмена" />
            <Button Grid.Column="3" x:Name="ConfirmBtn" Classes="dialog"
                    Content="Сохранить" IsEnabled="False" />
        </Grid>

    </StackPanel>

</Window>
