<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:DataBase.Controls.Widgets"
        x:Class="DataBase.Controls.Dialogs.GroupDialog"
        Title="Новая группа"
        Width="420"
        MinWidth="420"
        MaxWidth="420"
        MinHeight="0"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBg}">

    <StackPanel Spacing="0" Margin="20,16" Width="380">

        <TextBlock Text="Название"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <TextBox x:Name="NameBox"
                 Watermark="Введите название"
                 Height="34"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,12"
                 CornerRadius="{StaticResource RadiusMedium}" />

        <TextBlock Text="База данных"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <ComboBox x:Name="DbCombo"
                  HorizontalAlignment="Stretch"
                  Height="34"
                  VerticalContentAlignment="Center"
                  Margin="0,0,0,12"
                  Background="{StaticResource BrushSecondaryBg}"
                  CornerRadius="{StaticResource RadiusBase}" />

        <TextBlock Text="Расположение"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <ComboBox x:Name="LocationCombo"
                  HorizontalAlignment="Stretch"
                  Height="34"
                  VerticalContentAlignment="Center"
                  Margin="0,0,0,12"
                  Background="{StaticResource BrushSecondaryBg}"
                  CornerRadius="{StaticResource RadiusBase}">
            <!-- Длинный путь вложенности обрезается СЛЕВА (видна правая, самая конкретная
                 часть) — и в самом поле, и в пунктах выпадающего списка. -->
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               TextTrimming="LeadingCharacterEllipsis"
                               VerticalAlignment="Center" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
            <!-- Пункт списка не шире самого поля — выпадашка не растягивается. -->
            <ComboBox.Styles>
                <Style Selector="ComboBoxItem">
                    <Setter Property="MaxWidth" Value="{Binding $parent[ComboBox].Bounds.Width}" />
                </Style>
            </ComboBox.Styles>
        </ComboBox>

        <!-- Уведомление об ошибке валидации -->
        <w:ErrorBanner x:Name="ErrorBanner" Margin="0,0,0,12" />

        <!-- Кнопки -->
        <Grid ColumnDefinitions="*,Auto,8,Auto" Margin="0,4,0,0">
            <Button Grid.Column="1" x:Name="CancelBtn" Classes="dialog"
                    Content="Отмена" />
            <Button Grid.Column="3" x:Name="ConfirmBtn" Classes="dialog"
                    Content="Создать" />
        </Grid>

    </StackPanel>

</Window>
