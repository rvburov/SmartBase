<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:SmartBase.Controls.Behaviors"
        xmlns:w="clr-namespace:SmartBase.Controls.Widgets"
        x:Class="SmartBase.Controls.Dialogs.IntegrationRequestDialog"
        Title="Запрос"
        Width="{StaticResource DialogWidthData}"
        Height="{StaticResource DialogHeightData}"
        MinWidth="{StaticResource DialogMinWidthData}"
        MinHeight="{StaticResource DialogMinHeightData}"
        b:DialogFit.LimitToScreen="True"
        b:DialogSize.Remember="request-card"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{StaticResource BrushBg}">

    <!-- Окно КЛАССА «данные»: форма длинная, а сырой ответ сторонней программы читают глазами —
         поэтому форма живет в прокрутке, ответ и кнопки прижаты к низу, а окно тянется. -->
    <Grid RowDefinitions="*,Auto,Auto" Margin="{StaticResource DialogPadding}">

    <ScrollViewer Grid.Row="0"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="0" Margin="0,0,10,0">

        <TextBlock Text="Название"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />
        <TextBox x:Name="NameBox"
                 Watermark="Заказы за сутки"
                 Height="34" Margin="0,0,0,12"
                 VerticalContentAlignment="Center"
                 CornerRadius="{StaticResource RadiusMedium}" />

        <TextBlock Text="Соединение"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />
        <ComboBox x:Name="ConnectionCombo"
                  Height="34" Margin="0,0,0,12"
                  HorizontalAlignment="Stretch" />

        <TextBlock Text="Метод и путь"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />
        <Grid ColumnDefinitions="110,8,*" Margin="0,0,0,6">
            <ComboBox Grid.Column="0" x:Name="MethodCombo"
                      Height="34"
                      HorizontalAlignment="Stretch"
                      SelectedIndex="0">
                <ComboBoxItem Tag="get"    Content="GET" />
                <ComboBoxItem Tag="post"   Content="POST" />
                <ComboBoxItem Tag="put"    Content="PUT" />
                <ComboBoxItem Tag="patch"  Content="PATCH" />
                <ComboBoxItem Tag="delete" Content="DELETE" />
            </ComboBox>
            <TextBox Grid.Column="2" x:Name="PathBox"
                     Watermark="/orders?since=…"
                     Height="34"
                     VerticalContentAlignment="Center"
                     CornerRadius="{StaticResource RadiusMedium}" />
        </Grid>

        <!-- Итоговый адрес: путь относительный, и человеку нужно видеть, что из него и адреса
             соединения получается. Заодно тут же видно, что хост берется только из соединения. -->
        <TextBlock x:Name="FullAddressText"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <TextBlock Text="Заголовки запроса"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />
        <TextBox x:Name="HeadersBox"
                 AcceptsReturn="True"
                 Watermark="Accept: application/json"
                 Height="60" Margin="0,0,0,12"
                 TextWrapping="NoWrap"
                 CornerRadius="{StaticResource RadiusMedium}" />

        <StackPanel x:Name="BodyBlock" IsVisible="False">
            <TextBlock Text="Тело"
                       Margin="0,0,0,6"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <TextBox x:Name="BodyBox"
                     AcceptsReturn="True"
                     Height="80" Margin="0,0,0,12"
                     TextWrapping="NoWrap"
                     CornerRadius="{StaticResource RadiusMedium}" />
        </StackPanel>

        <Grid ColumnDefinitions="*,12,*" Margin="0,0,0,12">
            <StackPanel Grid.Column="0">
                <TextBlock Text="Разбивка на страницы"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="PagingCombo"
                          Height="34"
                          HorizontalAlignment="Stretch"
                          SelectedIndex="0">
                    <ComboBoxItem Tag="none"   Content="Все одним ответом" />
                    <ComboBoxItem Tag="page"   Content="Номер страницы" />
                    <ComboBoxItem Tag="offset" Content="Сдвиг от начала" />
                    <ComboBoxItem Tag="cursor" Content="Метка следующей порции" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2" x:Name="PagingFieldBlock" IsVisible="False">
                <TextBlock x:Name="PagingFieldLabel"
                           Text="Имя параметра"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <TextBox x:Name="PagingFieldBox"
                         Height="34"
                         VerticalContentAlignment="Center"
                         CornerRadius="{StaticResource RadiusMedium}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Массив записей в ответе"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />
        <TextBox x:Name="ItemsPathBox"
                 Watermark="data.items — пусто, если ответ сам является списком"
                 Height="34" Margin="0,0,0,12"
                 VerticalContentAlignment="Center"
                 CornerRadius="{StaticResource RadiusMedium}" />

        <w:NoticeBanner x:Name="NoticeBanner" Margin="0,0,0,12" />

        <TextBlock x:Name="StatusText"
                   IsVisible="False"
                   Margin="0,0,0,6"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeSmall}" />

    </StackPanel>
    </ScrollViewer>

        <!-- Сырой ответ: без него чужой API не настроить никогда. Только чтение. Живет он ВНЕ
             прокрутки формы: его читают глазами, и уезжать вместе с полями он не должен. -->
        <TextBox x:Name="AnswerBox"
                 Grid.Row="1"
                 IsVisible="False"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 MinHeight="120" MaxHeight="320" Margin="0,8,0,12"
                 TextWrapping="NoWrap"
                 CornerRadius="{StaticResource RadiusMedium}" />

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,8,Auto" Margin="0,4,0,0">
            <Button Grid.Column="0" x:Name="TestBtn" Classes="dialog" Width="130"
                    Content="Проверить" />
            <Button Grid.Column="2" x:Name="CancelBtn" Classes="dialog"
                    Content="Отмена" />
            <Button Grid.Column="4" x:Name="ConfirmBtn" Classes="dialog"
                    Content="Сохранить" />
        </Grid>

    </Grid>

</Window>
