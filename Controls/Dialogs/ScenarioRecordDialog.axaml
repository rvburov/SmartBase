<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:SmartBase.Controls.Behaviors"
        xmlns:w="clr-namespace:SmartBase.Controls.Widgets"
        x:Class="SmartBase.Controls.Dialogs.ScenarioRecordDialog"
        Title="Создать запись"
        Width="{StaticResource DialogWidthBase}"
        MinWidth="{StaticResource DialogWidthBase}"
        MaxWidth="{StaticResource DialogWidthBase}"
        MinHeight="0"
        SizeToContent="Height"
        b:DialogFit.LimitToScreen="True"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBg}">

    <StackPanel Spacing="0" Margin="{StaticResource DialogPadding}">

        <!-- ── Куда писать ──────────────────────────────────────────────────── -->

        <TextBlock Text="Куда писать"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <ComboBox x:Name="PlaceCombo"
                  Height="34"
                  Margin="0,0,0,12"
                  HorizontalAlignment="Stretch"
                  VerticalContentAlignment="Center"
                  Background="{StaticResource BrushSecondaryBg}"
                  CornerRadius="{StaticResource RadiusBase}" />

        <!-- ── Значения полей ───────────────────────────────────────────────── -->

        <TextBlock Text="Поля записи"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <TextBlock Text="Слева — имя поля коллекции, как оно видно в таблице (или «Название»). Справа — значение: постоянный текст как написано, значение из строки предыдущего шага — {{Имя колонки}}. Календарный триггер приносит колонки: Название, Начало, Конец, Весь день, Коллекция."
                   Margin="0,0,0,6"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <!-- Полоса идет во всю высоту блока, а воздух висит на содержимом ВНУТРИ прокрутки
             (docs/developer/ui/scrolling.md) — иначе она отходит от рамки. -->
        <Border BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="{DynamicResource BorderLine}"
                CornerRadius="{StaticResource RadiusBase}"
                ClipToBounds="True"
                Margin="0,0,0,8"
                Padding="0">
            <ScrollViewer MaxHeight="240"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FieldsPanel" Spacing="8" Margin="10,8" />
            </ScrollViewer>
        </Border>

        <WrapPanel Margin="0,0,0,8">
            <Button x:Name="AddFieldBtn" Content="+ Поле" Height="30" Padding="12,0" />
        </WrapPanel>

        <w:NoticeBanner x:Name="NoticeBanner" Margin="0,0,0,12" />

        <Grid ColumnDefinitions="*,Auto,8,Auto" Margin="0,4,0,0">
            <Button Grid.Column="1" x:Name="CancelBtn" Classes="dialog" Content="Отмена" />
            <Button Grid.Column="3" x:Name="SaveBtn"   Classes="dialog" Content="Готово" />
        </Grid>

    </StackPanel>

</Window>
