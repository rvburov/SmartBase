<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:SmartBase.Controls.Widgets"
        x:Class="SmartBase.Controls.Dialogs.DbSettingsDialog"
        Title="Настройки базы данных"
        Width="{StaticResource DialogWidthBase}"
        MinWidth="{StaticResource DialogWidthBase}"
        MaxWidth="{StaticResource DialogWidthBase}"
        MinHeight="0"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBg}">

    <Window.Styles>
        <!-- Кнопка-ссылка: без подложки/рамки, при наведении меняется только цвет
             текста (копия стиля из PropertyEditorDialog). -->
        <Style Selector="Button.link">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="4,2" />
            <Setter Property="Foreground"      Value="{StaticResource BrushAccent}" />
            <Setter Property="Cursor"          Value="Hand" />
        </Style>
        <Style Selector="Button.link /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.link:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.link:pointerover">
            <Setter Property="Foreground" Value="#0062CC" />
        </Style>
    </Window.Styles>

    <StackPanel Spacing="0" Margin="{StaticResource DialogPadding}">

        <TextBlock Text="Название в списке"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />
        <TextBox x:Name="NameBox"
                 Height="34" Margin="0,0,0,12"
                 VerticalContentAlignment="Center"
                 CornerRadius="{StaticResource RadiusMedium}" />

        <TextBlock Text="Расположение"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />
        <SelectableTextBlock x:Name="PathText"
                             Margin="0,0,0,12"
                             TextWrapping="Wrap"
                             Foreground="{StaticResource BrushSecondaryText}" />

        <!-- ── Файловая база (SQLite) ─────────────────────────────────────── -->
        <StackPanel x:Name="SqliteSection" Spacing="0">

            <TextBlock Text="Файл"
                       Margin="0,8,0,6"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <!-- «файл 1,7 ГБ · свободно 1,1 ГБ (64 %)» — красным, когда стоит сжать -->
            <TextBlock x:Name="StorageText"
                       Margin="0,0,0,12"
                       TextWrapping="Wrap" />

            <Grid ColumnDefinitions="Auto,8,Auto,*" Margin="0,0,0,12">
                <Button Grid.Column="0" x:Name="CompactBtn" Classes="dialog auto"
                        Content="Сжать файл"
                        ToolTip.Tip="Вернуть свободное место: файл переписывается целиком, на время сжатия база отключается" />
                <Button Grid.Column="2" x:Name="BackupBtn" Classes="dialog auto"
                        Content="Резервная копия…"
                        ToolTip.Tip="Сохранить компактную копию файла базы (без свободных страниц); базу не отключает" />
            </Grid>

        </StackPanel>

        <!-- ── Серверная база (PostgreSQL) ────────────────────────────────── -->
        <StackPanel x:Name="PgSection" Spacing="0">

            <TextBlock Text="Сервер"
                       Margin="0,8,0,6"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <!-- Живой статус: работает ли сервер прямо сейчас (TCP-проба порта) -->
            <TextBlock x:Name="ServerStatusText"
                       Margin="0,0,0,2"
                       TextWrapping="Wrap" />
            <!-- Запуск, автозапуск и установка сервера — в помощнике -->
            <Button x:Name="HelpBtn" Classes="link"
                    Content="Установка и автозапуск сервера…"
                    HorizontalAlignment="Left"
                    Margin="-4,0,0,10" />

            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                <Button Grid.Column="0" x:Name="DetailsBtn" Classes="dialog auto"
                        Content="Данные подключения"
                        ToolTip.Tip="Сервер, порт, база и роль для передачи коллеге (без пароля)" />
            </Grid>

            <TextBlock Text="Сменить пароль подключения"
                       Margin="0,0,0,6"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushSecondaryText}" />
            <TextBox x:Name="PgPasswordBox"
                     PasswordChar="●"
                     Watermark="Оставьте пустым, чтобы не менять"
                     Height="34" Margin="0,0,0,6"
                     VerticalContentAlignment="Center"
                     CornerRadius="{StaticResource RadiusMedium}" />
            <TextBlock Text="Нужно, когда пароль роли поменяли на сервере. Перед сохранением программа проверит новый пароль пробным подключением."
                       Margin="0,0,0,12"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{StaticResource BrushSecondaryText}" />

        </StackPanel>

        <!-- Ошибка валидации/сервера -->
        <w:NoticeBanner x:Name="NoticeBanner" Margin="0,0,0,12" />

        <!-- «Проверяю новый пароль…» серым -->
        <TextBlock x:Name="StatusText"
                   IsVisible="False"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeSmall}" />

        <!-- Кнопки -->
        <Grid ColumnDefinitions="*,Auto,8,Auto" Margin="0,4,0,0">
            <Button Grid.Column="1" x:Name="CancelBtn" Classes="dialog"
                    Content="Отмена" />
            <Button Grid.Column="3" x:Name="SaveBtn" Classes="dialog"
                    Content="Сохранить" />
        </Grid>

    </StackPanel>

</Window>
