<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:SmartBase.Controls.Widgets"
        x:Class="SmartBase.Controls.Dialogs.MasterHashDialog"
        Title="Мастер-пароль для политики"
        Width="{StaticResource DialogWidthBase}"
        MinWidth="{StaticResource DialogWidthBase}"
        MaxWidth="{StaticResource DialogWidthBase}"
        MinHeight="0"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBg}">

    <StackPanel Spacing="0" Margin="{StaticResource DialogPadding}">

        <TextBlock Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource BrushSecondaryText}"
                   Text="Придумайте мастер-пароль организации и получите его проверочный хэш — строку, которую надо вписать в политику полем &quot;masterHash&quot;. Сам пароль никуда не сохраняется: программа его не хранит и хранить не должна. Записать пароль и передать ответственному за интеграции — дело того, кто его придумал." />

        <TextBlock Text="Мастер-пароль"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <TextBox x:Name="PasswordBox"
                 Classes="password"
                 Watermark="Придумайте пароль"
                 Height="34"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,12"
                 CornerRadius="{StaticResource RadiusMedium}" />

        <TextBlock Text="Повторите пароль"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <TextBox x:Name="RepeatBox"
                 Classes="password"
                 Watermark="Введите пароль еще раз"
                 Height="34"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,12"
                 CornerRadius="{StaticResource RadiusMedium}" />

        <w:NoticeBanner x:Name="NoticeBanner" Margin="0,0,0,12" />

        <!-- Готовая строка. До первого подсчета блока нет вовсе: пустая рамка читается как
             «здесь что-то должно было появиться». -->
        <StackPanel x:Name="ResultBlock" Spacing="0" IsVisible="False">

            <TextBlock Text="Строка для политики"
                       Margin="0,0,0,6"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushSecondaryText}" />

            <Border BorderBrush="{StaticResource BrushSeparator}"
                    BorderThickness="{DynamicResource BorderLine}"
                    CornerRadius="{StaticResource RadiusBase}"
                    ClipToBounds="True"
                    Margin="0,0,0,8"
                    Padding="0">
                <!-- Моноширинный шрифт и перенос по знакам: строка длинная, состоит из base64,
                     и в ней надо видеть каждый знак — перенос по словам разорвал бы ее в
                     случайном месте, а без переноса она уехала бы за край окна. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120">
                    <SelectableTextBlock x:Name="HashText"
                                         Margin="10,8"
                                         TextWrapping="WrapWithOverflow"
                                         FontFamily="{StaticResource FontFamilyMono}"
                                         FontSize="{DynamicResource FontSizeMono}" />
                </ScrollViewer>
            </Border>

            <TextBlock Margin="0,0,0,12"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{StaticResource BrushSecondaryText}"
                       Text="Каждый подсчет дает другую строку — соль случайная. Это не ошибка: подходят обе, проверяется ими один и тот же пароль." />

        </StackPanel>

        <Grid ColumnDefinitions="Auto,8,Auto,*,Auto" Margin="0,4,0,0">
            <Button Grid.Column="0" x:Name="ComputeBtn" Classes="dialog" Content="Посчитать" />
            <Button Grid.Column="2" x:Name="CopyBtn" Classes="dialog"
                    Content="Скопировать" IsVisible="False" />
            <Button Grid.Column="4" x:Name="CloseBtn" Classes="dialog" Content="Закрыть" />
        </Grid>

    </StackPanel>

</Window>
