<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="using:DataBase.Controls.Components"
        x:Class="DataBase.Controls.Dialogs.ProgressDialog"
        Title="Импорт данных"
        Width="340"
        MinWidth="340"
        MaxWidth="340"
        MinHeight="0"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{StaticResource BrushBg}">

    <!-- Вся начинка — единый индикатор загрузки приложения. -->
    <components:ProgressIndicator x:Name="Indicator" Margin="22,20" />

</Window>
