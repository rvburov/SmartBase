<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="using:SmartBase.Controls.Components"
        x:Class="SmartBase.Controls.Dialogs.ProgressDialog"
        Title="Импорт данных"
        Width="340"
        MinWidth="340"
        MaxWidth="340"
        MinHeight="0"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{StaticResource BrushBg}">

    <!-- Вся начинка — единый индикатор загрузки приложения; кнопка отмены появляется
         только у операций, которые её включили (EnableCancel). -->
    <StackPanel Margin="22,20" Spacing="14">
        <components:ProgressIndicator x:Name="Indicator" />
        <Button x:Name="CancelBtn" Classes="dialog"
                Content="Отмена"
                IsVisible="False"
                Width="100" Height="34"
                HorizontalAlignment="Right" />
    </StackPanel>

</Window>
