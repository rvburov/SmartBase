<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MyPlanner.Controls.Dialogs.RecordDialog"
        Title="Новая запись"
        Width="520"
        MinWidth="400"
        MinHeight="0"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBg}">

    <DockPanel Margin="24">

        <!-- Динамические поля заполняются из кода -->
        <Grid DockPanel.Dock="Bottom"
              ColumnDefinitions="Auto,*,Auto,8,Auto"
              Margin="0,16,0,4">
            <Button Grid.Column="0" x:Name="DeleteBtn" Classes="dialog"
                    Content="Удалить" IsVisible="False" />
            <Button Grid.Column="2" x:Name="CancelBtn" Classes="dialog"
                    Content="Отмена" />
            <Button Grid.Column="4" x:Name="SaveBtn" Classes="dialog"
                    Content="Сохранить" />
        </Grid>

        <StackPanel x:Name="FieldsPanel" Spacing="10" />

    </DockPanel>

</Window>
