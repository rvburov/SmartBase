<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:DataBase.Controls.Widgets"
        x:Class="DataBase.Controls.Dialogs.RecordDialog"
        Title="Новая запись"
        Width="520"
        MinWidth="520"
        MaxWidth="520"
        MinHeight="0"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBg}">

    <DockPanel Margin="20,16">

        <!-- Кнопки внизу -->
        <Grid DockPanel.Dock="Bottom"
              ColumnDefinitions="Auto,*,Auto,8,Auto"
              Margin="0,16,0,4">
            <Button Grid.Column="0" x:Name="DeleteBtn" Classes="dialog"
                    Content="Удалить" IsVisible="False" />
            <Button Grid.Column="2" x:Name="CancelBtn" Classes="dialog"
                    Content="Отмена" />
            <Button Grid.Column="4" x:Name="SaveBtn" Classes="dialog"
                    Content="Сохранить" />
        </Grid>

        <!-- Уведомление об ошибке валидации -->
        <w:ErrorBanner x:Name="ErrorBanner" DockPanel.Dock="Bottom" Margin="0,0,0,12" />

        <StackPanel Spacing="0">

            <!-- ===== Режим календаря ===== -->
            <StackPanel x:Name="CalendarSection" IsVisible="False" Spacing="0">

                <!-- Название -->
                <TextBlock Text="Название"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <TextBox x:Name="TitleBox"
                         Watermark="Добавить название"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,12"
                         CornerRadius="{StaticResource RadiusMedium}" />

                <!-- Весь день -->
                <CheckBox x:Name="AllDayCheck"
                          Content="Весь день"
                          Margin="0,0,0,12"
                          />

                <!-- Начало -->
                <TextBlock x:Name="StartLabel"
                           Text="Начало"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <Grid x:Name="StartRow" ColumnDefinitions="2*,8,*" Margin="0,0,0,12">
                    <CalendarDatePicker Grid.Column="0" x:Name="StartDatePicker"
                                        Height="34" HorizontalAlignment="Stretch"
                                        SelectedDateFormat="Custom"
                                        CustomDateFormatString="dd.MM.yyyy" />
                    <Border Grid.Column="2" x:Name="StartTimeBorder" Classes="timeField" Height="34">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" x:Name="StartTimeInput" Classes="timeInput" />
                            <Button Grid.Column="1" x:Name="StartTimeArrow" Classes="timeArrow">
                                <Path Data="{StaticResource IconChevronDown}"
                                      Stretch="Fill" Width="12" Height="8"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Stroke="{StaticResource BrushSecondaryText}"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round" />
                            </Button>
                            <Popup Grid.Column="0" x:Name="StartTimePopup"
                                   PlacementTarget="{Binding #StartTimeBorder}"
                                   Placement="BottomEdgeAlignedLeft"
                                   IsLightDismissEnabled="True">
                                <Border Classes="timePopup"
                                        MinWidth="{Binding #StartTimeBorder.Bounds.Width}">
                                    <ScrollViewer MaxHeight="240">
                                        <ListBox x:Name="StartTimeList" Classes="timeList" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Конец -->
                <TextBlock x:Name="EndLabel"
                           Text="Конец"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <Grid x:Name="EndRow" ColumnDefinitions="2*,8,*" Margin="0,0,0,12">
                    <CalendarDatePicker Grid.Column="0" x:Name="EndDatePicker"
                                        Height="34" HorizontalAlignment="Stretch"
                                        SelectedDateFormat="Custom"
                                        CustomDateFormatString="dd.MM.yyyy" />
                    <Border Grid.Column="2" x:Name="EndTimeBorder" Classes="timeField" Height="34">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" x:Name="EndTimeInput" Classes="timeInput" />
                            <Button Grid.Column="1" x:Name="EndTimeArrow" Classes="timeArrow">
                                <Path Data="{StaticResource IconChevronDown}"
                                      Stretch="Fill" Width="12" Height="8"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Stroke="{StaticResource BrushSecondaryText}"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round" />
                            </Button>
                            <Popup Grid.Column="0" x:Name="EndTimePopup"
                                   PlacementTarget="{Binding #EndTimeBorder}"
                                   Placement="BottomEdgeAlignedLeft"
                                   IsLightDismissEnabled="True">
                                <Border Classes="timePopup"
                                        MinWidth="{Binding #EndTimeBorder.Bounds.Width}">
                                    <ScrollViewer MaxHeight="240">
                                        <ListBox x:Name="EndTimeList" Classes="timeList" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                </Grid>

                <!-- База данных (видна только при создании, когда смонтировано несколько БД) -->
                <StackPanel x:Name="DbSection" IsVisible="False" Spacing="0">
                    <TextBlock Text="База данных"
                               Margin="0,0,0,6"
                               FontWeight="{StaticResource FontWeightBold}"
                               Foreground="{StaticResource BrushSecondaryText}" />
                    <ComboBox x:Name="DbCombo"
                              HorizontalAlignment="Stretch"
                              Height="34"
                              Margin="0,0,0,12"
                              Background="{StaticResource BrushSecondaryBg}"
                              CornerRadius="{StaticResource RadiusBase}" />
                </StackPanel>

                <!-- Коллекция -->
                <TextBlock Text="Коллекция"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="CollectionCombo"
                          HorizontalAlignment="Stretch"
                          Height="34"
                          Margin="0,0,0,12"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}" />

                <!-- Дата записи: выбирает, какое поле-дата коллекции показывается в календаре
                     (общее для всей коллекции). Показывается всегда. -->
                <StackPanel x:Name="EventDateSection" IsVisible="False" Spacing="0">
                    <TextBlock Text="Дата записи"
                               Margin="0,0,0,6"
                               FontWeight="{StaticResource FontWeightBold}"
                               Foreground="{StaticResource BrushSecondaryText}" />
                    <ComboBox x:Name="EventDateCombo"
                              HorizontalAlignment="Stretch"
                              Height="34"
                              Margin="0,0,0,12"
                              PlaceholderText="Выберите дату"
                              Background="{StaticResource BrushSecondaryBg}"
                              CornerRadius="{StaticResource RadiusBase}" />
                </StackPanel>

                <!-- Описание -->
                <TextBlock Text="Описание"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <TextBox x:Name="DescBox"
                         Watermark="Добавить описание в Markdown (необязательно)"
                         Height="100"
                         Margin="0,0,0,4"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         CornerRadius="{StaticResource RadiusMedium}" />
            </StackPanel>

            <!-- ===== Схема-режим (поля из конструктора) ===== -->
            <StackPanel x:Name="FieldsPanel" Spacing="10" />

        </StackPanel>

    </DockPanel>

</Window>
