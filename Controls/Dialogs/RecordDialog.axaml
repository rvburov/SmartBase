<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:SmartBase.Controls.Widgets"
        xmlns:b="clr-namespace:SmartBase.Controls.Behaviors"
        x:Class="SmartBase.Controls.Dialogs.RecordDialog"
        Title="Новая запись"
        Width="520"
        MinWidth="520"
        MaxWidth="520"
        MinHeight="0"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBg}">

    <DockPanel Margin="20,16">

        <!-- Кнопки внизу -->
        <Grid DockPanel.Dock="Bottom"
              ColumnDefinitions="Auto,*,Auto,8,Auto"
              Margin="0,16,0,4">
            <Button Grid.Column="0" x:Name="DeleteBtn" Classes="dialog"
                    Content="Удалить" IsVisible="False" />
            <Button Grid.Column="2" x:Name="CancelBtn" Classes="dialog"
                    Content="Отмена" />
            <Button Grid.Column="4" x:Name="SaveBtn" Classes="dialog"
                    Content="Сохранить" />
        </Grid>

        <!-- Уведомление об ошибке валидации -->
        <w:NoticeBanner x:Name="NoticeBanner" DockPanel.Dock="Bottom" Margin="0,0,0,12" />

        <StackPanel Spacing="0">

            <!-- ===== Режим календаря ===== -->
            <StackPanel x:Name="CalendarSection" IsVisible="False" Spacing="0">

                <!-- Название -->
                <TextBlock Text="Название"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <!-- Название хранится как есть, вместе с переводами строк (их дает вставка
                     текста и импорт), а показывают его везде первой строкой (TitleText).
                     Здесь текст еще и СОХРАНЯЕТСЯ обратно, поэтому режем не текст, а высоту:
                     поле растет по содержимому до трех строк, дальше прокрутка. Однострочное
                     поле рисовало все строки внутри своих 34 пикселей — они наезжали. -->
                <TextBox x:Name="TitleBox"
                         Classes="multiline"
                         b:GrowingFieldAlign.CenterWhenSingleLine="True"
                         Watermark="Добавить название"
                         MinHeight="34"
                         MaxHeight="72"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Margin="0,0,0,12"
                         CornerRadius="{StaticResource RadiusMedium}" />

                <!-- Весь день -->
                <CheckBox x:Name="AllDayCheck"
                          Content="Весь день"
                          Margin="0,0,0,12"
                          />

                <!-- Начало -->
                <TextBlock x:Name="StartLabel"
                           Text="Начало"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <Grid x:Name="StartRow" ColumnDefinitions="2*,8,*" Margin="0,0,0,12">
                    <w:DateField Grid.Column="0" x:Name="StartDateField" />
                    <w:TimeField Grid.Column="2" x:Name="StartTimeField" />
                </Grid>

                <!-- Конец -->
                <TextBlock x:Name="EndLabel"
                           Text="Конец"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <Grid x:Name="EndRow" ColumnDefinitions="2*,8,*" Margin="0,0,0,12">
                    <w:DateField Grid.Column="0" x:Name="EndDateField" />
                    <w:TimeField Grid.Column="2" x:Name="EndTimeField" />
                </Grid>

                <!-- База данных (видна только при создании, когда смонтировано несколько БД) -->
                <StackPanel x:Name="DbSection" IsVisible="False" Spacing="0">
                    <TextBlock Text="База данных"
                               Margin="0,0,0,6"
                               FontWeight="{StaticResource FontWeightBold}"
                               Foreground="{StaticResource BrushSecondaryText}" />
                    <ComboBox x:Name="DbCombo"
                              HorizontalAlignment="Stretch"
                              Height="34"
                              Margin="0,0,0,12"
                              Background="{StaticResource BrushSecondaryBg}"
                              CornerRadius="{StaticResource RadiusBase}" />
                </StackPanel>

                <!-- Коллекция -->
                <TextBlock Text="Коллекция"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="CollectionCombo"
                          HorizontalAlignment="Stretch"
                          Height="34"
                          Margin="0,0,0,12"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}" />

                <!-- Дата записи: в какое поле-дату коллекции положить дату события. Список
                     перечисляет ВСЕ даты коллекции, включая те, у которых показ в календаре
                     выключен: событие заводят из календаря, и выбранной дате тумблер поднимут
                     при сохранении (подпись ниже предупреждает об этом). Показывается всегда. -->
                <StackPanel x:Name="EventDateSection" IsVisible="False" Spacing="6"
                            Margin="0,0,0,12">
                    <TextBlock Text="Дата записи"
                               FontWeight="{StaticResource FontWeightBold}"
                               Foreground="{StaticResource BrushSecondaryText}" />
                    <ComboBox x:Name="EventDateCombo"
                              HorizontalAlignment="Stretch"
                              Height="34"
                              PlaceholderText="Выберите дату"
                              Background="{StaticResource BrushSecondaryBg}"
                              CornerRadius="{StaticResource RadiusBase}" />
                    <!-- Виден, только когда выбрана дата с выключенным показом. Текст ставит
                         code-behind — UpdateEventDateHint. -->
                    <TextBlock x:Name="EventDateHint" IsVisible="False"
                               TextWrapping="Wrap"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{StaticResource BrushSecondaryText}" />
                </StackPanel>

                <!-- Описание -->
                <TextBlock Text="Описание"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <!-- Класс multiline (Controls.axaml): полоса прокрутки во всю высоту поля,
                     воздух текста — внутри области прокрутки. -->
                <TextBox x:Name="DescBox"
                         Classes="multiline"
                         Watermark="Добавить описание в Markdown (необязательно)"
                         Height="100"
                         Margin="0,0,0,4"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         CornerRadius="{StaticResource RadiusMedium}" />
            </StackPanel>

            <!-- ===== Схема-режим (поля из конструктора) ===== -->
            <StackPanel x:Name="FieldsPanel" Spacing="10" />

        </StackPanel>

    </DockPanel>

</Window>
