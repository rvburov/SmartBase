<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DataBase.Controls.Dialogs.SelectDatabaseDialog"
        Title="Выбор базы данных"
        Width="420"
        MinWidth="420"
        MaxWidth="420"
        MinHeight="0"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBg}">

    <StackPanel Spacing="16" Margin="24" Width="372">

        <TextBlock Text="В какую базу данных создать событие?"
                   TextWrapping="Wrap"
                   FontSize="{StaticResource FontSizeBase}"
                   Foreground="{StaticResource BrushPrimaryText}" />

        <ComboBox x:Name="DbCombo" HorizontalAlignment="Stretch" />

        <Grid ColumnDefinitions="*,Auto,8,Auto">
            <Button Grid.Column="1" x:Name="CancelBtn" Classes="dialog" Content="Отмена" />
            <Button Grid.Column="3" x:Name="OkBtn" Classes="dialog" Content="Создать" />
        </Grid>

    </StackPanel>

</Window>
