<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:SmartBase.Controls.Widgets"
        x:Class="SmartBase.Controls.Dialogs.CreateDatabaseDialog"
        Title="Создать базу данных"
        Width="{StaticResource DialogWidthBase}"
        MinWidth="{StaticResource DialogWidthBase}"
        MaxWidth="{StaticResource DialogWidthBase}"
        MinHeight="0"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBg}">

    <StackPanel Spacing="0" Margin="{StaticResource DialogPadding}">

        <TextBlock Text="Название"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <!-- Имя файла + фиксированное расширение .db справа -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBox Grid.Column="0" x:Name="NameBox"
                     Watermark="Введите название"
                     Height="34"
                     VerticalContentAlignment="Center"
                     CornerRadius="{StaticResource RadiusMedium}" />
            <TextBlock Grid.Column="1" Text=".db"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource BrushSecondaryText}" />
        </Grid>

        <TextBlock Text="Расположение"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <!-- Папка (длинный путь обрезается слева — видна конкретная часть) + «Обзор…» -->
        <Grid ColumnDefinitions="*,8,Auto" Margin="0,0,0,12">
            <Border Grid.Column="0"
                    Height="34"
                    CornerRadius="{StaticResource RadiusBase}"
                    Background="{StaticResource BrushSecondaryBg}"
                    Padding="10,0">
                <TextBlock x:Name="FolderText"
                           VerticalAlignment="Center"
                           TextTrimming="LeadingCharacterEllipsis" />
            </Border>
            <Button Grid.Column="2" x:Name="BrowseBtn" Classes="dialog"
                    Content="Обзор…" />
        </Grid>

        <!-- Уведомление об ошибке валидации (имя занято/пустое, папка недоступна) -->
        <w:NoticeBanner x:Name="NoticeBanner" Margin="0,0,0,12" />

        <!-- Кнопки -->
        <Grid ColumnDefinitions="*,Auto,8,Auto" Margin="0,4,0,0">
            <Button Grid.Column="1" x:Name="CancelBtn" Classes="dialog"
                    Content="Отмена" />
            <Button Grid.Column="3" x:Name="ConfirmBtn" Classes="dialog"
                    Content="Создать" />
        </Grid>

    </StackPanel>

</Window>
