<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:SmartBase.Controls.Behaviors"
        xmlns:d="clr-namespace:SmartBase.Controls.Dialogs"
        xmlns:w="clr-namespace:SmartBase.Controls.Widgets"
        x:Class="SmartBase.Controls.Dialogs.IntegrationBindingDialog"
        Title="В коллекцию"
        Width="{StaticResource DialogWidthData}"
        Height="{StaticResource DialogHeightData}"
        MinWidth="{StaticResource DialogMinWidthData}"
        MinHeight="{StaticResource DialogMinHeightData}"
        b:DialogFit.LimitToScreen="True"
        b:DialogSize.Remember="binding-in"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{StaticResource BrushBg}">

    <!-- Окно КЛАССА «данные»: шапка и низ на месте, а растет середина — раскладка колонок.
         Колонок в ответе бывает под сотню, и тянут окно именно ради нее. -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="{StaticResource DialogPadding}">

    <StackPanel Grid.Row="0" Spacing="0">

        <!-- Что пришло: без этой строки человек не знает, к чему относится раскладка ниже. -->
        <TextBlock x:Name="AnswerText"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <Grid ColumnDefinitions="*,12,*" Margin="0,0,0,12">
            <StackPanel Grid.Column="0">
                <TextBlock Text="База данных"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="DbCombo"
                          HorizontalAlignment="Stretch"
                          Height="34"
                          VerticalContentAlignment="Center"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Коллекция"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="CollectionCombo"
                          HorizontalAlignment="Stretch"
                          Height="34"
                          VerticalContentAlignment="Center"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}">
                    <!-- Длинное имя коллекции обрезается СЛЕВА (видна правая, конкретная часть). -->
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       TextTrimming="LeadingCharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.Styles>
                        <Style Selector="ComboBoxItem">
                            <Setter Property="MaxWidth" Value="{Binding $parent[ComboBox].Bounds.Width}" />
                        </Style>
                    </ComboBox.Styles>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="Auto,12,*,12,Auto" Margin="0,0,0,6">
            <TextBlock Grid.Column="0"
                       Text="Что куда ложится"
                       VerticalAlignment="Center"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushSecondaryText}" />

            <!-- Поиск по колонкам: в ответе их бывает под сотню, и листать список ради одной
                 «order_no» — не раскладка, а перебор. -->
            <TextBox Grid.Column="2" x:Name="SearchBox"
                     Height="30"
                     Watermark="Поиск по колонкам"
                     VerticalContentAlignment="Center"
                     CornerRadius="{StaticResource RadiusBase}" />

            <TextBlock Grid.Column="4" x:Name="FoundText"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{StaticResource BrushSecondaryText}" />
        </Grid>

    </StackPanel>

        <!-- Раскладка колонок — растущая середина окна: колонок в ответе бывает под сотню, и
             тянут окно именно ради нее. -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="{DynamicResource BorderLine}"
                CornerRadius="{StaticResource RadiusBase}"
                ClipToBounds="True"
                Margin="0,0,0,12"
                Padding="0">
            <!-- Полоса идет во всю высоту блока, а воздух висит на содержимом ВНУТРИ прокрутки
                 (docs/developer/ui/scrolling.md) — иначе она отходит от рамки. -->
            <Panel>
                <!-- Строки виртуализуются: на сотне колонок сотня комбобоксов, созданных разом,
                     заметна и на открытии окна, и на прокрутке. Состояние выбора живет в
                     модели строки, а не в контроле, — иначе прокрутка сбрасывала бы выбранное
                     вместе с пересозданным комбобоксом. -->
                <ItemsControl x:Name="MapItems" Margin="10,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="d:BindingMapRow">
                            <Grid ColumnDefinitions="*,12,*" Margin="0,0,0,6">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Column}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <ComboBox Grid.Column="2"
                                          Height="30"
                                          HorizontalAlignment="Stretch"
                                          VerticalContentAlignment="Center"
                                          ItemsSource="{Binding Options}"
                                          SelectedIndex="{Binding Selected, Mode=TwoWay}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="MapEmpty"
                           IsVisible="False"
                           Margin="10,8"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource BrushSecondaryText}" />
            </Panel>
        </Border>

    <StackPanel Grid.Row="2" Spacing="0">

        <Grid ColumnDefinitions="*,12,*" Margin="0,0,0,10">
            <StackPanel Grid.Column="0">
                <TextBlock Text="Искать записи по"
                           Margin="0,0,0,6"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox x:Name="MatchCombo"
                          HorizontalAlignment="Stretch"
                          Height="34"
                          VerticalContentAlignment="Center"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Bottom">
                <CheckBox x:Name="UpdateCheck" Content="Обновлять найденные" />
                <CheckBox x:Name="CreateCheck" Content="Заводить новые" />
            </StackPanel>
        </Grid>

        <!-- Что именно случится при переносе — словами. Обмен повторяется, и «заведет
             дубли» человек должен прочитать до нажатия, а не увидеть после. -->
        <TextBlock x:Name="HintText"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <w:NoticeBanner x:Name="NoticeBanner" Margin="0,0,0,12" />

        <Grid ColumnDefinitions="*,Auto,8,Auto" Margin="0,4,0,0">
            <Button Grid.Column="1" x:Name="CancelBtn" Classes="dialog"
                    Content="Отмена" />
            <Button Grid.Column="3" x:Name="ConfirmBtn" Classes="dialog"
                    Content="Перенести" />
        </Grid>

    </StackPanel>

    </Grid>

</Window>
