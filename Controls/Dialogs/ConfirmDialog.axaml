<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SmartBase.Controls.Dialogs.ConfirmDialog"
        Title="Подтверждение"
        Width="{StaticResource DialogWidthCompact}"
        MinWidth="{StaticResource DialogWidthCompact}"
        MaxWidth="{StaticResource DialogWidthCompact}"
        MinHeight="0"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBg}">

    <StackPanel Spacing="16" Margin="{StaticResource DialogPadding}">

        <TextBlock x:Name="MessageLabel"
                   TextWrapping="Wrap"
 />

        <Grid ColumnDefinitions="*,Auto,8,Auto">
            <Button Grid.Column="1" x:Name="CancelBtn" Classes="dialog"
                    Content="Отмена" />
            <Button Grid.Column="3" x:Name="ConfirmBtn" Classes="dialog"
                    Content="Удалить" />
        </Grid>

    </StackPanel>

</Window>
