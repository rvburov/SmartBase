<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:SmartBase.Controls.Widgets"
        x:Class="SmartBase.Controls.Dialogs.PgConnectDialog"
        Title="Подключение к PostgreSQL"
        Width="460"
        MinWidth="460"
        MaxWidth="460"
        MinHeight="0"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBg}">

    <StackPanel Spacing="0" Margin="20,16" Width="420">

        <TextBlock Text="Сервер и порт"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <!-- Адрес сервера + порт: localhost / IP / имя хоста в сети или в интернете -->
        <Grid ColumnDefinitions="*,8,80" Margin="0,0,0,12">
            <TextBox Grid.Column="0" x:Name="HostBox"
                     Watermark="localhost"
                     Height="34"
                     VerticalContentAlignment="Center"
                     CornerRadius="{StaticResource RadiusMedium}" />
            <TextBox Grid.Column="2" x:Name="PortBox"
                     Text="5432"
                     Height="34"
                     VerticalContentAlignment="Center"
                     CornerRadius="{StaticResource RadiusMedium}" />
        </Grid>

        <TextBlock Text="База данных"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />
        <TextBox x:Name="DatabaseBox"
                 Watermark="Имя базы на сервере"
                 Height="34" Margin="0,0,0,12"
                 VerticalContentAlignment="Center"
                 CornerRadius="{StaticResource RadiusMedium}" />

        <TextBlock Text="Пользователь"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />
        <TextBox x:Name="UserBox"
                 Watermark="postgres"
                 Height="34" Margin="0,0,0,12"
                 VerticalContentAlignment="Center"
                 CornerRadius="{StaticResource RadiusMedium}" />

        <TextBlock Text="Пароль"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />
        <TextBox x:Name="PasswordBox"
                 PasswordChar="●"
                 Height="34" Margin="0,0,0,12"
                 VerticalContentAlignment="Center"
                 CornerRadius="{StaticResource RadiusMedium}" />

        <TextBlock Text="Шифрование (SSL)"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />
        <ComboBox x:Name="SslCombo"
                  Height="34" Margin="0,0,0,12"
                  HorizontalAlignment="Stretch"
                  SelectedIndex="1">
            <ComboBoxItem Tag="Disable" Content="Отключено" />
            <ComboBoxItem Tag="Prefer"  Content="Если доступно" />
            <ComboBoxItem Tag="Require" Content="Обязательно" />
        </ComboBox>

        <TextBlock Text="Название в списке"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />
        <TextBox x:Name="NameBox"
                 Watermark="По умолчанию — имя базы"
                 Height="34" Margin="0,0,0,12"
                 VerticalContentAlignment="Center"
                 CornerRadius="{StaticResource RadiusMedium}" />

        <!-- Ошибка подключения/валидации -->
        <w:NoticeBanner x:Name="NoticeBanner" Margin="0,0,0,12" />

        <!-- Проверка соединения: «Проверяю…» серым, успех — зелёным -->
        <TextBlock x:Name="StatusText"
                   IsVisible="False"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeSmall}" />

        <!-- Кнопки -->
        <Grid ColumnDefinitions="Auto,*,Auto,8,Auto" Margin="0,4,0,0">
            <!-- Шире стандартных 110: полный текст иначе обрезается -->
            <Button Grid.Column="0" x:Name="TestBtn" Classes="dialog" Width="170"
                    Content="Проверить соединение" />
            <Button Grid.Column="2" x:Name="CancelBtn" Classes="dialog"
                    Content="Отмена" />
            <Button Grid.Column="4" x:Name="ConfirmBtn" Classes="dialog"
                    Content="Подключить" />
        </Grid>

    </StackPanel>

</Window>
