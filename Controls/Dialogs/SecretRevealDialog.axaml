<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:SmartBase.Controls.Behaviors"
        x:Class="SmartBase.Controls.Dialogs.SecretRevealDialog"
        Title="Секрет соединения"
        Width="{StaticResource DialogWidthBase}"
        MinWidth="{StaticResource DialogWidthBase}"
        MaxWidth="{StaticResource DialogWidthBase}"
        MinHeight="0"
        SizeToContent="Height"
        b:DialogFit.LimitToScreen="True"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BrushBg}">

    <!-- Устроено как окно мастер-хэша: пояснение, моноширинная рамка со значением и две
         кнопки. Значение живет только здесь — закрыли окно, и его нет нигде на экране. -->
    <StackPanel Spacing="0" Margin="{StaticResource DialogPadding}">

        <TextBlock x:Name="InfoText"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <TextBlock Text="Секрет"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <Border BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="{DynamicResource BorderLine}"
                CornerRadius="{StaticResource RadiusBase}"
                ClipToBounds="True"
                Margin="0,0,0,12"
                Padding="0">
            <!-- Моноширинный шрифт и перенос по знакам: токены чужих программ длинные и
                 состоят из похожих знаков, а в них надо видеть каждый — перенос по словам
                 разорвал бы строку в случайном месте, без переноса она уехала бы за край. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120">
                <SelectableTextBlock x:Name="SecretText"
                                     Margin="10,8"
                                     TextWrapping="WrapWithOverflow"
                                     FontFamily="{StaticResource FontFamilyMono}"
                                     FontSize="{DynamicResource FontSizeMono}" />
            </ScrollViewer>
        </Border>

        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
            <Button Grid.Column="0" x:Name="CopyBtn" Classes="dialog" Content="Скопировать" />
            <Button Grid.Column="2" x:Name="CloseBtn" Classes="dialog" Content="Закрыть" />
        </Grid>

    </StackPanel>

</Window>
