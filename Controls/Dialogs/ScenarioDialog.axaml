<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:SmartBase.Controls.Behaviors"
        xmlns:w="clr-namespace:SmartBase.Controls.Widgets"
        x:Class="SmartBase.Controls.Dialogs.ScenarioDialog"
        Title="Сценарий"
        Width="{StaticResource DialogWidthData}"
        Height="{StaticResource DialogHeightData}"
        MinWidth="{StaticResource DialogMinWidthData}"
        MinHeight="{StaticResource DialogMinHeightData}"
        b:DialogFit.LimitToScreen="True"
        b:DialogSize.Remember="scenario"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{StaticResource BrushBg}">

    <!-- Окно КЛАССА «данные»: растет СПИСОК ШАГОВ — в сценарии их бывает два десятка, и
         перебирать их в прокрутке высотой в пять строк невозможно. -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="{StaticResource DialogPadding}">

    <StackPanel Grid.Row="0" Spacing="0">

        <TextBlock Text="Название"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />
        <TextBox x:Name="NameBox"
                 Height="34"
                 Margin="0,0,0,12"
                 VerticalContentAlignment="Center"
                 Watermark="Заказы из учетной системы"
                 CornerRadius="{StaticResource RadiusBase}" />

        <!-- ── Когда ────────────────────────────────────────────────────────── -->

        <TextBlock Text="Когда запускать"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <StackPanel Spacing="6" Margin="0,0,0,12">

            <RadioButton x:Name="ManualRadio" GroupName="trigger" Content="Только вручную" />

            <!-- «При запуске программы» — забрать накопившееся у той стороны за то время, пока
                 этот компьютер был выключен. Расписанием это не выражается: «каждые 30 минут»
                 после включения ждет полчаса, а «ежедневно в 07:00» не сработает вовсе, если в
                 семь машина еще не работала. Парного «при остановке» нет намеренно — см.
                 ScenarioTriggerKind.Startup. -->
            <RadioButton x:Name="StartupRadio" GroupName="trigger"
                         Content="При запуске программы" />

            <Grid ColumnDefinitions="Auto,8,*">
                <RadioButton Grid.Column="0" x:Name="EveryRadio" GroupName="trigger"
                             Content="Каждые" VerticalAlignment="Center" />
                <ComboBox Grid.Column="2" x:Name="EveryCombo"
                          Height="30"
                          HorizontalAlignment="Left"
                          MinWidth="160"
                          VerticalContentAlignment="Center"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}" />
            </Grid>

            <Grid ColumnDefinitions="Auto,8,*">
                <RadioButton Grid.Column="0" x:Name="DailyRadio" GroupName="trigger"
                             Content="Ежедневно в" VerticalAlignment="Center" />
                <TextBox Grid.Column="2" x:Name="TimeBox"
                         Height="30"
                         Width="90"
                         HorizontalAlignment="Left"
                         VerticalContentAlignment="Center"
                         Watermark="07:00"
                         CornerRadius="{StaticResource RadiusBase}" />
            </Grid>

            <Grid ColumnDefinitions="Auto,8,*">
                <RadioButton Grid.Column="0" x:Name="ChangedRadio" GroupName="trigger"
                             Content="При правках в" VerticalAlignment="Center" />
                <ComboBox Grid.Column="2" x:Name="ChangedCombo"
                          Height="30"
                          HorizontalAlignment="Stretch"
                          VerticalContentAlignment="Center"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}" />
            </Grid>

            <!-- Время тишины — отдельной строкой с отступом: это уточнение к правкам, а не
                 пятый вид триггера. -->
            <Grid ColumnDefinitions="Auto,8,*" Margin="24,0,0,0">
                <TextBlock Grid.Column="0" x:Name="SettleLabel"
                           Text="через" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox Grid.Column="2" x:Name="SettleCombo"
                          Height="30"
                          MinWidth="160"
                          HorizontalAlignment="Left"
                          VerticalContentAlignment="Center"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}" />
            </Grid>

            <Grid ColumnDefinitions="Auto,8,*">
                <RadioButton Grid.Column="0" x:Name="CalendarRadio" GroupName="trigger"
                             Content="К событию в" VerticalAlignment="Center" />
                <ComboBox Grid.Column="2" x:Name="CalendarCombo"
                          Height="30"
                          HorizontalAlignment="Stretch"
                          VerticalContentAlignment="Center"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}" />
            </Grid>

            <!-- Упреждение — тем же приемом, что время тишины: уточнение, а не вид триггера. -->
            <Grid ColumnDefinitions="Auto,8,*" Margin="24,0,0,0">
                <TextBlock Grid.Column="0" x:Name="LeadLabel"
                           Text="когда" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox Grid.Column="2" x:Name="LeadCombo"
                          Height="30"
                          MinWidth="160"
                          HorizontalAlignment="Left"
                          VerticalContentAlignment="Center"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}" />
            </Grid>

            <!-- «По событию потока» — сторонняя программа сама сообщила о случившемся. Поток
                 заводят на вкладке «Потоки»; здесь только выбор из заведенных. -->
            <Grid ColumnDefinitions="Auto,8,*">
                <RadioButton Grid.Column="0" x:Name="StreamRadio" GroupName="trigger"
                             Content="По событию потока" VerticalAlignment="Center" />
                <ComboBox Grid.Column="2" x:Name="StreamCombo"
                          Height="30"
                          HorizontalAlignment="Stretch"
                          VerticalContentAlignment="Center"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}" />
            </Grid>

            <!-- Ответ на событие — уточнения к потоку, тем же приемом, что время тишины. Ответ
                 уходит по итогу ВСЕГО сценария, поэтому он здесь, а не шагом в списке: шаг после
                 неудавшегося не выполнился бы, а ответить надо как раз тогда. -->
            <Grid ColumnDefinitions="Auto,8,*" Margin="24,0,0,0">
                <TextBlock Grid.Column="0" x:Name="ReplyLabel"
                           Text="ответить запросом" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <ComboBox Grid.Column="2" x:Name="ReplyCombo"
                          Height="30"
                          HorizontalAlignment="Stretch"
                          VerticalContentAlignment="Center"
                          Background="{StaticResource BrushSecondaryBg}"
                          CornerRadius="{StaticResource RadiusBase}" />
            </Grid>

            <Grid ColumnDefinitions="Auto,8,*" Margin="24,0,0,0">
                <TextBlock Grid.Column="0" x:Name="FailLabel"
                           Text="при сбое ответить" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <TextBox Grid.Column="2" x:Name="FailBox"
                         Height="30"
                         VerticalContentAlignment="Center"
                         Watermark="пусто — при сбое не отвечать"
                         CornerRadius="{StaticResource RadiusBase}" />
            </Grid>

        </StackPanel>

        <!-- ── Что делать ───────────────────────────────────────────────────── -->

        <TextBlock Text="Что делать"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <TextBlock Text="Шаги идут по порядку. Первый неудавшийся останавливает сценарий: следующий работал бы с данными, которых не пришло."
                   Margin="0,0,0,6"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{StaticResource BrushSecondaryText}" />

    </StackPanel>

        <!-- Полоса идет во всю высоту блока, а воздух висит на содержимом ВНУТРИ прокрутки
             (docs/developer/ui/scrolling.md) — иначе она отходит от рамки. -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="{DynamicResource BorderLine}"
                CornerRadius="{StaticResource RadiusBase}"
                ClipToBounds="True"
                Margin="0,0,0,8"
                Padding="0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="StepsPanel" Spacing="6" Margin="10,8" />
            </ScrollViewer>
        </Border>

    <StackPanel Grid.Row="2" Spacing="0">

        <!-- Кнопок много, и в одну строку они не помещаются: WrapPanel переносит сам, а
             подпись «+» делает их кнопками добавления, а не отбора. -->
        <WrapPanel Margin="0,0,0,4">
            <Button x:Name="AddRequestBtn" Content="+ Запрос"          Height="30" Padding="12,0" Margin="0,0,8,8" />
            <Button x:Name="AddActionBtn"  Content="+ Действие"        Height="30" Padding="12,0" Margin="0,0,8,8" />
            <Button x:Name="AddIntakeBtn"  Content="+ Файл из папки"   Height="30" Padding="12,0" Margin="0,0,8,8" />
            <Button x:Name="AddFilterBtn"  Content="+ Отбор"           Height="30" Padding="12,0" Margin="0,0,8,8" />
            <Button x:Name="AddComputeBtn" Content="+ Преобразовать"   Height="30" Padding="12,0" Margin="0,0,8,8" />
            <Button x:Name="AddRecordBtn"  Content="+ Создать запись"  Height="30" Padding="12,0" Margin="0,0,8,8" />
            <Button x:Name="AddExportBtn"  Content="+ Экспорт выборки" Height="30" Padding="12,0" Margin="0,0,8,8" />
            <Button x:Name="AddNoticeBtn"  Content="+ Сообщение"       Height="30" Padding="12,0" Margin="0,0,8,8" />
        </WrapPanel>

        <!-- ── Включен ──────────────────────────────────────────────────────── -->

        <TextBlock Text="Ходит сам"
                   Margin="0,0,0,6"
                   FontWeight="{StaticResource FontWeightBold}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <ToggleSwitch x:Name="EnabledSwitch" Margin="0,0,0,4" />

        <TextBlock x:Name="EnabledHint"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource FontSizeSmall}"
                   Foreground="{StaticResource BrushSecondaryText}" />

        <w:NoticeBanner x:Name="NoticeBanner" Margin="0,0,0,12" />

        <Grid ColumnDefinitions="*,Auto,8,Auto" Margin="0,4,0,0">
            <Button Grid.Column="1" x:Name="CancelBtn" Classes="dialog" Content="Отмена" />
            <Button Grid.Column="3" x:Name="SaveBtn"   Classes="dialog" Content="Сохранить" />
        </Grid>

    </StackPanel>

    </Grid>

</Window>
