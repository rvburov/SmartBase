<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      Два таргета. Базовый net10.0 — macOS, Linux, тесты и утилиты (Tests/* ссылаются на
      проект и собираются под него). Windows-таргет net10.0-windows10.0.17763 нужен ровно
      ради нативных тостов: только под ним NuGet отдает WinRT-ассеты DesktopNotifications.
      Windows (lib/net6.0-windows10.0.17763) и Microsoft.Toolkit.Uwp.Notifications
      (lib/net5.0-windows10.0.17763). Под голым net10.0 подтягивались сборки БЕЗ WinRT, и
      менеджер уведомлений падал с TypeLoadException (ToastNotificationManagerCompat не
      найден) — баннеры на Windows молча не показывались. Windows собирать только вторым
      таргетом: Scripts/windows-build.sh передает -f.
    -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.17763</TargetFrameworks>
    <!-- Разрешает собирать Windows-таргет на macOS/Linux (ref-паки тянутся с nuget). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SmartBase</RootNamespace>
    <AssemblyName>SmartBase</AssemblyName>
    <Version>1.2.0</Version>
    <!-- Нужно для делегата-колбэка macOS-уведомлений (указатели на unmanaged-функции). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Иконка, вшиваемая в Windows .exe (проводник, ярлык, закреп в таскбаре).
         Учитывается только при сборке под Windows; на других ОС игнорируется. -->
    <ApplicationIcon>Assets\Branding\icon.ico</ApplicationIcon>
    <!--
      При публикации в один файл (-p:PublishSingleFile=true) вшивать нативные
      библиотеки (SkiaSharp, HarfBuzz, SQLite) в .exe и распаковывать их при
      запуске. Без этого Skia не грузится из бандла → DllNotFoundException и
      приложение падает на старте. На обычные сборки свойство не влияет.
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!--
      AVLN3001 «XAML resource won't be reachable via runtime loader, as no public constructor
      was found» — 14 окон и диалогов. Предупреждение о том, что их нельзя создать
      рантайм-загрузчиком XAML по строке avares://.

      У всех окон конструкторы с параметрами намеренно: окно без репозитория, без коллекции
      или без Workspace — это наполовину собранный объект, который потом падает в неожиданном
      месте. Публичный конструктор без аргументов пришлось бы заводить ровно ради того, чтобы
      его никто не вызывал.

      Рантайм-загрузчиком проект не пользуется: App.Initialize зовет перегрузку
      AvaloniaXamlLoader.Load(this) (скомпилированный XAML), а единственный avares://-адрес
      в коде указывает на иконку, а не на разметку. Предупреждение неприменимо целиком.
    -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia"                        Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop"               Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent"         Version="11.2.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid"     Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter"           Version="11.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm"          Version="8.3.2"  />
    <PackageReference Include="Microsoft.EntityFrameworkCore"  Version="9.0.1"  />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.1" />
    <!-- Разбор markdown. ЕДИНСТВЕННЫЙ парсер разметки в приложении: на нем и живое оформление
         в редакторе заметок, и показ готового текста (Controls/Markup — рендер свой). Готового
         движка показа больше нет: Markdown.Avalonia приносил второй парсер со своим набором
         разметки, и «Просмотр» неизбежно расходился с «Динамическим просмотром». -->
    <PackageReference Include="Markdig"                          Version="0.37.0" />
    <!-- Редактор с посимвольным оформлением (раздел «Заметки», живой markdown): у TextBox
         начертание одно на все поле, жирным можно сделать либо весь текст, либо ничего.
         Версия не ниже 11.1: в 11.0.0 приложение падает при потере фокуса редактором —
         TextAreaTextInputMethodClient.Selection не проверяет, что TextArea уже отцеплен, а
         Avalonia 11.2 спрашивает его в этот самый момент (SetTextArea(null) →
         RaiseSurroundingTextChanged → NRE). Берем 11.2.0 — под ту же линию, что и сама
         Avalonia. Сторожит номер версии Tests/Unit/EditorPackagePinTests. -->
    <PackageReference Include="Avalonia.AvaloniaEdit"            Version="11.2.0" />
    <PackageReference Include="ClosedXML"                        Version="0.104.2" />
    <!-- Разбор ссылок Excel напрямую (Extensions/ExcelBook: проверка определенных имен
         и ловля ParsingException по типу). Версия — та же, что транзитивно тянет ClosedXML;
         пин явный, т.к. используем пакет напрямую. -->
    <PackageReference Include="ClosedXML.Parser"                 Version="1.2.0" />
    <!-- Стриминговая ЗАПИСЬ .xlsx/.xlsm (экспорт, OpenXmlWriter/SAX). Версия — та же,
         что транзитивно тянет ClosedXML; пин явный, т.к. используем SDK напрямую. -->
    <PackageReference Include="DocumentFormat.OpenXml"           Version="3.1.1" />
    <PackageReference Include="ExcelDataReader"                  Version="3.7.0" />
    <PackageReference Include="PdfPig"                          Version="0.1.15" />
    <!-- Наложение знака на ГОТОВЫЙ PDF (Extensions/PdfWatermark): открывает документ и
         дописывает надпись в поток страницы, не пересобирая ее содержимое. PdfPig, которым
         «Анализ PDF файлов» читает документы, для этого не годится — его писатель собирает
         документ заново постранично. Шрифт знака (PT Sans) отдается своим IFontResolver,
         см. Extensions/PdfWatermark/WatermarkFont.cs. -->
    <PackageReference Include="PDFsharp"                         Version="6.2.4" />
    <!-- Растеризация страниц PDF (Extensions/PdfWatermark): знак ВПЕЧАТЫВАЕТСЯ в пиксели,
         иначе он снимается редактором за одну операцию — слой поверх страницы стирается
         выбрасыванием последнего потока /Contents. Docnet.Core, а не PDFtoImage: тот требует
         SkiaSharp 4.x, а Avalonia.Skia 11.2.3 жестко держит 2.88.9 — приложение бы не собралось.
         У Docnet.Core транзитивных зависимостей нет вовсе, внутри тот же PDFium. -->
    <PackageReference Include="Docnet.Core"                      Version="2.6.0" />
    <!-- Рисование знака по пикселям страницы. Пакет и так приезжает транзитивно с
         Avalonia.Skia; пин явный, т.к. используем его напрямую, и версия обязана совпадать
         с той, под которую собрана Avalonia. -->
    <PackageReference Include="SkiaSharp"                        Version="2.88.9" />
    <!-- Диагностическое логирование в отдельную базу logs.db (Serilog + SQLite-приемник).
         Sinks.SQLite тянет Microsoft.Data.Sqlite, но версия унифицируется вверх до 9.0.1
         (уже в проекте через EF Core) — нативный SQLite один на все приложение. -->
    <PackageReference Include="Serilog"                          Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.SQLite"             Version="7.0.0" />
    <!-- Нативные уведомления с колбэком клика и иконкой приложения для Windows и Linux
         (бэкенды netstandard2.0). macOS реализован своим кодом — Apple-бэкенд библиотеки
         нефункционален (заглушка). Пакет .Avalonia НЕ подключаем: он завязан на Avalonia
         0.10, у нас 11.2.3 — менеджеры создаем вручную (Program.BuildAvaloniaApp). -->
    <PackageReference Include="DesktopNotifications"             Version="1.3.1" />
    <PackageReference Include="DesktopNotifications.Windows"     Version="1.3.1" />
    <PackageReference Include="DesktopNotifications.FreeDesktop" Version="1.3.1" />
  </ItemGroup>

  <!--
    Пины транзитивных зависимостей с известными уязвимостями. Сами по себе в коде не
    используются — прямая ссылка нужна ровно затем, чтобы поднять версию, которую тянет
    кто-то другой: NuGet берет наибольшую из затребованных.

    Проверять актуальность: «dotnet list package» с ключами vulnerable и include-transitive
    (два дефиса подряд в XML-комментарий вписать нельзя). Когда зависимость обновится сама —
    например, выйдет Avalonia с новым Tmds.DBus.Protocol, — строку отсюда надо убрать,
    а не оставлять навечно.
  -->
  <ItemGroup>
    <!-- CVE-2025-6965, SQLite до 3.50.2: повреждение памяти. Тянут EF Core Sqlite и
         Serilog.Sinks.SQLite. Уязвимы версии по 2.1.11 включительно. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <!-- CVE-2021-24112, удаленное выполнение кода при разборе графики. Тянет
         Microsoft.Toolkit.Uwp.Notifications (только Windows-таргет). Уязвимы 4.0.0–4.7.1. -->
    <PackageReference Include="System.Drawing.Common" Version="4.7.2" />
    <!-- GHSA-xrw6-gwf8-vvr9: подмена сигналов D-Bus и исчерпание дескрипторов.
         Protocol тянет Avalonia.FreeDesktop, сам Tmds.DBus — DesktopNotifications.FreeDesktop.
         Для Protocol достаточно 0.21.3, для Tmds.DBus исправления есть только с 0.92.0. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="Tmds.DBus" Version="0.92.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- В сборку попадают только те файлы бренда, что читаются в работе программы:
         icon.ico (иконка окна и значка в трее) и icon-linux.png (иконка ярлыка .desktop,
         см. InstallService.ExtractIcon). Остальное нужно лишь сборочным скриптам, и они
         берут файлы с диска, а не из ресурсов, — вшивать их значит носить лишние ~1.6 МБ
         в бинаре каждой платформы. -->
    <AvaloniaResource Remove="Assets\Branding\icon-windows.png" />
    <AvaloniaResource Remove="Assets\Branding\icon-macos.png" />
    <AvaloniaResource Remove="Assets\Branding\icon.icns" />
    <AvaloniaResource Remove="Assets\Branding\Info.plist" />
    <AvaloniaResource Remove="Assets\Branding\SmartBase.desktop" />
    <!-- Инструкция пользователя показывается прямо в настройках (раздел «Инструкция
         пользователя»), а редактируется как обычные markdown-файлы в docs/user — они же
         читаются на GitHub. Копии в Assets нет намеренно: две копии разъехались бы. -->
    <AvaloniaResource Include="docs\user\**\*.md" />
  </ItemGroup>

  <!-- Файлы данных расширений: расширению бывает нужен собственный справочник, который не
       читается с диска (у пользователя его нет) и не помещается в код — например
       классификатор ЕСКД у «Регистрации КД». Такие файлы кладутся в папку расширения
       сжатыми и попадают в сборку встроенным ресурсом.

       Правило — ГЛОБ, а не перечисление: заведение и удаление расширения должны оставаться
       операцией над одной папкой, и этот файл при них не правится (см.
       docs/developer/features/extensions.md, «Как добавить / удалить расширение»).
       Имя ресурса собирается из RootNamespace и пути файла — потребители ищут его по
       окончанию имени, а не по полному. -->
  <ItemGroup>
    <EmbeddedResource Include="Extensions\**\*.gz" />
  </ItemGroup>

  <!-- Tests/ — отдельный проект-генератор стенда (Tests/DbGenerator), в приложение не входит -->
  <ItemGroup>
    <Compile    Remove="Tests\**" />
    <AvaloniaXaml Remove="Tests\**" />
    <AvaloniaResource Remove="Tests\**" />
    <None       Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
  </ItemGroup>

  <!-- packages/ — локальный кэш NuGet внутри репозитория (см. nuget.config). Пакеты
       вроде Microsoft.NET.Test.Sdk несут .cs-файлы в build/, которые иначе попадают
       в default-глоб «**/*.cs» этого проекта и ломают сборку. Исключаем как Tests\**. -->
  <ItemGroup>
    <Compile    Remove="packages\**" />
    <AvaloniaXaml Remove="packages\**" />
    <AvaloniaResource Remove="packages\**" />
    <None       Remove="packages\**" />
    <EmbeddedResource Remove="packages\**" />
  </ItemGroup>

</Project>
