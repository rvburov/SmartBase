<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="using:System"
        xmlns:registry="using:SmartBase.Extensions.DocRegistry"
        x:Class="SmartBase.Extensions.DocRegistry.DocRegistryWindow"
        Title="Регистрация КД"
        Width="720" Height="820"
        MinWidth="620" MinHeight="660"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBg}">

    <DockPanel Margin="24">

        <!-- Верх: как регистрируем, кто регистрирует, что за обозначение и как называется документ -->
        <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="0,0,0,10">

            <!-- Способ регистрации и файл со списком номеров — в одном ряду: поле со ссылкой и
                 «Обзор» относятся ко второму пункту списка и в ручном режиме недоступны. В
                 режиме файла наоборот гаснет все окно ниже — значения берутся из файла. -->
            <Grid ColumnDefinitions="290,10,*,10,Auto" VerticalAlignment="Center">
                <ComboBox Grid.Column="0" x:Name="ModeCombo"
                          Height="30" HorizontalAlignment="Stretch"
                          SelectionChanged="OnModeChanged" />
                <TextBox Grid.Column="2" x:Name="FileBox"
                         VerticalContentAlignment="Center"
                         Watermark="Путь к файлу со списком номеров КД"
                         TextChanged="OnFilePathChanged" />
                <Button Grid.Column="4" x:Name="BrowseBtn"
                        Classes="dialog"
                        Content="Обзор"
                        Click="OnBrowseClick" />
            </Grid>

            <StackPanel Spacing="6">
                <TextBlock Text="ФИО регистрирующего"
                           FontWeight="{StaticResource FontWeightBold}" />
                <TextBox x:Name="FioBox"
                         VerticalContentAlignment="Center"
                         Watermark="Иванов Иван Иванович"
                         TextChanged="OnFormChanged" />
            </StackPanel>

            <!-- Обозначение собрано из своих частей в один ряд и с теми же разделителями, что и
                 в готовом номере: строка читается как «АБВГ.301121.012-01». Номер выдает само
                 расширение — поле недоступно; исполнение выбирает человек. -->
            <StackPanel Spacing="6">
                <TextBlock Text="Обозначение"
                           FontWeight="{StaticResource FontWeightBold}" />
                <!-- Точки стоят по НИЖНЕЙ линии полей: точка сидит на строке, и по центру она
                     выглядела бы висящей. Дефис перед исполнением — наоборот, по середине и
                     ОБЫЧНОГО начертания: полужирным он превращался в жирную черту, а нужен
                     такой же знак, как в обычном тексте. -->
                <Grid ColumnDefinitions="150,10,*,10,150,10,110" VerticalAlignment="Center">
                    <ComboBox Grid.Column="0" x:Name="OrgCombo"
                              Height="30" HorizontalAlignment="Stretch"
                              SelectionChanged="OnTargetChanged" />
                    <TextBlock Grid.Column="1" Text="." VerticalAlignment="Bottom"
                               HorizontalAlignment="Center"
                               FontWeight="{StaticResource FontWeightBold}" />
                    <TextBox Grid.Column="2" x:Name="EskdBox"
                             VerticalContentAlignment="Center"
                             Watermark="Код ЕСКД"
                             TextChanged="OnEskdTextChanged"
                             KeyDown="OnEskdKeyDown" />
                    <TextBlock Grid.Column="3" Text="." VerticalAlignment="Bottom"
                               HorizontalAlignment="Center"
                               FontWeight="{StaticResource FontWeightBold}" />
                    <!-- Номер ВЫБИРАЮТ, а не вводят: список показывает свободный номер и все
                         выданные, разложенные по двум группам. В закрытом поле стоит только сам
                         номер, поэтому ряд по-прежнему читается как готовое обозначение;
                         заголовки групп живут в списке и выбраться не могут (IsEnabled). -->
                    <ComboBox Grid.Column="4" x:Name="NumberCombo"
                              Height="30" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center"
                              PlaceholderText="номер"
                              PlaceholderForeground="{StaticResource BrushSecondaryText}"
                              SelectionChanged="OnNumberChanged">
                        <ComboBox.Styles>
                            <Style Selector="ComboBoxItem" x:DataType="registry:NumberOption">
                                <Setter Property="IsEnabled" Value="{Binding !IsHeader}" />
                            </Style>
                        </ComboBox.Styles>
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="registry:NumberOption">
                                <Panel>
                                    <TextBlock Text="{Binding Text}" IsVisible="{Binding !IsHeader}" />
                                    <TextBlock Text="{Binding Text}" IsVisible="{Binding IsHeader}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               FontWeight="{StaticResource FontWeightBold}"
                                               Foreground="{StaticResource BrushSecondaryText}" />
                                </Panel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!-- Дефис — тот же знак, что и в самом обозначении: «АБВГ.301121.012-01».
                         Ряд читается как готовый номер, поэтому разделитель тут не украшение. -->
                    <TextBlock Grid.Column="5" Text="-" VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="{DynamicResource FontSizeMedium}" />
                    <!-- Исполнение не выбирают из девяноста девяти: у выбранного номера свободно
                         только следующее, оно одно в списке и стоит сразу. Выбран новый номер —
                         поле недоступно и пусто: у нового документа исполнения не бывает. -->
                    <ComboBox Grid.Column="6" x:Name="ExecutionCombo"
                              Height="30" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Наименование ЕСКД"
                           FontWeight="{StaticResource FontWeightBold}" />
                <TextBox x:Name="NameBox"
                         VerticalContentAlignment="Center"
                         Watermark="Подставится по выбранному коду — можно поправить"
                         TextChanged="OnFormChanged" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Классификатор ЕСКД"
                           FontWeight="{StaticResource FontWeightBold}" />
                <TextBlock x:Name="SuggestHint" Text=""
                           FontSize="{DynamicResource FontSizeSmall}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource BrushSecondaryText}" />
            </StackPanel>

        </StackPanel>

        <!-- Низ: чем заполнена строка журнала, куда она пишется и что получится -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="14" Margin="0,10,0,0">

            <Grid ColumnDefinitions="*,14,*" RowDefinitions="Auto,10,Auto,10,Auto">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                    <TextBlock Text="Проект"
                               FontWeight="{StaticResource FontWeightBold}" />
                    <TextBox x:Name="ProjectBox" VerticalContentAlignment="Center"
                             Watermark="Обязательно"
                             TextChanged="OnFormChanged" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="6">
                    <TextBlock Text="Отметка учета" Foreground="{StaticResource BrushSecondaryText}" />
                    <TextBox x:Name="AccountingBox" VerticalContentAlignment="Center"
                             Watermark="Необязательно" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
                    <TextBlock Text="Примечание (первичное применение)"
                               Foreground="{StaticResource BrushSecondaryText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBox x:Name="FirstUseBox" VerticalContentAlignment="Center"
                             Watermark="Необязательно" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Spacing="6">
                    <TextBlock Text="Примечание (краткая характеристика)"
                               Foreground="{StaticResource BrushSecondaryText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBox x:Name="SummaryBox" VerticalContentAlignment="Center"
                             Watermark="Необязательно" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="0" Spacing="6">
                    <TextBlock Text="База данных"
                               FontWeight="{StaticResource FontWeightBold}" />
                    <ComboBox x:Name="DbCombo" Height="30" HorizontalAlignment="Stretch"
                              SelectionChanged="OnDbChanged" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="2" Spacing="6">
                    <TextBlock Text="Коллекция"
                               FontWeight="{StaticResource FontWeightBold}" />
                    <ComboBox x:Name="CollectionCombo" Height="30" HorizontalAlignment="Stretch"
                              SelectionChanged="OnCollectionChanged" />
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource BrushSecondaryBg}"
                    BorderBrush="{StaticResource BrushSeparator}"
                    BorderThickness="{DynamicResource BorderLine}"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Padding="12,10">
                <TextBlock x:Name="StatusText"
                           Text="Готов к работе"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
            </Border>

            <Grid ColumnDefinitions="*,10,*">
                <Button Grid.Column="0" x:Name="RegisterBtn"
                        Classes="dialog"
                        Width="NaN" Height="36"
                        HorizontalAlignment="Stretch"
                        IsEnabled="False"
                        Content="Зарегистрировать"
                        Click="OnRegisterClick" />
                <Button Grid.Column="2" x:Name="CloseBtn"
                        Classes="dialog"
                        Width="NaN" Height="36"
                        HorizontalAlignment="Stretch"
                        Content="Закрыть"
                        Click="OnCloseClick" />
            </Grid>

        </StackPanel>

        <!-- Середина: классификатор занимает всю оставшуюся высоту. Открыт на классах, дальше
             вглубь — щелчком по строке или вводом цифр кода.

             Рамка и список собраны один в один как в окне «Отображение записей»
             (Controls/Dialogs/RecordDisplayDialog.axaml): Padding=0 и ClipToBounds у рамки,
             нулевые отступы у строк — выделение идет во всю ширину до линии рамки и обрезается
             по ее скруглению, а полоса прокрутки встает вплотную к рамке, а не висит в отступе. -->
        <Border BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="{DynamicResource BorderLine}"
                CornerRadius="{StaticResource RadiusBase}"
                ClipToBounds="True"
                MinHeight="120"
                Padding="0">
            <Panel>
                <TextBlock x:Name="SuggestEmpty"
                           Text="Справочник ЕСКД загружается…"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource BrushSecondaryText}" />
                <!-- Виртуализирующий список: рендерятся только видимые строки. В дереве их и так
                     немного, но поиск по слову выдает плоский перечень на тысячи строк. -->
                <ListBox x:Name="SuggestList"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         IsVisible="False"
                         Tapped="OnSuggestTapped">
                    <ListBox.Styles>
                        <Style Selector="ListBox#SuggestList ListBoxItem">
                            <Setter Property="Padding"   Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                        <Style Selector="ListBox#SuggestList ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource BrushSecondaryBg}" />
                        </Style>
                        <Style Selector="ListBox#SuggestList ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource BrushAccentLight}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="registry:EskdEntry">
                            <!-- Отступы строки задает содержимое, а не ListBoxItem: тогда
                                 подсветка занимает всю ширину, а текст все равно не липнет
                                 к краю (тот же прием, что в «Отображении записей»). -->
                            <Grid ColumnDefinitions="86,*" Margin="10,7">
                                <!-- Код и точки до шести знаков: точками показан уровень, как в
                                     исходной таблице классификатора. Есть точки — строка
                                     раскрывается; нет точек (шесть цифр) — строку можно
                                     зафиксировать. Отдельный значок для этого не нужен. -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Code}"
                                               FontWeight="{StaticResource FontWeightBold}" />
                                    <TextBlock Text="{Binding Dots}" Margin="4,0,0,0"
                                               Foreground="{StaticResource BrushSecondaryText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- Разбор файла со списком номеров занимает ту же рамку: в режиме файла
                     классификатор не нужен (код ЕСКД уже стоит в обозначении), а вот список
                     ошибок с номерами строк нужен целиком и сразу. -->
                <!-- Воздух — на содержимом ВНУТРИ прокрутки, а не на самом ScrollViewer: иначе
                     полоса отходит от края рамки, а сверху и снизу остаются мертвые зазоры
                     (docs/developer/ui/scrolling.md). -->
                <ScrollViewer x:Name="FileReport" IsVisible="False">
                    <ItemsControl x:Name="FileList" Margin="10,7">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>
        </Border>

    </DockPanel>

</Window>
