<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="using:SmartBase.Controls.Components"
        x:Class="SmartBase.Extensions.ProductCompare.ProductCompareWindow"
        Title="Сравнение составов изделий"
        Width="520" MinWidth="520" MaxWidth="520"
        MinHeight="0"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBg}">

    <StackPanel Margin="24" Spacing="14">

        <!-- Режим: от него зависят блоки 1–3 и журнал. У заключения — шаблон, старый и новый
             файлы; у расшифровки — свой шаблон и папка с расшифровками. -->
        <StackPanel Spacing="6">
            <TextBlock Text="Режим"
                       FontWeight="{StaticResource FontWeightBold}" />
            <ComboBox x:Name="ModeCombo" Height="30" HorizontalAlignment="Stretch"
                      SelectionChanged="OnModeChanged" />
        </StackPanel>

        <!-- 1. Файл-шаблон (у каждого режима свой) -->
        <StackPanel Spacing="6">
            <TextBlock x:Name="TemplateLabel"
                       Text="1. Файл-шаблон заключения (.xlsm)"
                       FontWeight="{StaticResource FontWeightBold}"
 />
            <Grid ColumnDefinitions="*,10,Auto">
                <TextBox Grid.Column="0" x:Name="TemplateBox"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Watermark="Файл не выбран" />
                <Button Grid.Column="2" x:Name="TemplateBtn"
                        Classes="dialog"
                        Content="Обзор"
                        Click="OnBrowseTemplate" />
            </Grid>
        </StackPanel>

        <!-- 2. Старый файл (заключение) -->
        <StackPanel x:Name="OldPanel" Spacing="6">
            <TextBlock Text="2. Старый файл (.xlsx / .xlsm)"
                       FontWeight="{StaticResource FontWeightBold}"
 />
            <Grid ColumnDefinitions="*,10,Auto">
                <TextBox Grid.Column="0" x:Name="OldBox"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Watermark="Файл не выбран" />
                <Button Grid.Column="2" x:Name="OldBtn"
                        Classes="dialog"
                        Content="Обзор"
                        Click="OnBrowseOld" />
            </Grid>
        </StackPanel>

        <!-- 3. Новый файл (заключение) -->
        <StackPanel x:Name="NewPanel" Spacing="6">
            <TextBlock Text="3. Новый файл (.xlsx / .xlsm)"
                       FontWeight="{StaticResource FontWeightBold}"
 />
            <Grid ColumnDefinitions="*,10,Auto">
                <TextBox Grid.Column="0" x:Name="NewBox"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Watermark="Файл не выбран" />
                <Button Grid.Column="2" x:Name="NewBtn"
                        Classes="dialog"
                        Content="Обзор"
                        Click="OnBrowseNew" />
            </Grid>
        </StackPanel>

        <!-- 2. Папка с расшифровками (расшифровка) -->
        <StackPanel x:Name="FolderPanel" Spacing="6" IsVisible="False">
            <TextBlock Text="2. Папка с расшифровками (файлы «Проект_ГГГГ.ММ.ДД_ФИО»)"
                       TextWrapping="Wrap"
                       FontWeight="{StaticResource FontWeightBold}"
 />
            <Grid ColumnDefinitions="*,10,Auto">
                <TextBox Grid.Column="0" x:Name="FolderBox"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Watermark="Папка не выбрана" />
                <Button Grid.Column="2" x:Name="FolderBtn"
                        Classes="dialog"
                        Content="Обзор"
                        Click="OnBrowseFolder" />
            </Grid>
        </StackPanel>

        <!-- Папка для сохранения (номер подписи — по режиму) -->
        <StackPanel Spacing="6">
            <TextBlock x:Name="OutputLabel"
                       Text="4. Папка для сохранения результата"
                       FontWeight="{StaticResource FontWeightBold}"
 />
            <Grid ColumnDefinitions="*,10,Auto">
                <TextBox Grid.Column="0" x:Name="OutputBox"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Watermark="Папка не выбрана" />
                <Button Grid.Column="2" x:Name="OutputBtn"
                        Classes="dialog"
                        Content="Обзор"
                        Click="OnBrowseOutput" />
            </Grid>
        </StackPanel>

        <!-- Статус -->
        <Border Background="{StaticResource BrushSecondaryBg}"
                BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="{DynamicResource BorderLine}"
                CornerRadius="{StaticResource RadiusMedium}"
                Padding="12,10">
            <TextBlock x:Name="StatusText"
                       Text="Готов к работе"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushSecondaryText}" />
        </Border>

        <!-- Прогресс: единый индикатор загрузки приложения -->
        <components:ProgressIndicator x:Name="Progress" />

        <!-- Запуск -->
        <Button x:Name="ExecuteBtn"
                Classes="dialog"
                Width="NaN" Height="36"
                HorizontalAlignment="Stretch"
                IsEnabled="False"
                Content="Запустить"
                Click="OnExecuteClick" />

        <!-- Журнал (расшифровка): найденные файлы, порядок дат, ход работы и причины отказа.
             Класс multiline (Controls.axaml): полоса прокрутки во всю высоту поля. -->
        <StackPanel x:Name="LogPanel" Spacing="8" IsVisible="False">
            <TextBlock Text="Журнал:"
                       FontWeight="{StaticResource FontWeightBold}" />
            <TextBox x:Name="LogBox"
                     Classes="multiline"
                     Height="220"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontFamily="{StaticResource FontFamilyBase}"
                     FontSize="{DynamicResource FontSizeSmall}" />
        </StackPanel>

    </StackPanel>

</Window>
