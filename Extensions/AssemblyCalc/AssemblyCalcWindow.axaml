<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="using:DataBase.Controls.Components"
        x:Class="DataBase.Extensions.AssemblyCalc.AssemblyCalcWindow"
        Title="Расчёт сборочных единиц в изделии"
        Width="560" MinWidth="560" MaxWidth="560"
        MinHeight="0"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBg}">

    <StackPanel Margin="24" Spacing="14">

        <!-- 1. Исходный файл -->
        <StackPanel Spacing="6">
            <TextBlock Text="1. Исходный файл «Список КД и ТД» (.xlsx / .xlsm)"
                       FontWeight="{StaticResource FontWeightBold}"
 />
            <Grid ColumnDefinitions="*,10,Auto">
                <TextBox Grid.Column="0" x:Name="SourceBox"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Watermark="Файл не выбран" />
                <Button Grid.Column="2" x:Name="SourceBtn"
                        Classes="dialog"
                        Content="Обзор"
                        Click="OnBrowseSource" />
            </Grid>
        </StackPanel>

        <!-- 2. Файл-шаблон -->
        <StackPanel Spacing="6">
            <TextBlock Text="2. Файл-шаблон «Расчёт сборочных единиц» (.xlsm)"
                       FontWeight="{StaticResource FontWeightBold}"
 />
            <Grid ColumnDefinitions="*,10,Auto">
                <TextBox Grid.Column="0" x:Name="TemplateBox"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Watermark="Файл не выбран" />
                <Button Grid.Column="2" x:Name="TemplateBtn"
                        Classes="dialog"
                        Content="Обзор"
                        Click="OnBrowseTemplate" />
            </Grid>
        </StackPanel>

        <!-- 3. Папка для сохранения -->
        <StackPanel Spacing="6">
            <TextBlock Text="3. Папка для сохранения результата"
                       FontWeight="{StaticResource FontWeightBold}"
 />
            <Grid ColumnDefinitions="*,10,Auto">
                <TextBox Grid.Column="0" x:Name="OutputBox"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Watermark="Папка не выбрана" />
                <Button Grid.Column="2" x:Name="OutputBtn"
                        Classes="dialog"
                        Content="Обзор"
                        Click="OnBrowseOutput" />
            </Grid>
        </StackPanel>

        <!-- Статус -->
        <Border Background="{StaticResource BrushSecondaryBg}"
                BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="{DynamicResource BorderLine}"
                CornerRadius="{StaticResource RadiusMedium}"
                Padding="12,10">
            <TextBlock x:Name="StatusText"
                       Text="Готов к работе"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       FontWeight="{StaticResource FontWeightBold}"
                       Foreground="{StaticResource BrushSecondaryText}" />
        </Border>

        <!-- Прогресс: единый индикатор загрузки приложения -->
        <components:ProgressIndicator x:Name="Progress" />

        <!-- Запуск -->
        <Button x:Name="ExecuteBtn"
                Classes="dialog"
                Width="NaN" Height="36"
                HorizontalAlignment="Stretch"
                IsEnabled="False"
                Content="Запустить"
                Click="OnExecuteClick" />

    </StackPanel>

</Window>
