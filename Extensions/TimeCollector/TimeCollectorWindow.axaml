<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="using:SmartBase.Controls.Components"
        x:Class="SmartBase.Extensions.TimeCollector.TimeCollectorWindow"
        Title="Сводная трудоемкость"
        Width="720" Height="760"
        MinWidth="560" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBg}">

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="0,0,0,14">

            <!-- Куда выгрузить: файл Excel или коллекция программы. От выбора зависят
                 блоки 2 и 3 — шаблон с папкой результата либо база с именем коллекции. -->
            <StackPanel Spacing="6">
                <TextBlock Text="Куда выгрузить"
                           FontWeight="{StaticResource FontWeightBold}" />
                <ComboBox x:Name="ModeCombo" Height="30" HorizontalAlignment="Stretch"
                          SelectionChanged="OnModeChanged" />
            </StackPanel>

            <!-- 1. Папка с расчетами -->
            <StackPanel Spacing="6">
                <TextBlock Text="1. Папка с расчетами (файлы «Проект_ГГГГ.ММ.ДД_ФИО.xlsm»)"
                           FontWeight="{StaticResource FontWeightBold}" />
                <Grid ColumnDefinitions="*,10,Auto">
                    <TextBox Grid.Column="0" x:Name="FolderBox"
                             VerticalContentAlignment="Center"
                             Watermark="Выберите папку с расчетами…"
                             TextChanged="OnPathChanged" />
                    <Button Grid.Column="2" x:Name="FolderBtn"
                            Classes="dialog" Content="Обзор…" Click="OnBrowseFolder" />
                </Grid>
            </StackPanel>

            <CheckBox x:Name="RecursiveCheck" IsChecked="False"
                      Content="Рекурсивный поиск (включая все подпапки)" />

            <CheckBox x:Name="FixTextCheck" IsChecked="True"
                      Content="Приводить текст к одному алфавиту (исправлять буквы из чужой раскладки)"
                      ToolTip.Tip="Русское слово приводится к кириллице, английское — к латинице.&#10;Двуязычные наименования не страдают: решение принимается по каждому слову отдельно.&#10;Что исправлено — в журнале." />

            <!-- 2. Файл-шаблон (выгрузка в Excel) -->
            <StackPanel x:Name="TemplatePanel" Spacing="6">
                <TextBlock Text="2. Файл-шаблон с листом «Таблица» (.xlsm)"
                           FontWeight="{StaticResource FontWeightBold}" />
                <Grid ColumnDefinitions="*,10,Auto">
                    <TextBox Grid.Column="0" x:Name="TemplateBox"
                             VerticalContentAlignment="Center"
                             Watermark="Файл не выбран"
                             TextChanged="OnPathChanged" />
                    <Button Grid.Column="2" x:Name="TemplateBtn"
                            Classes="dialog" Content="Обзор…" Click="OnBrowseTemplate" />
                </Grid>
            </StackPanel>

            <!-- 3. Папка для сохранения (выгрузка в Excel) -->
            <StackPanel x:Name="OutputPanel" Spacing="6">
                <TextBlock Text="3. Папка для сохранения результата"
                           FontWeight="{StaticResource FontWeightBold}" />
                <Grid ColumnDefinitions="*,10,Auto">
                    <TextBox Grid.Column="0" x:Name="OutputBox"
                             VerticalContentAlignment="Center"
                             Watermark="Папка не выбрана"
                             TextChanged="OnPathChanged" />
                    <Button Grid.Column="2" x:Name="OutputBtn"
                            Classes="dialog" Content="Обзор…" Click="OnBrowseOutput" />
                </Grid>
            </StackPanel>

            <!-- 2. База данных (выгрузка в программу) -->
            <StackPanel x:Name="DbPanel" Spacing="6" IsVisible="False">
                <TextBlock Text="2. База данных"
                           FontWeight="{StaticResource FontWeightBold}" />
                <ComboBox x:Name="DbCombo" Height="30" HorizontalAlignment="Stretch" />
            </StackPanel>

            <!-- 3. Название коллекции (выгрузка в программу) -->
            <StackPanel x:Name="NamePanel" Spacing="6" IsVisible="False">
                <TextBlock Text="3. Название коллекции"
                           FontWeight="{StaticResource FontWeightBold}" />
                <TextBox x:Name="NameBox"
                         VerticalContentAlignment="Center"
                         Watermark="Пусто — «Трудоемкость (дата и время)»" />
            </StackPanel>

            <!-- Колонки по операциям (выгрузка в программу) -->
            <CheckBox x:Name="OpsCheck" IsChecked="False" IsVisible="False"
                      Content="Добавить колонки по операциям"
                      IsCheckedChanged="OnOpsChanged"
                      ToolTip.Tip="После «Файл расчета» — колонка «Операции» и по колонке на каждую операцию, встретившуюся в расчетах.&#10;Время — из колонки G, на одну штуку изделия; только собственные операции изделия, без составных частей.&#10;Коллекция получается заметно тяжелее, а чтение — дольше." />

            <!-- 4. Файл списка операций (при колонках по операциям) -->
            <StackPanel x:Name="OpsPanel" Spacing="6" IsVisible="False">
                <TextBlock Text="4. Файл списка операций (Операции.xlsx)"
                           FontWeight="{StaticResource FontWeightBold}" />
                <Grid ColumnDefinitions="*,10,Auto">
                    <TextBox Grid.Column="0" x:Name="OpsBox"
                             VerticalContentAlignment="Center"
                             Watermark="Файл не выбран"
                             TextChanged="OnPathChanged" />
                    <Button Grid.Column="2" x:Name="OpsBtn"
                            Classes="dialog" Content="Обзор…" Click="OnBrowseOps" />
                </Grid>
            </StackPanel>

            <!-- Статус -->
            <Border Background="{StaticResource BrushSecondaryBg}"
                    BorderBrush="{StaticResource BrushSeparator}"
                    BorderThickness="{DynamicResource BorderLine}"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Padding="12,10">
                <TextBlock x:Name="StatusText"
                           Text="Готов к работе"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
            </Border>

            <!-- Прогресс: единый индикатор загрузки приложения -->
            <components:ProgressIndicator x:Name="Progress" />

            <!-- Действия (2 равные кнопки с зазором 10) -->
            <Grid ColumnDefinitions="*,10,*">
                <Button Grid.Column="0" x:Name="ExecuteBtn"
                        Classes="dialog"
                        Width="NaN" Height="36"
                        HorizontalAlignment="Stretch"
                        IsEnabled="False"
                        Content="Запустить"
                        Click="OnExecuteClick" />
                <Button Grid.Column="2" x:Name="StopBtn"
                        Classes="dialog"
                        Width="NaN" Height="36"
                        HorizontalAlignment="Stretch"
                        IsEnabled="False"
                        Content="Остановить"
                        Click="OnStopClick" />
            </Grid>

        </StackPanel>

        <!-- Заголовок журнала -->
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8"
                   Text="Журнал:"
                   FontWeight="{StaticResource FontWeightBold}" />

        <!-- Журнал (заполняет остаток). Класс multiline (Controls.axaml): полоса прокрутки
             во всю высоту поля, воздух текста — внутри области прокрутки. -->
        <TextBox x:Name="LogBox"
                 Classes="multiline"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 FontFamily="{StaticResource FontFamilyBase}"
                 FontSize="{DynamicResource FontSizeSmall}" />

    </DockPanel>

</Window>
