<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="using:SmartBase.Controls.Components"
        xmlns:w="clr-namespace:SmartBase.Controls.Widgets"
        x:Class="SmartBase.Extensions.PdfWatermark.PdfWatermarkWindow"
        Title="Водяной знак на PDF"
        Width="760" Height="900"
        MinWidth="620" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBg}">

    <Grid Margin="24" RowDefinitions="*,Auto,Auto,160">
        <!-- Форма прокручивается независимо; запуск, остановка и журнал остаются на месте. -->
        <ScrollViewer x:Name="FormScroll" Grid.Row="0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,14,14" Spacing="14">
                <Grid ColumnDefinitions="*,14,*">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="Режим надписи" FontWeight="{StaticResource FontWeightBold}" />
                        <ComboBox x:Name="ModeCombo" HorizontalAlignment="Stretch" SelectedIndex="1"
                                  SelectionChanged="OnModeChanged">
                            <ComboBoxItem Content="Свободный текст" />
                            <ComboBoxItem Content="С записью в таблицу" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6">
                        <TextBlock Text="Размещение" FontWeight="{StaticResource FontWeightBold}" />
                        <ComboBox x:Name="PlacementCombo" HorizontalAlignment="Stretch" SelectedIndex="0"
                                  SelectionChanged="OnPlacementChanged">
                            <ComboBoxItem Content="По центру" />
                            <ComboBoxItem Content="Блоками по всей странице" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="6">
                    <TextBlock Text="1. PDF-файл или папка с документами" FontWeight="{StaticResource FontWeightBold}" />
                    <Grid ColumnDefinitions="*,10,Auto,10,Auto">
                        <TextBox Grid.Column="0" x:Name="SourceBox" VerticalContentAlignment="Center"
                                 Watermark="Выберите файл или папку с документами…" TextChanged="OnSourceChanged" />
                        <Button Grid.Column="2" x:Name="FileBtn" Classes="dialog" Content="Файл…" Click="OnBrowseFile" />
                        <Button Grid.Column="4" x:Name="FolderBtn" Classes="dialog" Content="Папка…" Click="OnBrowseFolder" />
                    </Grid>
                    <TextBlock Text="Для смены надписи выбирайте исходный PDF без водяного знака."
                               TextWrapping="Wrap" Foreground="{StaticResource BrushSecondaryText}" />
                </StackPanel>

                <CheckBox x:Name="RecursiveCheck" IsChecked="False" IsEnabled="False"
                          Content="Рекурсивный поиск (включая все подпапки)" />

                <StackPanel Spacing="6">
                    <TextBlock Text="2. Папка для сохранения результата" FontWeight="{StaticResource FontWeightBold}" />
                    <Grid ColumnDefinitions="*,10,Auto">
                        <TextBox Grid.Column="0" x:Name="OutputBox" VerticalContentAlignment="Center"
                                 Watermark="Папка не выбрана" TextChanged="OnFormChanged" />
                        <Button Grid.Column="2" x:Name="OutputBtn" Classes="dialog" Content="Обзор…" Click="OnBrowseOutput" />
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="FreeTextPanel" Spacing="6" IsVisible="False">
                    <TextBlock Text="3. Свободный текст" FontWeight="{StaticResource FontWeightBold}" />
                    <TextBox x:Name="FreeTextBox" Classes="multiline" Height="120" AcceptsReturn="True"
                             TextWrapping="Wrap" MaxLength="4000" Watermark="Введите текст водяного знака"
                             TextChanged="OnFormChanged" />
                    <TextBlock Text="Текст используется только в PDF и не сохраняется в таблицу или настройки."
                               TextWrapping="Wrap" Foreground="{StaticResource BrushSecondaryText}" />
                </StackPanel>

                <StackPanel x:Name="JournalPanel" Spacing="14">
                    <!-- Номер экземпляра подбирается автоматически для каждого документа. -->
                    <Grid ColumnDefinitions="2*,14,*">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock x:Name="HolderLabel" Text="3. Выдан" FontWeight="{StaticResource FontWeightBold}" />
                            <TextBox x:Name="HolderBox" VerticalContentAlignment="Center"
                                     Watermark="Иванов Иван Иванович" TextChanged="OnFormChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Дата выдачи" FontWeight="{StaticResource FontWeightBold}" />
                            <w:DateField x:Name="DateBox" HorizontalAlignment="Stretch"
                                         Height="{StaticResource ControlHeightStandard}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="6">
                        <TextBlock Text="4. Текст предупреждения на знаке" FontWeight="{StaticResource FontWeightBold}" />
                        <TextBox x:Name="WarningBox" VerticalContentAlignment="Center"
                                 Watermark="Передача третьим лицам запрещена" TextChanged="OnFormChanged" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,14,*">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="5. База данных" FontWeight="{StaticResource FontWeightBold}" />
                            <ComboBox x:Name="DbCombo" Height="30" HorizontalAlignment="Stretch" SelectionChanged="OnDbChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Коллекция журнала выдачи" FontWeight="{StaticResource FontWeightBold}" />
                            <ComboBox x:Name="CollectionCombo" Height="30" HorizontalAlignment="Stretch" SelectionChanged="OnCollectionChanged" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="LayoutPanel" Spacing="6">
                    <TextBlock Text="Границы блока и отступы, мм" FontWeight="{StaticResource FontWeightBold}" />
                    <Grid ColumnDefinitions="*,14,*,14,*">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Ширина блока" />
                            <TextBox x:Name="BlockWidthBox" Text="75" TextChanged="OnFormChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Высота блока" />
                            <TextBox x:Name="BlockHeightBox" Text="50" TextChanged="OnFormChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Spacing="6">
                            <TextBlock Text="Отступ от краев" />
                            <TextBox x:Name="PageMarginBox" Text="8" TextChanged="OnFormChanged" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="GapPanel" ColumnDefinitions="*,14,*" IsVisible="False">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="Промежуток между столбцами" TextWrapping="Wrap" />
                            <TextBox x:Name="GapXBox" Text="10" TextChanged="OnFormChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Промежуток между рядами" TextWrapping="Wrap" />
                            <TextBox x:Name="GapYBox" Text="12" TextChanged="OnFormChanged" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Весь блок повернут по диагонали снизу слева вверх направо. Размеры задаются до поворота."
                               TextWrapping="Wrap" Foreground="{StaticResource BrushSecondaryText}" />
                </StackPanel>

                <TextBlock Text="Знак впечатывается в изображение страницы. В результате нет выделения и поиска текста; электронная подпись теряет действительность."
                           TextWrapping="Wrap" Foreground="{StaticResource BrushSecondaryText}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Spacing="10" Margin="0,10,0,14">
            <Border Background="{StaticResource BrushSecondaryBg}" BorderBrush="{StaticResource BrushSeparator}"
                    BorderThickness="{DynamicResource BorderLine}" CornerRadius="{StaticResource RadiusMedium}" Padding="12,10">
                <TextBlock x:Name="StatusText" Text="Готов к работе" TextWrapping="Wrap" HorizontalAlignment="Center"
                           FontWeight="{StaticResource FontWeightBold}" Foreground="{StaticResource BrushSecondaryText}" />
            </Border>
            <components:ProgressIndicator x:Name="Progress" />
            <Grid ColumnDefinitions="*,10,*">
                <Button Grid.Column="0" x:Name="ExecuteBtn" Classes="dialog" Width="NaN" Height="36"
                        HorizontalAlignment="Stretch" IsEnabled="False" Content="Запустить" Click="OnExecuteClick" />
                <Button Grid.Column="2" x:Name="StopBtn" Classes="dialog" Width="NaN" Height="36"
                        HorizontalAlignment="Stretch" IsEnabled="False" Content="Остановить" Click="OnStopClick" />
            </Grid>
        </StackPanel>
        <TextBlock Grid.Row="2" Margin="0,0,0,8" Text="Журнал:" FontWeight="{StaticResource FontWeightBold}" />
        <TextBox Grid.Row="3" x:Name="LogBox" Classes="multiline" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="Wrap" FontFamily="{StaticResource FontFamilyBase}" FontSize="{DynamicResource FontSizeSmall}" />
    </Grid>
</Window>
