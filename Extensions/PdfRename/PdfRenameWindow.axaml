<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="using:SmartBase.Controls.Components"
        x:Class="SmartBase.Extensions.PdfRename.PdfRenameWindow"
        Title="Переименование PDF-файлов"
        Width="760" Height="780"
        MinWidth="580" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBg}">

    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="0,0,0,14">

            <!-- Режим: по содержимому скана (шаблоны и OCR) или прежний — по имени файла. -->
            <StackPanel Spacing="6">
                <TextBlock Text="Режим" FontWeight="{StaticResource FontWeightBold}" />
                <ComboBox x:Name="ModeCombo" Height="30" HorizontalAlignment="Stretch"
                          SelectionChanged="OnModeChanged" />
            </StackPanel>

            <!-- 1. Папка шаблонов (по содержимому) -->
            <StackPanel x:Name="TemplatesPanel" Spacing="6">
                <TextBlock Text="1. Папка шаблонов (имя файла — тип документа, например «Спецификация.pdf»)"
                           TextWrapping="Wrap"
                           FontWeight="{StaticResource FontWeightBold}" />
                <Grid ColumnDefinitions="*,10,Auto">
                    <TextBox Grid.Column="0" x:Name="TemplatesBox"
                             VerticalContentAlignment="Center"
                             Watermark="Выберите папку с шаблонами…"
                             TextChanged="OnPathChanged" />
                    <Button Grid.Column="2" x:Name="TemplatesBtn"
                            Classes="dialog" Content="Обзор…" Click="OnBrowseTemplates" />
                </Grid>
                <!-- Подсказка по цветам рамок -->
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="Рамки на шаблоне:" Margin="0,0,10,0" VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{StaticResource BrushSecondaryText}" />
                    <Border Width="12" Height="12" Background="#2F6FE4" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock Text="синяя — обозначение" Margin="0,0,14,0" VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeSmall}" />
                    <Border Width="12" Height="12" Background="#2E9E44" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock Text="зеленая — наименование" Margin="0,0,14,0" VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeSmall}" />
                    <Border Width="12" Height="12" Background="#F0502A" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock Text="красно-оранжевая — оба поля вместе" VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeSmall}" />
                </WrapPanel>
            </StackPanel>

            <!-- 2. Папка с PDF (оба режима) -->
            <StackPanel Spacing="6">
                <TextBlock x:Name="SourceTitle" Text="2. Папка с PDF"
                           FontWeight="{StaticResource FontWeightBold}" />
                <Grid ColumnDefinitions="*,10,Auto">
                    <TextBox Grid.Column="0" x:Name="SourceBox"
                             VerticalContentAlignment="Center"
                             Watermark="Выберите папку с PDF-файлами…"
                             TextChanged="OnPathChanged" />
                    <Button Grid.Column="2" x:Name="SourceBtn"
                            Classes="dialog" Content="Обзор…" Click="OnBrowseSource" />
                </Grid>
            </StackPanel>

            <CheckBox x:Name="RecursiveCheck" IsChecked="False"
                      Content="Искать в подпапках"
                      IsCheckedChanged="OnRecursiveChanged" />

            <!-- Статус: счетчики и итог -->
            <Border Background="{StaticResource BrushSecondaryBg}"
                    BorderBrush="{StaticResource BrushSeparator}"
                    BorderThickness="{DynamicResource BorderLine}"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Padding="12,10">
                <TextBlock x:Name="StatusText"
                           Text="Готов к работе"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushSecondaryText}" />
            </Border>

            <!-- Прогресс: единый индикатор загрузки приложения -->
            <components:ProgressIndicator x:Name="Progress" />

            <!-- Действия: «Проверить» есть только у режима «по имени» -->
            <Grid x:Name="ActionsGrid" ColumnDefinitions="*,10,*,10,*">
                <Button Grid.Column="0" x:Name="PreviewBtn"
                        Classes="dialog" Width="NaN" Height="36"
                        HorizontalAlignment="Stretch"
                        Content="Проверить"
                        Click="OnPreviewClick" />
                <Button Grid.Column="2" x:Name="RunBtn"
                        Classes="dialog" Width="NaN" Height="36"
                        HorizontalAlignment="Stretch"
                        IsEnabled="False"
                        Content="Запустить"
                        Click="OnRunClick" />
                <Button Grid.Column="4" x:Name="StopBtn"
                        Classes="dialog" Width="NaN" Height="36"
                        HorizontalAlignment="Stretch"
                        IsEnabled="False"
                        Content="Стоп"
                        Click="OnStopClick" />
            </Grid>

        </StackPanel>

        <!-- Заголовок журнала и сохранение -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Журнал:" VerticalAlignment="Center"
                       FontWeight="{StaticResource FontWeightBold}" />
            <Button Grid.Column="1" x:Name="SaveLogBtn"
                    Classes="dialog" Content="Сохранить журнал…"
                    Width="NaN" Padding="14,0"
                    IsEnabled="False"
                    Click="OnSaveLog" />
        </Grid>

        <!-- Журнал: список строк с виртуализацией — полный результат большого прогона
             (тысячи файлов) листается без задержек. Выделенные строки копируются Ctrl+C. -->
        <Border Background="{StaticResource BrushSecondaryBg}"
                BorderBrush="{StaticResource BrushSeparator}"
                BorderThickness="{DynamicResource BorderLine}"
                CornerRadius="{StaticResource RadiusMedium}"
                ClipToBounds="True">
            <ListBox x:Name="LogList"
                     Background="Transparent"
                     SelectionMode="Multiple"
                     KeyDown="OnLogKeyDown">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="10,2" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap"
                                   FontFamily="{StaticResource FontFamilyBase}"
                                   FontSize="{DynamicResource FontSizeSmall}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

    </DockPanel>

</Window>
