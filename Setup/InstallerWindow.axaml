<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="using:SmartBase.Controls.Components"
        xmlns:setup="using:SmartBase.Setup"
        x:Class="SmartBase.Setup.InstallerWindow"
        Width="500" Height="440"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBg}"
        Title="SmartBase — Установка">

    <Window.Styles>
        <!-- Главная кнопка («Установить»/«Обновить»): размер как у dialog-кнопок приложения,
             синий фон (accent), темно-синий #0062CC при наведении. -->
        <Style Selector="Button.accent">
            <Setter Property="Width"                      Value="110" />
            <Setter Property="Height"                     Value="30" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment"   Value="Center" />
            <Setter Property="CornerRadius"               Value="{StaticResource RadiusMedium}" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0062CC" />
        </Style>

        <!-- Ссылка «Установить в другую папку…»: кнопка без рамки и фона. -->
        <Style Selector="Button.link">
            <Setter Property="Background"  Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"     Value="0" />
            <Setter Property="Foreground"  Value="{StaticResource BrushAccent}" />
            <Setter Property="Cursor"      Value="Hand" />
            <Setter Property="FontSize"    Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextBlock.TextDecorations" Value="Underline" />
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- Шапка -->
        <Border DockPanel.Dock="Top" Height="76"
                Background="{StaticResource BrushSecondaryBg}"
                BorderBrush="{StaticResource BrushSeparator}" BorderThickness="{DynamicResource BorderLineBottom}">
            <StackPanel VerticalAlignment="Center" Margin="24,0">
                <TextBlock Text="SmartBase"
                           FontSize="{DynamicResource FontSizeLarge}"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushPrimaryText}" />
                <TextBlock x:Name="VersionText" Text="Версия"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{StaticResource BrushSecondaryText}" />
            </StackPanel>
        </Border>

        <!-- Футер: галочка данных стоит НАД кнопками и относится только к «Удалить» —
             так однозначно читается, к какому действию она применяется. -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource BrushSecondaryBg}"
                BorderBrush="{StaticResource BrushSeparator}" BorderThickness="{DynamicResource BorderLineTop}">
            <StackPanel Margin="24,12" Spacing="10">
                <CheckBox x:Name="RemoveDataCheck" IsVisible="False"
                          Content="вместе с данными пользователя"
                          FontSize="{DynamicResource FontSizeSmall}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button x:Name="UninstallBtn" Content="Удалить"    Classes="dialog" Click="OnUninstall" IsVisible="False" />
                    <Button x:Name="CancelBtn"    Content="Отмена"     Classes="dialog" Click="OnCancel" />
                    <Button x:Name="PrimaryBtn"   Content="Установить" Classes="accent" Click="OnPrimary" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Тело -->
        <StackPanel Margin="24,18" Spacing="12">

            <TextBlock x:Name="SubtitleText" TextWrapping="Wrap"
                       Text="Поиск установленных копий…"
                       Foreground="{StaticResource BrushSecondaryText}" />

            <!-- Одна найденная копия: путь и версия строкой -->
            <StackPanel x:Name="SingleBlock" IsVisible="False" Spacing="2">
                <TextBlock x:Name="SinglePathText" TextWrapping="Wrap"
                           Foreground="{StaticResource BrushPrimaryText}" />
                <TextBlock x:Name="SingleVersionText"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{StaticResource BrushSecondaryText}" />
            </StackPanel>

            <!-- Несколько копий: выбор, к какой относятся кнопки -->
            <ListBox x:Name="InstallsList" IsVisible="False" MaxHeight="130"
                     Background="{StaticResource BrushSecondaryBg}"
                     CornerRadius="{StaticResource RadiusBase}"
                     SelectionChanged="OnInstallSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="setup:Installation">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Dir}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="{Binding VersionText}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{StaticResource BrushSecondaryText}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button x:Name="OtherFolderBtn" Classes="link" IsVisible="False"
                    Content="Установить в другую папку…" Click="OnOtherFolder" />

            <StackPanel x:Name="PathBlock" Spacing="6">
                <TextBlock Text="Папка установки"
                           FontSize="{DynamicResource FontSizeSmall}"
                           FontWeight="{StaticResource FontWeightBold}"
                           Foreground="{StaticResource BrushPrimaryText}" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="PathBox" Grid.Column="0" Height="30"
                             VerticalContentAlignment="Center" Margin="0,0,8,0"
                             Background="{StaticResource BrushSecondaryBg}"
                             CornerRadius="{StaticResource RadiusBase}" />
                    <Button Grid.Column="1" Content="Обзор" Classes="dialog" Click="OnBrowse" />
                </Grid>
                <!-- Виден, когда путь вписали руками и к нему допишется своя подпапка:
                     человек должен заранее знать, куда реально ляжет программа. -->
                <TextBlock x:Name="EffectivePathText" IsVisible="False" TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{StaticResource BrushSecondaryText}" />
            </StackPanel>

            <Border x:Name="WarnBox" IsVisible="False"
                    Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="{DynamicResource BorderLine}"
                    CornerRadius="6" Padding="10,8">
                <TextBlock x:Name="WarnText" TextWrapping="Wrap" Foreground="#B45309"
                           FontSize="{DynamicResource FontSizeSmall}" />
            </Border>

            <CheckBox x:Name="ShortcutCheck" Content="Создать ярлык на рабочем столе" IsChecked="True" />

            <!-- Единый индикатор загрузки приложения (полоса + проценты + фаза) -->
            <components:ProgressIndicator x:Name="ProgressBlock" IsVisible="False" />

        </StackPanel>

    </DockPanel>
</Window>
